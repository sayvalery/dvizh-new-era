---
/**
 * HeroSectionFull — full-screen hero для продуктовых страниц
 *
 * Слои (снизу вверх):
 *   1. slot="background" — абсолютный, inset-0, z-0: паттерн стрелочек, частицы и т.д.
 *      Покрывает ВСЮ секцию целиком.
 *   2. Двухколоночный грид (z-10):
 *      — левая колонка (60%): заголовок + описание + кнопки, прибиты к низу
 *      — правая колонка (40%): slot="right" — 3D-изображение, по центру
 *      Если slot="right" не передан — контент на всю ширину (оригинальный вариант).
 *   3. slot="logos" — строка логотипов под текстом в левой колонке
 *
 * @example с изображением
 * ```astro
 * <HeroSectionFull title="Заголовок" description="...">
 *   <PixelArrowPattern slot="background" />
 *   <img slot="right" src="/hero.webp" class="w-full animate-hero-float" />
 *   <LogoGrid slot="logos" />
 * </HeroSectionFull>
 * ```
 */

import Button from '../ui/Button.astro'

interface Props {
  badge?: string
  title: string
  description?: string
  demoLabel?: string
  kpLabel?: string
  demoPreset?: 'demo' | 'lead' | 'research' | 'subscribe'
  kpPreset?: 'demo' | 'lead' | 'research' | 'subscribe'
  class?: string
}

const {
  badge,
  title,
  description,
  demoLabel = 'Получить демо',
  kpLabel = 'Получить КП',
  demoPreset = 'demo',
  kpPreset = 'lead',
  class: className = '',
} = Astro.props

const hasLogos = Astro.slots.has('logos')
const hasRight = Astro.slots.has('right')
---

<section class:list={['relative overflow-hidden bg-background-primary', className]}>

  <!-- Слой 1: паттерн / фон — на всю секцию -->
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <slot name="background" />
  </div>

  <!-- Слой 2: контент поверх фона -->
  <div class="relative z-10 flex flex-col min-h-[calc(100dvh-76px)]">
    <div class="flex-1 max-w-[1440px] mx-auto w-full px-4 sm:px-6 lg:px-10">

      {hasRight ? (

        /* ── Двухколоночный вариант: текст слева, изображение справа ── */
        /*
         * lg:h-[calc(100dvh-76px)] фиксирует высоту на десктопе — иначе высокое
         * изображение в правой колонке раздувает grid-строку и смещает pb-40 за фолд.
         * min-h сохраняет рост на мобилках (правая колонка там скрыта).
         */
        <!-- <lg: flex-col — картинка (1-я в DOM) сверху, текст под ней (flex-1, прижат к низу).
             lg+: grid; колонки расставлены ЯВНО (lg:col-start-*), т.к. в DOM картинка идёт
             первой: текст в 1-й колонке слева (60%), картинка во 2-й справа (40%).
             Порядок — через DOM + col-start, а не order/flex-reverse (order-none не генерится
             минификатором, а column-reverse дал неверный порядок). Грид только с lg —
             иначе одна auto-строка не тянется и justify-end не прибивает контент к низу. -->
        <div class="flex flex-col min-h-[calc(100dvh-76px)] lg:grid lg:h-[calc(100dvh-76px)] lg:grid-cols-[60%_40%]">

          <!-- Колонка картинки — В DOM ПЕРВАЯ → на мобилке (flex-col) встаёт СВЕРХУ, вписана
               (см. <style>). На lg явно во 2-й колонке справа; absolute-обёртка даёт «вытекание»
               за колонку, не влияя на layout-высоту (верт. клип — overflow-hidden секции). -->
          <div class="hero-media relative lg:col-start-2 lg:row-start-1 lg:-mt-8" aria-hidden="true">
            <div class="flex justify-center lg:absolute lg:-top-[100px] lg:left-0 lg:right-0 lg:bottom-0 lg:items-start">
              <slot name="right" />
            </div>
          </div>

          <!-- Текстовая колонка — В DOM ВТОРАЯ → на мобилке снизу. На lg явно в 1-й колонке слева.
               flex-1 нужен только <lg (заполнить высоту flex-контейнера); в grid игнорируется.
               z-10 чтобы быть поверх картинки. hero-left-col: на .fluid-page pb флюидный (global.css). -->
          <div class="hero-left-col relative z-10 flex flex-1 flex-col justify-end pb-24 lg:pb-40 lg:col-start-1 lg:row-start-1">
            <div class="flex flex-col gap-6">
              {badge && <p class="text-brand text-body-lg font-normal">{badge}</p>}
              <h1 class="text-h1 text-gray-900">{title}</h1>
              {description && <p class="text-body-lg text-gray-500">{description}</p>}
              <div class="flex flex-col xs:flex-row gap-4 pt-2">
                <Button variant="primary" size="lg" drawerPreset={demoPreset} class="w-full xs:flex-1 lg:flex-none lg:w-auto">{demoLabel}</Button>
                <Button variant="ghost"   size="lg" drawerPreset={kpPreset}  class="w-full xs:flex-1 lg:flex-none lg:w-auto">{kpLabel}</Button>
              </div>
            </div>
            {hasLogos && (
              <div class="w-full overflow-x-hidden mt-12 md:mt-16">
                <slot name="logos" />
              </div>
            )}
          </div>

        </div>

      ) : (

        /* ── Оригинальный вариант: только текст, на всю ширину ── */
        <div class="hero-left-col flex flex-col justify-end flex-1 pb-24 lg:pb-40 min-h-[calc(100dvh-76px)]">
          <div class="flex flex-col gap-6 max-w-[1000px]">
            {badge && <p class="text-brand text-body-lg font-normal">{badge}</p>}
            <h1 class="text-h1 text-gray-900">{title}</h1>
            {description && <p class="text-body-lg text-gray-500">{description}</p>}
            <div class="flex flex-col xs:flex-row gap-4 pt-2">
              <Button variant="primary" size="lg" drawerPreset={demoPreset} class="w-full xs:flex-1 lg:flex-none lg:w-auto">{demoLabel}</Button>
              <Button variant="ghost"   size="lg" drawerPreset={kpPreset}  class="w-full xs:flex-1 lg:flex-none lg:w-auto">{kpLabel}</Button>
            </div>
          </div>
          {hasLogos && (
            <div class="w-full overflow-x-hidden mt-12 md:mt-16">
              <slot name="logos" />
            </div>
          )}
        </div>

      )}

    </div>
  </div>

</section>

<style>
  /* Размер hero-картинки задаётся в пропсах страницы (h-[106dvh] w-auto max-width:none) —
     это «вытекающий» десктопный рендер. На <lg каппим: вписываем сверху, не даём вытекать.
     :global(img) — картинка приходит через slot (вне scope компонента). max-width c
     !important перебивает inline style="max-width:none". На lg каппы снимаются → десктоп как был. */
  .hero-media :global(img) {
    max-height: 40dvh;
    max-width: 100% !important;
  }
  @media (min-width: 1024px) {
    .hero-media :global(img) {
      max-height: none;
      max-width: none !important;
    }
  }
</style>

