---
/**
 * FluidStyles — единая флюид-система для лаб-страниц (главная + продуктовые).
 *
 * Подключается на странице через `<FluidStyles />`, активируется классом
 * `fluid-page` на <body> (через `bodyClass` в SiteLayout). Без класса не
 * применяется — глобальную типографику не трогает.
 *
 * Что внутри:
 *   1. Типографика — clamp() без брейкпойнтов. На ~1280px значения совпадают
 *      с дизайн-системой (десктоп), дальше РАСТУТ выше ДС до потолка
 *      (h1→78, h2→64 …). Мобильных media-фиксов нет — флюид непрерывен.
 *   2. Ширина контента — плавно 1440 → 1920px (потолок ~с 2560px вьюпорта).
 *      Одна формула на .page-container, хэдер и hero — растут синхронно.
 *   3. Hero-картинка (HeroSectionFull) — правый край привязан к флюид-ширине,
 *      а не к фикс-1440 (иначе на широких экранах разъезжается с контентом).
 *
 * Не-типографика конкретной страницы (hero-сетка главной, LogoDrum, высоты
 * карточек) остаётся в <style> самой страницы — здесь только общая система.
 */
---

<style is:global>
  /* ── 1. Типографика (без мобильных фиксов — непрерывный флюид) ── */
  .fluid-page .text-h1,
  .fluid-page .text-h1-italic { font-size: clamp(28px, 1rem + 3.75vw, 68px); } /* потолок 68 (капается ~с 1386px); на 1280px = 64 (ДС-десктоп) */
  .fluid-page .text-h2 { font-size: clamp(30px, 1rem + 2.5vw, 64px); }
  .fluid-page .text-h3 { font-size: clamp(24px, 0.75rem + 1.56vw, 42px); }
  .fluid-page .text-product-card-h { font-size: clamp(24px, 1rem + 2.5vw, 64px); }
  .fluid-page .text-h4 { font-size: clamp(18px, 0.75rem + 0.94vw, 30px); }
  .fluid-page .text-h5 { font-size: clamp(16px, 0.88rem + 0.31vw, 20px); }
  .fluid-page .text-h6 { font-size: clamp(14px, 0.75rem + 0.31vw, 18px); }
  .fluid-page .text-card-title { font-size: clamp(20px, 1.15rem + 0.44vw, 24px); } /* мелкий лейбл карточки — капается на ДС-десктопе (24), выше не растим */

  /* Тело текста */
  .fluid-page .text-body-lg,
  .fluid-page .text-body-lg-italic,
  .fluid-page .text-body-lg-bold { font-size: clamp(16px, 0.88rem + 0.31vw, 20px); }
  .fluid-page .text-subhead { font-size: clamp(14px, 0.75rem + 0.31vw, 18px); }
  .fluid-page .text-medium-32 { font-size: clamp(18px, 0.5rem + 1.25vw, 32px); }

  /* ── 2. Ширина контента: 1440 → 1920px (одна формула на контейнер/хэдер/hero) ── */
  .fluid-page .page-container,
  .fluid-page header .max-w-\[1440px\],
  .fluid-page section .max-w-\[1440px\] { max-width: clamp(1440px, 60rem + 37.5vw, 1920px); }

  /* ── 3. Hero (HeroSectionFull) под .fluid-page — только продуктовые лаб-страницы ──
     body.fluid-page для специфичности выше scoped-стилей компонента. */

  /* Фикс: класс min-h-[calc(100dvh-76px)] не генерит CSS — calc без пробелов
     вокруг «-» невалиден, минификатор выкидывает правило, и hero теряет высоту
     (контент не прижимается к низу). Возвращаем min-height валидным calc.
     (То же есть в самом компоненте → латентно и на проде; здесь чиним только лаб.) */
  body.fluid-page .min-h-\[calc\(100dvh-76px\)\] {
    min-height: calc(100dvh - 76px);
  }

  /* Нижний отступ hero — флюидный вместо ступенчатого pb-24/lg:pb-40 (96/160).
     64px на мобилке (~375) → 96px на планшете (~768), дальше потолок 96px. */
  body.fluid-page .hero-left-col {
    padding-bottom: clamp(64px, 33.5px + 8.14vw, 96px);
  }

  @media (min-width: 1024px) {
    /* Текстовая колонка — % от КОНТЕЙНЕРА (не от вьюпорта), чтобы расти
       синхронно с hero-контейнером, а не обгонять его на широких экранах.
       На 1440px контейнер→1440, контент-бокс (минус px-10 = 80px) = 1360px,
       нужно 800px → 800 / 1360 = 58.82%. Дальше колонка = тот же % контейнера. */
    body.fluid-page .hero-left-col {
      max-width: 58.82%;
    }
    /* Иллюстрация сдвинута в боковое поле — на треть гаттера правее линии кнопки
       (раньше /2 = ровно по кнопке; /3 = ушла в гаттер на треть его ширины).
       Линия кнопки = боковой гаттер + паддинг 40px (контейнер max-w 1440→1920,
       px-10 на lg; «остров» хэдера нетто-0). width:auto — колонка по ширине картинки. */
    body.fluid-page .hero-right-col {
      width: auto;
      right: max(24px, calc((100vw - clamp(1440px, 60rem + 37.5vw, 1920px)) / 5 + 24px));
    }
  }
</style>
