---
/**
 * QuoteBlock — цитата внутри статьи
 *
 * Рендерится через компонент Review (no-photo вариант) в карточке с фоном.
 * Если у компании есть логотип — показывается он; иначе фото автора как
 * круглый аватар в футере.
 *
 * CMS-поля (блок 'quote' в BlogPosts → content):
 *   text    → текст цитаты (обязательно) → Review.quote
 *   author  → имя автора                 → Review.author
 *   company → должность / роль автора     → Review.role
 *   photo   → upload (Media), фото автора → Review.avatar (круглое)
 *
 * Рендерится через BlockRenderer.astro при blockType === 'quote'.
 */
import Review from '../ui/Review.astro'
import { normalizeMediaUrl } from '../../lib/payload'

interface Props {
  block: any
}

const { block } = Astro.props
const photoUrl = normalizeMediaUrl(block.photo?.url) ?? null
const avatar = photoUrl ? { src: photoUrl, alt: block.author ?? '' } : undefined

// Если у цитаты нет ни автора, ни подписи, ни фото — это просто выделенный
// текст: показываем его в серой плашке без иконки-кавычек и футера.
const hasAttribution = !!(block.author || block.company || photoUrl)
---

<div class="my-8">
  {hasAttribution ? (
    <Review
      quote={block.text}
      author={block.author ?? undefined}
      role={block.company ?? undefined}
      avatar={avatar}
      class="bg-gray-200 rounded-3xl p-8 lg:p-10"
    />
  ) : (
    <div class="bg-gray-200 rounded-3xl p-8 lg:p-10">
      <p class="text-body-lg text-gray-900">{block.text}</p>
    </div>
  )}
</div>
