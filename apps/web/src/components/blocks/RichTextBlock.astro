---
/**
 * RichTextBlock — форматированный текст (Payload Lexical)
 *
 * Сериализация вынесена в src/lib/lexical.ts (serializeLexical), чтобы
 * переиспользовать ее для построения оглавления и рендера на lab/blog-страницах.
 *
 * CMS-поля (блок 'richText' в BlogPosts → content):
 *   content → Lexical EditorState JSON (Rich Text поле Payload)
 *
 * Рендерится через BlockRenderer.astro при blockType === 'richText'.
 */
import { serializeLexical } from '../../lib/lexical'

interface Props {
  block: any
}

const { block } = Astro.props
const html = serializeLexical(block.content)
---

<div class="prose prose-gray max-w-none" set:html={html} />
