---
import NavBar from '../ui/NavBar.astro'
import type { NavItem } from '../ui/NavBar.astro'
import { getBlogPosts, normalizeMediaUrl } from '../../lib/payload'

interface Props {
  /** Прозрачный режим навигации (для страниц с цветным hero) */
  transparent?: boolean
  /** Вариант хедера: default — основной сайт, blog — блог/инсайты */
  variant?: 'default' | 'blog'
  /** Брендинг «ДВИЖ Инсайты» (логотип insight вместо основного) */
  insights?: boolean
}

const { transparent = false, variant = 'default', insights = false } = Astro.props

// Логотип: insight-версия или основной ДВИЖ. Пары цвет/белый одной геометрии (нет скачка),
// белая версия insights — настоящий SVG с вырезами-стрелками (не CSS-фильтр).
const logo = insights
  ? { label: 'ДВИЖ Инсайты', href: '/blog', image: '/logo-dvizh-insights.svg', imageLight: '/logo-dvizh-insights-white.svg' }
  : { label: 'ДВИЖ', href: '/', image: '/logo-dvizh.svg', imageLight: '/logo-dvizh-white.svg' }

// Свежие посты для выпадашек «Блог»/«Кейсы», карточки мегаменю и мобильного меню (только default-вариант).

/** Пост CMS → пропсы карточки выпадашки (cover передаём сырым — BlogCard сам нормализует + srcset) */
function toCard(post: any) {
  return {
    title: post.title,
    slug: post.slug,
    cover: post.cover,
  }
}

let latestPosts: any[] = []
let caseDocs: any[] = []
if (variant !== 'blog') {
  try {
    // Блог: 3 свежих поста (+ 1-й для карточки мегаменю)
    const { docs } = await getBlogPosts({ limit: 3, depth: 2 })
    latestPosts = docs
    // Кейсы: целевой запрос по категории (кейсы редкие, в общую выборку не попадают)
    const cases = await getBlogPosts({
      where: { _status: { equals: 'published' }, 'category.slug': { equals: 'cases' } },
      limit: 3,
      depth: 2,
    })
    caseDocs = cases.docs
  } catch {
    // CMS недоступен при сборке — меню работает без карточек
  }
}

const blogCards = latestPosts.slice(0, 3).map(toCard)
const caseCards = caseDocs.slice(0, 3).map(toCard)

// Последний пост — для правой колонки мегаменю (Продукты/Решения) и мобильного меню
const blogPosts = latestPosts.slice(0, 1).map((post: any) => ({
  title: post.title,
  slug: post.slug,
  cover: post.cover ? { url: normalizeMediaUrl(post.cover.url) ?? undefined, alt: post.cover.alt } : undefined,
  category: post.category?.title,
}))

const navItems: NavItem[] = [
  {
    label: 'Продукты',
    sections: [
      {
        title: 'Продукты',
        items: [
          { label: 'Ипотека', href: '/ipoteka' },
          { label: 'Электронная регистрация', href: '/elektronnaya-registraciya' },
          { label: 'Скоринг', href: '/scoring' },
          { label: 'Ипотечный калькулятор', href: '/ipotechnyy-kalkulyator' },
        ],
      },
    ],
  },
  {
    label: 'Решения',
    sections: [
      {
        title: 'Решения',
        items: [
          { label: 'Девелоперам', href: '/developers' },
          { label: 'Агентствам недвижимости', href: '/agentstva-nedvizhimosti' },
          { label: 'Департаменту продаж', href: '/for-sales-department' },
          { label: 'Отделу ипотеки', href: '/ipoteka' },
          { label: 'Отделу оформления', href: '/elektronnaya-registraciya' },
        ],
      },
    ],
  },
  { label: 'Блог', href: '/blog', badge: 'dot', posts: blogCards },
  { label: 'Кейсы', href: '/blog/category/cases', posts: caseCards },
]

// Пункты меню для блог-варианта — плоские ссылки без мегаменю
const blogNavItems: NavItem[] = [
  { label: 'Статьи', href: '/blog/articles' },
  { label: 'Кейсы', href: '/blog/category/cases' },
  { label: 'Подкасты', href: '/blog/category/podcasts' },
]
---

<NavBar
  logo={logo}
  items={variant === 'blog' ? blogNavItems : navItems}
  blogPosts={blogPosts}
  secondaryLink={variant === 'blog' ? { label: 'dvizh.io', href: '/' } : { label: '+7 495 032 10 47', href: 'tel:+74950321047' }}
  cta={variant === 'blog' ? { label: 'Стать автором', href: '/contacts' } : { label: 'Получить расчет', preset: 'demo' }}
  transparent={transparent}
  variant={variant}
/>
