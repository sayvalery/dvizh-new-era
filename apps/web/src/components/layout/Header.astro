---
import NavBar from '../ui/NavBar.astro'
import type { NavItem } from '../ui/NavBar.astro'
import { getBlogPosts, normalizeMediaUrl } from '../../lib/payload'

interface Props {
  /** Прозрачный режим навигации (для страниц с цветным hero) */
  transparent?: boolean
  /** Вариант хедера: default — основной сайт, blog — блог/инсайты */
  variant?: 'default' | 'blog'
}

const { transparent = false, variant = 'default' } = Astro.props

const navItems: NavItem[] = [
  {
    label: 'Продукты',
    sections: [
      {
        title: 'Продукты',
        items: [
          { label: 'Ипотека', href: '/ipoteka' },
          { label: 'Электронная регистрация', href: '/elektronnaya-registraciya' },
          { label: 'Скоринг', href: '/scoring' },
          { label: 'Ипотечный калькулятор', href: '/ipotechnyy-kalkulyator' },
        ],
      },
    ],
  },
  {
    label: 'Решения',
    sections: [
      {
        title: 'Решения',
        items: [
          { label: 'Девелоперам', href: '/developers' },
          { label: 'Агентствам недвижимости', href: '/agentstva-nedvizhimosti' },
          { label: 'Департаменту продаж', href: '/for-sales-department' },
          { label: 'Отделу ипотеки', href: '/ipoteka' },
          { label: 'Отделу оформления', href: '/elektronnaya-registraciya' },
        ],
      },
    ],
  },
  { label: 'Блог', href: '/blog', badge: 'dot' },
  { label: 'Кейсы', href: '/cases' },
  { label: 'О нас', href: '/about' },
]

// Последний пост — для правой колонки мегаменю (desktop) и мобильного меню
let blogPosts: { title: string; slug: string; cover?: { url?: string; alt?: string }; category?: string }[] = []
try {
  const { docs } = await getBlogPosts({ limit: 1 })
  blogPosts = docs.map((post: any) => ({
    title: post.title,
    slug: post.slug,
    cover: post.cover ? { url: normalizeMediaUrl(post.cover.url) ?? undefined, alt: post.cover.alt } : undefined,
    category: post.category?.title,
  }))
} catch {
  // CMS недоступен при сборке — меню работает без блог-карточек
}
---

<NavBar
  logo={{ label: 'ДВИЖ', href: '/', image: '/logo-dvizh.svg', imageLight: '/logo-dvizh-white.svg' }}
  items={navItems}
  blogPosts={blogPosts}
  secondaryLink={variant === 'blog' ? { label: 'На сайт ДВИЖ', href: '/' } : { label: '+7 495 032 10 47', href: 'tel:+74950321047' }}
  cta={variant === 'blog' ? { label: 'Стать автором', href: '/contacts', chevron: true } : { label: 'Получить расчет', preset: 'demo' }}
  transparent={variant === 'blog' ? true : transparent}
  variant={variant}
/>
