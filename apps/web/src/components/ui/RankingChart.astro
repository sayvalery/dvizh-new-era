---
/**
 * RankingChart — рейтинг с меняющимся составом
 *
 * Топ банков: строка на участника, полоса от нуля по общей шкале. Подписи устроены
 * так же, как в столбчатых диаграммах, только развёрнуто по горизонтали: значение
 * ВНУТРИ полосы у её начала, изменение — сразу за её концом, снаружи.
 *
 * Разница с прошлым месяцем показана ЗАШТРИХОВАННОЙ областью между прошлым и
 * текущим значением — тот же приём, что в воронке, только развёрнутый по
 * горизонтали:
 *
 *  - выросло → область лежит ВНУТРИ полосы, штриховка ложится поверх заливки;
 *  - упало   → та же область оказывается ЗА концом полосы, на пустом фоне, и
 *              показывает, сколько потеряно.
 *
 * Фигура одна, меняется только то, на чём она лежит. Прежние серые засечки не
 * годились: точка не показывает величину сдвига, только его положение.
 *
 * Состав меняется, и это часть данных: у новых участников стоит пометка, а кто
 * выпал из топа — перечислено под графиком. Молчание об этом искажает рейтинг.
 *
 * Bump chart не используется: на десяти участниках он превращается в спагетти и
 * показывает только порядок, теряя величину. См. chart-guidelines.md §14.
 *
 * Сделан на HTML и CSS: текст не должен масштабироваться вместе с полем (§12).
 */
import { buildRankingBlock, type RankingOptions } from '@/lib/charts/ranking'
import { ARROW_GLYPH, CHART_LABEL_CLASS, HATCH_LAYERS } from '@/lib/charts/presets'
import { SPARK_COLORS } from '@/lib/charts/sparkline'
import type { Indicator } from '@/lib/charts/types'

interface Props extends RankingOptions {
  indicator: Indicator
  showTitle?: boolean
  showSource?: boolean
  class?: string
}

const {
  indicator,
  showTitle = true,
  showSource = false,
  class: className = '',
  ...rankingOptions
} = Astro.props

const block = buildRankingBlock(indicator, rankingOptions)

const BRAND = '#ff4d00'

/**
 * Косая штриховка разницы.
 *
 * Угол 45deg, а НЕ -45deg: в CSS угол задаёт направление градиентной линии, а
 * полосы идут перпендикулярно ей. При -45deg полосы получались зеркальными к
 * воронке, где в SVG стоит rotate(-45). Это разные системы отсчёта, и знак угла
 * между ними не совпадает.
 *
 * Длины 6/12 отмеряются ВДОЛЬ градиентной линии, то есть видимая ширина полосы
 * равна 6 × cos45° ≈ 4px. Штрих и пропуск равны.
 *
 * Слои и цвета — из общего токена HATCH_LAYERS, те же, что в воронке. У прироста
 * два слоя: светлая подложка отделяет прибавившийся кусок от заливки, тёмный штрих
 * поверх даёт вес. Одним слоем не выходило ни в тёмную, ни в светлую сторону —
 * обоснование в токене.
 */
const HATCH = (color: string, opacity: number) =>
  `repeating-linear-gradient(45deg, ${color} 0 6px, transparent 6px 12px)` +
  `;opacity:${opacity}`

const at = (value: number) => (value / block.maxValue) * 100

/**
 * Порога в коде нет намеренно.
 *
 * Влезает ли значение внутрь полосы, зависит от её фактической ширины, а та
 * меняется вместе с контейнером — в статье, в узкой колонке и на телефоне полоса
 * разной длины. Любое число в процентах от шкалы верно ровно для одной ширины.
 * Поэтому решает браузер через container query, правила в global.css
 * (.chart-bar / .chart-bar-inside / .chart-bar-outside / .chart-bar-delta).
 */
const unitSuffix = indicator.unit === 'percent' ? '%' : indicator.unit === 'hours' ? ' ч' : ''
const betterIsLess = indicator.polarity === 'lower-is-better'
---

<figure class={`not-prose my-10 ${className}`} x-data="{ hovered: null }">
  {showTitle && (
    <figcaption class="mb-1">
      <h3 class="font-heading text-h4 text-gray-900">{indicator.title}</h3>
    </figcaption>
  )}

  <p class="mb-6 font-sans text-subhead text-gray-500">
    {block.currentMonth}
    {block.previousMonth && <> против {block.previousMonth}</>}
    {betterIsLess && <> · меньше — лучше</>}
  </p>

  <ul class="space-y-2">
    {block.rows.map((row, i) => {
      /**
       * Насколько штриховка вылезает за конец полосы — в процентах ОТ ШИРИНЫ
       * ПОЛОСЫ, потому что процентный padding считается от неё. Через эту величину
       * подписи обходят заштрихованную область, а не наезжают на неё.
       */
      const overhang =
        row.previous !== null && !row.isRest && row.previous > row.value && at(row.value) > 0
          ? ((at(row.previous) - at(row.value)) / at(row.value)) * 100
          : 0

      return (
      <li
        class="relative grid grid-cols-[9.5rem_1fr] items-center gap-3"
        @mouseenter={`hovered = ${i}`}
        @mouseleave="hovered = null"
      >
        <span
          class={`truncate font-sans text-footnote ${row.isRest ? 'text-gray-400' : 'text-gray-500'}`}
          title={row.name}
        >
          {row.name}
        </span>

        <!-- Справа зарезервировано место под изменение: полоса масштабируется
             внутри узкого блока, а подписи выходят за него. -->
        <span class="relative block h-8" style="margin-right:5.5rem">
          <!--
            Полоса — сам контейнер запроса. Обе подписи и изменение лежат внутри
            неё, потому что container query действует только на потомков.
            Скругление только справа: левый край стоит на нуле.
          -->
          <span
            class="chart-bar absolute inset-y-[0.15rem] left-0 rounded-r"
            style={`width:${at(row.value)}%;background:${
              row.isRest ? '#e6e4e1' : BRAND
            };--overhang:${overhang}%`}
          >
            <span
              class={`chart-bar-inside absolute top-1/2 left-0 z-10 -translate-y-1/2 whitespace-nowrap pl-2 text-white ${CHART_LABEL_CLASS}`}
            >
              {row.valueLabel}
            </span>
            <span
              class={`chart-bar-outside absolute top-1/2 left-full z-10 -translate-y-1/2 whitespace-nowrap text-gray-900 ${CHART_LABEL_CLASS}`}
            >
              {row.valueLabel}
            </span>

            <span
              class={`chart-bar-delta absolute top-1/2 left-full z-10 -translate-y-1/2 whitespace-nowrap text-gray-900 ${CHART_LABEL_CLASS}`}
            >
              {row.isNew ? (
                <span class="font-sans" style={`color:${BRAND}`}>новый</span>
              ) : row.deltaLabel ? (
                <>
                  <span
                    class="font-sans"
                    style={`color:${
                      row.isGood === null ? '#cacaca' : row.isGood ? SPARK_COLORS.good : SPARK_COLORS.bad
                    };font-weight:800`}
                    aria-hidden="true"
                  >{(row.delta as number) > 0 ? ARROW_GLYPH.up : ARROW_GLYPH.down}</span>{' '}
                  {row.deltaLabel}
                </>
              ) : (
                <span class="text-gray-300">—</span>
              )}
            </span>
          </span>

          <!--
            Штриховка идёт ПОСЛЕ полосы, иначе при росте она оказывается под
            непрозрачной заливкой и не видна вовсе — прежняя версия работала
            только на падениях. Подписи подняты на z-10, чтобы штриховка их не
            накрывала. Цвета из HATCH_COLORS, общие с воронкой.
          -->
          {/* Подложка только у прироста: она и делает область заметной. */}
          {row.previous !== null && !row.isRest && row.value >= row.previous && (
            <span
              class="pointer-events-none absolute inset-y-[0.15rem] rounded-r"
              style={[
                `left:${Math.min(at(row.previous), at(row.value))}%`,
                `width:${Math.abs(at(row.value) - at(row.previous))}%`,
                `background:${HATCH_LAYERS.grown.wash}`,
                `opacity:${HATCH_LAYERS.grown.washOpacity}`,
              ].join(';')}
            ></span>
          )}

          {row.previous !== null && !row.isRest && (
            <span
              class="pointer-events-none absolute inset-y-[0.15rem] rounded-r"
              style={[
                `left:${Math.min(at(row.previous), at(row.value))}%`,
                `width:${Math.abs(at(row.value) - at(row.previous))}%`,
                `background:${
                  row.value >= row.previous
                    ? HATCH(HATCH_LAYERS.grown.stripe, HATCH_LAYERS.grown.stripeOpacity)
                    : HATCH(HATCH_LAYERS.lost.stripe, HATCH_LAYERS.lost.stripeOpacity)
                }`,
              ].join(';')}
            ></span>
          )}
        </span>

        <!-- Подсказка своя у строки, абсолютным позиционированием -->
        <div
          x-show={`hovered === ${i}`}
          x-cloak
          class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-1 -translate-x-1/2 whitespace-nowrap rounded-xl bg-gray-900 px-3 py-2 text-center shadow-lg"
        >
          <span class="block font-heading text-footnote leading-tight text-white">{row.name}</span>
          <span class="mt-0.5 block font-sans text-[0.7rem] leading-tight text-white/70">
            {block.previousMonth} {row.previous === null ? 'не в топе' : `${row.previous.toLocaleString('ru-RU')}${unitSuffix}`}
            {' → '}
            {block.currentMonth} {row.valueLabel}
          </span>
          {row.rankShift !== null && row.rankShift !== 0 && (
            <span class="mt-0.5 block font-sans text-[0.7rem] leading-tight text-white/70">
              место {row.previousRank} → {row.rank}
            </span>
          )}
        </div>
      </li>
      )
    })}
  </ul>

  <p class="mt-5 font-sans text-footnote text-gray-400">
    Полосы от нуля, общая шкала до {block.maxValue.toLocaleString('ru-RU')}{unitSuffix}.
    Заштрихованное — разница с прошлым месяцем: внутри полосы прирост, за её концом потеря.
    {block.dropped.length > 0 && (
      <> Выпали из топа: {block.dropped.join(', ')}.</>
    )}
  </p>

  {block.notes.length > 0 && (
    <ul class="mt-3 space-y-1">
      {block.notes.map(note => <li class="font-sans text-footnote text-gray-400">{note}</li>)}
    </ul>
  )}

  {showSource && block.source && (
    <p class="mt-2 font-sans text-footnote text-gray-400">Источник: {block.source}</p>
  )}
</figure>
