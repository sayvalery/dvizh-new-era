---
/**
 * FormClosing — секция с формой или кнопками в конце страницы
 *
 * Два режима через prop `mode`:
 *   form    — инлайн-форма с полями (по умолчанию)
 *   buttons — две кнопки вместо формы (primary + secondary)
 *
 * Пункты списка `items` отображаются с иконкой check circle.
 *
 * @example
 * <!-- Форма с пунктами -->
 * <FormClosing
 *   preset="lead"
 *   title="Попробуйте ДВИЖ в деле"
 *   items={['Покажем кейсы', 'Рассчитаем ROMI', 'Разберём ваши задачи']}
 * />
 *
 * <!-- Вариант с кнопками -->
 * <FormClosing
 *   mode="buttons"
 *   title="Аудит вашего отдела продаж от аналитиков ДВИЖа"
 *   items={['Выявим системные ошибки', 'Покажем быстрые точки роста']}
 *   primaryButton={{ label: 'Получить аудит', drawerPreset: 'demo' }}
 *   secondaryButton={{ label: 'Скачать пример', drawerPreset: 'lead' }}
 * />
 */

import Button from './Button.astro'
import Input from './Input.astro'

const CLIENT_CMS_URL = import.meta.env.PUBLIC_CMS_URL ?? ''

interface ButtonAction {
  /** Текст кнопки */
  label: string
  /** Пресет дровера */
  drawerPreset?: 'demo' | 'lead' | 'research' | 'subscribe'
  /** Ссылка (если не дровер) */
  href?: string
}

interface Props {
  /** Режим: form — форма, buttons — две кнопки */
  mode?: 'form' | 'buttons'
  /** Пресет полей формы (используется в mode=form) */
  preset?: 'lead' | 'subscribe' | 'demo' | 'research'
  /** Заголовок */
  title: string
  /** Описание под заголовком (опционально) */
  description?: string
  /** Список пунктов с иконкой check circle */
  items?: string[]
  /** Текст на кнопке отправки (mode=form) */
  submitLabel?: string
  /** Основная кнопка (mode=buttons) */
  primaryButton?: ButtonAction
  /** Вторичная кнопка (mode=buttons) */
  secondaryButton?: ButtonAction
  /** Цвет фона карточки (Tailwind-класс или css), по умолчанию белый */
  bgColor?: string
  /** URL фонового изображения карточки */
  bgImage?: string
  /** Позиция фонового изображения */
  bgImagePosition?: 'center' | 'right' | 'left' | 'top' | 'bottom' | 'top right' | 'top left' | 'bottom right' | 'bottom left'
  /** Вариант формы: light — для светлого фона, dark — для тёмного */
  formVariant?: 'light' | 'dark'
  /** Цвет текста заголовка (Tailwind-класс), по умолчанию text-gray-900 */
  textColor?: string
  /** Показывать согласие на обработку персональных данных (mode=form) */
  showPrivacy?: boolean
  /** Текст согласия */
  privacyText?: string
  /** Дополнительные CSS-классы */
  class?: string
}

const {
  mode = 'form',
  preset = 'lead',
  title,
  description,
  items,
  submitLabel,
  primaryButton,
  secondaryButton,
  bgColor = '#FBF9F6', // gray-100 токен (#FBF9F6) — используется в inline style, Tailwind-класс недоступен
  bgImage = '/api/media/file/form-closing-bg3.png',
  bgImagePosition = 'center',
  formVariant,
  textColor = 'text-gray-900',
  showPrivacy = true,
  privacyText,
  class: className = '',
} = Astro.props

const isDark = formVariant === 'dark'

const cardStyle = [
  bgImage ? `background-image: url('${bgImage}'); background-size: cover; background-position: ${bgImagePosition};` : '',
  `background-color: ${bgColor};`,
].join(' ')

const headingCls    = isDark ? 'text-white'    : textColor
const descCls       = isDark ? 'text-white/60' : 'text-gray-500'
const listTextCls   = isDark ? 'text-white/75' : 'text-gray-700'
const checkCls      = isDark ? 'text-white/50' : 'text-gray-400'
const privacyLinkCls = isDark ? 'text-white/40 underline hover:text-white/60' : 'text-gray-400 underline hover:text-gray-600'
const privacyCls    = isDark ? 'text-white/40' : 'text-gray-400'
const checkboxBorder = isDark ? 'border-white/20 bg-white/5' : 'border-gray-300/60 bg-gray-100/50'
const successCls = isDark ? 'text-green-400' : 'text-green-600'
const errorCls   = isDark ? 'text-red-400'   : 'text-red-500'

const fields: Record<string, string[]> = {
  lead:      ['name', 'phone'],
  subscribe: ['email'],
  demo:      ['name', 'email', 'phone', 'company'],
  research:  ['name', 'email', 'company'],
}
const fieldLabels: Record<string, string> = {
  name:    'Ваше имя',
  email:   'Email',
  phone:   'Ваш телефон',
  company: 'Компания',
}
const defaultSubmitLabels: Record<string, string> = {
  lead:      'Получить демо',
  subscribe: 'Подписаться',
  demo:      'Получить демо',
  research:  'Получить исследование',
}

const btnLabel   = submitLabel ?? defaultSubmitLabels[preset] ?? 'Отправить'
const formFields = fields[preset] ?? ['name', 'email']

const privacyMain = privacyText
  ?? `Нажимая кнопку «${btnLabel}», вы даёте согласие на обработку ваших персональных данных и подтверждаете, что ознакомлены с `
---

<section class:list={['', className]}>
  <div class="page-container">
  <div
    class="relative overflow-hidden rounded-2xl lg:rounded-3xl border border-neutral-100 px-8 py-10 md:px-10 md:py-12"
    style={cardStyle}
  >

    <!-- Заголовок + описание -->
    <div class="max-w-full lg:max-w-[800px]">
      <h2 class:list={['text-h2 font-medium leading-none tracking-tighter', headingCls]}>
        {title}
      </h2>

      {description && (
        <p class:list={['mt-4 text-body-lg leading-relaxed', descCls]}>
          {description}
        </p>
      )}
    </div>

    <!-- Список пунктов с check circle -->
    {items && items.length > 0 && (
      <ul class="mt-6 space-y-3 max-w-full lg:max-w-[800px]">
        {items.map((item) => (
          <li class="flex items-start gap-2">
            <svg
              class:list={['w-6 h-6 shrink-0 mt-0.5', checkCls]}
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
              <path d="M8.5 12l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class:list={['text-body-lg leading-snug', listTextCls]}>{item}</span>
          </li>
        ))}
      </ul>
    )}

    <!-- Режим: кнопки -->
    {mode === 'buttons' && (
      <div class="mt-8 flex flex-wrap gap-2 max-w-full lg:max-w-[800px]">
        {primaryButton && (
          <Button
            variant="primary"
            href={primaryButton.href}
            drawerPreset={primaryButton.drawerPreset}
          >{primaryButton.label}</Button>
        )}
        {secondaryButton && (
          <Button
            variant="dark"
            href={secondaryButton.href}
            drawerPreset={secondaryButton.drawerPreset}
          >{secondaryButton.label}</Button>
        )}
      </div>
    )}

    <!-- Режим: форма -->
    {mode === 'form' && (
      <form
        class="mt-8 space-y-3 max-w-full lg:max-w-[800px]"
        data-form-closing
        data-preset={preset}
        data-cms-url={CLIENT_CMS_URL}
      >
        <div class="flex flex-col lg:flex-row gap-3">
          <div class="flex flex-col md:flex-row gap-3 w-full lg:w-3/5 flex-shrink-0">
            {formFields.map((field) => (
              <Input
                name={field}
                type={field === 'email' ? 'email' : field === 'phone' ? 'tel' : 'text'}
                required={field === 'email' || field === 'name'}
                placeholder={fieldLabels[field]}
                variant={isDark ? 'white' : 'colour'}
                size="M"
                class="md:flex-1 md:min-w-0"
              />
            ))}
          </div>
          <Button
            type="submit"
            variant="primary"
            size="md"
            class="shrink-0"
          >
            {btnLabel}
          </Button>
        </div>

        {showPrivacy && (
          <label class="flex items-start gap-2 cursor-pointer max-w-3xl">
            <div class="relative mt-[2px] w-4 h-4 shrink-0">
              <input
                type="checkbox"
                required
                class="peer absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
              />
              <div class:list={[
                'absolute inset-0 rounded-[4px] border-2 transition-colors duration-150',
                'peer-checked:bg-brand peer-checked:border-brand',
                checkboxBorder,
              ]}></div>
              <svg
                class="absolute inset-0 w-full h-full p-[3px] text-white opacity-0 peer-checked:opacity-100 transition-opacity duration-150 pointer-events-none"
                viewBox="0 0 10 8"
                fill="none"
                aria-hidden="true"
              >
                <path d="M1.5 4L3.5 6.5L8.5 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class:list={['text-[13px] leading-snug', privacyCls]}>
              {privacyMain}<a href="/privacy" class={privacyLinkCls}>Политикой&nbsp;обработки персональных&nbsp;данных</a>
            </span>
          </label>
        )}

        <div class="hidden">
          <input name="_honeypot" tabindex="-1" autocomplete="off" />
        </div>

        <p class:list={['form-success hidden text-sm', successCls]}>Спасибо! Мы свяжемся с вами.</p>
        <p class:list={['form-error hidden text-sm', errorCls]}>Ошибка отправки. Попробуйте ещё раз.</p>
      </form>
    )}

  </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-form-closing]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const f = e.target as HTMLFormElement
      const cmsUrl = f.dataset.cmsUrl ?? ''
      const preset = f.dataset.preset ?? ''

      const honeypot = (f.querySelector('[name="_honeypot"]') as HTMLInputElement)?.value
      if (honeypot) return

      const data: Record<string, string> = { preset }
      new FormData(f).forEach((val, key) => {
        if (key !== '_honeypot') data[key] = val as string
      })
      data.page = window.location.href

      const btn = f.querySelector<HTMLButtonElement>('button[type="submit"]')!
      btn.disabled = true

      try {
        const res = await fetch(`${cmsUrl}/api/form-submissions`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        })
        if (res.ok) {
          f.querySelector('.form-success')?.classList.remove('hidden')
          f.reset()
        } else {
          throw new Error('Server error')
        }
      } catch {
        f.querySelector('.form-error')?.classList.remove('hidden')
      } finally {
        btn.disabled = false
      }
    })
  })
</script>
