---
/**
 * ProductCard — карточка продукта
 *
 * Структура: заголовок → список пунктов со значком-квадратом → кнопка → изображение → [отзыв].
 * Блок отзыва (review) — необязательный пропс; рендерится через Review.
 *
 * @example
 * ```astro
 * <ProductCard
 *   title="Поможем перевыполнить план продаж на том же трафике"
 *   items={['До 96% одобрения', 'Единая анкета в 40+ банков']}
 *   button={{ label: 'Подробнее', href: '/ipoteka' }}
 *   image={{ src: '/api/media/file/ipoteka.jpg', alt: 'Цифровая ипотека' }}
 *   review={{
 *     quote: 'С появлением ДВИЖа мы ускорили подачу заявок с часа до 5 минут',
 *     author: 'Анастасия Швед',
 *     role: 'Руководитель управления прямых продаж',
 *     company: { logo: '/api/media/file/talan-logo.svg', alt: 'Талан' },
 *     caseLink: { label: 'Читать кейс', href: '/cases/talan' },
 *   }}
 * />
 * ```
 */

import Review from './Review.astro'

interface Button {
  label: string
  href: string
}

interface Review {
  /** Текст цитаты */
  quote: string
  /** Имя автора */
  author: string
  /** Должность / роль автора */
  role: string
  /** Логотип компании */
  company?: { logo: string; alt?: string }
  /** Ссылка на кейс */
  caseLink?: { label?: string; href: string }
}

interface Props {
  /** Заголовок карточки */
  title: string
  /** Список пунктов — значок-квадрат + текст, количество произвольное */
  items?: string[]
  /** Кнопка CTA */
  button?: Button
  /** Изображение. Если не передано — нейтральный placeholder */
  image?: { src: string; alt?: string }
  /** Блок цитаты клиента. Если передан — рендерится ниже изображения */
  review?: Review
  /** Дополнительные CSS классы */
  class?: string
}

const {
  title,
  items = [],
  button,
  image,
  review,
  class: className = ''
} = Astro.props
---

<div class:list={['rounded-2xl lg:rounded-3xl bg-stone-100 overflow-hidden', className]}>

  <!-- Текстовая часть -->
  <div class="p-6 lg:p-10">

    <!-- Заголовок -->
    <h2 class="text-h2 text-gray-900">{title}</h2>

    <!-- Список пунктов -->
    {items.length > 0 && (
      <ul class="mt-6 space-y-3">
        {items.map(item => (
          <li class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-[2px] bg-gray-300 shrink-0" aria-hidden="true" />
            <span class="text-body-lg text-gray-500">{item}</span>
          </li>
        ))}
      </ul>
    )}

    <!-- Кнопка -->
    {button && (
      <div class="mt-8">
        <a
          href={button.href}
          class="inline-flex items-center rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-gray-700"
        >
          {button.label}
        </a>
      </div>
    )}
  </div>

  <!-- Изображение -->
  <div class:list={[
    'mx-6 lg:mx-8 overflow-hidden rounded-2xl bg-stone-200 aspect-video',
    review ? 'mb-0' : 'mb-6 lg:mb-8'
  ]}>
    {image && (
      <img
        src={image.src}
        alt={image.alt ?? ''}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    )}
  </div>

  <!-- Отзыв клиента (опционально) -->
  {review && (
    <div class="px-8 pb-8 lg:px-10 lg:pb-10 pt-10">
      <Review
        quote={review.quote}
        author={review.author}
        role={review.role}
        company={review.company}
        caseLink={review.caseLink}
      />
    </div>
  )}

</div>
