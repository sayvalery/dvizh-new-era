---
/**
 * ProductCard — карточка продукта
 *
 * Структура: заголовок → список пунктов со значком-квадратом → кнопка → изображение.
 * Блок отзыва (review) будет добавлен позже как отдельный пропс.
 *
 * @example
 * ```astro
 * <ProductCard
 *   title="Поможем перевыполнить план продаж на том же трафике"
 *   items={['До 96% одобрения', 'Единая анкета в 40+ банков']}
 *   button={{ label: 'Подробнее', href: '/ipoteka' }}
 *   image={{ src: '/api/media/file/ipoteka.jpg', alt: 'Цифровая ипотека' }}
 * />
 * ```
 */

interface Button {
  label: string
  href: string
}

interface Props {
  /** Заголовок карточки */
  title: string
  /** Список пунктов — значок-квадрат + текст, количество произвольное */
  items?: string[]
  /** Кнопка CTA */
  button?: Button
  /** Изображение. Если не передано — нейтральный placeholder */
  image?: { src: string; alt?: string }
  /** Дополнительные CSS классы */
  class?: string
}

const {
  title,
  items = [],
  button,
  image,
  class: className = ''
} = Astro.props
---

<div class:list={['rounded-[32px] bg-stone-100 overflow-hidden', className]}>

  <!-- Текстовая часть -->
  <div class="p-8 lg:p-10">

    <!-- Заголовок -->
    <h2 class="text-h2 text-gray-900">{title}</h2>

    <!-- Список пунктов -->
    {items.length > 0 && (
      <ul class="mt-6 space-y-3">
        {items.map(item => (
          <li class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-[2px] bg-gray-300 shrink-0" aria-hidden="true" />
            <span class="text-body-lg text-gray-500">{item}</span>
          </li>
        ))}
      </ul>
    )}

    <!-- Кнопка -->
    {button && (
      <div class="mt-8">
        <a
          href={button.href}
          class="inline-flex items-center rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-gray-700"
        >
          {button.label}
        </a>
      </div>
    )}
  </div>

  <!-- Изображение -->
  <div class="mx-6 mb-6 lg:mx-8 lg:mb-8 overflow-hidden rounded-[24px] bg-stone-200 aspect-video">
    {image && (
      <img
        src={image.src}
        alt={image.alt ?? ''}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    )}
  </div>

</div>
