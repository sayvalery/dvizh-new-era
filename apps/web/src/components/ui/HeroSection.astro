---
/**
 * HeroSection — главная hero-секция страницы с заголовком, описанием и формой
 *
 * Лейауты:
 *   default  — левая колонка (заголовок + форма) + правая (изображение/слот)
 *   split    — левая (бейдж + заголовок) + правая (описание + кнопки) — Linear-style
 *   full     — анимированный фон через слот «background», контент прибит к низу слева
 *
 * @example
 * ```astro
 * <HeroSection layout="full" title="Заголовок" description="Описание" demoLabel="Демо" kpLabel="КП">
 *   <PixelAnimation slot="background" />
 * </HeroSection>
 * ```
 */

import Form from './Form.astro'
import Button from './Button.astro'
import FlutedGlassBg from './FlutedGlassBg.astro'
import StatsSection from './StatsSection.astro'
import HeroBadge from '../lab-new/HeroBadge.astro'

interface StatItem {
  /** Основное значение (цифра или текст) */
  value: string
  /** Описание/подпись */
  label: string
  /** Опциональная иконка (HTML) */
  icon?: string
}

interface Props {
  /** Лейаут: default (с формой), split (Linear-style с кнопками), full (контент внизу + слот для анимации) */
  layout?: 'default' | 'split' | 'full'
  /** Бейдж/надпись над заголовком (оранжевый) */
  badge?: string
  /** Основной заголовок */
  title: string
  /** Описание под заголовком */
  description?: string
  /** Показывать форму */
  withForm?: boolean
  /** Пресет формы: lead, demo, subscribe, research */
  formPreset?: 'lead' | 'demo' | 'subscribe' | 'research'
  /** Текст кнопки формы */
  formSubmitLabel?: string
  /** Текст кнопки «Посмотреть демо» (split / full layout) */
  demoLabel?: string
  /** Текст кнопки «Получить КП» (split / full layout) */
  kpLabel?: string
  /** Пресет дровера для первой кнопки (full layout, дефолт: 'demo') */
  demoPreset?: string
  /** Пресет дровера для второй кнопки (full layout, дефолт: 'lead') */
  kpPreset?: string
  /** Изображение справа (URL) */
  image?: string
  /** Alt-текст для изображения */
  imageAlt?: string
  /** Показывать mesh-градиент фоном */
  withGradient?: boolean
  /** Цвета градиента (CSS hex/rgb/hsl) */
  gradientColors?: string[]
  /** Статистика для отображения после HeroSection (split layout) */
  stats?: StatItem[]
  /** Количество колонок статистики (2-4) */
  statsCols?: 2 | 3 | 4
  /** Дополнительные CSS классы */
  class?: string
}

const {
  layout = 'default',
  badge,
  title,
  description,
  withForm = true,
  formPreset = 'lead',
  formSubmitLabel,
  demoLabel = 'Посмотреть демо',
  kpLabel = 'Получить КП',
  demoPreset = 'demo',
  kpPreset = 'lead',
  image,
  imageAlt = 'Hero image',
  withGradient = false,
  gradientColors,
  stats,
  statsCols = 4,
  class: className = ''
} = Astro.props

const hasRightSlot = Astro.slots.has('right')
const isSplit = layout === 'split'
const isFull = layout === 'full'
---

<section class:list={['relative overflow-hidden', withGradient ? 'bg-brand' : 'bg-background-primary', isFull ? 'md:pb-24 lg:pb-36' : '', className]}>

  {withGradient && <FlutedGlassBg />}

  {isFull && (
    <div class="relative flex flex-col min-h-[680px] lg:min-h-[900px]">
      <!-- Слот для анимированного фона -->
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <slot name="background" />
      </div>

      <!-- Контент: прибит к низу слева -->
      <div class="relative z-10 flex flex-col justify-end flex-1 max-w-[1440px] mx-auto w-full px-4 sm:px-6 lg:px-10 pb-8 xs:pb-16 lg:pb-24">
        <div class="flex flex-col gap-6 max-w-[1000px]">
          {badge && <p class="text-brand text-body-lg font-normal">{badge}</p>}
          <h1 class="text-h1 text-gray-900">{title}</h1>
          {description && <p class="text-body-lg text-gray-500">{description}</p>}
          <div class="flex flex-col xs:flex-row gap-4 pt-2">
            <Button variant="primary" size="lg" drawerPreset={demoPreset as any} class="w-full xs:flex-1 lg:flex-none lg:w-auto">{demoLabel}</Button>
            <Button variant="ghost" size="lg" drawerPreset={kpPreset as any} class="w-full xs:flex-1 lg:flex-none lg:w-auto">{kpLabel}</Button>
          </div>
        </div>
      </div>
    </div>
  )}

  {!isFull && (
    <div class="relative z-10 max-w-[1440px] mx-auto px-4">
      {isSplit ? (
        <div class="grid lg:grid-cols-2 gap-16 items-center py-24 lg:py-32">
          <!-- Левая колонка: бейдж и заголовок -->
          <div class="flex flex-col gap-9 order-2 lg:order-1">
            {badge && <HeroBadge text={badge} />}
            <h1 class="text-h1 text-gray-900">{title}</h1>
          </div>

          <!-- Правая колонка: описание и кнопки -->
          <div class="flex flex-col gap-8 order-1 lg:order-2">
            {description && (
              <p class="text-body-lg text-gray-500">{description}</p>
            )}
            <div class="flex flex-col sm:flex-row gap-4">
              <Button variant="primary" size="lg" drawerPreset={demoPreset as any}>{demoLabel}</Button>
              <Button variant="ghost" size="lg" drawerPreset={kpPreset as any}>{kpLabel}</Button>
            </div>
            <slot name="actions" />
          </div>
        </div>
      ) : (
        <div class:list={['grid lg:grid-cols-[726px_1fr] gap-8 items-center', withGradient ? 'min-h-svh lg:max-h-[1100px]' : 'lg:min-h-[800px]']}>
          <!-- Левая колонка: контент -->
          <div class:list={['flex flex-col justify-center gap-[52px] order-2 lg:order-1', withGradient ? 'pt-24 pb-16 lg:pt-0 lg:pb-0' : 'py-16 lg:py-0']}>
            <div class="flex flex-col gap-9">
              {badge && (
                <p class:list={['text-body-lg font-normal', withGradient ? 'text-brand-300' : 'text-brand']}>
                  {badge}
                </p>
              )}
              <div class="flex flex-col gap-8">
                <h1 class:list={['text-h1', withGradient ? 'text-white' : 'text-gray-900']}>
                  {title}
                </h1>
                {description && (
                  <p class:list={['text-body-lg max-w-[602px]', withGradient ? 'text-white/70' : 'text-gray-500']}>
                    {description}
                  </p>
                )}
              </div>
            </div>
            {withForm && (
              <Form preset={formPreset} layout="inline" variant={withGradient ? 'dark' : 'light'} submitLabel={formSubmitLabel} />
            )}
          </div>

          <!-- Правая колонка -->
          {image ? (
            <div class="relative h-[400px] lg:h-[800px] w-full bg-gray-300 rounded-none overflow-hidden order-1 lg:order-2">
              <img
                src={image}
                alt={imageAlt}
                class="w-full h-full object-cover"
                width="595"
                height="800"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          ) : hasRightSlot ? (
            <div class="hidden lg:flex items-center justify-center order-1 lg:order-2">
              <slot name="right" />
            </div>
          ) : null}
        </div>
      )}
    </div>
  )}

  <!-- StatsSection для split layout -->
  {isSplit && stats && stats.length > 0 && (
    <StatsSection items={stats} cols={statsCols} />
  )}

</section>
