---
/**
 * CalculatorEmbed — живое демо ипотечного калькулятора ДВИЖ во встраиваемом iframe.
 *
 * Виджет (SPA на nfront.dvizh.tech) встраивается напрямую через <iframe src>.
 * Высота по умолчанию фиксированная и адаптивная (см. minHeight/minHeightDesktop),
 * при нехватке высоты внутри iframe появляется собственный скролл.
 *
 * Отступы «внутри виджета»: настоящий padding живёт в DOM калькулятора (cross-origin,
 * недоступен). Эмулируем — обёртка bg-white + скругление + p-8/lg:p-10, iframe прозрачный
 * без скругления. Корень виджета прозрачный (html/body/#app), внутри белая карточка —
 * поэтому белый фон обёртки сливается с виджетом, и padding читается как внутренний.
 *
 * Хост-хендшейк (см. <script> ниже, сниппет от команды калькулятора): виджет шлёт
 * `embedReady`, мы отвечаем `embedSyncAuth` v1.0 с пустым токеном (анонимно) → связь
 * установлена, результаты грузятся. На `embedResize` подгоняем высоту iframe (авто-высота).
 * Требует, чтобы наш origin был в allowlist на стороне калькулятора (настроено их командой).
 */
interface Props {
  /** URL встраиваемого калькулятора */
  src?: string
  /** Заголовок iframe для доступности */
  title?: string
  /** Стартовая высота на мобильных, px */
  minHeight?: number
  /** Стартовая высота на десктопе (lg+), px */
  minHeightDesktop?: number
  class?: string
}

const {
  src = 'https://nfront.dvizh.tech/embed/b2c/ganymede/calculator',
  title = 'Ипотечный калькулятор ДВИЖ',
  minHeight = 640,
  minHeightDesktop = 760,
  class: className = '',
} = Astro.props

// origin виджета — только от него принимаем postMessage
const allowedOrigin = new URL(src).origin
---

<div
  class:list={['dvizh-calc-embed w-full bg-white rounded-2xl lg:rounded-3xl overflow-hidden p-8 lg:p-10', className]}
  data-calc-embed
  data-allowed-origin={allowedOrigin}
  style={`--calc-h-mobile:${minHeight}px;--calc-h-desktop:${minHeightDesktop}px`}
>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    class="w-full block border-0 bg-transparent h-[var(--calc-h-mobile)] lg:h-[var(--calc-h-desktop)]"
  ></iframe>
</div>

<script>
  // Хост-хендшейк embed-протокола v1.0 (сниппет от команды калькулятора):
  // на embedReady отвечаем embedSyncAuth (анонимно, token: '') → виджет устанавливает
  // связь и грузит результаты; на embedResize подгоняем высоту iframe (авто-высота).
  const PROTOCOL_VERSION = '1.0'
  const fingerprint = crypto.randomUUID()

  document.querySelectorAll<HTMLElement>('[data-calc-embed]').forEach((wrapper) => {
    const iframe = wrapper.querySelector('iframe')
    const allowedOrigin = wrapper.dataset.allowedOrigin
    if (!iframe || !allowedOrigin) return

    let sequenceNumber = 0

    window.addEventListener('message', (event) => {
      if (event.source !== iframe.contentWindow || event.origin !== allowedOrigin) return

      const data = event.data
      if (!data || typeof data !== 'object') return

      if (data.type === 'embedReady') {
        sequenceNumber += 1
        iframe.contentWindow?.postMessage(
          { type: 'embedSyncAuth', protocolVersion: PROTOCOL_VERSION, sequenceNumber, token: '', fingerprint },
          allowedOrigin,
        )
      } else if (data.type === 'embedResize' && typeof data.height === 'number' && data.height > 0) {
        // Авто-высота + компенсация скролла: состояние снимаем ДО изменения высоты,
        // при уменьшении подкручиваем страницу на дельту, чтобы вьюпорт не «прыгал».
        const prevScrollY = window.scrollY
        const rectBefore = iframe.getBoundingClientRect()
        const prevClientHeight = iframe.clientHeight

        iframe.style.height = `${Math.ceil(data.height)}px`
        const delta = iframe.clientHeight - prevClientHeight
        if (delta < 0 && rectBefore.top < window.innerHeight) {
          const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight)
          window.scrollTo(0, Math.min(Math.max(0, prevScrollY + delta), maxScroll))
        }
      }
    })
  })
</script>
