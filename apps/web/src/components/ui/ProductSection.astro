---
/**
 * ProductSection — секция с меню продуктов и одной карточкой
 *
 * @deprecated Используйте ProductSectionNew — он поддерживает несколько карточек,
 * sticky-меню и IntersectionObserver.
 *
 * Адаптивная секция: на lg+ — меню слева, контент справа; на md- — вертикально.
 */

import ProductCard from './ProductCard.astro'

interface SectionItem {
  number: string
  title: string
  active?: boolean
}

interface Button {
  label: string
  href: string
}

interface Props {
  sections: SectionItem[]
  title?: string
  items?: string[]
  button?: Button
  image?: { src: string; alt?: string }
  class?: string
}

const {
  sections,
  title = '',
  items = [],
  button,
  image,
  class: className = ''
} = Astro.props

const componentId = `product-section-${Math.random().toString(36).substr(2, 9)}`
---

<section class:list={['bg-white', className]}>
  <div id={componentId} class="page-container py-[50px]">
    <div class="flex flex-col md:gap-[52px] lg:flex-row lg:gap-[120px]">
      <!-- Меню секций (md-sm: сверху, lg+: слева) -->
      <div class="lg:w-[220px] lg:flex-shrink-0" />

      <!-- Product Card (контент справа) -->
      <div class="flex-1">
        <ProductCard
          title={title}
          items={items}
          button={button}
          image={image}
        />
      </div>
    </div>
  </div>
</section>
