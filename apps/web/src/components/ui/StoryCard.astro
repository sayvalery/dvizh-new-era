---
/**
 * StoryCard — карточка истории успеха
 *
 * Используется для демонстрации кейсов и отзывов.
 *
 * Props:
 *   variant        — вариант карточки: 'active' (фоновое фото) | 'default' (светлый фон)
 *   backgroundImage — URL фонового изображения (только для variant='active')
 *   title — основной заголовок карточки
 *   person — объект персоны (имя, должность, фото)
 *
 * Slots:
 *   logo — слот для логотипа компании (сверху над заголовком)
 *   modal-body — содержимое модалки (статья)
 *
 * Пример (active):
 *   <StoryCard
 *     variant="active"
 *     backgroundImage="/images/story-bg.jpg"
 *     title="Помогли начать обрабатывать на 98% больше заявок"
 *     person={{ name: "Светлана Корнелюк", jobTitle: "Директор отдела продаж", photo: { url: "/photos/photo.jpg" } }}
 *   >
 *     <img src="/logos/logo.svg" alt="Логотип" slot="logo" />
 *   </StoryCard>
 *
 * Пример (default):
 *   <StoryCard
 *     variant="default"
 *     title="Помогли начать обрабатывать на 98% больше заявок"
 *     person={{ name: "Светлана Корнелюк", jobTitle: "Директор отдела продаж", photo: { url: "/photos/photo.jpg" } }}
 *   />
 */

import PersonCard from './PersonCard.astro'
import ModalInlineForm from './ModalInlineForm.astro'

interface Person {
  name: string
  slug?: string
  photo?: { url: string; alt?: string }
  jobTitle?: string
  company?: { name: string; slug?: string }
}

interface Props {
  variant?: 'active' | 'default'
  backgroundImage?: string
  title: string
  /** HTML-заголовок с поддержкой тегов (например, <span class="text-brand">выделение</span>) */
  titleHtml?: string
  person: Person
  /** URL логотипа компании (альтернатива слоту logo) */
  logo?: string
  /** Alt-текст логотипа */
  logoAlt?: string
  /** URL белого логотипа для hover-состояния (только для variant='default') */
  logoHover?: string
  /** URL фонового изображения для hover (только для variant='default') */
  hoverBackground?: string
  /** На hover делать плашку логотипа прозрачно-стеклянной (для логотипов с вырезанными буквами) */
  hoverGlass?: boolean
  /** Дополнительные классы для карточки (например переопределить высоту) */
  class?: string
}

const { variant = 'active', backgroundImage, title, titleHtml, person, logo, logoAlt = 'Logo', logoHover, hoverBackground, hoverGlass = false, class: className = '' } = Astro.props

const isActive = variant === 'active'
const hasModal = Astro.slots.has('modal-body')
const hasHover = !isActive && !!hoverBackground
---

<div
  x-data="{ open: false, scrolled: false }"
  x-effect="
    document.body.style.overflow = open ? 'hidden' : '';
    if (!open) scrolled = false;
  "
>
  <!-- Карточка -->
  <div
    class:list={[
      'w-full rounded-2xl sm:rounded-3xl overflow-hidden relative flex flex-col',
      !className && 'aspect-[4/3] md:aspect-square',
      isActive ? 'bg-cover bg-center' : 'bg-background-secondary',
      hasModal ? 'cursor-pointer' : '',
      hasHover && 'story-card-hover group',
      className,
    ]}
    style={isActive && backgroundImage ? `background-image: url(${backgroundImage})` : ''}
    @click={hasModal ? 'open = true' : ''}
  >
    {/* Оверлей hover-фона (только в default + hoverBackground) */}
    {hasHover && (
      <div
        class="absolute inset-0 bg-cover bg-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
        style={`background-image: url(${hoverBackground})`}
        aria-hidden="true"
      />
    )}
    <div class:list={['p-4 lg:p-8 flex flex-col h-full relative', !isActive && 'justify-between']}>

      <!-- Логотип: в потоке (default) или абсолютный (active) -->
      {(Astro.slots.has('logo') || logo) && (
        isActive ? (
          /* active (тёмный фон): стеклянная плашка, белые логотипы */
          <div class="self-start inline-flex items-center bg-white/[0.15] backdrop-blur-[8px] rounded-full px-5 py-2.5 ring-1 ring-white/30 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)]">
            {Astro.slots.has('logo') ? <slot name="logo" /> : (
              <img src={logo} alt={logoAlt} class="h-5 w-auto object-contain" />
            )}
          </div>
        ) : (
          /* default (светлый фон): стеклянная плашка с увеличенной непрозрачностью */
          <div class:list={['self-start inline-flex items-center backdrop-blur-[8px] rounded-full px-5 py-2.5 ring-1 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)] transition-[background-color,--tw-ring-color] duration-300', hoverGlass ? 'bg-white/40 ring-white/60 group-hover:bg-white/[0.15] group-hover:ring-white/30' : 'bg-white/40 ring-white/60']}>
            {Astro.slots.has('logo') ? <slot name="logo" /> : logoHover ? (
              <span class="relative inline-flex">
                <img src={logo} alt={logoAlt} class="h-5 w-auto object-contain block group-hover:invisible" />
                <img src={logoHover} alt={logoAlt} class="absolute inset-0 h-full w-full object-contain hidden group-hover:block" aria-hidden="true" />
              </span>
            ) : (
              <img src={logo} alt={logoAlt} class="h-5 w-auto object-contain" />
            )}
          </div>
        )
      )}

      <!-- Спейсер: растягивается если есть место, но минимум 64px -->
      <div class="flex-1 min-h-16"></div>

      <!-- Нижняя часть с заголовком и PersonCard -->
      <div class:list={['flex flex-col gap-4 lg:gap-8', isActive && 'mt-auto']}>
        {titleHtml ? (
          <h3 class:list={['text-h3 transition-colors', isActive ? 'text-white' : 'text-gray-900', hasHover && 'group-hover:text-white']} set:html={titleHtml} />
        ) : (
          <h3 class:list={['text-h3 transition-colors', isActive ? 'text-white' : 'text-gray-900', hasHover && 'group-hover:text-white']}>{title}</h3>
        )}

        <PersonCard person={person} theme={isActive ? 'dark' : 'light'} />
      </div>
    </div>
  </div>

  <!-- Модальное окно -->
  {hasModal && (
    <div
      x-show="open"
      x-transition:enter="transition duration-200 ease-out"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition duration-150 ease-in"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 z-50 bg-black/40"
      @click="open = false"
      @keydown.escape.window="open = false"
      x-cloak
    >
      <!-- Панель -->
      <div
        class="fixed bottom-0 left-1/2 -translate-x-1/2 w-screen md:w-[540px] lg:w-[50vw] lg:min-w-[600px]"
        @click.stop
      >
        <!-- Белая панель -->
        <div class="relative flex flex-col overflow-hidden bg-white h-[90vh] rounded-t-3xl">
          <!-- Кнопка закрыть -->
          <button
            @click.stop="open = false"
            class="absolute top-5 right-5 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 hover:bg-gray-50"
            aria-label="Закрыть"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <path d="M3 3l10 10M13 3L3 13"/>
            </svg>
          </button>

          <!-- Скроллируемая область -->
          <div class="overflow-y-auto flex-1" @scroll="scrolled = true">
            <slot name="modal-body" />
          </div>

          <!-- Inline-форма -->
          <div
            x-show="scrolled"
            x-transition:enter="transition duration-300 ease-out"
            x-transition:enter-start="opacity-0 translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition duration-200 ease-in"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 translate-y-2"
            class="shrink-0 bg-white border-t border-gray-100 px-8 py-6"
            x-cloak
          >
            <ModalInlineForm />
          </div>
        </div>
      </div>
    </div>
  )}
</div>

<style>
  /* Hover-вариант default-карточки: оранжевые акценты и текст PersonCard становятся белыми */
  .story-card-hover:hover :global(.text-brand) { color: #fff; }
  .story-card-hover:hover :global(.text-gray-500) { color: rgba(255, 255, 255, 0.7); }
  .story-card-hover:hover :global(.text-gray-900) { color: #fff; }
  .story-card-hover:hover :global(.bg-gray-300\/60) { background-color: rgba(255, 255, 255, 0.3); }
</style>
