---
/**
 * BlogCards — сетка карточек статей блога
 *
 * Дизайн карточки: обложка (16:10) → дата → заголовок.
 * Дата принимается как ISO-строка ("2024-01-15") или уже готовый текст ("19 марта 2026") —
 * ISO-даты форматируются автоматически в русский формат.
 *
 * @example
 * ```astro
 * <BlogCards
 *   title="Из блога"
 *   description="Экспертные советы для роста вашего бизнеса"
 *   articles={[
 *     {
 *       image: '/cover.jpg',
 *       date: '2026-03-19',
 *       title: 'Как Аякс закрыл на 26% больше сделок',
 *       href: '/blog/case-ayaks',
 *       category: '',
 *       description: '',
 *     }
 *   ]}
 * />
 * ```
 */

interface Author {
  name: string
  role?: string
  avatar?: string
}

interface Article {
  image: string
  imageAlt?: string
  /** ISO-строка ("2024-01-15") или готовый текст ("19 марта 2026") */
  date: string
  category: string
  categoryHref?: string
  title: string
  description: string
  href?: string
  author?: Author
}

interface Props {
  /** Заголовок секции */
  title?: string
  /** Описание секции */
  description?: string
  /** Массив статей */
  articles: Article[]
  /** Дополнительные CSS классы */
  class?: string
}

const {
  title,
  description,
  articles,
  class: className = ''
} = Astro.props

/** Форматирует ISO-дату в "19 марта 2026". Нераспознанные строки возвращает как есть. */
function formatDate(dateStr: string): string {
  // Если уже содержит буквы (кириллица или латиница) — уже отформатировано
  if (/[a-zA-Zа-яА-ЯёЁ]/.test(dateStr)) return dateStr
  try {
    const date = new Date(dateStr)
    if (isNaN(date.getTime())) return dateStr
    return new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(date).replace(' г.', '').replace(' г.', '').trim()
  } catch {
    return dateStr
  }
}
---

<section class:list={[className]}>
  <div class="page-container">

    {(title || description) && (
      <div class="mb-12">
        {title && (
          <h2 class="text-h2 text-gray-900">{title}</h2>
        )}
        {description && (
          <p class="mt-4 text-body-lg text-gray-500">{description}</p>
        )}
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-10 md:gap-5">
      {articles.map((article) => (
        <a href={article.href || '#'} class="group flex flex-col gap-6">

          {/* Обложка 16:10 */}
          <div class="relative overflow-hidden rounded-[24px] aspect-[16/10] bg-gray-100 shrink-0">
            {article.image
              ? (
                <img
                  src={article.image}
                  alt={article.imageAlt || article.title}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              )
              : (
                <div class="absolute inset-0 bg-gray-100" />
              )
            }
          </div>

          {/* Дата + заголовок */}
          <div class="flex flex-col gap-3">
            <p class="text-subhead text-gray-500 leading-snug">
              {formatDate(article.date)}
            </p>
            <h3 class="text-card-title text-gray-900 group-hover:text-brand transition-colors duration-200">
              {article.title}
            </h3>
          </div>

        </a>
      ))}
    </div>

  </div>
</section>
