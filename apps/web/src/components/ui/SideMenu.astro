---
/**
 * SideMenu — боковое меню (горизонтальная карусель до lg, вертикальное с lg)
 *
 * До lg: горизонтальная карусель с scroll-snap и скроллом без полосы прокрутки.
 * С lg и выше: вертикальный стек пунктов.
 * Активный пункт выделяется оранжевым.
 * Клик переключает активный пункт и вызывает callback через Alpine.js событие.
 *
 * @example
 * ```astro
 * <SideMenu
 *   items={[
 *     { title: 'Цифровая ипотека', active: true },
 *     { title: 'Калькулятор' },
 *     { title: 'Скоринг' },
 *   ]}
 * />
 * ```
 */

interface MenuItem {
  title: string
  active?: boolean
}

interface Props {
  items: MenuItem[]
  /** Дополнительные CSS классы */
  class?: string
}

const { items, class: className = '' } = Astro.props
---

<nav
  x-data={`{ active: ${items.findIndex(i => i.active) ?? 0} }`}
  class:list={[
    'flex flex-row gap-0 overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden snap-x snap-mandatory',
    'lg:flex-col lg:overflow-visible lg:gap-6',
    className
  ]}
>
  {items.map((item, index) => (
    <button
      class="flex-shrink-0 snap-start px-5 py-2 border-b-2 pb-0.5 text-left transition-colors hover:opacity-70 lg:px-3 lg:py-0 lg:border-b-0 lg:pb-0 lg:border-l-2"
      :class={`active === ${index} ? 'text-brand border-brand' : 'text-[#858585] border-transparent'`}
      @click={`active = ${index}; $dispatch('side-menu-change', { index: ${index}, item: ${JSON.stringify(item)} })`}
    >
      <span class="text-side-menu whitespace-nowrap">{item.title}</span>
    </button>
  ))}
</nav>
