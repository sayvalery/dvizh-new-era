---
/**
 * SideMenu — вертикальное боковое меню
 *
 * Отображает список пунктов. Активный пункт выделяется оранжевым.
 * Клик переключает активный пункт и вызывает callback через Alpine.js событие.
 *
 * @example
 * ```astro
 * <SideMenu
 *   items={[
 *     { title: 'Цифровая ипотека', active: true },
 *     { title: 'Калькулятор' },
 *     { title: 'Скоринг' },
 *   ]}
 * />
 * ```
 */

interface MenuItem {
  title: string
  active?: boolean
}

interface Props {
  items: MenuItem[]
  /** Дополнительные CSS классы */
  class?: string
}

const { items, class: className = '' } = Astro.props
---

<nav
  x-data={`{ active: ${items.findIndex(i => i.active) ?? 0} }`}
  class:list={['flex flex-col gap-6', className]}
>
  {items.map((item, index) => (
    <button
      class="flex items-center gap-2 text-left transition-colors hover:opacity-70"
      :class={`active === ${index} ? 'text-brand' : 'text-[#858585]'`}
      @click={`active = ${index}; $dispatch('side-menu-change', { index: ${index}, item: ${JSON.stringify(item)} })`}
    >
      <span class="text-side-menu">{item.title}</span>
    </button>
  ))}
</nav>
