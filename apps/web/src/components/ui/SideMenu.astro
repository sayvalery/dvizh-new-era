---
/**
 * SideMenu — боковое меню оглавления
 *
 * variant="default" (по умолчанию):
 *   До lg — горизонтальная карусель (scroll-snap, без полосы прокрутки).
 *   С lg — вертикальный стек пунктов.
 *
 * variant="panel":
 *   С xl — вертикальный sticky-стек (как default на lg+).
 *   xs–lg — фиксированная внизу плашка с названием активного раздела и шевроном.
 *     Тап по плашке раскрывает список пунктов вверх (без затемнения).
 *     Тап по пункту — плавный скролл к нему. Плашка видна только в пределах
 *     ближайшего <article> (IntersectionObserver).
 *
 * Активный пункт выделяется оранжевым.
 * Клик переключает активный пункт и вызывает callback через Alpine.js событие.
 *
 * @example
 * ```astro
 * <SideMenu
 *   navId="article-toc"
 *   variant="panel"
 *   items={[
 *     { title: 'Цифровая ипотека', level: 2, active: true },
 *     { title: 'Калькулятор', level: 3 },
 *     { title: 'Скоринг', level: 2 },
 *   ]}
 * />
 * ```
 */

interface MenuItem {
  title: string
  active?: boolean
  /** Уровень заголовка: 2 — верхний (h2), 3 — вложенный (h3, с отступом слева) */
  level?: number
}

interface Props {
  items: MenuItem[]
  /** Дополнительные CSS классы (применяются к вертикальному стеку) */
  class?: string
  /**
   * ID для внешнего управления активным пунктом.
   * Если передан — компонент слушает window-событие `side-menu-set-active`
   * с `detail: { navId, index }`. Используется в ProductSection.
   */
  navId?: string
  /** Поведение на брейкпойнтах xs–lg: 'default' — карусель, 'panel' — нижняя плашка */
  variant?: 'default' | 'panel'
}

const { items, class: className = '', navId = '', variant = 'default' } = Astro.props

const initialActive = Math.max(0, items.findIndex((i) => i.active))

// Вертикальный интервал между пунктами оглавления (panel, xl-стек): зависит от уровней.
// перед h2 — 32px (mt-8), h3 после h2 — 16px (mt-4), h3 после h3 — 12px (mt-3).
const gapClass = (index: number) => {
  if (index === 0) return ''
  const cur = items[index]?.level ?? 2
  const prev = items[index - 1]?.level ?? 2
  if (cur <= 2) return 'mt-8'
  return prev <= 2 ? 'mt-4' : 'mt-3'
}

// Alpine-состояние. Для panel дополнительно: open (раскрыт список), visible (плашка в зоне статьи).
const xData = `{
  active: ${initialActive},
  open: false,
  visible: false,
  init() {
    const id = '${navId}';
    if (id) {
      window.addEventListener('side-menu-set-active', e => {
        if (e.detail && e.detail.navId === id) this.active = e.detail.index;
      });
    }
    ${variant === 'panel' ? `
    const article = this.$el.closest('article');
    if (article && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        entries => { this.visible = entries[0]?.isIntersecting ?? false; if (!this.visible) this.open = false; },
        { rootMargin: '0px', threshold: 0 }
      );
      io.observe(article);
    } else {
      this.visible = true;
    }` : ''}
  }
}`

// Кнопки вертикального стека (xl+ для panel, lg+ для default)
---

{variant === 'default' ? (
  <nav
    x-data={xData}
    class:list={[
      'flex flex-row gap-0 overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden snap-x snap-mandatory',
      'lg:flex-col lg:overflow-visible lg:gap-6',
      className
    ]}
  >
    {items.map((item, index) => (
      <button
        class:list={[
          `flex-shrink-0 snap-start text-left transition-colors hover:opacity-70
           flex flex-col items-start px-5 py-2
           lg:flex-row lg:items-center lg:gap-2 lg:px-0 lg:py-0`,
          (item.level ?? 2) >= 3 && 'lg:pl-4',
        ]}
        :class={`active === ${index} ? 'text-brand' : 'text-[#858585]'`}
        @click={`active = ${index}; $dispatch('side-menu-change', { index: ${index}, item: ${JSON.stringify(item)} })`}
      >
        <span
          class="hidden lg:block w-0.5 self-stretch flex-shrink-0 transition-colors"
          :class={`active === ${index} ? 'bg-brand' : 'bg-transparent'`}
        ></span>
        <span class="inline-flex flex-col gap-1">
          <span class="text-side-menu whitespace-nowrap">{item.title}</span>
          <span
            class="lg:hidden h-0.5 transition-colors"
            :class={`active === ${index} ? 'bg-brand' : 'bg-transparent'`}
          ></span>
        </span>
      </button>
    ))}
  </nav>
) : (
  <div x-data={xData}>
    {/* ── xl+ : вертикальный sticky-стек (как default lg+) ── */}
    <nav class:list={['hidden xl:flex xl:flex-col', className]}>
      {items.map((item, index) => (
        <button
          class:list={[
            'text-left transition-colors hover:opacity-70 flex flex-row items-center gap-2',
            (item.level ?? 2) >= 3 && 'pl-4',
            gapClass(index),
          ]}
          :class={`active === ${index} ? 'text-brand' : 'text-[#858585]'`}
          @click={`active = ${index}; $dispatch('side-menu-change', { index: ${index}, item: ${JSON.stringify(item)} })`}
        >
          <span
            class="block w-0.5 self-stretch flex-shrink-0 transition-colors"
            :class={`active === ${index} ? 'bg-brand' : 'bg-transparent'`}
          ></span>
          <span class:list={[(item.level ?? 2) >= 3 ? 'text-footnote' : 'text-side-menu']}>{item.title}</span>
        </button>
      ))}
    </nav>

    {/* ── xs–lg : фиксированная нижняя плашка (full-width, без тени/обводки) ── */}
    <div
      x-show="visible"
      x-cloak
      x-transition.opacity
      class="fixed bottom-0 inset-x-0 z-30 xl:hidden"
    >
      {/* Единый список. Закрыто — виден только активный пункт (плашка-якорь).
           Открыто — все пункты в естественном порядке, активный выделен.
           Шеврон зафиксирован справа сверху — общий тоггл, не привязан к пункту. */}
      <div class="bg-gray-100">
        <div class="page-container">
          <div class="relative border-t border-gray-900/10">
            <div class="flex flex-col py-[24px] max-h-[60vh] overflow-y-auto">
              {items.map((item, index) => (
                <button
                  type="button"
                  x-show={`open || active === ${index}`}
                  x-cloak
                  class:list={[
                    'w-full flex items-center gap-2 pr-8 text-left transition-opacity',
                    (item.level ?? 2) >= 3 && 'pl-4',
                  ]}
                  :class={`{ 'text-brand': active === ${index}, 'text-gray-500 hover:opacity-70': active !== ${index}${gapClass(index) ? `, '${gapClass(index)}': open` : ''} }`}
                  @click={`active === ${index} ? (open = !open) : (active = ${index}, open = false, $dispatch('side-menu-change', { index: ${index}, item: ${JSON.stringify(item)} }))`}
                >
                  <span
                    class="block w-0.5 self-stretch flex-shrink-0 transition-colors"
                    :class={`active === ${index} ? 'bg-brand' : 'bg-transparent'`}
                  ></span>
                  <span class:list={[(item.level ?? 2) >= 3 ? 'text-footnote' : 'text-side-menu', 'min-w-0']}>{item.title}</span>
                </button>
              ))}
            </div>

            {/* Шеврон — всегда справа сверху, выровнен по первой строке */}
            <button
              type="button"
              @click="open = !open"
              class="absolute right-0 top-[24px] flex h-[17px] items-center justify-end text-brand"
              aria-label="Оглавление"
            >
              <svg
                class="transition-transform duration-200"
                :class="open ? '-rotate-90' : 'rotate-0'"
                width="20" height="20" viewBox="0 0 16 16" fill="none"
                stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 4l4 4-4 4"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
)}
