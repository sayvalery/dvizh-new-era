---
/**
 * FeatureBlock — секция с авто-переключающимися пунктами и изображением
 *
 * Desktop (lg+): двухколоночный grid — пункты слева, изображение справа.
 * Mobile (< lg): одна колонка, изображение появляется inline под активным пунктом.
 *
 * Опционально: описание под заголовком и кнопка CTA.
 *
 * Дизайн: Figma 402:7195 (desktop), 418:4462 (mobile)
 *
 * @example
 * ```astro
 * <FeatureBlock
 *   heading="Повышаем конверсию в 2 раза"
 *   description="Подключите ДВИЖ и закрывайте до 26% больше сделок."
 *   button={{ label: 'Узнать больше', drawerPreset: 'demo' }}
 *   features={[
 *     { title: '40+ банков-партнёров', subtitle: '15 «быстрых» банков по API' },
 *     { title: '«Умный» скоринг покупателя' },
 *   ]}
 * />
 * ```
 */

import Button from './Button.astro'
import Review from './Review.astro'

interface Feature {
  /** Заголовок пункта */
  title: string
  /** Подпись — показывается при активном состоянии */
  subtitle?: string
  /** Изображение этого пункта (если не задано — серый плейсхолдер на десктопе и общий fallback на мобайле) */
  image?: string
  /** Изображение для мобильной версии (если не задано — используется `image`) */
  imageMobile?: string
  /** Alt изображения пункта */
  imageAlt?: string
}

interface ButtonProps {
  /** Текст кнопки */
  label: string
  /** Пресет дровера */
  drawerPreset?: 'demo' | 'lead' | 'research' | 'subscribe'
  /** Ссылка (если не дровер) */
  href?: string
}

interface ReviewProps {
  /** Текст цитаты */
  quote: string
  /** Имя автора */
  author: string
  /** Должность автора */
  role: string
  /** Логотип компании */
  company?: { logo: string; alt?: string }
  /** Ссылка на кейс */
  caseLink?: { label?: string; href: string }
}

interface Props {
  /** Заголовок секции */
  heading?: string
  /** Описание под заголовком (опционально) */
  description?: string
  /** Кнопка CTA под описанием (опционально) */
  button?: ButtonProps
  /** Список пунктов */
  features: Feature[]
  /** URL изображения */
  image?: string
  /** Alt изображения */
  imageAlt?: string
  /** Сторона изображения на десктопе: right (по умолчанию) или left */
  imageSide?: 'left' | 'right'
  /** Интервал переключения в мс (по умолчанию 5000) */
  interval?: number
  /** Отзыв под списком пунктов (опционально) */
  review?: ReviewProps
  /** Дополнительные классы */
  class?: string
}

const {
  heading = 'Повышаем конверсию в 2 раза',
  description,
  button,
  features = [],
  image,
  imageAlt = '',
  imageSide = 'right',
  interval = 5000,
  review,
  class: className = '',
} = Astro.props

const imageLeft = imageSide === 'left'
const featuresWithImage = features.map((f, i) => f.image ? i : -1).filter(i => i !== -1)
---

<section class:list={['py-24 lg:py-[120px]', className]}>
  <div class="page-container">
    <div
      class="grid lg:grid-cols-2 gap-16 items-stretch"
      x-data={`{
        active: 0,
        total: ${features.length},
        timer: null,
        init() { this.startTimer() },
        startTimer() {
          clearInterval(this.timer)
          this.timer = setInterval(() => {
            this.active = (this.active + 1) % this.total
          }, ${interval})
        },
        select(i) {
          this.active = i
          this.startTimer()
        }
      }`}
    >

      <!-- Текстовая колонка (+ inline image на мобайле) -->
      <div class:list={['flex flex-col gap-12 lg:gap-16 lg:justify-between lg:h-[720px]', imageLeft && 'lg:order-2']}>

        <!-- Заголовок + описание + кнопка -->
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-4">
            <h2 class="text-h2 text-gray-900">{heading}</h2>
            {description && (
              <p class="text-body-lg text-gray-900">{description}</p>
            )}
          </div>
          {button && (
            <div>
              <Button
                variant="primary"
                href={button.href}
                drawerPreset={button.drawerPreset}
              >{button.label}</Button>
            </div>
          )}
        </div>

        <!-- Пункты -->
        <ul class="flex flex-col">
          {features.map((feature, i) => (
            <li>
              <!-- Разделитель с прогресс-баром -->
              <div class="relative h-px bg-gray-300">
                <div
                  class="absolute inset-0 bg-brand"
                  style="transform: scaleX(0); transform-origin: left"
                  x-show={`active === ${i}`}
                  x-bind:style={`active === ${i} ? 'transform-origin: left; animation: feature-progress ${interval}ms linear forwards' : 'transform: scaleX(0); transform-origin: left'`}
                  x-cloak
                ></div>
              </div>

              <div
                class="flex gap-3 items-start py-5 cursor-pointer select-none"
                @click={`select(${i})`}
              >
                <!-- Текст -->
                <div class="flex-1 min-w-0">
                  <p
                    class="text-body-lg-bold transition-colors duration-300"
                    x-bind:class={`active === ${i} ? 'text-gray-900' : 'text-gray-500'`}
                  >{feature.title}</p>

                  {feature.subtitle && (
                    <p
                      class="text-body-lg text-gray-500 overflow-hidden transition-[max-height,opacity,margin-top] duration-300 ease-in-out"
                      style="max-height: 0; opacity: 0; margin-top: 0"
                      x-bind:style={`active === ${i} ? 'max-height: 80px; opacity: 1; margin-top: 0.5rem' : 'max-height: 0; opacity: 0; margin-top: 0'`}
                    >{feature.subtitle}</p>
                  )}

                  <!-- Mobile: изображение под активным пунктом (скрыто на lg+) -->
                  <div
                    class="lg:hidden overflow-hidden transition-[max-height,opacity,margin-top] duration-300 ease-in-out"
                    style="max-height: 0; opacity: 0; margin-top: 0"
                    x-bind:style={`active === ${i} ? 'max-height: 800px; opacity: 1; margin-top: 1rem' : 'max-height: 0; opacity: 0; margin-top: 0'`}
                  >
                    {(feature.imageMobile ?? feature.image ?? image) ? (
                      <img
                        src={feature.imageMobile ?? feature.image ?? image}
                        alt={feature.imageAlt ?? imageAlt}
                        class="block w-full h-auto rounded-2xl"
                        loading="lazy"
                      />
                    ) : (
                      <div class="aspect-[4/3] rounded-2xl bg-background-secondary">
                        <slot name="image-mobile" />
                      </div>
                    )}

                  </div>
                </div>
              </div>
            </li>
          ))}
          <li><div class="h-px bg-gray-300"></div></li>
        </ul>

        {review && (
          <Review
            quote={review.quote}
            author={review.author}
            role={review.role}
            company={review.company}
            caseLink={review.caseLink}
            variant="dark"
          />
        )}


      </div>

      <!-- Desktop: колонка с изображением (скрыта на мобайле) -->
      <div
        class:list={[
          'hidden lg:block relative rounded-3xl overflow-hidden lg:h-[720px] transition-colors duration-500 bg-background-primary',
          imageLeft && 'lg:order-1'
        ]}
        x-bind:class={`${JSON.stringify(featuresWithImage)}.includes(active) ? 'bg-background-primary' : 'bg-background-secondary'`}
      >
        {features.some(f => f.image) ? (
          features.map((feature, i) => feature.image && (
            <img
              src={feature.image}
              alt={feature.imageAlt ?? feature.title}
              class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 opacity-0"
              x-bind:class={`active === ${i} ? 'opacity-100' : 'opacity-0'`}
              loading="lazy"
            />
          ))
        ) : image ? (
          <img
            src={image}
            alt={imageAlt}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        ) : (
          <slot name="image" />
        )}
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes feature-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
</style>
