---
/**
 * LogoGrid — бегущая строка логотипов клиентов/партнёров (marquee)
 *
 * @example
 * ```astro
 * <LogoGrid logos={[{ src: "/partners/lsr.svg", alt: "ЛСР" }]} />
 * <LogoGrid logos={[{ src: "/partners/lsr.svg", alt: "ЛСР" }]} noFade white />
 * ```
 */

interface Logo {
  /** URL логотипа */
  src: string
  /** Alt-текст */
  alt: string
  /** Ширина исходника (для monochrome — задаёт aspect-ratio спана без async-сайзера) */
  w?: number
  /** Высота исходника */
  h?: number
  /** Множитель высоты относительно базовых 2rem (например 0.8 — на 20% меньше) */
  scale?: number
}

interface Props {
  /** Массив логотипов */
  logos: Logo[]
  /** Убрать градиенты по бокам */
  noFade?: boolean
  /** Белые логотипы без opacity (для тёмного/цветного фона) */
  white?: boolean
  /** Плоский ровный серый (#374151) через CSS-маску — для разноцветных оригиналов */
  monochrome?: boolean
  /** Убрать внутренние отступы (padding: 0) */
  noPadding?: boolean
  /** Дополнительные CSS классы */
  class?: string
}

const { logos, noFade = false, white = false, monochrome = false, noPadding = false, class: className = '' } = Astro.props
---

<div class:list={['logo-grid-root', noPadding && 'logo-grid-root--no-padding', className]}>
  {!noFade && <div class="logo-grid-fade logo-grid-fade--left" aria-hidden="true"></div>}
  {!noFade && <div class="logo-grid-fade logo-grid-fade--right" aria-hidden="true"></div>}

  <div class="logo-grid-set">
    {[...logos, ...logos, ...logos, ...logos].map((logo, i) => (
      monochrome ? (
        <span
          class="logo-grid-img logo-grid-img--mono"
          style={`-webkit-mask-image:url("${logo.src}");mask-image:url("${logo.src}")` +
            (logo.w && logo.h ? `;aspect-ratio:${logo.w}/${logo.h}` : '')}
          role="img"
          aria-label={i < logos.length ? logo.alt : undefined}
          aria-hidden={i >= logos.length ? 'true' : undefined}
        >
          {!(logo.w && logo.h) && (
            <img src={logo.src} alt="" height="32" class="logo-grid-mono-sizer"
              loading="eager" draggable="false" />
          )}
        </span>
      ) : (
        <img
          src={logo.src}
          alt={logo.alt}
          height="32"
          class:list={['logo-grid-img', white && 'logo-grid-img--white']}
          style={logo.scale ? `height:${2 * logo.scale}rem` : undefined}
          loading={i < logos.length ? 'eager' : 'lazy'}
          draggable="false"
          aria-hidden={i >= logos.length ? 'true' : undefined}
        />
      )
    ))}
  </div>
</div>

<style>
  .logo-grid-root {
    --gap: 4rem;
    display: flex;
    overflow: hidden;
    gap: var(--gap);
    padding: 2rem 0;
    position: relative;
    user-select: none;
    width: 100%;
    min-width: 0;
  }

  .logo-grid-root--no-padding {
    padding: 0;
  }

  .logo-grid-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8rem;
    z-index: 10;
    pointer-events: none;
  }

  .logo-grid-fade--left {
    left: 0;
    background: linear-gradient(to right, #FBF9F6, transparent);
  }

  .logo-grid-fade--right {
    right: 0;
    background: linear-gradient(to left, #FBF9F6, transparent);
  }

  .logo-grid-set {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--gap);
    animation: logo-grid-scroll 30s linear infinite;
    will-change: transform;
  }

  .logo-grid-img {
    height: 2rem;
    width: auto;
    max-width: 7.5rem;
    object-fit: contain;
    filter: grayscale(100%) opacity(45%);
  }

  .logo-grid-img--white {
    filter: brightness(0) invert(1);
  }

  /* Плоский ровный серый через маску: любой логотип красится в один цвет по форме.
     Внутренний <img> задаёт размеры (пропорции лого), сам скрыт. #374151 — тон,
     совпадающий с серыми логотипами в partners/dark/. */
  .logo-grid-img--mono {
    display: inline-block;
    height: 2rem;
    width: auto;
    max-width: 7.5rem;
    background-color: #374151;
    filter: opacity(45%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  .logo-grid-mono-sizer {
    display: block;
    height: 2rem;
    width: auto;
    max-width: 7.5rem;
    object-fit: contain;
    visibility: hidden;
  }

  @keyframes logo-grid-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-25%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-grid-set {
      animation-play-state: paused;
    }
  }
</style>
