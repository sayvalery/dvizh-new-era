---
/**
 * LogoGrid — бегущая строка логотипов клиентов/партнёров (marquee)
 *
 * @example
 * ```astro
 * <LogoGrid logos={[{ src: "/partners/lsr.svg", alt: "ЛСР" }]} />
 * <LogoGrid logos={[{ src: "/partners/lsr.svg", alt: "ЛСР" }]} noFade white />
 * ```
 */

interface Logo {
  /** URL логотипа */
  src: string
  /** Alt-текст */
  alt: string
}

interface Props {
  /** Массив логотипов */
  logos: Logo[]
  /** Убрать градиенты по бокам */
  noFade?: boolean
  /** Белые логотипы без opacity (для тёмного/цветного фона) */
  white?: boolean
  /** Дополнительные CSS классы */
  class?: string
}

const { logos, noFade = false, white = false, class: className = '' } = Astro.props
---

<div class:list={['logo-grid-root', className]}>
  {!noFade && <div class="logo-grid-fade logo-grid-fade--left" aria-hidden="true"></div>}
  {!noFade && <div class="logo-grid-fade logo-grid-fade--right" aria-hidden="true"></div>}

  <div class="logo-grid-set">
    {[...logos, ...logos, ...logos, ...logos].map((logo, i) => (
      <img
        src={logo.src}
        alt={logo.alt}
        height="32"
        class:list={['logo-grid-img', white && 'logo-grid-img--white']}
        loading={i < logos.length ? 'eager' : 'lazy'}
        draggable="false"
        aria-hidden={i >= logos.length ? 'true' : undefined}
      />
    ))}
  </div>
</div>

<style>
  .logo-grid-root {
    --gap: 4rem;
    display: flex;
    overflow: hidden;
    gap: var(--gap);
    padding: 2rem 0;
    position: relative;
    user-select: none;
    width: 100%;
    min-width: 0;
  }

  .logo-grid-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8rem;
    z-index: 10;
    pointer-events: none;
  }

  .logo-grid-fade--left {
    left: 0;
    background: linear-gradient(to right, #FBF9F6, transparent);
  }

  .logo-grid-fade--right {
    right: 0;
    background: linear-gradient(to left, #FBF9F6, transparent);
  }

  .logo-grid-set {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--gap);
    animation: logo-grid-scroll 30s linear infinite;
    will-change: transform;
  }

  .logo-grid-img {
    height: 2rem;
    width: auto;
    max-width: 7.5rem;
    object-fit: contain;
    filter: grayscale(100%) opacity(45%);
  }

  .logo-grid-img--white {
    filter: brightness(0) invert(1);
  }

  @keyframes logo-grid-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-25%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-grid-set {
      animation-play-state: paused;
    }
  }
</style>
