---
/**
 * LogoGrid — бегущая строка логотипов клиентов/партнёров (marquee)
 *
 * @example
 * ```astro
 * <LogoGrid
 *   logos={[
 *     { src: "/partners/dark/lsr.svg", alt: "ЛСР" },
 *     { src: "/partners/dark/a101.svg", alt: "A101" },
 *   ]}
 * />
 * ```
 */

interface Logo {
  /** URL логотипа */
  src: string
  /** Alt-текст */
  alt: string
}

interface Props {
  /** Массив логотипов */
  logos: Logo[]
  /** Дополнительные CSS классы */
  class?: string
}

const { logos, class: className = '' } = Astro.props
---

<div class:list={['logo-grid-root', className]}>
  <!-- Левый блюр -->
  <div class="logo-grid-fade logo-grid-fade--left" aria-hidden="true"></div>
  <!-- Правый блюр -->
  <div class="logo-grid-fade logo-grid-fade--right" aria-hidden="true"></div>

  <!-- Набор 1 -->
  <div class="logo-grid-set">
    {logos.map(logo => (
      <img
        src={logo.src}
        alt={logo.alt}
        height="32"
        class="logo-grid-img"
        loading="lazy"
        draggable="false"
      />
    ))}
  </div>

  <!-- Набор 2 — точная копия для бесшовного цикла -->
  <div class="logo-grid-set" aria-hidden="true">
    {logos.map(logo => (
      <img
        src={logo.src}
        alt={logo.alt}
        height="32"
        class="logo-grid-img"
        loading="lazy"
        draggable="false"
      />
    ))}
  </div>
</div>

<style>
  .logo-grid-root {
    --gap: 4rem;
    display: flex;
    overflow: hidden;
    gap: var(--gap);
    padding: 1.5rem 0;
    position: relative;
    user-select: none;
  }

  .logo-grid-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8rem;
    z-index: 10;
    pointer-events: none;
  }

  .logo-grid-fade--left {
    left: 0;
    background: linear-gradient(to right, white, transparent);
  }

  .logo-grid-fade--right {
    right: 0;
    background: linear-gradient(to left, white, transparent);
  }

  /* Каждый набор занимает минимум 100% ширины контейнера.
     translateX(-100% - gap) сдвигает ровно на ширину одного набора,
     и второй набор занимает его место — бесшовный loop. */
  .logo-grid-set {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--gap);
    min-width: 100%;
    animation: logo-grid-scroll 30s linear infinite;
    will-change: transform;
  }

  .logo-grid-img {
    height: 2rem;
    width: auto;
    object-fit: contain;
    filter: grayscale(100%) opacity(45%);
  }

  @keyframes logo-grid-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-100% - var(--gap))); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-grid-set {
      animation-play-state: paused;
    }
  }
</style>
