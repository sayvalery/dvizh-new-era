---
/**
 * LogoGrid — бегущая строка логотипов клиентов/партнёров (marquee)
 *
 * @example
 * ```astro
 * <LogoGrid
 *   logos={[
 *     { src: "/partners/dark/lsr.svg", alt: "ЛСР" },
 *     { src: "/partners/dark/a101.svg", alt: "A101" },
 *   ]}
 * />
 * ```
 */

interface Logo {
  /** URL логотипа */
  src: string
  /** Alt-текст */
  alt: string
}

interface Props {
  /** Массив логотипов */
  logos: Logo[]
  /** Дополнительные CSS классы */
  class?: string
}

const { logos, class: className = '' } = Astro.props
---

<div class:list={['logo-grid-root', className]}>
  <!-- Левый блюр -->
  <div class="logo-grid-fade logo-grid-fade--left" aria-hidden="true"></div>
  <!-- Правый блюр -->
  <div class="logo-grid-fade logo-grid-fade--right" aria-hidden="true"></div>

  <!-- 4 копии логотипов в одну строку, анимируется на -25% = ровно 1 копия -->
  <div class="logo-grid-set">
    {[...logos, ...logos, ...logos, ...logos].map((logo, i) => (
      <img
        src={logo.src}
        alt={logo.alt}
        height="32"
        class="logo-grid-img"
        loading={i < logos.length ? 'eager' : 'lazy'}
        draggable="false"
        aria-hidden={i >= logos.length ? 'true' : undefined}
      />
    ))}
  </div>
</div>

<style>
  .logo-grid-root {
    --gap: 4rem;
    display: flex;
    overflow: hidden;
    gap: var(--gap);
    padding: 2rem 0;
    position: relative;
    user-select: none;
    width: 100%;
  }

  .logo-grid-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8rem;
    z-index: 10;
    pointer-events: none;
  }

  .logo-grid-fade--left {
    left: 0;
    background: linear-gradient(to right, #FBF9F6, transparent);
  }

  .logo-grid-fade--right {
    right: 0;
    background: linear-gradient(to left, #FBF9F6, transparent);
  }

  /* 4 копии логотипов в одной строке.
     translateX(-25%) сдвигает ровно на 1 копию — бесшовный loop. */
  .logo-grid-set {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--gap);
    animation: logo-grid-scroll 30s linear infinite;
    will-change: transform;
  }

  .logo-grid-img {
    height: 2rem;
    width: auto;
    max-width: 7.5rem;
    object-fit: contain;
    filter: grayscale(100%) opacity(45%);
  }

  @keyframes logo-grid-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-25%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-grid-set {
      animation-play-state: paused;
    }
  }
</style>
