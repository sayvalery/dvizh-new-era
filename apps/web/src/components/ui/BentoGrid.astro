---
/**
 * BentoGrid — секция с тремя карточками в bento-раскладке
 *
 * Два маленьких элемента слева (стек) + один большой справа.
 *
 * @example
 * ```astro
 * <BentoGrid
 *   heading="Другие причины выбрать ДВИЖ"
 *   items={[
 *     {
 *       title: "Выпуск подписи за 5 минут",
 *       description: "Поддерживаем все технологии: токен, Sign.Me, Госключ",
 *       image: "/img/feature-sign.png"
 *     },
 *     {
 *       title: "Ускорим подачу заявления",
 *       description: "Подключим оплату госпошлины с авансового счёта внутри ДВИЖа",
 *       image: "/img/feature-gosuslugi.png"
 *     },
 *     {
 *       title: "Расчёт вероятности и скорости одобрения по банкам",
 *       description: "Поможем зарегистрировать сложные сделки: с иностранными гражданами или военной ипотекой",
 *       image: "/img/feature-scoring.png"
 *     }
 *   ]}
 * />
 * ```
 */

interface BentoItem {
  /** Заголовок карточки */
  title: string
  /** Подпись под заголовком */
  description?: string
  /** URL изображения */
  image?: string
  /** Alt-текст изображения */
  imageAlt?: string
}

interface Props {
  /** Заголовок секции над сеткой */
  heading?: string
  /**
   * Три карточки сетки:
   * [0] — верхняя левая (маленькая, текст слева-сверху, изображение справа-сверху)
   * [1] — нижняя левая (маленькая, изображение слева-сверху, текст снизу-справа)
   * [2] — правая (большая, текст сверху, изображение снизу)
   */
  items: BentoItem[]
  /** Дополнительные CSS классы на секцию */
  class?: string
}

const { heading, items, class: className = '' } = Astro.props

const card1 = items[0] ?? { title: '' }
const card2 = items[1] ?? { title: '' }
const card3 = items[2] ?? { title: '' }
---

<section class:list={['flex flex-col gap-10 lg:gap-16', className]}>

  {heading && (
    <h2 class="font-heading text-[32px] font-medium leading-none tracking-[-0.04em] text-[#32393e] lg:text-5xl lg:tracking-[-0.042em]">
      {heading}
    </h2>
  )}

  <!-- Сетка: две колонки на десктопе, стек на мобайле -->
  <div class="flex flex-col gap-6 lg:flex-row lg:items-stretch" style="min-height:0">

    <!-- Левая колонка: два равных элемента -->
    <div class="flex flex-1 flex-col gap-6">

      <!-- Карточка 1: текст сверху-слева, изображение сверху-справа -->
      <div class="relative flex min-h-[240px] flex-1 flex-col overflow-hidden rounded-[32px] bg-[#f9f7f5] p-8 lg:min-h-0 lg:rounded-[40px] lg:p-10">
        <div class="relative z-10 flex flex-col gap-3 lg:gap-4" style="max-width:60%">
          <h3 class="font-sans text-[22px] font-medium leading-tight tracking-[-0.03em] text-[#1c1c1e] lg:text-[28px]">
            {card1.title}
          </h3>
          {card1.description && (
            <p class="font-sans text-sm leading-[1.3] tracking-[-0.02em] text-black/40 lg:text-[17px]">
              {card1.description}
            </p>
          )}
        </div>
        {card1.image ? (
          <img
            src={card1.image}
            alt={card1.imageAlt ?? card1.title}
            class="absolute right-0 top-0 h-full w-auto max-w-[55%] rounded-[20px] object-cover object-left lg:rounded-[24px]"
          />
        ) : (
          <div class="absolute right-0 top-0 h-full w-[48%] bg-[#e5e3e0]" aria-hidden="true" />
        )}
      </div>

      <!-- Карточка 2: изображение сверху-слева, текст снизу-справа -->
      <div class="relative flex min-h-[240px] flex-1 flex-col items-end justify-end overflow-hidden rounded-[32px] bg-[#f9f7f5] p-8 lg:min-h-0 lg:rounded-[40px] lg:p-10">
        {card2.image ? (
          <img
            src={card2.image}
            alt={card2.imageAlt ?? card2.title}
            class="absolute left-0 top-0 h-full w-auto max-w-[55%] rounded-[20px] object-cover object-right lg:rounded-[24px]"
          />
        ) : (
          <div class="absolute left-0 top-0 h-full w-[48%] bg-[#e5e3e0]" aria-hidden="true" />
        )}
        <div class="relative z-10 flex flex-col gap-3 lg:gap-4" style="max-width:60%">
          <h3 class="font-sans text-[22px] font-medium leading-tight tracking-[-0.03em] text-[#1c1c1e] lg:text-[28px]">
            {card2.title}
          </h3>
          {card2.description && (
            <p class="font-sans text-sm leading-[1.3] tracking-[-0.02em] text-black/40 lg:text-[17px]">
              {card2.description}
            </p>
          )}
        </div>
      </div>

    </div>

    <!-- Правая колонка: один большой элемент -->
    <div class="relative flex min-h-[400px] flex-1 flex-col overflow-hidden rounded-[32px] bg-[#f9f7f5] p-8 lg:min-h-0 lg:rounded-[40px] lg:p-10">
      <div class="relative z-10 flex flex-col gap-3 lg:gap-4">
        <h3 class="font-sans text-[22px] font-medium leading-tight tracking-[-0.03em] text-[#1c1c1e] lg:text-[28px]">
          {card3.title}
        </h3>
        {card3.description && (
          <p class="font-sans text-sm leading-[1.3] tracking-[-0.02em] text-black/40 lg:text-[17px]">
            {card3.description}
          </p>
        )}
      </div>
      {card3.image ? (
        <img
          src={card3.image}
          alt={card3.imageAlt ?? card3.title}
          class="absolute bottom-0 left-0 w-full object-cover"
        />
      ) : (
        <div class="absolute bottom-0 left-0 h-[55%] w-full bg-[#e5e3e0]" aria-hidden="true" />
      )}
    </div>

  </div>
</section>
