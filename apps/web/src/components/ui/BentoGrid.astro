---
/**
 * BentoGrid — секция с bento-раскладкой карточек
 *
 * ## Вариант 'three' (по умолчанию)
 * Два маленьких элемента слева (стек) + один большой справа.
 *
 * @example variant='three'
 * ```astro
 * <BentoGrid
 *   heading="Другие причины выбрать ДВИЖ"
 *   items={[
 *     { title: "Выпуск подписи за 5 минут", description: "...", image: "/img/sign.png" },
 *     { title: "Ускорим подачу заявления", description: "...", image: "/img/gosuslugi.png" },
 *     { title: "Расчёт вероятности одобрения", description: "...", image: "/img/scoring.png" }
 *   ]}
 * />
 * ```
 *
 * ## Вариант 'four'
 * Две строки по две карточки с разными пропорциями:
 * - Строка 1: широкая (≈77%) + узкая (≈23%), текст внизу/вверху соответственно
 * - Строка 2: узкая (≈40%) + широкая (≈60%), текст внизу у обеих
 *
 * Карточки поддерживают фоновое изображение на всю площадь (backgroundImage).
 *
 * @example variant='four'
 * ```astro
 * <BentoGrid
 *   variant="four"
 *   items={[
 *     { title: "Распознавание", description: "Определяем тип документа автоматически" },
 *     { title: "Дополняем профиль клиента", description: "Данные из ФНС, ГИБДД, БКИ" },
 *     { title: "Антифрод", description: "Ищем признаки мошенничества" },
 *     { title: "Верификация", description: "Проверяем документ на подлинность" },
 *   ]}
 * />
 * ```
 */

interface BentoItem {
  /** Заголовок карточки */
  title: string
  /** Подпись под заголовком */
  description?: string
  /** URL изображения (для variant='three') */
  image?: string
  /** Alt-текст изображения */
  imageAlt?: string
  /**
   * URL фонового изображения на всю карточку (для variant='four').
   * Растягивается на весь размер карточки (background-size: cover).
   */
  backgroundImage?: string
}

interface Props {
  /** Вариант раскладки: 'three' — 3 карточки (по умолчанию), 'four' — 4 карточки в 2 строках */
  variant?: 'three' | 'four'
  /** Заголовок секции над сеткой */
  heading?: string
  /**
   * Карточки сетки.
   * variant='three': [0] верх-лево, [1] низ-лево, [2] большая справа.
   * variant='four':  [0] строка1-широкая, [1] строка1-узкая, [2] строка2-узкая, [3] строка2-широкая.
   */
  items: BentoItem[]
  /** Дополнительные CSS классы на секцию */
  class?: string
}

const { variant = 'three', heading, items, class: className = '' } = Astro.props

const card1 = items[0] ?? { title: '' }
const card2 = items[1] ?? { title: '' }
const card3 = items[2] ?? { title: '' }
const card4 = items[3] ?? { title: '' }

const isThree = variant === 'three'
const isFour = variant === 'four'
---

<section class:list={['flex flex-col gap-10 lg:gap-16', className]}>

  {heading && (
    <h2 class="text-h2 text-gray-900">
      {heading}
    </h2>
  )}

  <!--
    ═══ VARIANT THREE ═══
    Две колонки на десктопе: левая — два стекированных элемента, правая — один большой.
  -->
  {isThree && (
    <div class="flex flex-col gap-6 lg:h-[738px] lg:flex-row">

      <!-- Левая колонка: два равных элемента -->
      <div class="flex flex-1 flex-col gap-6">

        <!-- Карточка 1: текст сверху-слева, изображение сверху-справа -->
        <div class="relative flex min-h-[240px] flex-1 flex-col overflow-hidden rounded-[32px] bg-background-secondary p-6 lg:rounded-[40px] lg:p-10">
          <div class="relative z-10 flex max-w-[48%] flex-col gap-3 lg:gap-4">
            <h3 class="text-h4 text-gray-900">
              {card1.title}
            </h3>
            {card1.description && (
              <p class="text-subhead text-black/40">
                {card1.description}
              </p>
            )}
          </div>
          {card1.image ? (
            <img
              src={card1.image}
              alt={card1.imageAlt ?? card1.title}
              class="absolute right-0 top-0 h-full w-auto max-w-[55%] rounded-[20px] object-cover object-left lg:rounded-[24px]"
            />
          ) : (
            <div class="absolute right-0 top-0 h-full w-[48%] bg-gray-200" aria-hidden="true" />
          )}
        </div>

        <!-- Карточка 2: изображение сверху-слева, текст снизу-справа -->
        <div class="relative flex min-h-[240px] flex-1 flex-col items-end justify-end overflow-hidden rounded-[32px] bg-background-secondary p-6 lg:rounded-[40px] lg:p-10">
          {card2.image ? (
            <img
              src={card2.image}
              alt={card2.imageAlt ?? card2.title}
              class="absolute left-0 top-0 h-full w-auto max-w-[55%] rounded-[20px] object-cover object-right lg:rounded-[24px]"
            />
          ) : (
            <div class="absolute left-0 top-0 h-full w-[48%] bg-gray-200" aria-hidden="true" />
          )}
          <div class="relative z-10 flex max-w-[48%] flex-col gap-3 lg:gap-4">
            <h3 class="text-h4 text-gray-900">
              {card2.title}
            </h3>
            {card2.description && (
              <p class="text-subhead text-black/40">
                {card2.description}
              </p>
            )}
          </div>
        </div>

      </div>

      <!-- Правая колонка: один большой элемент -->
      <div class="relative flex min-h-[400px] flex-1 flex-col overflow-hidden rounded-[32px] bg-background-secondary p-6 lg:rounded-[40px] lg:p-10">
        <div class="relative z-10 flex flex-col gap-3 lg:gap-4">
          <h3 class="text-h4 text-gray-900">
            {card3.title}
          </h3>
          {card3.description && (
            <p class="text-subhead text-black/40">
              {card3.description}
            </p>
          )}
        </div>
        {card3.image ? (
          <img
            src={card3.image}
            alt={card3.imageAlt ?? card3.title}
            class="absolute bottom-0 left-0 w-full object-cover"
          />
        ) : (
          <div class="absolute bottom-0 left-0 h-[55%] w-full bg-gray-200" aria-hidden="true" />
        )}
      </div>

    </div>
  )}

  <!--
    ═══ VARIANT FOUR ═══
    Две строки с разными пропорциями карточек.
    Строка 1 (высокая): широкая (≈77%) + узкая (≈23%)
    Строка 2 (пониже):  узкая (≈40%) + широкая (≈60%)
    Карточки поддерживают backgroundImage — растягивается на всю площадь карточки.
  -->
  {isFour && (
    <div class="flex flex-col gap-6">

      <!-- Строка 1 -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[62fr_38fr] lg:h-[488px]">

        <!-- Карточка 1: широкая, текст внизу-слева -->
        <div
          class="relative min-h-[300px] overflow-hidden rounded-[32px] bg-background-secondary lg:rounded-[40px]"
          style={card1.backgroundImage ? `background-image: url('${card1.backgroundImage}'); background-size: cover; background-position: center;` : ''}
        >
          <div class="absolute bottom-8 left-8 flex flex-col gap-4 lg:bottom-10 lg:left-10">
            <h3 class="text-h3 text-gray-900">{card1.title}</h3>
            {card1.description && (
              <p class="text-body-lg text-black/40 max-w-[380px]">{card1.description}</p>
            )}
          </div>
        </div>

        <!-- Карточка 2: узкая, текст вверху-слева -->
        <div
          class="relative min-h-[300px] overflow-hidden rounded-[32px] bg-background-secondary lg:rounded-[40px]"
          style={card2.backgroundImage ? `background-image: url('${card2.backgroundImage}'); background-size: cover; background-position: center;` : ''}
        >
          <div class="absolute top-8 left-8 right-8 flex flex-col gap-4 lg:top-10 lg:left-10 lg:right-10">
            <h3 class="text-h3 text-gray-900">{card2.title}</h3>
            {card2.description && (
              <p class="text-body-lg text-black/40">{card2.description}</p>
            )}
          </div>
        </div>

      </div>

      <!-- Строка 2 -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[40fr_60fr] lg:h-[360px]">

        <!-- Карточка 3: узкая, текст внизу-слева -->
        <div
          class="relative min-h-[240px] overflow-hidden rounded-[32px] bg-background-secondary lg:rounded-[40px]"
          style={card3.backgroundImage ? `background-image: url('${card3.backgroundImage}'); background-size: cover; background-position: center;` : ''}
        >
          <div class="absolute bottom-8 left-8 flex flex-col gap-4 lg:bottom-10 lg:left-10">
            <h3 class="text-h3 text-gray-900">{card3.title}</h3>
            {card3.description && (
              <p class="text-body-lg text-black/40">{card3.description}</p>
            )}
          </div>
        </div>

        <!-- Карточка 4: широкая, текст внизу-слева -->
        <div
          class="relative min-h-[240px] overflow-hidden rounded-[32px] bg-background-secondary lg:rounded-[40px]"
          style={card4.backgroundImage ? `background-image: url('${card4.backgroundImage}'); background-size: cover; background-position: center;` : ''}
        >
          <div class="absolute bottom-8 left-8 flex flex-col gap-4 lg:bottom-10 lg:left-10">
            <h3 class="text-h3 text-gray-900">{card4.title}</h3>
            {card4.description && (
              <p class="text-body-lg text-black/40">{card4.description}</p>
            )}
          </div>
        </div>

      </div>

    </div>
  )}

</section>
