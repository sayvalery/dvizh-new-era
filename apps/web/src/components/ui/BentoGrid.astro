---
/**
 * BentoGrid — секция с bento-раскладкой карточек
 *
 * Карточки в обоих вариантах поддерживают `backgroundImage` — растягивается на всю
 * площадь карточки через <img object-cover>. Текст лежит абсолютом поверх —
 * учитывай читаемость при подборе картинки.
 * Позиция фокуса управляется через `imagePosition` (CSS object-position, default: 'center').
 *
 * ## Вариант 'two'
 * Две равные карточки 50/50. На десктопе (lg+) — вертикальные (portrait), рядом.
 * До lg — стек друг под другом. Текст всегда снизу-слева: заголовок (h3) + подзаголовок.
 * Картинки под этот вариант — вертикальные (portrait crop).
 *
 * @example variant='two'
 * ```astro
 * <BentoGrid
 *   variant="two"
 *   heading="Делаем все для ваших крутых результатов"
 *   items={[
 *     { title: "Готовые интеграции", description: "С популярными системами", backgroundImage: "/img/crm.png" },
 *     { title: "Быстрая поддержка", description: "Среднее время ответа — 57 секунд", backgroundImage: "/img/chat.png" }
 *   ]}
 * />
 * ```
 *
 * ## Вариант 'three' (по умолчанию)
 * xs–lg включительно: три карточки вертикальным стеком, текст всегда снизу-слева.
 * xl+: bento — слева стек из двух, справа большая. Позиции текста: card1 — верх-лево,
 *      card2 — низ-лево, card3 — верх-лево.
 *
 * @example variant='three'
 * ```astro
 * <BentoGrid
 *   heading="Другие причины выбрать ДВИЖ"
 *   items={[
 *     { title: "Выпуск подписи за 5 минут", description: "...", backgroundImage: "/img/sign.png" },
 *     { title: "Ускорим подачу заявления", description: "...", backgroundImage: "/img/gosuslugi.png" },
 *     { title: "Расчет вероятности одобрения", description: "...", backgroundImage: "/img/scoring.png" }
 *   ]}
 * />
 * ```
 *
 * ## Вариант 'four'
 * Две строки по две карточки с разными пропорциями:
 * - Строка 1: широкая (≈62%) + узкая (≈38%)
 * - Строка 2: узкая (≈40%) + широкая (≈60%)
 * Текст у всех четырех карточек прижат к низу. Высота строк одинаковая (430px на lg+).
 *
 * @example variant='four'
 * ```astro
 * <BentoGrid
 *   variant="four"
 *   items={[
 *     { title: "Распознавание", description: "Определяем тип документа автоматически", imagePosition: "top" },
 *     { title: "Дополняем профиль клиента", description: "Данные из ФНС, ГИБДД, БКИ" },
 *     { title: "Антифрод", description: "Ищем признаки мошенничества" },
 *     { title: "Верификация", description: "Проверяем документ на подлинность" },
 *   ]}
 * />
 * ```
 */

interface BentoItem {
  /** Заголовок карточки */
  title: string
  /**
   * Заголовок в HTML — для фиксированных переносов через <br>.
   * Если задан, используется вместо title. Поддерживается в variant='three' и 'four'.
   */
  titleHtml?: string
  /** Подпись под заголовком */
  description?: string
  /**
   * URL фонового изображения на всю карточку.
   * Растягивается на весь размер карточки (object-fit: cover).
   */
  backgroundImage?: string
  /** URL картинки под мобилку (<640px) — обычно вертикальный кроп. Если не задан — backgroundImage. */
  backgroundImageMobile?: string
  /** URL картинки под планшет (640–1023px). Если не задан — backgroundImage. */
  backgroundImageTablet?: string
  /**
   * Позиция кропа (CSS object-position) по брейкпойнтам. Значения вроде 'center', 'top', '50% 85%'.
   *   imagePosition   — мобилка (<640px), дефолт 'top' (мобильные картинки — субъект вверху)
   *   imagePositionSm — планшет (640–1023px), дефолт 'center'
   *   imagePositionLg — десктоп (≥1024px), дефолт 'center'
   */
  imagePosition?: string
  imagePositionSm?: string
  imagePositionLg?: string
}

interface Props {
  /** Вариант раскладки: 'two' — 2 карточки 50/50 (вертикальные), 'three' — 3 карточки (по умолчанию), 'four' — 4 карточки в 2 строках */
  variant?: 'two' | 'three' | 'four'
  /** Заголовок секции над сеткой */
  heading?: string
  /** HTML-заголовок (альтернатива heading, поддерживает <br> и spans) */
  headingHtml?: string
  /** Описание под заголовком (опционально) */
  description?: string
  /**
   * Карточки сетки.
   * variant='two':   [0] левая, [1] правая — две равные вертикальные карточки.
   * variant='three': [0] верх-лево, [1] низ-лево, [2] большая справа.
   * variant='four':  [0] строка1-широкая, [1] строка1-узкая, [2] строка2-узкая, [3] строка2-широкая.
   */
  items: BentoItem[]
  /** Дополнительные CSS классы на секцию */
  class?: string
}

const { variant = 'three', heading, headingHtml, description, items, class: className = '' } = Astro.props

const card1 = items[0] ?? { title: '' }
const card2 = items[1] ?? { title: '' }
const card3 = items[2] ?? { title: '' }
const card4 = items[3] ?? { title: '' }

const isTwo = variant === 'two'
const isThree = variant === 'three'
const isFour = variant === 'four'

// object-position по брейкпойнтам через CSS-переменные (см. .bento-obj в global.css).
const imgStyle = (c: BentoItem) => {
  let s = ''
  if (c.imagePosition)   s += `--bento-obj: ${c.imagePosition};`
  if (c.imagePositionSm) s += `--bento-obj-sm: ${c.imagePositionSm};`
  if (c.imagePositionLg) s += `--bento-obj-lg: ${c.imagePositionLg};`
  return s
}
---

<section class:list={['flex flex-col gap-10 lg:gap-16', className]}>

  {(heading || headingHtml) && (
    <div class="flex flex-col gap-4">
      {headingHtml
        ? <h2 class="text-h2 text-gray-900" set:html={headingHtml} />
        : <h2 class="text-h2 text-gray-900">{heading}</h2>
      }
      {description && (
        <p class="text-body-lg text-gray-600 max-w-3xl">{description}</p>
      )}
    </div>
  )}

  <!--
    ═══ VARIANT TWO ═══
    Две равные карточки 50/50. lg+: вертикальные (portrait) рядом; до lg — стек.
    Текст снизу-слева: заголовок (h3) + подзаголовок (description).
    Картинки — вертикальные, растягиваются на всю площадь карточки.
    Высота: 484/602px до lg и 43.5rem с lg (= 696px на 1440). rem, а не px, —
    чтобы карточка росла вместе с корневым font-size на .fluid-scale-страницах
    (см. global.css); заодно снимает конфликт с fluid-оверрайдами ProductBento,
    которые перехватывают «круглые» `.lg\:h-\[600px\]` и т.п.
  -->
  {isTwo && (
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      {[card1, card2].map((card) => (
        <div class="relative h-[484px] sm:h-[602px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl lg:h-[43.5rem]">
          {card.backgroundImage && (
            <picture>
              {card.backgroundImageMobile && (
                <source media="(max-width: 639px)" srcset={card.backgroundImageMobile} />
              )}
              {card.backgroundImageTablet && (
                <source media="(min-width: 640px) and (max-width: 1023px)" srcset={card.backgroundImageTablet} />
              )}
              <img
                src={card.backgroundImage}
                alt=""
                class="absolute inset-0 w-full h-full object-cover bento-obj"
                style={imgStyle(card)}
                loading="lazy"
              />
            </picture>
          )}
          <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-3 lg:bottom-10 lg:left-10 lg:right-10 lg:gap-4 max-w-2xl">
            <h3 class="text-h3 text-gray-900">{card.title}</h3>
            {card.description && (
              <p class="text-body-lg text-black/40">{card.description}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  )}

  <!--
    ═══ VARIANT THREE ═══
    xs–lg (включая lg): все карточки вертикальным стеком, текст всегда снизу-слева.
    xl+: bento — две колонки, слева стек из двух карточек, справа большая;
         позиции текста: card1 — верх-лево, card2 — низ-лево, card3 — верх-лево.
  -->
  {isThree && (
    <div class="flex flex-col gap-6 xl:h-[738px] xl:flex-row">

      <!-- Левая колонка (xl+): два равных элемента -->
      <div class="flex flex-col gap-6 xl:flex-1">

        <!-- Карточка 1: текст снизу-слева до xl, сверху-слева на xl+ -->
        <div class="relative min-h-[400px] sm:min-h-[460px] md:min-h-[520px] flex-1 overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl xl:min-h-0">
          {card1.backgroundImage && (
            <picture>
              {card1.backgroundImageMobile && (
                <source media="(max-width: 639px)" srcset={card1.backgroundImageMobile} />
              )}
              <img
                src={card1.backgroundImage}
                alt=""
                class="absolute inset-0 w-full h-full object-cover bento-obj"
                style={imgStyle(card1)}
                loading="lazy"
              />
            </picture>
          )}
          <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-3 lg:bottom-10 lg:left-10 lg:right-10 lg:gap-4 max-w-md xl:bottom-auto xl:top-10 xl:max-w-[78%]">
            {card1.titleHtml
              ? <h3 class="text-h3 text-gray-900" set:html={card1.titleHtml} />
              : <h3 class="text-h3 text-gray-900">{card1.title}</h3>}
            {card1.description && (
              <p class="text-body-lg text-black/40">{card1.description}</p>
            )}
          </div>
        </div>

        <!-- Карточка 2: текст снизу-слева в стеке, сверху-слева на xl+ -->
        <div class="relative min-h-[400px] sm:min-h-[460px] md:min-h-[520px] flex-1 overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl xl:min-h-0">
          {card2.backgroundImage && (
            <picture>
              {card2.backgroundImageMobile && (
                <source media="(max-width: 639px)" srcset={card2.backgroundImageMobile} />
              )}
              {card2.backgroundImageTablet && (
                <source media="(min-width: 640px) and (max-width: 1023px)" srcset={card2.backgroundImageTablet} />
              )}
              <img
                src={card2.backgroundImage}
                alt=""
                class="absolute inset-0 w-full h-full object-cover bento-obj"
                style={imgStyle(card2)}
                loading="lazy"
              />
            </picture>
          )}
          <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-3 lg:bottom-10 lg:left-10 lg:right-10 lg:gap-4 max-w-md xl:bottom-auto xl:top-10 xl:max-w-[78%]">
            {card2.titleHtml
              ? <h3 class="text-h3 text-gray-900" set:html={card2.titleHtml} />
              : <h3 class="text-h3 text-gray-900">{card2.title}</h3>}
            {card2.description && (
              <p class="text-body-lg text-black/40">{card2.description}</p>
            )}
          </div>
        </div>

      </div>

      <!-- Правая колонка (xl+): один большой элемент. Текст снизу-слева до xl, сверху-слева на xl+ -->
      <div class="relative min-h-[400px] sm:min-h-[460px] md:min-h-[520px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl xl:min-h-0 xl:flex-1">
        {card3.backgroundImage && (
          <picture>
            {card3.backgroundImageMobile && (
              <source media="(max-width: 639px)" srcset={card3.backgroundImageMobile} />
            )}
            <img
              src={card3.backgroundImage}
              alt=""
              class="absolute inset-0 w-full h-full object-cover bento-obj"
              style={imgStyle(card3)}
              loading="lazy"
            />
          </picture>
        )}
        <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-3 lg:bottom-10 lg:left-10 lg:right-10 lg:gap-4 max-w-md xl:max-w-none xl:bottom-auto xl:top-10">
          {card3.titleHtml
            ? <h3 class="text-h3 text-gray-900" set:html={card3.titleHtml} />
            : <h3 class="text-h3 text-gray-900">{card3.title}</h3>}
          {card3.description && (
            <p class="text-body-lg text-black/40">{card3.description}</p>
          )}
        </div>
      </div>

    </div>
  )}

  <!--
    ═══ VARIANT FOUR ═══
    Две строки с разными пропорциями карточек, высота строк одинаковая (430px на lg+).
    Строка 1: широкая (≈62%) + узкая (≈38%)
    Строка 2: узкая (≈40%) + широкая (≈60%)
    Карточки поддерживают backgroundImage — растягивается на всю площадь карточки.
  -->
  {isFour && (
    <div class="flex flex-col gap-6">

      <!-- Строка 1 -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[62fr_38fr] lg:h-[430px]">

        <!-- Карточка 1: широкая, текст внизу-слева -->
        <div class="relative h-[350px] sm:h-[400px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl lg:h-auto">
          {card1.backgroundImage && (
            <picture>
              {card1.backgroundImageMobile && (
                <source media="(max-width: 639px)" srcset={card1.backgroundImageMobile} />
              )}
              <img
                src={card1.backgroundImage}
                alt=""
                class="absolute inset-0 w-full h-full object-cover bento-obj"
                style={imgStyle(card1)}
                loading="lazy"
              />
            </picture>
          )}
          <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-4 lg:bottom-10 lg:left-10 lg:right-10">
            {card1.titleHtml
              ? <h3 class="text-h3 text-gray-900" set:html={card1.titleHtml} />
              : <h3 class="text-h3 text-gray-900">{card1.title}</h3>
            }
            {card1.description && (
              <p class="text-body-lg text-black/40">{card1.description}</p>
            )}
          </div>
        </div>

        <!-- Карточка 2: узкая, текст внизу-слева -->
        <div class="relative h-[350px] sm:h-[400px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl lg:h-auto">
          {card2.backgroundImage && (
            <picture>
              {card2.backgroundImageMobile && (
                <source media="(max-width: 639px)" srcset={card2.backgroundImageMobile} />
              )}
              {card2.backgroundImageTablet && (
                <source media="(min-width: 640px) and (max-width: 1023px)" srcset={card2.backgroundImageTablet} />
              )}
              <img
                src={card2.backgroundImage}
                alt=""
                class="absolute inset-0 w-full h-full object-cover bento-obj"
                style={imgStyle(card2)}
                loading="lazy"
              />
            </picture>
          )}
          <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-4 lg:bottom-10 lg:left-10 lg:right-10">
            {card2.titleHtml
              ? <h3 class="text-h3 text-gray-900" set:html={card2.titleHtml} />
              : <h3 class="text-h3 text-gray-900">{card2.title}</h3>
            }
            {card2.description && (
              <p class="text-body-lg text-black/40">{card2.description}</p>
            )}
          </div>
        </div>

      </div>

      <!-- Строка 2 -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[40fr_60fr] lg:h-[430px]">

        <!-- Карточка 3: узкая, текст внизу-слева -->
        <div class="relative h-[350px] sm:h-[400px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl lg:h-auto">
          {card3.backgroundImage && (
            <picture>
              {card3.backgroundImageMobile && (
                <source media="(max-width: 639px)" srcset={card3.backgroundImageMobile} />
              )}
              <img
                src={card3.backgroundImage}
                alt=""
                class="absolute inset-0 w-full h-full object-cover bento-obj"
                style={imgStyle(card3)}
                loading="lazy"
              />
            </picture>
          )}
          <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-4 lg:bottom-10 lg:left-10 lg:right-10">
            {card3.titleHtml
              ? <h3 class="text-h3 text-gray-900" set:html={card3.titleHtml} />
              : <h3 class="text-h3 text-gray-900">{card3.title}</h3>
            }
            {card3.description && (
              <p class="text-body-lg text-black/40">{card3.description}</p>
            )}
          </div>
        </div>

        <!-- Карточка 4: широкая, текст внизу-слева -->
        <div class="relative h-[350px] sm:h-[400px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl lg:h-auto">
          {card4.backgroundImage && (
            <picture>
              {card4.backgroundImageMobile && (
                <source media="(max-width: 639px)" srcset={card4.backgroundImageMobile} />
              )}
              <img
                src={card4.backgroundImage}
                alt=""
                class="absolute inset-0 w-full h-full object-cover bento-obj"
                style={imgStyle(card4)}
                loading="lazy"
              />
            </picture>
          )}
          <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-4 lg:bottom-10 lg:left-10 lg:right-10">
            {card4.titleHtml
              ? <h3 class="text-h3 text-gray-900" set:html={card4.titleHtml} />
              : <h3 class="text-h3 text-gray-900">{card4.title}</h3>
            }
            {card4.description && (
              <p class="text-body-lg text-black/40">{card4.description}</p>
            )}
          </div>
        </div>

      </div>

    </div>
  )}

</section>
