---
/**
 * BentoGrid — секция с bento-раскладкой карточек
 *
 * Карточки в обоих вариантах поддерживают `backgroundImage` — растягивается на всю
 * площадь карточки через <img object-cover>. Текст лежит абсолютом поверх —
 * учитывай читаемость при подборе картинки.
 * Позиция фокуса управляется через `imagePosition` (CSS object-position, default: 'center').
 *
 * ## Вариант 'three' (по умолчанию)
 * xs–lg включительно: три карточки вертикальным стеком, текст всегда снизу-слева.
 * xl+: bento — слева стек из двух, справа большая. Позиции текста: card1 — верх-лево,
 *      card2 — низ-лево, card3 — верх-лево.
 *
 * @example variant='three'
 * ```astro
 * <BentoGrid
 *   heading="Другие причины выбрать ДВИЖ"
 *   items={[
 *     { title: "Выпуск подписи за 5 минут", description: "...", backgroundImage: "/img/sign.png" },
 *     { title: "Ускорим подачу заявления", description: "...", backgroundImage: "/img/gosuslugi.png" },
 *     { title: "Расчет вероятности одобрения", description: "...", backgroundImage: "/img/scoring.png" }
 *   ]}
 * />
 * ```
 *
 * ## Вариант 'four'
 * Две строки по две карточки с разными пропорциями:
 * - Строка 1: широкая (≈62%) + узкая (≈38%), текст внизу/вверху соответственно
 * - Строка 2: узкая (≈40%) + широкая (≈60%), текст внизу у обеих
 *
 * @example variant='four'
 * ```astro
 * <BentoGrid
 *   variant="four"
 *   items={[
 *     { title: "Распознавание", description: "Определяем тип документа автоматически", imagePosition: "top" },
 *     { title: "Дополняем профиль клиента", description: "Данные из ФНС, ГИБДД, БКИ" },
 *     { title: "Антифрод", description: "Ищем признаки мошенничества" },
 *     { title: "Верификация", description: "Проверяем документ на подлинность" },
 *   ]}
 * />
 * ```
 */

interface BentoItem {
  /** Заголовок карточки */
  title: string
  /** Подпись под заголовком */
  description?: string
  /**
   * URL фонового изображения на всю карточку.
   * Растягивается на весь размер карточки (object-fit: cover).
   */
  backgroundImage?: string
  /**
   * Позиция фокуса изображения. Значение CSS object-position.
   * Примеры: 'center' (по умолчанию), 'top', 'bottom', 'left', 'right', '50% 20%'
   */
  imagePosition?: string
}

interface Props {
  /** Вариант раскладки: 'three' — 3 карточки (по умолчанию), 'four' — 4 карточки в 2 строках */
  variant?: 'three' | 'four'
  /** Заголовок секции над сеткой */
  heading?: string
  /** Описание под заголовком (опционально) */
  description?: string
  /**
   * Карточки сетки.
   * variant='three': [0] верх-лево, [1] низ-лево, [2] большая справа.
   * variant='four':  [0] строка1-широкая, [1] строка1-узкая, [2] строка2-узкая, [3] строка2-широкая.
   */
  items: BentoItem[]
  /** Дополнительные CSS классы на секцию */
  class?: string
}

const { variant = 'three', heading, description, items, class: className = '' } = Astro.props

const card1 = items[0] ?? { title: '' }
const card2 = items[1] ?? { title: '' }
const card3 = items[2] ?? { title: '' }
const card4 = items[3] ?? { title: '' }

const isThree = variant === 'three'
const isFour = variant === 'four'
---

<section class:list={['flex flex-col gap-10 lg:gap-16', className]}>

  {heading && (
    <div class="flex flex-col gap-4">
      <h2 class="text-h2 text-gray-900">{heading}</h2>
      {description && (
        <p class="text-body-lg text-gray-600 max-w-3xl">{description}</p>
      )}
    </div>
  )}

  <!--
    ═══ VARIANT THREE ═══
    xs–lg (включая lg): все карточки вертикальным стеком, текст всегда снизу-слева.
    xl+: bento — две колонки, слева стек из двух карточек, справа большая;
         позиции текста: card1 — верх-лево, card2 — низ-лево, card3 — верх-лево.
  -->
  {isThree && (
    <div class="flex flex-col gap-6 xl:h-[738px] xl:flex-row">

      <!-- Левая колонка (xl+): два равных элемента -->
      <div class="flex flex-col gap-6 xl:flex-1">

        <!-- Карточка 1: текст снизу-слева до xl, сверху-слева на xl+ -->
        <div class="relative min-h-[350px] flex-1 overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl xl:min-h-0">
          {card1.backgroundImage && (
            <img
              src={card1.backgroundImage}
              alt=""
              class="absolute inset-0 w-full h-full object-cover"
              style={card1.imagePosition ? `object-position: ${card1.imagePosition}` : ''}
              loading="lazy"
            />
          )}
          <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-3 lg:bottom-10 lg:left-10 lg:right-10 lg:gap-4 xl:bottom-auto xl:top-10 xl:max-w-[48%]">
            <h3 class="text-h3 text-gray-900">{card1.title}</h3>
            {card1.description && (
              <p class="text-body-lg text-black/40">{card1.description}</p>
            )}
          </div>
        </div>

        <!-- Карточка 2: текст снизу-слева на всех брейкпойнтах -->
        <div class="relative min-h-[350px] flex-1 overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl xl:min-h-0">
          {card2.backgroundImage && (
            <img
              src={card2.backgroundImage}
              alt=""
              class="absolute inset-0 w-full h-full object-cover"
              style={card2.imagePosition ? `object-position: ${card2.imagePosition}` : ''}
              loading="lazy"
            />
          )}
          <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-3 lg:bottom-10 lg:left-10 lg:right-10 lg:gap-4 xl:max-w-[48%]">
            <h3 class="text-h3 text-gray-900">{card2.title}</h3>
            {card2.description && (
              <p class="text-body-lg text-black/40">{card2.description}</p>
            )}
          </div>
        </div>

      </div>

      <!-- Правая колонка (xl+): один большой элемент. Текст снизу-слева до xl, сверху-слева на xl+ -->
      <div class="relative min-h-[350px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl xl:min-h-0 xl:flex-1">
        {card3.backgroundImage && (
          <img
            src={card3.backgroundImage}
            alt=""
            class="absolute inset-0 w-full h-full object-cover"
            style={card3.imagePosition ? `object-position: ${card3.imagePosition}` : ''}
            loading="lazy"
          />
        )}
        <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-3 lg:bottom-10 lg:left-10 lg:right-10 lg:gap-4 xl:bottom-auto xl:top-10">
          <h3 class="text-h3 text-gray-900">{card3.title}</h3>
          {card3.description && (
            <p class="text-body-lg text-black/40">{card3.description}</p>
          )}
        </div>
      </div>

    </div>
  )}

  <!--
    ═══ VARIANT FOUR ═══
    Две строки с разными пропорциями карточек.
    Строка 1 (высокая): широкая (≈62%) + узкая (≈38%)
    Строка 2 (пониже):  узкая (≈40%) + широкая (≈60%)
    Карточки поддерживают backgroundImage — растягивается на всю площадь карточки.
  -->
  {isFour && (
    <div class="flex flex-col gap-6">

      <!-- Строка 1 -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[62fr_38fr] lg:h-[488px]">

        <!-- Карточка 1: широкая, текст внизу-слева -->
        <div class="relative h-[350px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl lg:h-auto">
          {card1.backgroundImage && (
            <img
              src={card1.backgroundImage}
              alt=""
              class="absolute inset-0 w-full h-full object-cover"
              style={card1.imagePosition ? `object-position: ${card1.imagePosition}` : ''}
              loading="lazy"
            />
          )}
          <div class="absolute bottom-6 left-6 flex flex-col gap-4 lg:bottom-10 lg:left-10">
            <h3 class="text-h3 text-gray-900">{card1.title}</h3>
            {card1.description && (
              <p class="text-body-lg text-black/40 max-w-[380px]">{card1.description}</p>
            )}
          </div>
        </div>

        <!-- Карточка 2: узкая, текст вверху-слева на десктопе / внизу-слева на мобайле -->
        <div class="relative h-[350px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl lg:h-auto">
          {card2.backgroundImage && (
            <img
              src={card2.backgroundImage}
              alt=""
              class="absolute inset-0 w-full h-full object-cover"
              style={card2.imagePosition ? `object-position: ${card2.imagePosition}` : ''}
              loading="lazy"
            />
          )}
          <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-4 lg:top-10 lg:bottom-auto lg:left-10 lg:right-10">
            <h3 class="text-h3 text-gray-900">{card2.title}</h3>
            {card2.description && (
              <p class="text-body-lg text-black/40">{card2.description}</p>
            )}
          </div>
        </div>

      </div>

      <!-- Строка 2 -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[40fr_60fr] lg:h-[360px]">

        <!-- Карточка 3: узкая, текст внизу-слева -->
        <div class="relative h-[350px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl lg:h-auto">
          {card3.backgroundImage && (
            <img
              src={card3.backgroundImage}
              alt=""
              class="absolute inset-0 w-full h-full object-cover"
              style={card3.imagePosition ? `object-position: ${card3.imagePosition}` : ''}
              loading="lazy"
            />
          )}
          <div class="absolute bottom-6 left-6 flex flex-col gap-4 lg:bottom-10 lg:left-10">
            <h3 class="text-h3 text-gray-900">{card3.title}</h3>
            {card3.description && (
              <p class="text-body-lg text-black/40">{card3.description}</p>
            )}
          </div>
        </div>

        <!-- Карточка 4: широкая, текст внизу-слева -->
        <div class="relative h-[350px] overflow-hidden rounded-2xl bg-background-secondary sm:rounded-3xl lg:h-auto">
          {card4.backgroundImage && (
            <img
              src={card4.backgroundImage}
              alt=""
              class="absolute inset-0 w-full h-full object-cover"
              style={card4.imagePosition ? `object-position: ${card4.imagePosition}` : ''}
              loading="lazy"
            />
          )}
          <div class="absolute bottom-6 left-6 flex flex-col gap-4 lg:bottom-10 lg:left-10">
            <h3 class="text-h3 text-gray-900">{card4.title}</h3>
            {card4.description && (
              <p class="text-body-lg text-black/40">{card4.description}</p>
            )}
          </div>
        </div>

      </div>

    </div>
  )}

</section>
