---
/**
 * Search — строка поиска блога/инсайтов
 *
 * Всегда на темном/цветном фоне — элементы белые.
 * Default: bg-white/20, без рамки.
 * Active (фокус): + border border-white.
 *
 * @example
 * ```astro
 * <Search placeholder="Ищите в инсайтах" name="q" />
 * ```
 */

interface Props {
  /** Текст-заглушка */
  placeholder?: string
  /** Имя поля для формы */
  name?: string
  /** action формы */
  action?: string
  /** Дополнительные CSS классы */
  class?: string
  /**
   * Адаптивная тема: белая при `clear` (прозрачный хедер вверху),
   * темная при `!clear` (фрост над белым телом). Требует родительского
   * Alpine-стейта `clear` (NavBar в transparent-режиме).
   */
  adaptive?: boolean
}

const {
  placeholder = 'Ищите в инсайтах',
  name = 'q',
  action = '/blog/search',
  class: className = '',
  adaptive = false,
} = Astro.props

// Адаптивные классы. Не-adaptive путь рендерит ровно прежний (белый) вид.
const labelBase = 'flex items-center gap-3 h-[38px] px-4 rounded-full transition-all duration-150 cursor-text'
const labelStatic = adaptive ? labelBase : `${labelBase} bg-white/20`
// Темная тема (!clear): фон gray-300, текст/иконка #1D1E21 (gray-900) @50%, бордер только в active.
const labelBind = adaptive
  ? "(clear ? 'bg-white/20 ' : 'bg-gray-300 ') + (active ? (clear ? 'border border-white' : 'border border-gray-900/50') : 'border border-transparent')"
  : "active ? 'border border-white' : 'border border-transparent'"

const inputStatic = adaptive
  ? 'search-input flex-1 min-w-0 bg-transparent text-subhead focus:outline-none'
  : 'search-input flex-1 min-w-0 bg-transparent text-subhead text-white placeholder:text-white/50 focus:outline-none'
// Набранный текст в темной теме — полный #1D1E21 (gray-900); плейсхолдер — @50%.
const inputBind = adaptive ? "clear ? 'text-white placeholder:text-white/50' : 'text-gray-900 placeholder:text-gray-900/50'" : null
// Цвет автозаполненного/выделенного текста (webkit-text-fill-color и ::selection) через CSS-переменную:
// темная тема (!clear) → #1D1E21, иначе белый (фолбэк).
const fgStyleBind = adaptive ? "!clear ? '--search-fg: #1D1E21' : ''" : null

const btnStatic = adaptive ? 'shrink-0 transition-colors' : 'shrink-0 text-white/70 hover:text-white transition-colors'
const btnBind = adaptive ? "clear ? 'text-white/70 hover:text-white' : 'text-gray-900/50'" : null
---

<form
  action={action}
  method="get"
  x-data="{ active: false }"
  class:list={['group relative', className]}
>
  <label class={labelStatic} :class={labelBind}>
    <input
      type="search"
      name={name}
      placeholder={placeholder}
      @focus="active = true"
      @blur="active = false"
      class={inputStatic}
      :class={inputBind}
      :style={fgStyleBind}
    />
    <button type="submit" class={btnStatic} :class={btnBind} aria-label="Найти">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
      </svg>
    </button>
  </label>
</form>

<style>
  /* Убрать нативный крестик очистки и декорации браузера */
  .search-input::-webkit-search-cancel-button,
  .search-input::-webkit-search-decoration,
  .search-input::-webkit-search-results-button,
  .search-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  /* Убрать синюю подсветку автозаполнения */
  .search-input:-webkit-autofill,
  .search-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 30px transparent inset !important;
    -webkit-text-fill-color: var(--search-fg, white) !important;
    transition: background-color 9999s ease-in-out 0s;
  }

  /* Цвет выделения текста: по умолчанию белый, в темной теме (--search-fg) — #1D1E21 */
  .search-input::selection {
    background: rgba(255, 255, 255, 0.25);
    color: var(--search-fg, white);
  }
</style>
