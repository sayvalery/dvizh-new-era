---
/**
 * ComparisonSection — блок сравнения «рынок vs ДВИЖ»
 *
 * ## Вариант 'default' (по умолчанию)
 * Две колонки:
 * - Левая (нейтральная, серая): иконка «минус», всегда один вид.
 * - Правая (темная): логотип/изображение вверху, иконка «чек», CTA снизу.
 *
 * На десктопе пункты выровнены построчно: каждая пара (левый/правый пункт)
 * занимает одну CSS Grid строку — высота ячейки определяется более высоким
 * содержимым. Это гарантирует выравнивание даже если текст занимает разное
 * количество строк.
 *
 * @example variant='default'
 * ```astro
 * <ComparisonSection
 *   label="В чем разница"
 *   title="Выбирайте лучшее"
 *   leftTitle="Самописные и рыночные решения"
 *   leftItems={[
 *     'Необходимо вручную поддерживать актуальность ставок',
 *     'Нельзя рассчитать комбо- и ипотеку с удорожанием стоимости',
 *   ]}
 *   rightItems={[
 *     'Ипотечные ставки обновляются автоматически',
 *     'Считает все виды ипотек: траншевую, комбо, с удорожанием',
 *   ]}
 *   primaryButtonText="Записаться на демо"
 *   secondaryButtonText="Попробовать бесплатно"
 * />
 * ```
 *
 * ## Вариант 'prices'
 * Ценовое сравнение: строки вида «название → цена».
 * - Левая карточка (серая): заголовок + строки цен с приглушенностью (opacity-60).
 * - Правая карточка (темная): логотип + строки цен (белый текст, опциональный тултип).
 * CTA-кнопок нет. Опционально: слот `cta` — рендерится под карточками с маленьким отступом.
 *
 * @example variant='prices'
 * ```astro
 * <ComparisonSection
 *   variant="prices"
 *   label="Стоимость"
 *   title="Дешевле на каждом этапе"
 *   leftTitle="Без ДВИЖа"
 *   priceRows={[
 *     { label: 'Регистрация', tooltip: 'Стоимость услуги сервиса', leftValue: 'от 1 700 ₽', rightValue: '1 000 ₽' },
 *     { label: 'Госпошлина', leftValue: '7%', rightValue: '200 ₽' },
 *   ]}
 * />
 * ```
 */

/** Строка ценового сравнения для variant='prices' */
interface PriceRow {
  /** Название параметра */
  label: string
  /** Текст подсказки (tooltip) для иконки-информации в правой карточке */
  tooltip?: string
  /** Значение в левой (серой) карточке */
  leftValue: string
  /** Значение в правой (темной) карточке */
  rightValue: string
}

interface Props {
  /** Вариант отображения: 'default' — пункты с иконками, 'prices' — строки цен, 'symmetric' — обе карточки одного цвета */
  variant?: 'default' | 'prices' | 'symmetric'
  /** Мелкая подпись-бейдж над заголовком */
  label?: string
  /** Главный заголовок секции */
  title?: string
  /** HTML-версия заголовка (для принудительных переносов `<br>`). Имеет приоритет над `title`. */
  titleHtml?: string
  /** Выравнивание заголовка секции: 'center' (по умолчанию) или 'left' */
  titleAlign?: 'center' | 'left'
  /** Заголовок левой карточки */
  leftTitle: string
  /** Заголовок правой карточки (только для variant='symmetric') */
  rightTitle?: string
  /** Пункты левой карточки (серые, с иконкой «минус») — только для variant='default' */
  leftItems?: string[]
  /** Пункты правой (темной) карточки (с иконкой «чек») — только для variant='default' */
  rightItems?: string[]
  /** Строки ценового сравнения — только для variant='prices' */
  priceRows?: PriceRow[]
  /** URL логотипа или изображения для правой карточки */
  rightLogoSrc?: string
  /** Alt-текст логотипа */
  rightLogoAlt?: string
  /** Текст основной CTA-кнопки — только для variant='default' */
  primaryButtonText?: string
  /** Пресет дровера для основной кнопки */
  primaryDrawerPreset?: 'demo' | 'lead' | 'research' | 'subscribe'
  /** Текст вторичной CTA-кнопки — только для variant='default' */
  secondaryButtonText?: string
  /** Пресет дровера для вторичной кнопки */
  secondaryDrawerPreset?: 'demo' | 'lead' | 'research' | 'subscribe'
  /** Дополнительные CSS классы */
  class?: string
}

import Button from './Button.astro'

const {
  variant = 'default',
  label = 'В чем разница',
  title = 'Выбирайте лучшее',
  titleHtml,
  titleAlign = 'center',
  leftTitle,
  rightTitle = '',
  leftItems = [],
  rightItems = [],
  priceRows = [],
  rightLogoSrc,
  rightLogoAlt = 'ДВИЖ',
  primaryButtonText = 'Записаться на демо',
  primaryDrawerPreset = 'demo',
  secondaryButtonText = 'Попробовать бесплатно',
  secondaryDrawerPreset = 'lead',
  class: className = '',
} = Astro.props

const isPrices = variant === 'prices'
const isSymmetric = variant === 'symmetric'

/**
 * Попарно объединяем пункты: каждый индекс — одна горизонтальная строка.
 * Если массивы разной длины, пустые ячейки заполняются null.
 * Используется только в variant='default'.
 */
const maxLen = Math.max(leftItems.length, rightItems.length)
const pairs = Array.from({ length: maxLen }, (_, i) => ({
  left:  (leftItems[i]  ?? null) as string | null,
  right: (rightItems[i] ?? null) as string | null,
}))
---

<section class:list={['bg-gray-100', className]}>
  <div class="page-container flex flex-col gap-16">

    <!-- Заголовок секции. Без заголовка блок не рендерится — иначе пустой
         flex-ребенок съедает gap-16 контейнера. -->
    {(titleHtml || title) && (
      <div class:list={['flex flex-col gap-5', titleAlign === 'left' ? 'items-start text-left' : 'items-center text-center']}>
        {titleHtml
          ? <h2 class="text-h1 font-medium text-gray-900" set:html={titleHtml} />
          : <h2 class="text-h1 font-medium text-gray-900">{title}</h2>
        }
      </div>
    )}

    <!--
      ═══ PRICES VARIANT ═══
      Адаптивный: на мобайле flex-col, на десктопе flex-row.
      justify-between на desktop — заголовок/лого вверху, строки цен внизу,
      что визуально выравнивает их между карточками.
    -->
    {isPrices && (
      <div class="flex flex-col lg:flex-row gap-6 lg:gap-10">

        <!-- Левая карточка (без ДВИЖа) — на мобайле второй -->
        <div class="bg-gray-200 rounded-2xl lg:rounded-3xl p-[2.125rem] flex flex-col gap-8 lg:flex-1 lg:justify-between lg:min-h-[18.75rem] order-2 lg:order-1">
          <h3 class="text-h3 text-gray-900">{leftTitle}</h3>
          <div class="border-t border-gray-300 pt-8 flex flex-col gap-6 opacity-60">
            {priceRows.map((row) => (
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-body-lg text-gray-900 leading-[1.3]">{row.label}</span>
                <span class="text-h3 text-gray-900 shrink-0 leading-none">{row.leftValue}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Правая карточка (ДВИЖ) — на мобайле первой -->
        <!-- bg #151517 → bg-gray-900 (#1D1E21), ближайший токен -->
        <div class="bg-gray-900 rounded-2xl lg:rounded-3xl p-[2.125rem] flex flex-col gap-8 lg:flex-1 lg:justify-between lg:min-h-[18.75rem] order-1 lg:order-2">

          <!-- Логотип -->
          <div class="h-[3.375rem] flex items-center">
            {rightLogoSrc ? (
              <img src={rightLogoSrc} alt={rightLogoAlt} class="h-full w-auto object-contain" />
            ) : (
              <div class="h-full w-[13.75rem] rounded-xl bg-white/10" role="img" aria-label={rightLogoAlt} />
            )}
          </div>

          <!-- Строки цен -->
          <div class="border-t border-white/15 pt-8 flex flex-col gap-6">
            {priceRows.map((row) => (
              <div class="flex items-baseline justify-between gap-4">
                <div class="flex items-center gap-1.5">
                  <span class="text-body-lg text-white leading-[1.3]">{row.label}</span>
                  {row.tooltip && (
                    <span x-data="{ open: false }" class="relative inline-flex shrink-0">
                      <button
                        type="button"
                        @mouseenter="open = true"
                        @mouseleave="open = false"
                        @focus="open = true"
                        @blur="open = false"
                        class="text-white/40 hover:text-white/70 transition-colors cursor-default"
                        aria-label={row.tooltip}
                      >
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5"/>
                          <path d="M8 7.5V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          <circle cx="8" cy="5.5" r="0.75" fill="currentColor"/>
                        </svg>
                      </button>
                      <div
                        x-show="open"
                        x-cloak
                        x-transition.opacity
                        class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 bg-gray-800 text-white text-footnote rounded-3xl px-3 py-2 pointer-events-none z-20 text-center"
                      >{row.tooltip}</div>
                    </span>
                  )}
                </div>
                <span class="text-h3 text-white shrink-0 leading-none">{row.rightValue}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    )}

    <!--
      ═══ MOBILE (< lg): простые стекированные карточки ═══
      Стандартный flex-col — пункты внутри каждой карточки независимы.
    -->
    {!isPrices && !isSymmetric && (
    <div class="flex flex-col gap-6 lg:hidden">

      <!-- Правая карточка (темная, «С ДВИЖем») — первой на мобайле -->
      <!-- Цвет фона в Figma: #131313 → используем bg-gray-900 (#1D1E21), ближайший токен -->
      <div class="bg-gray-900 rounded-2xl lg:rounded-3xl p-8 flex flex-col justify-between gap-10">
        <div class="flex flex-col gap-10">
          <div class="h-[3.375rem] flex items-center">
            {rightLogoSrc ? (
              <img src={rightLogoSrc} alt={rightLogoAlt} class="h-full w-auto object-contain" />
            ) : (
              <div class="h-full w-[13.75rem] rounded-xl bg-white/10" role="img" aria-label={rightLogoAlt} />
            )}
          </div>
          <div class="flex flex-col divide-y divide-white/15">
            {rightItems.map((text) => (
              <div class="flex gap-3 items-start py-5 first:pt-0 last:pb-0">
                <svg class="w-6 h-6 shrink-0 mt-0.5 text-white" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
                  <path d="M8.5 12l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <p class="text-body-lg text-white leading-[1.3]" set:html={text} />
              </div>
            ))}
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <Button variant="primary" drawerPreset={primaryDrawerPreset}>{primaryButtonText}</Button>
          {secondaryButtonText && <Button variant="ghost-dark" drawerPreset={secondaryDrawerPreset}>{secondaryButtonText}</Button>}
        </div>
      </div>

      <!-- Левая карточка (серая, «Без ДВИЖа») — второй на мобайле -->
      <div class="bg-gray-200 rounded-2xl lg:rounded-3xl p-8 flex flex-col gap-14">
        <div class="h-[3.375rem] flex items-center">
          <h3 class="text-h3 text-gray-900">{leftTitle}</h3>
        </div>
        <div class="flex flex-col divide-y divide-gray-300">
          {leftItems.map((text) => (
            <div class="flex gap-3 items-start py-5 first:pt-0 last:pb-0 opacity-60">
              <svg class="w-6 h-6 shrink-0 mt-0.5 text-gray-900" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
                <path d="M8 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
              <p class="text-body-lg text-gray-900 leading-[1.3]" set:html={text} />
            </div>
          ))}
        </div>
      </div>

    </div>
    )}

    <!--
      ═══ SYMMETRIC VARIANT (mobile) ═══
      Обе карточки одного цвета (bg-gray-200). Чек-иконки серые для обеих колонок.
      Слот right-icon — опциональная иконка в шапке правой карточки.
    -->
    {isSymmetric && (
    <div class="flex flex-col gap-6 lg:hidden">

      <!-- Правая карточка — первой на мобайле -->
      <div class="bg-gray-200 rounded-2xl lg:rounded-3xl p-8 flex flex-col gap-10">
        <div class="flex items-center gap-3 min-h-[3.375rem]">
          <slot name="right-icon" />
          {rightTitle && <h3 class="text-h3 text-gray-900">{rightTitle}</h3>}
        </div>
        <div class="flex flex-col divide-y divide-gray-300">
          {rightItems.map((text) => (
            <div class="flex gap-3 items-start py-5 first:pt-0 last:pb-0">
              <svg class="w-6 h-6 shrink-0 mt-0.5 text-gray-500" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
                <path d="M8.5 12l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <p class="text-body-lg text-gray-900 leading-[1.3]" set:html={text} />
            </div>
          ))}
        </div>
      </div>

      <!-- Левая карточка -->
      <div class="bg-gray-200 rounded-2xl lg:rounded-3xl p-8 flex flex-col gap-10">
        <div class="min-h-[3.375rem] flex items-center gap-3">
          <slot name="left-icon" />
          <h3 class="text-h3 text-gray-900">{leftTitle}</h3>
        </div>
        <div class="flex flex-col divide-y divide-gray-300">
          {leftItems.map((text) => (
            <div class="flex gap-3 items-start py-5 first:pt-0 last:pb-0">
              <svg class="w-6 h-6 shrink-0 mt-0.5 text-gray-500" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
                <path d="M8.5 12l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <p class="text-body-lg text-gray-900 leading-[1.3]" set:html={text} />
            </div>
          ))}
        </div>
      </div>

    </div>
    )}

    <!--
      ═══ DESKTOP (≥ lg): выровненная по строкам сетка ═══

      Принцип: фоновые карточки — абсолютно позиционированные декоративные
      блоки, не влияющие на сетку. Содержимое обеих колонок — прямые дочерние
      элементы одного CSS Grid контейнера с grid-cols-2.

      Каждая пара пунктов (левый[i] + правый[i]) попадает в одну grid-строку.
      CSS Grid автоматически выравнивает высоты ячеек в строке по максимуму —
      если один текст однострочный, а другой двухстрочный, оба занимают
      одинаковую высоту.
    -->
    {!isPrices && !isSymmetric && (
    <div class="hidden lg:grid lg:grid-cols-2 lg:gap-6 relative">

      <!--
        Декоративные фоны карточек.
        width: calc(50% - 0.75rem) = половина контейнера минус половина gap-6 (1.5rem).
        inset-y-0 растягивает их на полную высоту grid-контейнера.
      -->
      <div
        class="absolute inset-y-0 left-0 rounded-2xl lg:rounded-3xl bg-gray-200"
        style="width: calc(50% - 0.75rem)"
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-y-0 right-0 rounded-2xl lg:rounded-3xl bg-gray-900"
        style="width: calc(50% - 0.75rem)"
        aria-hidden="true"
      ></div>

      <!-- ── Строка 1: заголовок | логотип ── -->
      <div class="relative z-10 px-[2.125rem] pt-[2.125rem] pb-8">
        <div class="h-[3.375rem] flex items-center">
          <h3 class="text-h3 text-gray-900">{leftTitle}</h3>
        </div>
      </div>
      <div class="relative z-10 px-[2.125rem] pt-[2.125rem] pb-14 flex items-start">
        <div class="h-[3.375rem] flex items-center">
          {rightLogoSrc ? (
            <img src={rightLogoSrc} alt={rightLogoAlt} class="h-full w-auto object-contain" />
          ) : (
            <div class="h-full w-[13.75rem] rounded-xl bg-white/10" role="img" aria-label={rightLogoAlt} />
          )}
        </div>
      </div>

      <!-- ── Строки 2..N+1: попарные пункты ── -->
      {pairs.map((pair, i) => (
        <Fragment>
          <!-- Левая ячейка строки i -->
          <!-- Левая ячейка: flex items-center центрирует группу в строке -->
          <!-- border-t перенесен на внутренний блок, чтобы линия была вровень с контентом (учитывает px-[2.125rem]) -->
          <div class="relative z-10 px-[2.125rem] flex items-start opacity-60 pb-5">
            {pair.left && (
              <div class:list={[
                'flex gap-3 items-start w-full',
                i !== 0 && 'border-t border-gray-300 pt-5',
              ]}>
                <svg class="w-6 h-6 shrink-0 mt-0.5 text-gray-900" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
                  <path d="M8 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
                <p class="text-body-lg text-gray-900 leading-[1.3]" set:html={pair.left} />
              </div>
            )}
          </div>

          <!-- Правая ячейка: flex items-center центрирует группу в строке -->
          <!-- border-t перенесен на внутренний блок, чтобы линия была вровень с контентом (учитывает px-[2.125rem]) -->
          <div class="relative z-10 px-[2.125rem] flex items-start pb-5">
            {pair.right && (
              <div class:list={[
                'flex gap-3 items-start w-full',
                i !== 0 && 'border-t border-white/15 pt-5',
              ]}>
                <svg class="w-6 h-6 shrink-0 mt-0.5 text-white" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
                  <path d="M8.5 12l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <p class="text-body-lg text-white leading-[1.3]" set:html={pair.right} />
              </div>
            )}
          </div>
        </Fragment>
      ))}

      <!-- ── Строка N+2: кнопки (только правая колонка) ── -->
      <!--
        Пустая левая ячейка нужна для сохранения grid-строки.
        Высота строки = высота правой ячейки с кнопками.
        Левый фон через эту строку тоже продолжается — визуально левая карточка
        «дотягивается» до высоты правой, как в дизайне Figma.
      -->
      <div class="relative z-10 px-[2.125rem] pb-[2.125rem] pt-8"></div>
      <div class="relative z-10 px-[2.125rem] pb-[2.125rem] pt-8 flex flex-wrap gap-2">
        <Button variant="primary" drawerPreset={primaryDrawerPreset}>{primaryButtonText}</Button>
        {secondaryButtonText && <Button variant="ghost-dark" drawerPreset={secondaryDrawerPreset}>{secondaryButtonText}</Button>}
      </div>

    </div>
    )}

    <!--
      ═══ SYMMETRIC VARIANT (desktop ≥ lg) ═══
      Оба абсолютных фона bg-gray-200. Чек-иконки серые для обеих колонок.
    -->
    {isSymmetric && (
    <div class="hidden lg:grid lg:grid-cols-2 lg:gap-x-6 relative">

      <!-- Декоративные фоны — оба серые -->
      <div
        class="absolute inset-y-0 left-0 rounded-2xl lg:rounded-3xl bg-gray-200"
        style="width: calc(50% - 0.75rem)"
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-y-0 right-0 rounded-2xl lg:rounded-3xl bg-gray-200"
        style="width: calc(50% - 0.75rem)"
        aria-hidden="true"
      ></div>

      <!-- Строка 1: заголовки / иконка -->
      <div class="relative z-10 px-[2.125rem] pt-[2.125rem] pb-8">
        <div class="min-h-[3.375rem] flex items-center gap-3">
          <slot name="left-icon" />
          <h3 class="text-h3 text-gray-900">{leftTitle}</h3>
        </div>
      </div>
      <div class="relative z-10 px-[2.125rem] pt-[2.125rem] pb-8">
        <div class="min-h-[3.375rem] flex items-center gap-3">
          <slot name="right-icon" />
          {rightTitle && <h3 class="text-h3 text-gray-900">{rightTitle}</h3>}
        </div>
      </div>

      <!-- Строки 2..N+1: попарные пункты -->
      <!-- border-t на внешнем div → равный py-5 сверху и снизу, items-center вертикально центрирует -->
      {pairs.map((pair, i) => (
        <Fragment>
          <div class:list={['relative z-10 px-[2.125rem] flex items-center py-10', i !== 0 && 'border-t border-gray-300']}>
            {pair.left && (
              <div class="flex gap-3 items-center w-full">
                <svg class="w-6 h-6 shrink-0 text-gray-500" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
                  <path d="M8.5 12l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <p class="text-body-lg text-gray-900 leading-[1.3]">{pair.left}</p>
              </div>
            )}
          </div>
          <div class:list={['relative z-10 px-[2.125rem] flex items-center py-10', i !== 0 && 'border-t border-gray-300']}>
            {pair.right && (
              <div class="flex gap-3 items-center w-full">
                <svg class="w-6 h-6 shrink-0 text-gray-500" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
                  <path d="M8.5 12l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <p class="text-body-lg text-gray-900 leading-[1.3]">{pair.right}</p>
              </div>
            )}
          </div>
        </Fragment>
      ))}

      <!-- Нижний отступ -->
      <div class="relative z-10 px-[2.125rem] pb-[2.125rem] pt-8"></div>
      <div class="relative z-10 px-[2.125rem] pb-[2.125rem] pt-8"></div>

    </div>
    )}

  </div>

  {Astro.slots.has('cta') && (
    <div class="page-container mt-6 lg:mt-10">
      <slot name="cta" />
    </div>
  )}

</section>
