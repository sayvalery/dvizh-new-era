                  <Fragment>
                    <p class={statValueClass(s.highlight, c4.variant)}>{s.value}</p>
                    <p class:list={['text-body-lg', statLabelColor(c4.variant)]}>{s.label}</p>
                  </Fragment>
                ) : (
