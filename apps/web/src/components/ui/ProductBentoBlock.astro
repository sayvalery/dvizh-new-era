            </div>
            {c5.stats && c5.stats.length > 0 && (
              <div class:list={['flex flex-wrap', c5.statsLayout === 'inline' ? 'gap-3 items-baseline' : 'gap-6 lg:gap-10']}>
                {c5.stats.map(s => c5.statsLayout === 'inline' ? (
                  <Fragment>
                    <p class={statValueClass(s.highlight, c5.variant)}>{s.value}</p>
                    <p class:list={['text-body-lg', statLabelColor(c5.variant)]}>{s.label}</p>
