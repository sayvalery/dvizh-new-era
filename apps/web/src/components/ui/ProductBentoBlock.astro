            <p class:list={['text-body-lg', descColor(c4.variant)]}>{c4.description}</p>
            {c4.stats && c4.stats.length > 0 && (
              <div class:list={['flex flex-wrap mt-2', c4.statsLayout === 'inline' ? 'gap-3 items-baseline' : 'gap-6 lg:gap-10']}>
