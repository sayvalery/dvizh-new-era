---
/**
 * MegaMenu — компактный дропдаун навигации (desktop).
 *
 * Управляется снаружи через x-show в NavBar — позиционируется absolute
 * под конкретным пунктом, не на всю ширину.
 * Лейаут: список ссылок раздела + одна небольшая карточка блога (~ширина одной из трёх).
 * Скругление rounded-2xl — как у острова навбара (по системе).
 */

import BlogCard from './BlogCard.astro'

export interface NavChild {
  label: string
  href: string
  description?: string
}

export interface NavSection {
  title: string
  items: NavChild[]
}

interface BlogPost {
  title: string
  slug: string
  cover?: { url?: string; alt?: string }
  category?: string
}

interface Props {
  sections: NavSection[]
  blogPosts?: BlogPost[]
}

const { sections, blogPosts = [] } = Astro.props

const section = sections[0]
const post = blogPosts[0]
---

<div class="flex gap-6 w-max bg-background-primary border border-gray-200 rounded-2xl shadow-xl p-6">

  {/* Пункты раздела — одна широкая колонка */}
  {section && (
    <ul class="flex flex-col gap-0.5 w-[360px]">
      {section.items.map(child => (
        <li>
          <a
            href={child.href}
            class="block whitespace-nowrap px-3 py-2 text-subhead text-gray-700 rounded-lg hover:bg-background-secondary hover:text-gray-900 transition-colors"
          >
            {child.label}
          </a>
        </li>
      ))}
    </ul>
  )}

  {/* Полноразмерная карточка последней статьи */}
  {post && (
    <div class="w-[360px] border-l border-gray-100 pl-6">
      <BlogCard
        title={post.title}
        slug={post.slug}
        cover={post.cover}
        category={post.category}
        size="md"
      />
    </div>
  )}

</div>
