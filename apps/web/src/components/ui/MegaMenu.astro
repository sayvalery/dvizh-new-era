---
/**
 * MegaMenu — мега-дропдаун навигации
 *
 * Используется внутри NavBar.astro. Управляется родительским x-data
 * (megaOpen, hoverTimeout) — компонент только рендерит панель.
 *
 * Props:
 *   sections   → массив секций (Продукты, Решения, Для кого)
 *   blogPosts  → 2 поста для правой колонки
 *
 * Hover-поведение остаётся на родителе (NavBar обёртывает всё в hover-зону).
 */

import BlogCard from './BlogCard.astro'

export interface NavChild {
  label: string
  href: string
  description?: string
}

export interface NavSection {
  title: string
  items: NavChild[]
}

interface BlogPost {
  title: string
  slug: string
  cover?: { url?: string; alt?: string }
  category?: string
}

interface Props {
  sections: NavSection[]
  blogPosts?: BlogPost[]
}

const { sections, blogPosts = [] } = Astro.props
---

<div
  x-cloak
  x-show="megaOpen"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0 -translate-y-1"
  x-transition:enter-end="opacity-100 translate-y-0"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100 translate-y-0"
  x-transition:leave-end="opacity-0 -translate-y-1"
  class="border-t border-gray-100 bg-background-primary rounded-b-3xl overflow-hidden"
>
  <div class="mx-auto max-w-[1440px] p-10">
    <div class="grid grid-cols-4 gap-10">
      {sections.map(section => (
        <div class="flex flex-col gap-4">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-[1px]">{section.title}</p>
          <ul class="flex flex-col gap-3">
            {section.items.map(child => (
              <li>
                <a href={child.href} class="flex flex-col gap-[3px] p-2 rounded-md hover:bg-background-secondary transition-colors">
                  <span class="text-subhead text-gray-700">{child.label}</span>
                  {child.description && (
                    <span class="text-footnote text-gray-400">{child.description}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      {blogPosts.length > 0 && (
        <div class="flex flex-col gap-4">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-[1px]">Блог</p>
          <div class="flex flex-col gap-3">
            {blogPosts.map(post => (
              <BlogCard
                title={post.title}
                slug={post.slug}
                cover={post.cover}
                category={post.category}
                class="border-0 shadow-none hover:shadow-none"
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</div>
