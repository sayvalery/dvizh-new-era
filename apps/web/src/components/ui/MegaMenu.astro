---
/**
 * MegaMenu — дропдаун навигации (desktop).
 *
 * Управляется снаружи через showExpression (Alpine x-show).
 * Лейаут: 2 колонки — данные (sections[0]) + блог.
 * Пункты без описаний, gap-1.5 между ними.
 */

import BlogCard from './BlogCard.astro'

export interface NavChild {
  label: string
  href: string
  description?: string
}

export interface NavSection {
  title: string
  items: NavChild[]
}

interface BlogPost {
  title: string
  slug: string
  cover?: { url?: string; alt?: string }
  category?: string
}

interface Props {
  sections: NavSection[]
  blogPosts?: BlogPost[]
}

const { sections, blogPosts = [] } = Astro.props

const section = sections[0]
---

<div>
  <div class="mx-auto max-w-[1440px] p-10">
    <div class="grid grid-cols-2 gap-10">

      {/* Левая колонка: пункты раздела */}
      {section && (
        <div class="flex flex-col gap-4">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-[1px]">{section.title}</p>
          <ul class="flex flex-col gap-1.5">
            {section.items.map(child => (
              <li>
                <a
                  href={child.href}
                  class="block p-2 text-subhead text-gray-700 rounded-md hover:bg-background-secondary transition-colors"
                >
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* Правая колонка: блог */}
      {blogPosts.length > 0 && (
        <div class="flex flex-col gap-4">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-[1px]">Блог</p>
          <div class="flex flex-col gap-3">
            {blogPosts.map(post => (
              <BlogCard
                title={post.title}
                slug={post.slug}
                cover={post.cover}
                category={post.category}
                class="border-0 shadow-none hover:shadow-none"
              />
            ))}
          </div>
        </div>
      )}

    </div>
  </div>
</div>
