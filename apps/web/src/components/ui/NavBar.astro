---
/**
 * NavBar — навигационная шапка-островок
 *
 * Используется в:
 *   Header.astro    → основной сайт (мега-меню, CTA, блог-карточки)
 *   BlogLayout.astro → ДВИЖ Инсайты (только лого + плоские ссылки + secondaryLink)
 *
 * Дизайн: плавающий «островок» со скруглёнными краями, margin-top, внутренним padding.
 * На белых страницах — белый на белом (невидим). На градиенте — полупрозрачный с blur.
 *
 * Прозрачный режим (transparent=true):
 *   clear = transparent && !megaOpen && !mobileOpen
 *   clear: островок полупрозрачный, белый текст/лого
 *   !clear: белый фон до верха страницы, стандартные цвета
 *
 * Мега-меню остаётся открытым пока курсор внутри всего хедера (nav + dropdown).
 */

import BlogCard from './BlogCard.astro'
import Button from './Button.astro'
import MegaMenu from './MegaMenu.astro'
import MenuPosts from './MenuPosts.astro'
import Search from './Search.astro'

export interface NavChild {
  label: string
  href: string
  description?: string
}

export interface NavSection {
  title: string
  items: NavChild[]
}

export interface MenuPost {
  title: string
  slug: string
  cover?: any
}

export interface NavItem {
  label: string
  href?: string
  children?: NavChild[]
  sections?: NavSection[]
  /** Выпадашка с 3 горизонтальными карточками (Блог, Кейсы) */
  posts?: MenuPost[]
  /** Закреплённая статья в правой карточке мегаменю (иначе — общий blogPosts) */
  featuredPost?: BlogPost
  badge?: 'dot'
}

interface BlogPost {
  title: string
  slug: string
  cover?: { url?: string; alt?: string }
  category?: string
}

interface Props {
  logo: { label: string; href: string; image?: string; imageLight?: string; lightFilter?: boolean }
  items?: NavItem[]
  blogPosts?: BlogPost[]
  secondaryLink?: { label: string; href: string; arrow?: 'left' }
  cta?: { label: string; preset?: string; href?: string }
  transparent?: boolean
  /** Вариант: default — основной сайт, blog — блог/инсайты (белые элементы + поиск) */
  variant?: 'default' | 'blog'
  /**
   * Инвертировать триггер «clear» (белая версия): по умолчанию белый ВВЕРХУ
   * (lastY < threshold). При invertClear=true — наоборот: тёмный вверху, белый
   * ПОСЛЕ скролла (lastY >= threshold). Для страниц со светлой шапкой над цветным блоком.
   */
  invertClear?: boolean
  /** Кастомный порог переключения clear (px). По умолчанию 450 (24 для blog). */
  clearAt?: number
}

const { logo, items = [], blogPosts = [], secondaryLink, cta, transparent = false, variant = 'default', invertClear = false, clearAt } = Astro.props
const isBlog = variant === 'blog'

// Порог переключения «прозрачная → фрост» версии (lastY < threshold = прозрачная).
// Блог-герой маленький (оранжевая полоса под хедером), поэтому переключаемся почти сразу;
// на обычных transparent-страницах (главная) — после высокого hero.
const clearThreshold = clearAt ?? (isBlog ? 24 : 450)
// Сравнение для clear: обычно белый вверху (<), при invertClear — белый после скролла (>=).
const clearCmp = invertClear ? '>=' : '<'

// ── Анти-FOUC: серверный начальный цвет ──
// Getter `clear` при lastY=0 и mobileOpen=false:
//   invertClear=false → clear = transparent && (0 < threshold)  = transparent
//   invertClear=true  → clear = transparent && (0 >= threshold) = false (threshold всегда > 0)
// Этот же класс кладём в статический `class`, чтобы SSR-рендер сразу был верным цветом
// (белый на цветном hero / тёмный на светлых страницах) — без скачка чёрный→белый после JS.
// Alpine-:class (object-синтаксис) затем чисто переключает цвета при скролле/состоянии.
const initialClear = transparent && !invertClear

// Фон острова. Вверху страницы — пусто (нет холостой подложки), фрост появляется при скролле:
//  - transparent (главная) — фрост привязан к clear (вверху прозрачно, при скролле фрост);
//  - blog непрозрачный (текущий прод /blog) — bg-white/20 по lastY;
//  - default непрозрачный (продуктовые страницы) — фрост ТОЛЬКО при скролле, вверху пусто.
const frostIsland = 'bg-background-primary/60 backdrop-blur-lg shadow-[inset_1px_2px_2px_rgba(255,255,255,0.3)]'
const navIslandClass = transparent
  ? `clear ? '' : '${frostIsland}'`
  : isBlog
    ? "lastY > 20 ? 'bg-white/20 backdrop-blur-[10px]' : ''"
    : `lastY > 20 ? '${frostIsland}' : ''`
---

<header
  x-data={`{
    mobileOpen: false,
    megaOpen: null,
    openMenu: null,
    menuTimeout: null,
    hoverTimeout: null,
    settleTimer: null,
    lastY: 0,
    hidden: false,
    get clear() { return ${transparent} && !this.mobileOpen && this.lastY ${clearCmp} ${clearThreshold} },
    get floatingIsland() { return ${transparent} && !this.clear && !this.mobileOpen },
    onScroll() {
      const y = window.scrollY;
      if (y < 100) { this.hidden = false }
      else if (y < this.lastY - 5) { this.hidden = false }
      else if (y > this.lastY + 5) { this.hidden = true }
      this.lastY = y;
      // throttle роняет trailing-событие — дочитываем финальную позицию после остановки,
      // иначе lastY застревает выше порога и clear не возвращается в true у самого верха
      clearTimeout(this.settleTimer);
      this.settleTimer = setTimeout(() => { this.lastY = window.scrollY }, 120);
    }
  }`}
  x-init="lastY = window.scrollY"
  @scroll.window.throttle.100ms="onScroll()"
  class:list={[isBlog ? 'sticky top-0' : transparent ? 'fixed top-0 left-0 right-0' : 'sticky top-0']}
  :class="{
    '-translate-y-full': hidden && !mobileOpen && !megaOpen && !openMenu,
    'z-50': openMenu || megaOpen || mobileOpen,
    'z-40': !openMenu && !megaOpen && !mobileOpen
  }"
  class="transition-transform duration-300"
>
  <!-- Gradient blur backdrop for transparent mode: two layers. -->
  <!-- Начальный display = initialClear (анти-FOUC): на светлых страницах не мигает блюром вверху. -->
  <div x-show="clear" x-transition.opacity.duration.300ms class="nav-blur-fade" style={initialClear ? undefined : 'display:none'}></div>
  <div x-show="clear" x-transition.opacity.duration.300ms class="nav-blur-fade nav-blur-strong" style={initialClear ? undefined : 'display:none'}></div>

  <!-- Hover zone: keeps mega menu open while cursor is inside header area -->
  <div
    @mouseenter="if (megaOpen) clearTimeout(hoverTimeout)"
    @mouseleave="hoverTimeout = setTimeout(() => megaOpen = null, 200)"
    class="bg-transparent transition-colors duration-200"
  >
    <!-- Island wrapper: горизонтальные паддинги = боковым отступам страницы (.page-container 16/24/40). -->
    <!-- Единые гаттеры для всех вариантов (сайт = блог) → лого/кнопка совпадают с краями контента, хэдер не «скачет» при переходе сайт↔блог. -->
    <div class:list={['max-w-[1440px] mx-auto pt-3 pb-2', 'px-4 sm:px-6 lg:px-10']}>
      <nav
        class:list={['flex items-center justify-between h-14 rounded-2xl transition-all duration-200', '-mx-4 px-4 sm:-mx-6 sm:px-6']}
        :class={navIslandClass}
      >
        <!-- Left: logo + desktop nav -->
        <div class="flex items-center gap-6">
          <a href={logo.href} class="flex-shrink-0">
            {logo.image && logo.imageLight && transparent ? (
              /* Две версии лого. SSR-видимость задаётся initialClear (через inline display),
                 чтобы изначально показывалась нужная версия без скачка; Alpine переключает при скролле. */
              <>
                <img src={logo.image} alt={logo.label} class="h-7 w-auto" x-show="!clear" style={initialClear ? 'display:none' : undefined} />
                <img src={logo.imageLight} alt={logo.label} class:list={['h-7 w-auto', logo.lightFilter && 'brightness-0 invert']} x-show="clear" style={initialClear ? undefined : 'display:none'} />
              </>
            ) : logo.image ? (
              <img src={logo.image} alt={logo.label} class="h-7 w-auto" />
            ) : (
              <span class="font-bold text-xl">{logo.label}</span>
            )}
          </a>

          {/* Поиск — только blog-вариант, lg+. Временно скрыт. */}
          {/* {isBlog && (
            <Search class="hidden lg:block w-60" action="/blog/search" adaptive={transparent} />
          )} */}

          <div class="hidden lg:flex lg:gap-x-1">
            {items.map(item => (
              item.posts?.length ? (
                /* === POSTS DROPDOWN (Блог / Кейсы) — клик ведёт на страницу, ховер/фокус открывает === */
                <div
                  class="relative h-full flex items-center"
                  @mouseenter={`clearTimeout(hoverTimeout); megaOpen = '${item.label}'`}
                  @focusin={`clearTimeout(hoverTimeout); megaOpen = '${item.label}'`}
                  @keydown.escape={`megaOpen = null; $el.querySelector('a')?.focus()`}
                  @focusout={`if (!$el.contains($event.relatedTarget)) megaOpen = (megaOpen === '${item.label}' ? null : megaOpen)`}
                >
                  <a
                    href={item.href}
                    aria-haspopup="true"
                    :aria-expanded={`megaOpen === '${item.label}' ? 'true' : 'false'`}
                    class:list={['inline-flex items-center gap-1 px-3 py-2 text-subhead rounded-md transition-colors', initialClear ? 'text-white' : 'text-gray-700']}
                    :class={`{
                      'text-white hover:bg-white/10': clear,
                      'bg-white/10': clear && megaOpen === '${item.label}',
                      'text-gray-700 hover:bg-gray-100': !clear,
                      'bg-gray-100': !clear && megaOpen === '${item.label}'
                    }`}
                  >
                    {item.label}
                    {item.badge === 'dot' && (
                      <span
                        class:list={['w-1.5 h-1.5 rounded-full flex-shrink-0 transition-colors', initialClear ? 'bg-white' : 'bg-brand']}
                        :class={`{ 'bg-white': clear, 'bg-brand': !clear }`}
                      />
                    )}
                  </a>
                  <div
                    x-cloak
                    x-show={`megaOpen === '${item.label}'`}
                    x-transition:enter="transition-[clip-path,opacity] ease-[cubic-bezier(0.16,1,0.3,1)] duration-[400ms]"
                    x-transition:enter-start="opacity-0 [clip-path:inset(0_-48px_40%_-48px)]"
                    x-transition:enter-end="opacity-100 [clip-path:inset(-48px_-48px_-48px_-48px)]"
                    x-transition:leave="transition-[clip-path,opacity] ease-in duration-[50ms]"
                    x-transition:leave-start="opacity-100 [clip-path:inset(-48px_-48px_-48px_-48px)]"
                    x-transition:leave-end="opacity-0 [clip-path:inset(0_-48px_40%_-48px)]"
                    class="absolute top-full left-0 pt-2 z-50"
                  >
                    <MenuPosts posts={item.posts ?? []} />
                  </div>
                </div>
              ) : item.sections?.length ? (
                /* === MEGA MENU (компактный дропдаун под пунктом) === */
                <div
                  class="relative h-full flex items-center"
                  @mouseenter={`clearTimeout(hoverTimeout); megaOpen = '${item.label}'`}
                  @keydown.escape={`megaOpen = null; $el.querySelector('button')?.focus()`}
                  @focusout={`if (!$el.contains($event.relatedTarget)) megaOpen = (megaOpen === '${item.label}' ? null : megaOpen)`}
                >
                  <button
                    type="button"
                    @click={`clearTimeout(hoverTimeout); megaOpen = (megaOpen === '${item.label}' ? null : '${item.label}')`}
                    aria-haspopup="true"
                    :aria-expanded={`megaOpen === '${item.label}' ? 'true' : 'false'`}
                    class:list={['flex items-center gap-1 px-3 py-2 text-subhead rounded-md transition-colors', initialClear ? 'text-white' : 'text-gray-700']}
                    :class={`{
                      'text-white hover:bg-white/10': clear,
                      'bg-white/10': clear && megaOpen === '${item.label}',
                      'text-gray-700 hover:bg-gray-100': !clear,
                      'bg-gray-100': !clear && megaOpen === '${item.label}'
                    }`}
                  >
                    {item.label}
                    <svg class="w-3.5 h-3.5 transition-transform" :class={`megaOpen === '${item.label}' && 'rotate-180'`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div
                    x-cloak
                    x-show={`megaOpen === '${item.label}'`}
                    x-transition:enter="transition-[clip-path,opacity] ease-[cubic-bezier(0.16,1,0.3,1)] duration-[400ms]"
                    x-transition:enter-start="opacity-0 [clip-path:inset(0_-48px_40%_-48px)]"
                    x-transition:enter-end="opacity-100 [clip-path:inset(-48px_-48px_-48px_-48px)]"
                    x-transition:leave="transition-[clip-path,opacity] ease-in duration-[50ms]"
                    x-transition:leave-start="opacity-100 [clip-path:inset(-48px_-48px_-48px_-48px)]"
                    x-transition:leave-end="opacity-0 [clip-path:inset(0_-48px_40%_-48px)]"
                    class="absolute top-full left-0 pt-2 z-50"
                  >
                    <MegaMenu sections={item.sections ?? []} blogPosts={item.featuredPost ? [item.featuredPost] : blogPosts} />
                  </div>
                </div>
              ) : item.children?.length ? (
                /* === SIMPLE DROPDOWN === */
                <div
                  class="relative h-full flex items-center"
                  @mouseenter={`clearTimeout(menuTimeout); openMenu = '${item.label}'`}
                  @mouseleave={`menuTimeout = setTimeout(() => openMenu = null, 150)`}
                  @keydown.escape={`openMenu = null; $el.querySelector('button')?.focus()`}
                  @focusout={`if (!$el.contains($event.relatedTarget)) openMenu = (openMenu === '${item.label}' ? null : openMenu)`}
                >
                  <button
                    type="button"
                    @click={`clearTimeout(menuTimeout); openMenu = (openMenu === '${item.label}' ? null : '${item.label}')`}
                    aria-haspopup="true"
                    :aria-expanded={`openMenu === '${item.label}' ? 'true' : 'false'`}
                    class:list={['flex items-center gap-1 px-3 py-2 text-subhead rounded-md transition-colors', initialClear ? 'text-white' : 'text-gray-700']}
                    :class={`{ 'text-white hover:bg-white/10': clear, 'text-gray-700 hover:bg-gray-100': !clear }`}
                  >
                    {item.label}
                    <svg
                      class="w-3.5 h-3.5 transition-transform"
                      :class={`openMenu === '${item.label}' ? 'rotate-180' : ''`}
                      fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div
                    x-cloak
                    x-show={`openMenu === '${item.label}'`}
                    x-transition:enter="transition ease-out duration-150"
                    x-transition:enter-start="opacity-0 -translate-y-1"
                    x-transition:enter-end="opacity-100 translate-y-0"
                    x-transition:leave="transition ease-in duration-100"
                    x-transition:leave-start="opacity-100 translate-y-0"
                    x-transition:leave-end="opacity-0 -translate-y-1"
                    class="absolute top-full left-0 pt-1 z-50"
                  >
                    <div class="bg-background-primary border border-gray-200 rounded-xl shadow-lg py-2 min-w-52">
                      {item.children.map(child => (
                        <a href={child.href} class="block px-4 py-2 text-sm text-gray-700 hover:bg-background-secondary hover:text-gray-900">
                          {child.label}
                          {child.description && (
                            <span class="block text-xs text-gray-400 mt-0.5">{child.description}</span>
                          )}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                /* === FLAT LINK === */
                <a
                  href={item.href}
                  class:list={['inline-flex items-center gap-1 px-3 py-2 text-subhead rounded-md transition-colors', initialClear ? 'text-white' : 'text-gray-700']}
                  :class={`{ 'text-white hover:bg-white/10': clear, 'text-gray-700 hover:bg-gray-100': !clear }`}
                >
                  {item.label}
                  {item.badge === 'dot' && (
                    <span
                      class:list={['w-1.5 h-1.5 rounded-full flex-shrink-0 transition-colors', initialClear ? 'bg-white' : 'bg-brand']}
                      :class={`{ 'bg-white': clear, 'bg-brand': !clear }`}
                    />
                  )}
                </a>
              )
            ))}
          </div>
        </div>

        <!-- Right: phone + CTA + hamburger -->
        <div class="flex items-center gap-2 sm:gap-3">

          <!-- Phone: xs+ only (hidden below xs) -->
          {secondaryLink && (
            <a
              href={secondaryLink.href}
              class:list={['hidden sm:inline-flex items-center gap-1.5 text-subhead opacity-80 transition-colors group', initialClear ? 'text-white' : 'text-gray-500']}
              :class={`{ 'text-white hover:text-white/70': clear, 'text-gray-500 hover:text-gray-900': !clear }`}
            >
              {secondaryLink.arrow === 'left' && (
                <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 7H2M6 3L2 7l4 4" />
                </svg>
              )}
              {secondaryLink.label}
            </a>
          )}

          <!-- CTA blog (transparent/insights): dark-кнопка из UI-кита, инверсия в белую при clear -->
          {cta && isBlog && transparent && (
            <Button
              href={cta.href ?? '/contacts'}
              variant="dark"
              size="sm"
              class={`hidden sm:inline-flex${initialClear ? ' !bg-white !text-gray-900 hover:!bg-white/90' : ''}`}
              x-bind:class={`{ '!bg-white !text-gray-900 hover:!bg-white/90': clear }`}
            >{cta.label}</Button>
          )}

          <!-- CTA blog (непрозрачный, прод /blog): прежняя белая кнопка -->
          {cta && isBlog && !transparent && (
            <a
              href={cta.href ?? '/contacts'}
              class="hidden sm:inline-flex items-center h-9 px-4 bg-white text-gray-900 text-btn font-semibold rounded-lg whitespace-nowrap hover:bg-white/90 transition-colors"
            >{cta.label}</a>
          )}

          <!-- CTA text button: xs+ to lg (hidden below xs and on lg+ handled separately) -->
          {cta && !isBlog && (
            <Button
              variant="dark"
              size="sm"
              drawerPreset={cta.preset ?? 'demo'}
              class={`hidden sm:inline-flex lg:hidden${initialClear ? ' !bg-white !text-gray-900 hover:!bg-white/90' : ''}`}
              x-bind:class={`{ '!bg-white !text-gray-900 hover:!bg-white/90': clear }`}
            >{cta.label}</Button>
          )}

          <!-- CTA text button: lg+ desktop -->
          {cta && !isBlog && (
            <Button
              variant="dark"
              size="sm"
              drawerPreset={cta.preset ?? 'demo'}
              class={`hidden lg:inline-flex${initialClear ? ' !bg-white !text-gray-900 hover:!bg-white/90' : ''}`}
              x-bind:class={`{ '!bg-white !text-gray-900 hover:!bg-white/90': clear }`}
            >{cta.label}</Button>
          )}

          <!-- Hamburger square button: visible below lg. Вариант и clear-инверсия идентичны CTA-кнопке слева. -->
          <Button
            type="button"
            iconOnly
            size="sm"
            variant="dark"
            @click="mobileOpen = true"
            x-bind:class={`{ '!bg-white !text-gray-900 hover:!bg-white/90': clear }`}
            class={`lg:hidden flex-shrink-0${initialClear ? ' !bg-white !text-gray-900 hover:!bg-white/90' : ''}`}
            aria-label="Открыть меню"
          >
            <svg slot="icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </Button>

        </div>
      </nav>
    </div>

  </div>

  <!-- Mobile menu overlay -->
  <div
    x-cloak
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-50 lg:hidden"
  >
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-black/10" @click="mobileOpen = false"></div>

    <!-- Panel -->
    <div
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="-translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="-translate-x-full"
      class="fixed inset-y-0 left-0 w-full flex flex-col bg-background-primary"
    >
      <!-- Scrollable content -->
      <div class="flex-1 overflow-y-auto px-8 pt-3 pb-4">

        <!-- Header: logo LEFT | ✕ RIGHT — высота h-14 как в navbar island -->
        <div class="flex items-center justify-between h-14 mb-6">
          <a href={logo.href} class="flex-shrink-0" @click="mobileOpen = false">
            {logo.image ? (
              <img src={logo.image} alt={logo.label} class="h-7 w-auto" />
            ) : (
              <span class="font-bold text-xl">{logo.label}</span>
            )}
          </a>
          <button
            type="button"
            @click="mobileOpen = false"
            class="p-2 rounded-lg text-gray-500 hover:bg-background-secondary transition-colors"
            aria-label="Закрыть меню"
          >
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Nav sections -->
        <nav class="flex flex-col gap-5">
          {items.map(item => (
            item.sections?.length ? (
              item.sections.map(section => (
                <div>
                  <p class="text-side-menu text-gray-400 mb-1">
                    {section.title}
                  </p>
                  {section.items.map(child => (
                    <a
                      href={child.href}
                      @click="mobileOpen = false"
                      class="block py-2.5 text-body-lg text-gray-900 hover:text-brand transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              ))
            ) : item.children?.length ? (
              <div>
                <p class="text-side-menu text-gray-400 mb-1">
                  {item.label}
                </p>
                {item.children.map(child => (
                  <a
                    href={child.href}
                    @click="mobileOpen = false"
                    class="block py-2.5 text-body-lg text-gray-900 hover:text-brand transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            ) : (
              <a
                href={item.href}
                @click="mobileOpen = false"
                class="flex items-center gap-2 py-2.5 text-body-lg text-gray-900 hover:text-brand transition-colors"
              >
                {item.label}
                {item.badge === 'dot' && (
                  <span class="w-1.5 h-1.5 bg-brand rounded-full flex-shrink-0" />
                )}
              </a>
            )
          ))}
        </nav>

        <!-- ИЗ БЛОГА -->
        {blogPosts.length > 0 && (
          <div class="mt-6">
            <p class="text-side-menu text-gray-400 mb-3">Из блога</p>
            <div class="flex flex-col gap-1">
              {blogPosts.map(post => (
                <BlogCard
                  title={post.title}
                  slug={post.slug}
                  cover={post.cover}
                  category={post.category}
                />
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Bottom bar: на base/xs/sm — вертикально (CTA сверху), на md — горизонтально (ghost слева, CTA справа) -->
      {(secondaryLink || cta) && (
        <div class="flex-shrink-0 flex flex-col md:flex-row-reverse items-stretch md:items-center gap-3 px-8 py-4 border-t border-gray-200">
          {cta && (
            <Button
              variant="dark"
              size="sm"
              drawerPreset={cta.preset ?? 'demo'}
              class="w-full md:flex-1"
              @click="mobileOpen = false"
            >{cta.label}</Button>
          )}
          {secondaryLink && (
            <Button
              variant="ghost"
              size="sm"
              href={secondaryLink.href}
              class="w-full md:flex-1"
              @click="mobileOpen = false"
            >
              {secondaryLink.arrow === 'left' && (
                <svg slot="icon-left" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 7H2M6 3L2 7l4 4" />
                </svg>
              )}
              {secondaryLink.label}
            </Button>
          )}
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .nav-blur-fade {
    position: absolute;
    inset: 0;
    bottom: -20px;
    z-index: -1;
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, transparent 100%);
  }

  .nav-blur-strong {
    bottom: 50%;
    -webkit-backdrop-filter: blur(32px);
    backdrop-filter: blur(32px);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-blur-fade {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, transparent 100%);
    }
    .nav-blur-strong {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
