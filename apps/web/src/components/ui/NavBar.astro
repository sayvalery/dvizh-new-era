---
/**
 * NavBar — навигационная шапка-островок
 *
 * Используется в:
 *   Header.astro    → основной сайт (мега-меню, CTA, блог-карточки)
 *   BlogLayout.astro → ДВИЖ Инсайты (только лого + плоские ссылки + secondaryLink)
 *
 * Дизайн: плавающий «островок» со скруглёнными краями, margin-top, внутренним padding.
 * На белых страницах — белый на белом (невидим). На градиенте — полупрозрачный с blur.
 *
 * Прозрачный режим (transparent=true):
 *   clear = transparent && !megaOpen && !mobileOpen
 *   clear: островок полупрозрачный, белый текст/лого
 *   !clear: белый фон до верха страницы, стандартные цвета
 *
 * Мега-меню остаётся открытым пока курсор внутри всего хедера (nav + dropdown).
 */

import BlogCard from './BlogCard.astro'
import Button from './Button.astro'
import MegaMenu from './MegaMenu.astro'
import Search from './Search.astro'

export interface NavChild {
  label: string
  href: string
  description?: string
}

export interface NavSection {
  title: string
  items: NavChild[]
}

export interface NavItem {
  label: string
  href?: string
  children?: NavChild[]
  sections?: NavSection[]
  badge?: 'dot'
}

interface BlogPost {
  title: string
  slug: string
  cover?: { url?: string; alt?: string }
  category?: string
}

interface Props {
  logo: { label: string; href: string; image?: string; imageLight?: string }
  items?: NavItem[]
  blogPosts?: BlogPost[]
  secondaryLink?: { label: string; href: string }
  cta?: { label: string; preset?: string; href?: string; chevron?: boolean }
  transparent?: boolean
  /** Вариант: default — основной сайт, blog — блог/инсайты (белые элементы + поиск) */
  variant?: 'default' | 'blog'
}

const { logo, items = [], blogPosts = [], secondaryLink, cta, transparent = false, variant = 'default' } = Astro.props
const isBlog = variant === 'blog'

// Мега-пункты (Продукты, Решения) — рендерят отдельные дропдауны
const megaItems = items.filter(i => i.sections?.length)
---

<header
  x-data={`{
    mobileOpen: false,
    megaOpen: null,
    openMenu: null,
    menuTimeout: null,
    hoverTimeout: null,
    lastY: 0,
    hidden: false,
    get clear() { return ${transparent} && !this.megaOpen && !this.mobileOpen && this.lastY < 450 },
    get floatingIsland() { return ${transparent} && !this.clear && !this.megaOpen && !this.mobileOpen },
    onScroll() {
      const y = window.scrollY;
      if (y < 100) { this.hidden = false }
      else if (y < this.lastY - 5) { this.hidden = false }
      else if (y > this.lastY + 5) { this.hidden = true }
      this.lastY = y;
    }
  }`}
  x-init="lastY = window.scrollY"
  @scroll.window.throttle.100ms="onScroll()"
  class:list={[isBlog ? 'sticky top-0' : transparent ? 'fixed top-0 left-0 right-0' : 'sticky top-0']}
  :class="{
    '-translate-y-full': hidden && !mobileOpen && !megaOpen && !openMenu,
    'z-50': openMenu || megaOpen || mobileOpen,
    'z-40': !openMenu && !megaOpen && !mobileOpen
  }"
  class="transition-transform duration-300"
>
  <!-- Gradient blur backdrop for transparent mode: two layers -->
  <div x-show="clear" x-transition.opacity.duration.300ms class="nav-blur-fade"></div>
  <div x-show="clear" x-transition.opacity.duration.300ms class="nav-blur-fade nav-blur-strong"></div>

  <!-- Hover zone: keeps mega menu open while cursor is inside header area -->
  <div
    @mouseenter="if (megaOpen) clearTimeout(hoverTimeout)"
    @mouseleave="hoverTimeout = setTimeout(() => megaOpen = null, 200)"
    :class={`{
      'bg-background-primary': !clear && !floatingIsland && !${isBlog},
      'bg-transparent': clear || floatingIsland || ${isBlog},
      'rounded-b-3xl': megaOpen,
      'overflow-hidden': megaOpen
    }`}
    class="transition-colors duration-200"
  >
    <!-- Island wrapper: content aligns at 1440px, rounded corners extend beyond -->
    <div class="max-w-[1440px] mx-auto px-4 pt-3 pb-2">
      <nav
        class="flex items-center justify-between -mx-2 px-6 h-14 rounded-2xl transition-all duration-200"
        :class={`${isBlog} ? (lastY > 20 ? 'bg-white/20 backdrop-blur-[10px]' : '') : (clear ? '' : 'bg-background-primary/60 backdrop-blur-lg shadow-[inset_1px_2px_2px_rgba(255,255,255,0.3)]')`}
      >
        <!-- Left: logo + desktop nav -->
        <div class="flex items-center gap-6">
          <a href={logo.href} class="flex-shrink-0">
            {logo.image && logo.imageLight && transparent ? (
              <>
                <img src={logo.image} alt={logo.label} class="h-7 w-auto" x-show="!clear" x-cloak />
                <img src={logo.imageLight} alt={logo.label} class="h-7 w-auto" x-show="clear" />
              </>
            ) : logo.image ? (
              <img src={logo.image} alt={logo.label} class="h-7 w-auto" />
            ) : (
              <span class="font-bold text-xl">{logo.label}</span>
            )}
          </a>

          {/* Поиск — только blog-вариант, lg+ */}
          {isBlog && (
            <Search class="hidden lg:block w-60" action="/blog/search" />
          )}

          <div class="hidden lg:flex lg:gap-x-1">
            {items.map(item => (
              item.sections?.length ? (
                /* === MEGA MENU TRIGGER === */
                <button
                  class="flex items-center gap-1 px-3 py-2 text-subhead rounded-md transition-colors"
                  :class="clear ? 'text-white hover:bg-white/10' : 'text-gray-700 hover:bg-gray-100'"
                  @mouseenter={`clearTimeout(hoverTimeout); megaOpen = '${item.label}'`}
                >
                  {item.label}
                  <svg class="w-3.5 h-3.5 transition-transform" :class={`megaOpen === '${item.label}' && 'rotate-180'`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              ) : item.children?.length ? (
                /* === SIMPLE DROPDOWN === */
                <div
                  class="relative h-full flex items-center"
                  @mouseenter={`clearTimeout(menuTimeout); openMenu = '${item.label}'`}
                  @mouseleave={`menuTimeout = setTimeout(() => openMenu = null, 150)`}
                >
                  <button
                    class="flex items-center gap-1 px-3 py-2 text-subhead rounded-md transition-colors"
                    :class="clear ? 'text-white hover:bg-white/10' : 'text-gray-700 hover:bg-gray-100'"
                  >
                    {item.label}
                    <svg
                      class="w-3.5 h-3.5 transition-transform"
                      :class={`openMenu === '${item.label}' ? 'rotate-180' : ''`}
                      fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div
                    x-cloak
                    x-show={`openMenu === '${item.label}'`}
                    x-transition:enter="transition ease-out duration-150"
                    x-transition:enter-start="opacity-0 -translate-y-1"
                    x-transition:enter-end="opacity-100 translate-y-0"
                    x-transition:leave="transition ease-in duration-100"
                    x-transition:leave-start="opacity-100 translate-y-0"
                    x-transition:leave-end="opacity-0 -translate-y-1"
                    class="absolute top-full left-0 pt-1 z-50"
                  >
                    <div class="bg-background-primary border border-gray-200 rounded-xl shadow-lg py-2 min-w-52">
                      {item.children.map(child => (
                        <a href={child.href} class="block px-4 py-2 text-sm text-gray-700 hover:bg-background-secondary hover:text-gray-900">
                          {child.label}
                          {child.description && (
                            <span class="block text-xs text-gray-400 mt-0.5">{child.description}</span>
                          )}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                /* === FLAT LINK === */
                <a
                  href={item.href}
                  class="inline-flex items-center gap-1 px-3 py-2 text-subhead rounded-md transition-colors"
                  :class="clear ? 'text-white hover:bg-white/10' : 'text-gray-700 hover:bg-gray-100'"
                >
                  {item.label}
                  {item.badge === 'dot' && (
                    <span
                      class="w-1.5 h-1.5 rounded-full flex-shrink-0 transition-colors"
                      :class="clear ? 'bg-white' : 'bg-red-500'"
                    />
                  )}
                </a>
              )
            ))}
          </div>
        </div>

        <!-- Right: phone + CTA + hamburger -->
        <div class="flex items-center gap-2 sm:gap-3">

          <!-- Phone: xs+ only (hidden below xs) -->
          {secondaryLink && (
            <a
              href={secondaryLink.href}
              class="hidden sm:block text-subhead opacity-80 transition-colors"
              :class="clear ? 'text-white hover:text-white/70' : 'text-gray-500 hover:text-gray-900'"
            >
              {secondaryLink.label}
            </a>
          )}

          <!-- CTA: blog-вариант — белая кнопка со стрелкой (sm+) -->
          {cta && isBlog && (
            <a
              href={cta.href ?? '/contacts'}
              class="hidden sm:inline-flex items-center gap-1 h-9 px-4 bg-white text-gray-900 text-btn font-semibold rounded-lg whitespace-nowrap hover:bg-white/90 transition-colors"
            >
              {cta.label}
              {cta.chevron && (
                <svg class="w-3.5 h-3.5 -rotate-90 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              )}
            </a>
          )}

          <!-- CTA text button: xs+ to lg (hidden below xs and on lg+ handled separately) -->
          {cta && !isBlog && (
            <Button
              variant="dark"
              size="sm"
              drawerPreset={cta.preset ?? 'demo'}
              class="hidden sm:inline-flex lg:hidden"
              x-bind:class={`clear ? '!bg-white !text-gray-900 hover:!bg-white/90' : ''`}
            >{cta.label}</Button>
          )}

          <!-- CTA text button: lg+ desktop -->
          {cta && !isBlog && (
            <Button
              variant="dark"
              size="sm"
              drawerPreset={cta.preset ?? 'demo'}
              class="hidden lg:inline-flex"
              x-bind:class={`clear ? '!bg-white !text-gray-900 hover:!bg-white/90' : ''`}
            >{cta.label}</Button>
          )}

          <!-- Hamburger square button: visible below lg. Вариант и clear-инверсия идентичны CTA-кнопке слева. -->
          <Button
            type="button"
            iconOnly
            size="sm"
            variant="dark"
            @click="mobileOpen = true"
            x-bind:class={`clear ? '!bg-white !text-gray-900 hover:!bg-white/90' : ''`}
            class="lg:hidden flex-shrink-0"
            aria-label="Открыть меню"
          >
            <svg slot="icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </Button>

        </div>
      </nav>
    </div>

    <!-- Один анимированный враппер; контент внутри переключается без transition -->
    {megaItems.length > 0 && (
      <div
        x-cloak
        x-show="megaOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-1"
        class="border-t border-gray-100 bg-background-primary rounded-b-3xl overflow-hidden"
      >
        {megaItems.map(item => (
          <div x-show={`megaOpen === '${item.label}'`}>
            <MegaMenu sections={item.sections ?? []} blogPosts={blogPosts} />
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Mobile menu overlay -->
  <div
    x-cloak
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-50 lg:hidden"
  >
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-black/10" @click="mobileOpen = false"></div>

    <!-- Panel -->
    <div
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="-translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="-translate-x-full"
      class="fixed inset-y-0 left-0 w-full flex flex-col bg-background-primary"
    >
      <!-- Scrollable content -->
      <div class="flex-1 overflow-y-auto px-8 pt-3 pb-4">

        <!-- Header: logo LEFT | ✕ RIGHT — высота h-14 как в navbar island -->
        <div class="flex items-center justify-between h-14 mb-6">
          <a href={logo.href} class="flex-shrink-0" @click="mobileOpen = false">
            {logo.image ? (
              <img src={logo.image} alt={logo.label} class="h-7 w-auto" />
            ) : (
              <span class="font-bold text-xl">{logo.label}</span>
            )}
          </a>
          <button
            type="button"
            @click="mobileOpen = false"
            class="p-2 rounded-lg text-gray-500 hover:bg-background-secondary transition-colors"
            aria-label="Закрыть меню"
          >
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Nav sections -->
        <nav class="flex flex-col gap-5">
          {items.map(item => (
            item.sections?.length ? (
              item.sections.map(section => (
                <div>
                  <p class="text-side-menu text-gray-400 mb-1">
                    {section.title}
                  </p>
                  {section.items.map(child => (
                    <a
                      href={child.href}
                      @click="mobileOpen = false"
                      class="block py-2.5 text-body-lg text-gray-900 hover:text-brand transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              ))
            ) : item.children?.length ? (
              <div>
                <p class="text-side-menu text-gray-400 mb-1">
                  {item.label}
                </p>
                {item.children.map(child => (
                  <a
                    href={child.href}
                    @click="mobileOpen = false"
                    class="block py-2.5 text-body-lg text-gray-900 hover:text-brand transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            ) : (
              <a
                href={item.href}
                @click="mobileOpen = false"
                class="flex items-center gap-2 py-2.5 text-body-lg text-gray-900 hover:text-brand transition-colors"
              >
                {item.label}
                {item.badge === 'dot' && (
                  <span class="w-1.5 h-1.5 bg-red-500 rounded-full flex-shrink-0" />
                )}
              </a>
            )
          ))}
        </nav>

        <!-- ИЗ БЛОГА -->
        {blogPosts.length > 0 && (
          <div class="mt-6">
            <p class="text-side-menu text-gray-400 mb-3">Из блога</p>
            <div class="flex flex-col gap-1">
              {blogPosts.map(post => (
                <BlogCard
                  title={post.title}
                  slug={post.slug}
                  cover={post.cover}
                  category={post.category}
                />
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Bottom bar: phone + CTA -->
      {(secondaryLink || cta) && (
        <div class="flex-shrink-0 flex items-center gap-4 px-8 py-4 border-t border-gray-200">
          {secondaryLink && (
            <a
              href={secondaryLink.href}
              @click="mobileOpen = false"
              class="text-btn text-gray-500 opacity-80 whitespace-nowrap hover:text-gray-900 transition-colors"
            >
              {secondaryLink.label}
            </a>
          )}
          {cta && (
            <Button
              variant="dark"
              size="sm"
              drawerPreset={cta.preset ?? 'demo'}
              class="flex-1"
              @click="mobileOpen = false"
            >{cta.label}</Button>
          )}
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .nav-blur-fade {
    position: absolute;
    inset: 0;
    bottom: -20px;
    z-index: -1;
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, transparent 100%);
  }

  .nav-blur-strong {
    bottom: 50%;
    -webkit-backdrop-filter: blur(32px);
    backdrop-filter: blur(32px);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-blur-fade {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, transparent 100%);
    }
    .nav-blur-strong {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
