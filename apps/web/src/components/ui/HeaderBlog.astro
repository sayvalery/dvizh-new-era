---
/**
 * HeaderBlog — хедер блога/инсайтов ДВИЖ
 *
 * Всегда на тёмном/цветном фоне — все элементы белые.
 * При скролле добавляется backdrop-blur + bg-white/20 на nav-контейнер.
 *
 * Брейкпоинты:
 *   lg+ (≥1024px): лого + поиск + ссылки + «На сайт ДВИЖ» + «Стать автором»
 *   sm-md (640-1023px): лого + «На сайт ДВИЖ» + «Стать автором» + гамбургер
 *   xs (<640px): лого + гамбургер
 *
 * @example
 * ```astro
 * <HeaderBlog />
 * ```
 */

interface NavLink {
  label: string
  href: string
}

const navLinks: NavLink[] = [
  { label: 'Статьи', href: '/blog' },
  { label: 'Кейсы', href: '/cases' },
  { label: 'Подкасты', href: '/blog/category/podcasts' },
]
---

<header
  x-data="{
    mobileOpen: false,
    scrolled: false,
    hidden: false,
    lastY: 0,
    onScroll() {
      const y = window.scrollY;
      this.scrolled = y > 20;
      if (y < 100) { this.hidden = false }
      else if (y < this.lastY - 5) { this.hidden = false }
      else if (y > this.lastY + 5) { this.hidden = true }
      this.lastY = y;
    }
  }"
  x-init="lastY = window.scrollY"
  @scroll.window.throttle.100ms="onScroll()"
  :class="{ '-translate-y-full': hidden && !mobileOpen, 'z-50': mobileOpen, 'z-40': !mobileOpen }"
  class="fixed top-0 left-0 right-0 transition-transform duration-300"
>
  <div class="max-w-[1440px] mx-auto px-4 pt-3 pb-2">
    <nav
      class="flex items-center justify-between h-14 px-6 rounded-2xl transition-all duration-300"
      :class="scrolled ? 'bg-white/20 backdrop-blur-[10px]' : ''"
    >

      <!-- Left: лого + поиск (lg+) + ссылки (lg+) -->
      <div class="flex items-center gap-6 h-full">

        <!-- Лого -->
        <a href="/blog" class="flex-shrink-0 flex items-center gap-2">
          <img src="/logo-dvizh-white.svg" alt="ДВИЖ Инсайты" class="h-7 w-auto" />
        </a>

        <!-- Поиск — только lg+ -->
        <div class="hidden lg:flex items-center gap-3 ml-2">
          <div class="flex items-center gap-3 h-9 px-4 rounded-full bg-white/20 w-60">
            <span class="text-subhead text-white/70 flex-1 whitespace-nowrap">Ищите в инсайтах</span>
            <svg class="w-4 h-4 text-white/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
            </svg>
          </div>

          <!-- Навигационные ссылки -->
          <div class="flex items-center gap-1">
            {navLinks.map(link => (
              <a
                href={link.href}
                class="px-3 py-2 text-subhead text-white rounded-lg hover:bg-white/10 transition-colors whitespace-nowrap"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right -->
      <div class="flex items-center gap-4">

        <!-- «На сайт ДВИЖ» — sm+ -->
        <a href="/" class="hidden sm:block text-subhead text-white font-semibold whitespace-nowrap hover:text-white/70 transition-colors">
          На сайт ДВИЖ
        </a>

        <!-- «Стать автором» — sm+ -->
        <a
          href="/contacts"
          class="hidden sm:inline-flex items-center gap-1 h-9 px-4 bg-white text-gray-900 text-btn rounded-lg font-semibold whitespace-nowrap hover:bg-white/90 transition-colors"
        >
          Стать автором
          <svg class="w-3.5 h-3.5 -rotate-90 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <!-- Гамбургер — ниже lg -->
        <button
          type="button"
          @click="mobileOpen = true"
          class="lg:hidden flex items-center justify-center w-9 h-9 bg-white rounded-lg shrink-0"
          aria-label="Открыть меню"
        >
          <svg class="w-4 h-4 text-gray-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>

      </div>
    </nav>
  </div>

  <!-- Мобильное меню -->
  <div
    x-cloak
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-50 lg:hidden"
  >
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" @click="mobileOpen = false"></div>

    <!-- Panel -->
    <div
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="-translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="-translate-x-full"
      class="fixed inset-y-0 left-0 w-full flex flex-col bg-gray-900"
    >
      <div class="flex-1 overflow-y-auto px-8 pt-3 pb-4">

        <!-- Header панели -->
        <div class="flex items-center justify-between h-14 mb-6">
          <a href="/blog" class="flex-shrink-0" @click="mobileOpen = false">
            <img src="/logo-dvizh-white.svg" alt="ДВИЖ Инсайты" class="h-7 w-auto" />
          </a>
          <button
            type="button"
            @click="mobileOpen = false"
            class="w-9 h-9 flex items-center justify-center rounded-lg bg-white/10 text-white hover:bg-white/20 transition-colors"
            aria-label="Закрыть меню"
          >
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Ссылки -->
        <nav class="flex flex-col gap-1">
          {navLinks.map(link => (
            <a
              href={link.href}
              @click="mobileOpen = false"
              class="py-3 text-body-lg text-white hover:text-white/70 transition-colors"
            >
              {link.label}
            </a>
          ))}
          <a href="/" @click="mobileOpen = false" class="py-3 text-body-lg text-white/50 hover:text-white/70 transition-colors">
            На сайт ДВИЖ
          </a>
        </nav>
      </div>

      <!-- Bottom bar -->
      <div class="flex-shrink-0 flex items-center gap-4 px-8 py-4 border-t border-white/10">
        <a
          href="/contacts"
          @click="mobileOpen = false"
          class="flex-1 flex items-center justify-center gap-1 h-10 bg-white text-gray-900 text-btn rounded-lg font-semibold"
        >
          Стать автором
          <svg class="w-3.5 h-3.5 -rotate-90 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>
