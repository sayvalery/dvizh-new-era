---
/**
 * Input — поле ввода
 *
 * Два варианта (variant):
 *   colour — для светлого фона (кремовый bg-gray-100)
 *   white  — для темного фона (полупрозрачный белый, при заполнении становится белым)
 *
 * Два размера (size):
 *   M — ~44px (py-[9px] + text-base), текст 16px
 *   S — компактный (py-2), текст 14px
 *
 * Состояния Default / Active / Filled — CSS-driven:
 *   Default  — без рамки
 *   Active   — :focus → цветная рамка 2px
 *   Filled   — :not(:placeholder-shown) → для white-варианта фон становится белым
 *
 * @example
 * ```astro
 * <!-- Базовый -->
 * <Input name="email" type="email" placeholder="Введите email" />
 *
 * <!-- Компактный -->
 * <Input name="phone" placeholder="Телефон" size="S" />
 *
 * <!-- Для темного фона -->
 * <Input name="name" placeholder="Имя" variant="white" />
 * ```
 */

interface Props {
  /** Имя поля (для форм) */
  name: string
  /** Тип HTML-инпута */
  type?: 'text' | 'email' | 'tel' | 'number' | 'password' | 'search'
  /** Плейсхолдер */
  placeholder?: string
  /** id для связки с <label> */
  id?: string
  /** Начальное значение */
  value?: string
  /** Обязательное поле */
  required?: boolean
  /** Отключенное состояние */
  disabled?: boolean
  /** Размер: M — 44px высота, S — компактный */
  size?: 'M' | 'S'
  /** Тема: colour — светлый фон, white — для темного фона */
  variant?: 'colour' | 'white'
  /** Дополнительные CSS-классы */
  class?: string
}

const {
  name,
  type = 'text',
  placeholder = '',
  id,
  value,
  required = false,
  disabled = false,
  size = 'M',
  variant = 'colour',
  class: className,
} = Astro.props

const base = 'w-full rounded-lg px-4 font-sans font-normal leading-[1.4] tracking-[-0.5px] border-2 transition-colors duration-150 focus:outline-none'

const sizeClasses = size === 'M' ? 'py-[9px] text-base' : 'py-2 text-sm'

const variantClasses = variant === 'colour'
  ? 'bg-gray-200 text-gray-900 placeholder:text-gray-400 border-transparent focus:border-brand-300'
  : 'bg-white/10 text-white placeholder:text-white/60 border-transparent focus:border-white'

const disabledClasses = disabled ? 'opacity-50 cursor-not-allowed' : ''

// Маркер-классы для флюид-скейла (.fluid-page .field-* в global.css). Инертны без .fluid-page.
const markerCls = size === 'M' ? 'field field-m' : 'field field-s'
---

<input
  {name}
  {type}
  {placeholder}
  {id}
  {value}
  {required}
  {disabled}
  class:list={[base, sizeClasses, variantClasses, disabledClasses, markerCls, className]}
/>
