---
/**
 * KeyFacts — секция с ключевыми фактами/метриками
 *
 * Блок с опциональным заголовком и 2–4 колонками. Каждая колонка:
 * вертикальная черта слева, крупное значение и описание внизу.
 * Контент «прибит» к низу колонки.
 *
 * @example
 * ```astro
 * <KeyFacts
 *   title="Зачем вам ипотечный калькулятор?"
 *   items={[
 *     { value: '80% заявок', description: 'приходит в нерабочее время, не теряйте их' },
 *     { value: '50% клиентов', description: 'заранее хотят рассчитать ежемесячный платеж' },
 *     { value: 'на 20% выше', description: 'конверсия в сделку, когда клиент знает доступный бюджет ипотеки' },
 *   ]}
 * />
 * ```
 */

interface FactItem {
  /** Крупное значение/метрика (напр. «80% заявок», «на 20% выше») */
  value: string
  /** Описание под значением. Поддерживает HTML (напр. <br> для переноса) */
  description: string
  /** Мелкая сноска под описанием (напр. «По данным ОКБ»). Серый текст text-footnote. */
  footnote?: string
}

interface Props {
  /** Массив фактов — от 2 до 4 элементов */
  items: FactItem[]
  /** Заголовок секции (опционально) */
  title?: string
  /** HTML-заголовок (поддерживает <br>) */
  titleHtml?: string
  /** Подзаголовок под заголовком (опционально). Поддерживает HTML */
  subtitle?: string
  /** Количество колонок на десктопе (2–4). По умолчанию — по числу items */
  cols?: 2 | 3 | 4
  /**
   * Размер значений: 'default' — text-h3 (для длинных текстов),
   * 'large' — text-h2 (для коротких цифр и метрик)
   */
  variant?: 'default' | 'large'
  /** Дополнительные CSS классы на секции */
  class?: string
}

const { items, title, titleHtml, subtitle, cols, variant = 'default', class: className = '' } = Astro.props

const valueCls = variant === 'large' ? 'text-h2' : 'text-h3'

const colCount = (cols ?? Math.min(items.length, 4)) as 2 | 3 | 4

// xs: 1 кол, sm-lg: 2 кол, xl+: cols по пропу. Значения выравниваются по нижней линии за счет justify-end + одинакового min-h.
const gridCols = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 xl:grid-cols-3',
  4: 'sm:grid-cols-2 xl:grid-cols-4',
}[colCount]
---

<section class:list={['bg-gray-100 pt-20 lg:pt-[120px]', className]}>
  <div class="page-container">
    <div class="flex flex-col gap-14 lg:gap-20">

      {(title || subtitle) && (
        <div class="flex flex-col gap-5">
          {(title || titleHtml) && (
            titleHtml
              ? <h2 class="text-h1 font-medium text-gray-900" set:html={titleHtml} />
              : <h2 class="text-h1 font-medium text-gray-900">{title}</h2>
          )}
          {subtitle && (
            <p class="text-body-lg text-gray-500 max-w-3xl" set:html={subtitle} />
          )}
        </div>
      )}

      <!-- Сетка фактов: subgrid из 2 строк (значение + описание). Все значения попадают в строку 1 родителя — выровнены друг с другом, описания в строку 2 — независимо от их высоты. -->
      <div class:list={['grid grid-cols-1 grid-rows-[auto_auto] gap-x-8 gap-y-4', gridCols]}>
        {items.map((item) => (
          <div class="grid grid-rows-subgrid row-span-2">
            <!-- Ряд 1: вертикальная линия + значение -->
            <div class="flex gap-6 min-h-[220px] xl:min-h-[340px]">
              <div class="w-px shrink-0 self-stretch" style="background: linear-gradient(to bottom, transparent 0%, #ff4d00 47%, transparent 100%)" aria-hidden="true"></div>
              <div class="flex flex-col justify-end flex-1">
                <p class:list={[valueCls, 'text-gray-900']}>{item.value}</p>
              </div>
            </div>
            <!-- Ряд 2: описание + сноска в одну строку -->
            <div class="pl-[25px] flex items-baseline gap-3 flex-wrap">
              <p class="text-body-lg text-gray-900" set:html={item.description} />
              {item.footnote && (
                <span class="text-footnote text-gray-400 shrink-0">{item.footnote}</span>
              )}
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
