---
/**
 * KeyFacts — секция с нумерованными ключевыми фактами/метриками
 *
 * Блок с опциональным заголовком и 2–4 колонками. Каждая колонка:
 * порядковый номер сверху, вертикальная черта слева, крупное
 * значение и описание внизу. Контент «прибит» к низу колонки.
 *
 * @example
 * ```astro
 * <KeyFacts
 *   title="Зачем вам ипотечный калькулятор?"
 *   items={[
 *     { value: '80% заявок', description: 'приходит в нерабочее время, не теряйте их' },
 *     { value: '50% клиентов', description: 'заранее хотят рассчитать ежемесячный платеж' },
 *     { value: 'на 20% выше', description: 'конверсия в сделку, когда клиент знает доступный бюджет ипотеки' },
 *   ]}
 * />
 * ```
 */

interface FactItem {
  /** Крупное значение/метрика (напр. «80% заявок», «на 20% выше») */
  value: string
  /** Описание под значением. Поддерживает HTML (напр. <br> для переноса) */
  description: string
}

interface Props {
  /** Массив фактов — от 2 до 4 элементов */
  items: FactItem[]
  /** Заголовок секции (опционально) */
  title?: string
  /** Количество колонок на десктопе (2–4). По умолчанию — по числу items */
  cols?: 2 | 3 | 4
  /** Дополнительные CSS классы на секции */
  class?: string
}

const { items, title, cols, class: className = '' } = Astro.props

const colCount = (cols ?? Math.min(items.length, 4)) as 2 | 3 | 4

const gridCols = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[colCount]
---

<section class:list={['bg-gray-100 py-20 lg:py-[120px]', className]}>
  <div class="page-container">
    <div class="flex flex-col gap-14 lg:gap-20">

      {title && (
        <h2 class="text-h1 font-medium text-gray-900 max-w-4xl">
          {title}
        </h2>
      )}

      <div class="flex flex-col gap-4 lg:gap-6">

        <!-- Ряд 1: номер + значение. justify-between выравнивает значения по одной линии,
             поскольку description вынесен в отдельный ряд и не влияет на высоту ячейки -->
        <div class:list={['grid grid-cols-1 gap-10 lg:gap-8', gridCols]}>
          {items.map((item, i) => (
            <div class="flex gap-6 min-h-[220px] lg:min-h-[340px]">

              {/* Вертикальная черта — градиент */}
              <div class="w-px shrink-0 self-stretch" style="background: linear-gradient(to bottom, transparent 0%, #ff4d00 47%, transparent 100%)" aria-hidden="true"></div>

              <div class="flex flex-col justify-between flex-1">
                <span class="text-subhead text-gray-400">
                  {String(i + 1).padStart(3, '0')}
                </span>
                <p class="text-h2 text-gray-900">{item.value}</p>
              </div>

            </div>
          ))}
        </div>

        <!-- Ряд 2: описания — вынесены сюда, чтобы не сдвигали значения вверх -->
        <div class:list={['grid grid-cols-1 gap-10 lg:gap-8', gridCols]}>
          {items.map((item) => (
            <p class="text-body-lg text-gray-900 pl-[25px]" set:html={item.description} />
          ))}
        </div>

      </div>

    </div>
  </div>
</section>
