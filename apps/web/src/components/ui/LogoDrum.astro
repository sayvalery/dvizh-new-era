---
/**
 * LogoDrum — 3D-барабан с логотипами (чистый CSS)
 *
 * Анимация: CSS 3D-цилиндр, вращается вокруг оси X вверх.
 * Логотипы повторяются, чтобы заполнить барабан с равным расстоянием.
 * Каждый проходит через «фокусную зону» — sharp и яркий,
 * за пределами — уходит в blur и прозрачность.
 *
 * Логотипы отображаются в натуральных пропорциях SVG.
 * Ноль JavaScript. Ноль библиотек. Чистые CSS transforms + filter.
 *
 * @example
 * ```astro
 * <LogoDrum
 *   logos={['/logo1.svg', '/logo2.svg', '/logo3.svg']}
 *   duration={25}
 * />
 * ```
 */

/** Логотип: URL или {src, ratio, h}. ratio = ширина/высота из viewBox.
 *  h — явная высота в px (оверрайд авто-нормировки для отдельного лого). */
type LogoItem = string | { src: string; ratio?: number; h?: number }

interface Props {
  /** Массив логотипов. Передавай {src, ratio} для нормировки по площади (см. ниже). */
  logos: LogoItem[]
  /** Длительность полного оборота в секундах */
  duration?: number
  /** Радиус цилиндра в px */
  radius?: number
  /** Угловой шаг между логотипами в градусах (меньше = плотнее) */
  angleGap?: number
  /** Дополнительные CSS классы */
  class?: string
}

const {
  logos,
  duration = 25,
  radius = 380,
  angleGap = 22,
  class: className = ''
} = Astro.props

/* Единая система размера: нормировка по ОПТИЧЕСКОЙ ПЛОЩАДИ, а не по высоте.
   Высота = √(AREA / ratio) с клампом [MIN_H, MAX_H] → у всех примерно равный
   «чернильный вес»: узкие чуть выше, широкие чуть ниже. Лого без ratio падают
   на CSS-фолбэк (max-height). ratio = width/height из viewBox SVG. */
const AREA = 7200
const MIN_H = 20
const MAX_H = 48
const heightFor = (ratio?: number): number | null =>
  ratio ? Math.round(Math.min(MAX_H, Math.max(MIN_H, Math.sqrt(AREA / ratio)))) : null

// Нормализуем вход к {src, ratio}
const norm = logos.map((l) => (typeof l === 'string' ? { src: l } : l))

// Сколько слотов помещается на барабане (ближайшее целое к 360/angleGap)
const totalSlots = Math.round(360 / angleGap)
// Реальный шаг — ровно делит 360°, чтобы стык первого/последнего лого был
// таким же, как остальные зазоры (иначе остается «шов» из остатка деления).
const step = 360 / totalSlots

// Заполняем слоты, повторяя логотипы по кругу
const items = Array.from({ length: totalSlots }, (_, i) => norm[i % norm.length])
---

<div class:list={['logo-drum', className]}>
  <div class="logo-drum-rotor" style={`animation-duration: ${duration}s;`}>
    {items.map((logo, i) => (
      <div
        class="logo-drum-face"
        style={`
          transform: rotateX(${i * step}deg) translateZ(${radius}px);
          animation-duration: ${duration}s;
          animation-delay: ${(-i / totalSlots * duration).toFixed(2)}s;
        `}
      >
        <img
          src={logo.src}
          alt=""
          class="logo-drum-img"
          style={(logo.h ?? heightFor(logo.ratio)) ? `height:${logo.h ?? heightFor(logo.ratio)}px` : undefined}
          loading="eager"
        />
      </div>
    ))}
  </div>
</div>

<style>
  .logo-drum {
    perspective: 1200px;
    perspective-origin: center 50%;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-drum-rotor {
    position: relative;
    width: 240px;
    height: 80px;
    transform-style: preserve-3d;
    animation-name: drum-spin;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  @keyframes drum-spin {
    from { transform: rotateX(0deg); }
    to { transform: rotateX(360deg); }
  }

  .logo-drum-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    animation-name: face-depth;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  @keyframes face-depth {
    0%, 8% {
      opacity: 1;
    }
    14% {
      opacity: 0.3;
    }
    20%, 80% {
      opacity: 0;
      visibility: hidden;
    }
    86% {
      opacity: 0.3;
    }
    92%, 100% {
      opacity: 1;
    }
  }

  .logo-drum-img {
    height: auto;
    max-height: 60px;
    width: auto;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    filter: brightness(0) invert(1);
  }
</style>
