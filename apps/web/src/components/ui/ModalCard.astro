---
/**
 * ModalCard — компактная карточка модуля/продукта с hover-эффектом
 *
 * Default: прозрачный фон, тёмный текст.
 * Hover: фон background/secondary (`#f3f1ee`), текст brand-orange.
 *
 * Дизайн: Figma node 311:5194
 *
 * @example
 * ```astro
 * <ModalCard
 *   title="Ипотечный калькулятор"
 *   description="Собирайте заявки в нерабочее время"
 *   image={{ src: '/api/media/file/calc.png', alt: 'Калькулятор' }}
 *   href="/ipotechnyy-kalkulyator"
 * />
 * ```
 */

interface Props {
  /** Заголовок карточки */
  title: string
  /** Описание / подзаголовок */
  description?: string
  /** Иконка или изображение 60×60. Если не передано — серая заглушка */
  image?: { src: string; alt?: string }
  /** URL для перехода. Если передан — карточка становится тегом <a> */
  href?: string
  /** Дополнительные CSS классы */
  class?: string
}

const { title, description, image, href, class: className = '' } = Astro.props

const Tag = (href ? 'a' : 'div') as 'a' | 'div'
---

<Tag
  {...(href ? { href } : {})}
  class:list={[
    'group flex flex-col gap-4 p-6 rounded-3xl',
    'transition-colors duration-200',
    'hover:bg-background-secondary',
    href && 'cursor-pointer',
    className,
  ]}
>

  <!-- Иконка / изображение 60×60 -->
  <div class="shrink-0 size-[60px] rounded-2xl overflow-hidden bg-gray-200">
    {image
      ? <img src={image.src} alt={image.alt ?? ''} class="w-full h-full object-cover" loading="lazy" />
      : <div class="w-full h-full bg-gray-200" aria-hidden="true" />
    }
  </div>

  <!-- Текстовый блок -->
  <div class="flex flex-col gap-1">
    <p class="text-h4 text-gray-900 transition-colors duration-200 group-hover:text-brand">
      {title}
    </p>
    {description && (
      <p class="text-body-lg text-gray-900 transition-colors duration-200 group-hover:text-brand">
        {description}
      </p>
    )}
  </div>

</Tag>
