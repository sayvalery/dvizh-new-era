---
/**
 * Form — контактная форма с пресетами
 *
 * Пресеты полей:
 *   lead      → name, phone
 *   subscribe → email
 *   demo      → name, email, phone, company
 *   research  → name, email, company
 *   author    → name, phone, email, topic (все поля обязательны)
 *
 * Лейауты:
 *   stacked (по умолчанию) — лейбл сверху, инпут снизу
 *   labels-left             — лейбл слева, инпут справа. Для дровера
 *   inline                  — горизонтальная форма в одну строку. Для hero-секций
 *
 * Варианты:
 *   light (по умолчанию) — для белого/светлого фона
 *   dark                  — для тёмного фона (FormClosing и т.п.)
 *
 * Примеры:
 *   <Form preset="demo" />
 *   <Form preset="lead" layout="labels-left" />
 *   <Form preset="lead" layout="inline" variant="dark" />
 *
 * Отправка: POST /api/form-submissions на CMS.
 */
import Input from './Input.astro'
import Button from './Button.astro'
import { PRIVACY_POLICY_URL } from '../../lib/links'

const CMS_URL = import.meta.env.CMS_URL || 'http://localhost:3002'
const CLIENT_CMS_URL = import.meta.env.PUBLIC_CMS_URL ?? ''

interface Props {
  preset: 'lead' | 'subscribe' | 'demo' | 'research' | 'author'
  layout?: 'stacked' | 'labels-left' | 'inline'
  /** light — для светлого фона, dark — для тёмного (FormClosing и т.п.) */
  variant?: 'light' | 'dark'
  submitLabel?: string
  /** Показывать чекбокс согласия на обработку персональных данных */
  showPrivacy?: boolean
  /** Текст согласия перед ссылкой на Политику (по умолчанию — стандартный) */
  privacyText?: string
  /** Переопределить набор полей пресета (напр. lead-дровер с полями demo) */
  fields?: string[]
  class?: string
}

const { preset, layout = 'stacked', variant = 'light', submitLabel, showPrivacy = true, privacyText, fields: fieldsOverride, class: className } = Astro.props

const isDark = variant === 'dark'

const labelClasses = isDark
  ? 'text-[13px] font-medium text-white/60 pl-1'
  : 'text-[13px] font-medium text-gray-500 pl-1'

const successClasses = isDark ? 'text-green-400' : 'text-green-600'
const errorClasses = isDark ? 'text-red-400' : 'text-red-600'

// Согласие на обработку ПД — визуал/тема как в FormClosing (единообразие по сайту)
const privacyLinkCls = isDark ? 'text-white/40 underline hover:text-white/60' : 'text-gray-400 underline hover:text-gray-600'
const privacyCls = isDark ? 'text-white/40' : 'text-gray-400'
const checkboxBorder = isDark ? 'border-white/20 bg-white/5' : 'border-gray-300/60 bg-gray-100/50'
const privacyMain = privacyText ?? 'Я даю согласие на обработку персональных данных и ознакомлен с '

const fields: Record<string, string[]> = {
  lead:     ['name', 'phone', 'company'],
  subscribe:['email'],
  demo:     ['name', 'email', 'phone', 'company'],
  research: ['name', 'email', 'company'],
  author:   ['name', 'phone', 'email', 'company', 'topic'],
}

const fieldLabels: Record<string, string> = {
  name:    'Ваше имя',
  email:   'Email',
  phone:   'Телефон',
  company: 'Компания',
  topic:   'Тема материала',
}

const defaultSubmitLabels: Record<string, string> = {
  lead:      'Отправить',
  subscribe: 'Подписаться',
  demo:      'Получить демо',
  research:  'Получить исследование',
  author:    'Отправить заявку',
}

// Обязательные поля по пресету. Если пресет не указан — дефолт: name + email.
// author — все поля обязательны. company — обязательно везде, где встречается.
const requiredFields: Record<string, string[]> = {
  author: ['name', 'phone', 'email', 'company', 'topic'],
}
const isRequired = (field: string): boolean =>
  field === 'company' || (requiredFields[preset]?.includes(field) ?? (field === 'email' || field === 'name'))

const btnLabel = submitLabel ?? defaultSubmitLabels[preset] ?? 'Отправить'
const formFields = fieldsOverride ?? fields[preset] ?? ['name', 'email']

// Инлайн-форма с 3+ полями: кнопка уходит на отдельную строку под полями,
// чтобы поля заняли всю ширину колонки (иначе кнопка съедает ширину и поля узкие).
const manyInline = layout === 'inline' && formFields.length >= 3
---

<form
  class:list={[className]}
  data-preset={preset}
  data-cms-url={CLIENT_CMS_URL}
>
  {layout === 'inline' ? (
    <div class:list={['flex flex-col gap-3', !manyInline && 'sm:flex-row sm:items-start']}>
      <div class="flex flex-col sm:flex-row gap-3 sm:flex-1">
        {formFields.map((field) => (
          <Input
            id={`field-${preset}-${field}`}
            type={field === 'email' ? 'email' : field === 'phone' ? 'tel' : 'text'}
            name={field}
            required={isRequired(field)}
            placeholder={fieldLabels[field]}
            variant={isDark ? 'white' : 'colour'}
            class="flex-1"
          />
        ))}
      </div>
      <Button
        type="submit"
        size="md"
        variant={isDark ? 'secondary' : 'primary'}
        class="w-full sm:w-auto"
      >
        {btnLabel}
      </Button>
    </div>
  ) : layout === 'labels-left' ? (
    <div class="space-y-3">
      {formFields.map((field) => (
        <div class="flex flex-col gap-1.5">
          <label
            for={`field-${preset}-${field}`}
            class={labelClasses}
          >
            {fieldLabels[field]}
          </label>
          <Input
            id={`field-${preset}-${field}`}
            type={field === 'email' ? 'email' : field === 'phone' ? 'tel' : 'text'}
            name={field}
            required={isRequired(field)}
            placeholder={fieldLabels[field]}
            variant={isDark ? 'white' : 'colour'}
          />
        </div>
      ))}
    </div>
  ) : (
    <div class="space-y-3">
      {formFields.map((field) => (
        <div class="flex flex-col gap-1.5">
          <label
            for={`field-${preset}-${field}`}
            class={labelClasses}
          >
            {fieldLabels[field]}
          </label>
          <Input
            id={`field-${preset}-${field}`}
            type={field === 'email' ? 'email' : field === 'phone' ? 'tel' : 'text'}
            name={field}
            required={isRequired(field)}
            placeholder={fieldLabels[field]}
            variant={isDark ? 'white' : 'colour'}
          />
        </div>
      ))}
    </div>
  )}

  <div class="hidden">
    <input name="_honeypot" tabindex="-1" autocomplete="off" />
  </div>

  {layout !== 'inline' && (
    <Button
      type="submit"
      size="md"
      variant={isDark ? 'secondary' : 'primary'}
      class="mt-5 w-full"
    >
      {btnLabel}
    </Button>
  )}

  {showPrivacy && (
    <label class="flex items-start gap-2 cursor-pointer mt-4">
      <div class="relative mt-[2px] w-4 h-4 shrink-0">
        <input
          type="checkbox"
          required
          class="peer absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
        />
        <div class:list={[
          'absolute inset-0 rounded-[4px] border-2 transition-colors duration-150',
          'peer-checked:bg-brand peer-checked:border-brand',
          checkboxBorder,
        ]}></div>
        <svg
          class="absolute inset-0 w-full h-full p-[3px] text-white opacity-0 peer-checked:opacity-100 transition-opacity duration-150 pointer-events-none"
          viewBox="0 0 10 8"
          fill="none"
          aria-hidden="true"
        >
          <path d="M1.5 4L3.5 6.5L8.5 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <span class:list={['text-[13px] leading-snug', privacyCls]}>
        {privacyMain}<a href={PRIVACY_POLICY_URL} target="_blank" rel="noopener" class={privacyLinkCls}>Политикой&nbsp;обработки персональных&nbsp;данных</a>
      </span>
    </label>
  )}

  <p class:list={['form-success hidden mt-3 text-sm', successClasses]}>Спасибо! Мы свяжемся с вами.</p>
  <p class:list={['form-error hidden mt-3 text-sm', errorClasses]}>Ошибка отправки. Попробуйте ещё раз.</p>
</form>

<script>
  // :not([data-form-closing]) — у форм FormClosing свой обработчик (data-form-closing).
  // Без исключения они получали ДВА submit-листенера → двойная отправка заявки.
  document.querySelectorAll('form[data-preset]:not([data-form-closing])').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const f = e.target as HTMLFormElement
      const cmsUrl = f.dataset.cmsUrl
      const preset = f.dataset.preset

      const honeypot = (f.querySelector('[name="_honeypot"]') as HTMLInputElement)?.value
      if (honeypot) return

      const data: Record<string, string> = { preset: preset ?? '' }
      new FormData(f).forEach((val, key) => {
        if (key !== '_honeypot') data[key] = val as string
      })
      data.page = window.location.href

      const btn = f.querySelector('button[type="submit"]') as HTMLButtonElement
      btn.disabled = true

      try {
        const res = await fetch(`${cmsUrl}/api/form-submissions`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        })
        if (res.ok) {
          f.querySelector('.form-success')?.classList.remove('hidden')
          f.reset()
        } else {
          throw new Error('Server error')
        }
      } catch {
        f.querySelector('.form-error')?.classList.remove('hidden')
      } finally {
        btn.disabled = false
      }
    })
  })
</script>
