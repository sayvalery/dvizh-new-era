---
import ModalInlineForm from './ModalInlineForm.astro'

/**
 * AdvantageCard — карточка преимущества с hover-эффектом и модальным окном
 *
 * Дефолт: фон background/secondary (`bg-background-secondary`), курсив на стате только
 *   на мобайле/планшете.
 * Hover: градиентная картинка (`adv_card_bg.png`), все тексты становятся белыми, стат курсивный.
 * Клик: открывает модальное окно 50vw × 80vh с кнопками закрыть и раскрыть.
 *
 * @example
 * ```astro
 * <AdvantageCard
 *   title="Закрывают до 26% больше сделок на том же трафике"
 *   stat="+26%"
 *   label="Сделок на том же трафике"
 * />
 * ```
 */

interface Props {
  /** Заголовок карточки */
  title: string
  /** Крупное числовое значение */
  stat: string
  /** Подпись под числом */
  label: string
  /** URL для кнопки "раскрыть" (открывает в новой вкладке) */
  expandHref?: string
  /** Дополнительные CSS классы */
  class?: string
}

const { title, stat, label, expandHref, class: className = '' } = Astro.props
---

<div
  x-data="{ open: false, expanded: false, scrolled: false }"
  x-effect="
    document.body.style.overflow = open ? 'hidden' : '';
    if (!open) scrolled = false;
  "
  class="h-full"
>

  <!-- Карточка -->
  <div
    class:list={[
      'group relative flex flex-col overflow-hidden cursor-pointer h-full',
      'rounded-2xl sm:rounded-3xl',
      'p-6 md:p-8',
      'min-h-[300px] sm:min-h-[320px] lg:min-h-[360px]',
      'bg-background-secondary',
      className
    ]}
    @click="open = true"
  >

    <!-- Hover background (градиент) -->
    <div class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true">
      <div class="absolute inset-0 bg-[url('/adv_card_bg.png')] bg-cover bg-center"></div>
    </div>

    <!-- Content -->
    <div class="relative flex flex-1 flex-col justify-between">

      <!-- Top: title + arrow icon -->
      <div class="flex items-start justify-between gap-3">
        <p class="font-sans font-medium leading-none tracking-[-1px] text-[22px] sm:text-[24px] lg:text-[32px] lg:max-w-[75%] text-gray-900">{title}</p>
        <svg
          class="absolute bottom-4 right-4 sm:static shrink-0 w-7 h-7 sm:w-6 sm:h-6 lg:w-8 lg:h-8 text-gray-400 transition-colors duration-300 group-hover:text-brand"
          viewBox="0 0 21 32" fill="currentColor" aria-hidden="true"
        >
          <path d="M2.70271 32C1.21228 32 0 30.7877 0 29.2973V26.2057C0 24.7153 1.21228 23.503 2.70271 23.503H5.53766C5.79236 23.503 5.99886 23.2965 5.99886 23.0418V20.3299C5.99886 18.8395 7.21114 17.6272 8.70157 17.6272H11.5365C11.7912 17.6272 11.9977 17.4207 11.9977 17.166V14.834C11.9977 14.5793 11.7912 14.3728 11.5365 14.3728H8.70157C7.21114 14.3728 5.99886 13.1605 5.99886 11.6701V8.95823C5.99886 8.70352 5.79236 8.49703 5.53766 8.49703H2.70271C1.21228 8.49703 0 7.28475 0 5.79432V2.70271C0 1.21228 1.21228 0 2.70271 0H5.79432C7.28475 0 8.49703 1.21228 8.49703 2.70271V5.41454C8.49703 5.66925 8.70352 5.87574 8.95823 5.87574H11.7932C13.2836 5.87574 14.4959 7.08802 14.4959 8.57845V11.2903C14.4959 11.545 14.7024 11.7515 14.9571 11.7515H17.792C19.2825 11.7515 20.4947 12.9638 20.4947 14.4542V17.5458C20.4947 19.0362 19.2825 20.2485 17.792 20.2485H14.9571C14.7024 20.2485 14.4959 20.455 14.4959 20.7097V23.4215C14.4959 24.912 13.2836 26.1243 11.7932 26.1243H8.95823C8.70352 26.1243 8.49703 26.3308 8.49703 26.5855V29.2973C8.49703 30.7877 7.28475 32 5.79432 32H2.70271Z"/>
        </svg>
      </div>

      <!-- Bottom: stat + label -->
      <div>
        <!-- На мобайле/планшете — курсив по умолчанию, на десктопе — только при hover -->
        <p class="font-heading font-bold leading-none tracking-[-1px] italic lg:not-italic text-[42px] lg:text-[64px] text-gray-900/40 transition-colors duration-300 group-hover:text-brand-500 group-hover:italic">{stat}</p>
        <p class="text-body-lg text-gray-500 transition-colors duration-300 group-hover:text-brand-500">{label}</p>
      </div>

    </div>
  </div>

  <!-- Модальное окно -->
  <div
    x-show="open"
    x-transition:enter="transition duration-200 ease-out"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition duration-150 ease-in"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-50 bg-black/40"
    @click="open = false"
    @keydown.escape.window="open = false"
    x-cloak
  >
    <!-- Панель, прибита к низу по центру -->
    <div
      class="fixed bottom-0 left-1/2 -translate-x-1/2 w-screen md:w-[540px] lg:w-[50vw] lg:min-w-[600px]"
      @click.stop
    >
      <!-- Белая панель -->
      <div
        class="relative flex flex-col overflow-hidden bg-white h-[90vh] rounded-t-3xl"
      >
        <!-- Кнопка закрыть — правый верхний угол -->
        <button
          @click.stop="open = false"
          class="absolute top-5 right-5 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-gray-300 bg-white text-gray-500 hover:bg-gray-100"
          aria-label="Закрыть"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13"/>
          </svg>
        </button>

        <!-- Скроллируемая область контента -->
        <div class="overflow-y-auto flex-1" @scroll="scrolled = true">
          <slot name="modal-body">
            <div class="p-10">
              <p class="text-medium-32 text-gray-900">{title}</p>
              <div class="mt-16">
                <p class="text-h1 text-gray-900">{stat}</p>
                <p class="mt-1 text-body-lg text-gray-500">{label}</p>
              </div>
            </div>
          </slot>
        </div>

        <!-- Inline-форма внутри панели, появляется после первого скролла -->
        <div
          x-show="scrolled"
          x-transition:enter="transition duration-300 ease-out"
          x-transition:enter-start="opacity-0 translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition duration-200 ease-in"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-2"
          class="shrink-0 bg-white border-t border-gray-300 px-8 py-6"
          x-cloak
        >
          <ModalInlineForm />
        </div>
      </div>
    </div>
  </div>

</div>
