---
/**
 * Banner — универсальный CTA-баннер
 *
 * Объединяет функциональность CTA и CTABanner.
 * Каждая часть включается/отключается через булевые пропсы — как в Figma.
 *
 * Варианты фона:
 *   bg="bg-gray-100"   — светлый кремовый (по умолчанию)
 *   bg="bg-gray-900"   — тёмный
 *   bg="bg-brand"      — брендовый оранжевый
 *   bgImage="/img.jpg" — фоновое изображение (cover)
 *
 * Скругления по дизайн-системе:
 *   rounded="3xl" → 24px (по умолчанию, для страниц)
 *   rounded="2xl" → 16px (для вложенных секций)
 *
 * @example
 * ```astro
 * <!-- Компактный баннер с боковой кнопкой (замена CTABanner) -->
 * <Banner
 *   title="Узнайте, сколько вы можете сэкономить"
 *   showSideButton
 *   buttonText="Получить расчёт"
 *   buttonDrawerPreset="lead"
 *   rounded="2xl"
 * />
 *
 * <!-- Большой баннер с формой и списком (замена CTA) -->
 * <Banner
 *   title="Автоматизируйте продажи"
 *   subtitle="AI-платформа для застройщиков"
 *   paragraphs={['До 96% одобрения ипотечных заявок', 'Единая анкета в 40+ банков']}
 *   showForm
 *   formPreset="lead"
 *   formFootnote="Нажимая кнопку, вы соглашаетесь с политикой конфиденциальности"
 *   bg="bg-gray-900"
 *   dark
 * />
 *
 * <!-- С фоновым изображением -->
 * <Banner
 *   title="Запросить демо"
 *   showSideButton
 *   buttonText="Запросить демо"
 *   buttonDrawerPreset="demo"
 *   bgImage="/images/banner-bg.jpg"
 *   dark
 * />
 * ```
 */

import Button from './Button.astro'
import Form from './Form.astro'

interface Props {
  // ─── Контент ───────────────────────────────────────────────────────────────
  /** Основной заголовок */
  title: string
  /** Подзаголовок под заголовком */
  subtitle?: string
  /** Список пунктов с иконкой галочки */
  paragraphs?: string[]

  // ─── Форма ─────────────────────────────────────────────────────────────────
  /** Показывать встроенную форму */
  showForm?: boolean
  /** Пресет формы */
  formPreset?: 'lead' | 'demo' | 'research' | 'subscribe'
  /** Лейбл кнопки отправки формы */
  formSubmitLabel?: string
  /** Текст согласия/сноски под формой */
  formFootnote?: string

  // ─── Боковая кнопка ────────────────────────────────────────────────────────
  /** Показывать кнопку справа от контента */
  showSideButton?: boolean
  /** Текст боковой кнопки */
  buttonText?: string
  /** Ссылка для боковой кнопки (игнорируется если задан buttonDrawerPreset) */
  buttonHref?: string
  /** Пресет дровера для боковой кнопки */
  buttonDrawerPreset?: 'demo' | 'lead' | 'research' | 'subscribe'

  // ─── Оформление ────────────────────────────────────────────────────────────
  /** Tailwind-класс фона: bg-gray-100, bg-gray-900, bg-brand и др. */
  bg?: string
  /** URL фонового изображения (background-size: cover) */
  bgImage?: string
  /** Тёмный фон — инвертирует цвет текста */
  dark?: boolean
  /** Скругление: 3xl = 24px (по умолчанию), 2xl = 16px */
  rounded?: '2xl' | '3xl'
  /** Минимальная высота баннера, например "320px" или "50vh" */
  minHeight?: string
  /** HTML-тег заголовка (по умолчанию h2) */
  titleTag?: 'h1' | 'h2' | 'h3' | 'h4'
  /** Дополнительные CSS классы */
  class?: string
}

const {
  title,
  subtitle,
  paragraphs,
  showForm = false,
  formPreset = 'lead',
  formSubmitLabel,
  formFootnote,
  showSideButton = false,
  buttonText = 'Запросить демо',
  buttonHref,
  buttonDrawerPreset,
  bg = 'bg-gray-100',
  bgImage,
  dark = false,
  rounded = '3xl',
  minHeight,
  titleTag = 'h2',
  class: className = '',
} = Astro.props

const roundedCls = rounded === '2xl' ? 'rounded-2xl' : 'rounded-3xl'

const titleCls    = dark ? 'text-white'    : 'text-gray-900'
const subtitleCls = dark ? 'text-white/70' : 'text-gray-600'
const itemCls     = dark ? 'text-white/80' : 'text-gray-700'
const checkCls    = dark ? 'text-white/50' : 'text-gray-500'
const footnoteCls = dark ? 'text-white/40' : 'text-gray-400'
---

<section
  class:list={[
    bgImage ? '' : bg,
    roundedCls,
    'overflow-hidden p-10',
    className,
  ]}
  style={[
    bgImage ? `background-image:url('${bgImage}');background-size:cover;background-position:center` : '',
    minHeight ? `min-height:${minHeight}` : '',
  ].filter(Boolean).join(';') || undefined}
>
  <div class="flex gap-10 items-center">

    <!-- ── Левая колонка ──────────────────────────────────────────────────── -->
    <div class="flex-1 flex flex-col gap-10 min-w-0">

      <!-- Заголовок + подзаголовок -->
      <div class="flex flex-col gap-2">
        <Fragment set:html={`<${titleTag} class="${['text-h2', titleCls].join(' ')}">${title}</${titleTag}>`} />
        {subtitle && (
          <p class:list={['text-body-lg', subtitleCls]}>{subtitle}</p>
        )}
      </div>

      <!-- Список пунктов с галочками -->
      {paragraphs && paragraphs.length > 0 && (
        <ul class="flex flex-col gap-3">
          {paragraphs.map((item) => (
            <li class="flex gap-3 items-start">
              <svg
                class:list={['w-6 h-6 shrink-0 mt-0.5', checkCls]}
                viewBox="0 0 24 24"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22ZM16.7071 9.70711C17.0976 9.31658 17.0976 8.68342 16.7071 8.29289C16.3166 7.90237 15.6834 7.90237 15.2929 8.29289L10.5 13.0858L8.70711 11.2929C8.31658 10.9024 7.68342 10.9024 7.29289 11.2929C6.90237 11.6834 6.90237 12.3166 7.29289 12.7071L9.79289 15.2071C10.1834 15.5976 10.8166 15.5976 11.2071 15.2071L16.7071 9.70711Z"
                />
              </svg>
              <span class:list={['text-body-lg', itemCls]}>{item}</span>
            </li>
          ))}
        </ul>
      )}

      <!-- Встроенная форма -->
      {showForm && (
        <div class="flex flex-col gap-3">
          <Form
            preset={formPreset}
            layout="inline"
            variant={dark ? 'dark' : 'light'}
            submitLabel={formSubmitLabel}
          />
          {formFootnote && (
            <p class:list={['text-footnote', footnoteCls]}>{formFootnote}</p>
          )}
        </div>
      )}

    </div>
    <!-- ─────────────────────────────────────────────────────────────────────── -->

    <!-- ── Боковая кнопка ────────────────────────────────────────────────── -->
    {showSideButton && (
      <div class="shrink-0">
        <Button
          size="lg"
          variant="primary"
          drawerPreset={buttonDrawerPreset}
          href={!buttonDrawerPreset ? (buttonHref ?? '#') : undefined}
        >
          {buttonText}
        </Button>
      </div>
    )}
    <!-- ─────────────────────────────────────────────────────────────────────── -->

  </div>
</section>
