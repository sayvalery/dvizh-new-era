---
/**
 * SupportSection — блок команды поддержки с интерактивными табами
 *
 * Три плашки справа переключают большое фото и данные команды слева.
 * Alpine.js управляет активным табом, фото меняются через crossfade (opacity).
 */

interface Tab {
  /** URL иконки в плашке 56px. Пустая строка — серая заглушка */
  icon?: string
  /** Заголовок плашки */
  title: string
  /** Три пункта описания */
  bullets: string[]
  /** URL большого фото слева. Пустая строка — серая заглушка */
  photo?: string
  /** Имя человека на фото */
  personName: string
  /** Должность */
  personTitle: string
  /** URL мини-аватарок в углу карточки (до 4, пустая строка → серый круг) */
  avatars?: string[]
  /** Число в квадрате «+N» рядом с аватарками (мобайл). Перекрывает авторасчёт */
  extraCount?: number
}

interface Props {
  /** Первая строка заголовка */
  title?: string
  /** Вторая строка заголовка (оранжевая) */
  titleAccent?: string
  /** Подзаголовок */
  subtitle?: string
  /** Ровно 3 таба */
  tabs: Tab[]
  /** Текст кнопки CTA */
  ctaLabel?: string
  /** Пресет дровера */
  ctaDrawerPreset?: 'demo' | 'lead' | 'research' | 'subscribe'
  class?: string
}

const {
  title = 'Не оставим вас одних.',
  titleAccent = 'Ни на одном этапе',
  subtitle = 'От внедрения до обучения команды. За каждым тикетом — конкретный человек, который знает ваш проект и знает рынок',
  tabs,
  ctaLabel = 'Оставить заявку',
  ctaDrawerPreset = 'demo',
  class: className,
} = Astro.props
---

<!-- Классы Alpine, используемые в :class-биндингах (нужны для сканера Tailwind):
     bg-gray-900 bg-background-secondary bg-gray-200 bg-brand bg-gray-300 bg-white/10
     text-white text-gray-900 text-white/80 text-gray-500
     opacity-100 opacity-0 hover:bg-gray-200
     brightness-0 invert
-->

<section class:list={['py-24 lg:py-[120px]', className]}>
  <div class="page-container flex flex-col gap-16">

    <!-- Шапка -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
      <div class="flex flex-col gap-3">
        <h2 class="text-h2">
          {title}<br />
          <span class="text-brand">{titleAccent}</span>
        </h2>
        <p class="text-body-lg text-gray-500 max-w-[620px]">{subtitle}</p>
      </div>
      <div class="shrink-0" x-data>
        <button
          @click={`$dispatch('open-drawer', { preset: '${ctaDrawerPreset}' })`}
          class="bg-brand text-white rounded-[12px] px-6 py-3 text-btn-lg whitespace-nowrap hover:bg-brand-600 transition-colors duration-200"
        >
          {ctaLabel}
        </button>
      </div>
    </div>

    <!-- Контент -->
    <div
      x-data="{ active: window.innerWidth >= 1024 ? 0 : -1 }"
      class="flex flex-col lg:flex-row gap-6"
    >

      <!-- Левая карточка с фото -->
      <div class="hidden lg:block relative rounded-[24px] bg-background-secondary overflow-hidden lg:w-[45%] min-h-[480px]">

        <!-- Фото / плейсхолдеры (стопкой, crossfade) -->
        {tabs.map((tab, i) =>
          tab.photo ? (
            <img
              src={tab.photo}
              alt={tab.personName}
              class="absolute inset-0 w-full h-full object-cover transition-opacity duration-300 ease-out pointer-events-none"
              :class={`active === ${i} ? 'opacity-100' : 'opacity-0'`}
            />
          ) : (
            <div
              class="absolute inset-0 bg-gray-200 transition-opacity duration-300 ease-out"
              :class={`active === ${i} ? 'opacity-100' : 'opacity-0'`}
            />
          )
        )}

        <!-- Мини-аватарки (левый верхний угол), меняются с табом -->
        {tabs.map((tab, i) => {
          const avs = tab.avatars ?? []
          const shown = avs.slice(0, 2)
          const extra = tab.extraCount ?? (avs.length - 2)
          return (
            <div
              class="absolute top-6 left-6 z-10 flex gap-2 transition-opacity duration-300"
              :class={`active === ${i} ? 'opacity-100' : 'opacity-0'`}
            >
              {shown.map(src =>
                src ? (
                  <img
                    src={src}
                    alt=""
                    class="size-[54px] rounded-[12px] object-cover border-2 border-white"
                  />
                ) : (
                  <div class="size-[54px] rounded-[12px] bg-gray-300 border-2 border-white" />
                )
              )}
              {extra > 0 && (
                <div class="size-[54px] rounded-[12px] bg-white/20 border-2 border-white flex items-center justify-center">
                  <span class="text-h5 text-white">+{extra}</span>
                </div>
              )}
            </div>
          )
        })}

        <!-- Нейм-бейдж (снизу), меняется с табом -->
        {tabs.map((tab, i) => (
          <div
            class="absolute bottom-0 left-0 right-0 z-10 p-6 bg-gray-900/30 backdrop-blur-sm rounded-b-[24px] transition-opacity duration-300 ease-out"
            :class={`active === ${i} ? 'opacity-100' : 'opacity-0'`}
          >
            <p class="text-h4 text-white">{tab.personName}</p>
            <p class="text-body-lg text-white/80 mt-1">{tab.personTitle}</p>
          </div>
        ))}
      </div>

      <!-- Правая колонка: три кликабельные плашки -->
      <div class="flex-1 flex flex-col gap-6">
        {tabs.map((tab, i) => (
          <div
            @click={`if(window.innerWidth >= 1024) active = ${i}`}
            :class={`active === ${i} ? 'bg-gray-900' : 'bg-background-secondary lg:hover:bg-gray-200'`}
            class="rounded-[24px] p-6 flex flex-col gap-8 flex-1 min-h-[220px] lg:cursor-pointer transition-colors duration-300 select-none"
          >
            <!-- Аватарки команды (только мобайл) -->
            {(tab.avatars ?? []).length > 0 && (
              <div class="flex gap-1 lg:hidden">
                {(tab.avatars ?? []).slice(0, 3).map(src =>
                  src ? (
                    <img src={src} alt="" class="size-[54px] rounded-[12px] object-cover border-2 border-white/50 shrink-0" loading="lazy" />
                  ) : (
                    <div class="size-[54px] rounded-[12px] bg-gray-300 border-2 border-white/50 shrink-0" />
                  )
                )}
                {(tab.extraCount !== undefined || (tab.avatars ?? []).length > 3) && (
                  <div
                    class="size-[54px] rounded-[12px] border-2 border-white/50 flex items-center justify-center shrink-0 transition-colors duration-300"
                    :class={`active === ${i} ? 'bg-white/20' : 'bg-gray-200'`}
                  >
                    <span
                      class="text-h5 transition-colors duration-300"
                      :class={`active === ${i} ? 'text-white' : 'text-gray-500'`}
                    >+{tab.extraCount ?? ((tab.avatars ?? []).length - 3)}</span>
                  </div>
                )}
              </div>
            )}

            <!-- Иконка + заголовок -->
            <div class="flex items-center gap-4">
              {tab.icon && (
                <div
                  :class={`active === ${i} ? 'bg-white/10' : 'bg-gray-300'`}
                  class="size-14 rounded-[15px] shrink-0 transition-colors duration-300 hidden lg:flex items-center justify-center"
                >
                  <img
                    src={tab.icon}
                    alt=""
                    :class={`active === ${i} ? 'brightness-0 invert' : ''`}
                    class="size-8 transition-[filter] duration-300"
                  />
                </div>
              )}
              <h3
                :class={`active === ${i} ? 'text-white' : 'text-gray-900'`}
                class="text-h3 transition-colors duration-300"
              >
                {tab.title}
              </h3>
            </div>

            <!-- Пункты -->
            <ul class="flex flex-col gap-3">
              {tab.bullets.map(bullet => (
                <li class="flex items-start gap-3">
                  <span
                    :class={`active === ${i} ? 'bg-brand' : 'bg-gray-300'`}
                    class="size-2 rounded-full shrink-0 mt-[9px] transition-colors duration-300"
                  />
                  <span
                    :class={`active === ${i} ? 'text-white/80' : 'text-gray-500'`}
                    class="text-body-lg transition-colors duration-300"
                  >
                    {bullet}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
