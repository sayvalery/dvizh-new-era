---
/**
 * ReviewFull — обертка над Review с photo.
 * @deprecated Используй Review с prop photo напрямую.
 */
import Review from './Review.astro'

interface Company {
  logo: string
  alt?: string
}

interface Props {
  photo?: { src: string; alt?: string }
  quote: string
  author: string
  role: string
  company?: Company
  caseLink?: { label?: string; href: string }
  class?: string
}

const { photo, quote, author, role, company, caseLink, class: className = '' } = Astro.props
---

<Review
  photo={photo}
  quote={quote}
  author={author}
  role={role}
  company={company}
  caseLink={caseLink}
  variant="dark"
  class={className}
/>
