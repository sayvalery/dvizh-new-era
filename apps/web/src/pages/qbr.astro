---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSection from '../components/ui/HeroSection.astro'
import CTA from '../components/ui/CTA.astro'
---

<SiteLayout bodyClass="fluid-page" title="QBR — квартальный бизнес-обзор — ДВИЖ" description="Подробная аналитика ипотечного рынка. Данные по банкам, ставкам и одобрениям для принятия бизнес-решений." jsonLd={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'ДВИЖ QBR', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', provider: { '@type': 'Organization', name: 'ДВИЖ', url: 'https://dvizh.io' } }}>
  <HeroSection
    badge="QBR"
    title="QBR — квартальный бизнес-обзор"
    description="Готовый отчет ипотечного отдела, который помогает привлечь и закрыть больше клиентов"
  />

  <!-- CTA -->
  <div class="max-w-[1440px] mx-auto px-4 py-12">
    <CTA
      title="Получить пример отчета"
      description="Посмотрите, как QBR поможет вашему ипотечному отделу работать эффективнее"
      buttonText="Получить пример отчета"
      buttonHref="#"
    />
  </div>
</SiteLayout>
