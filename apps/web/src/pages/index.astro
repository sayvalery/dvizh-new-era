---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSection from '../components/ui/HeroSection.astro'
import LogoDrum from '../components/ui/LogoDrum.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import Island from '../components/ui/Island.astro'
import AdvantageCard from '../components/ui/AdvantageCard.astro'
import SuccessStoryBlock from '../components/ui/SuccessStoryBlock.astro'
import ProductBentoBlock from '../components/ui/ProductBentoBlock.astro'
import ProductSection from '../components/ui/ProductSection.astro'
import SupportSection from '../components/ui/SupportSection.astro'
import KeyFacts from '../components/ui/KeyFacts.astro'
import BlogCards from '../components/ui/BlogCards.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import { getBlogPost, getBlogPosts, normalizeBodyHtml, normalizeMediaUrl, sanitizeBodyHtml } from '../lib/payload'

// Фетч статьи для модалки AdvantageCard: CMS → fallback dvizh.io
async function fetchArticleHtml(slug: string): Promise<{ title: string | null, html: string | null }> {
  // 1. Пробуем CMS
  try {
    const post = await getBlogPost(slug)
    if (post?.bodyHtml) {
      const html = sanitizeBodyHtml(normalizeBodyHtml(
        post.bodyHtml
          .replaceAll('href="https://dvizh.webflow.io/', 'href="/')
          .replaceAll('href="https://www.dvizh.io/', 'href="/')
      ))
      return { title: post.title ?? null, html }
    }
  } catch {}

  // 2. Fallback: парсим dvizh.io
  try {
    const res = await fetch(`https://www.dvizh.io/blog/${slug}`)
    const raw = await res.text()
    const bodyStart = raw.indexOf('class="blog-article-body"')
    if (bodyStart !== -1) {
      const tagStart = raw.lastIndexOf('<', bodyStart)
      const innerStart = raw.indexOf('>', tagStart) + 1
      const tagName = raw.slice(tagStart + 1).match(/^[a-zA-Z]+/)?.[0] ?? 'section'
      const openRe = new RegExp(`<${tagName}[\\s>]`, 'gi')
      const closeRe = new RegExp(`</${tagName}>`, 'gi')
      let depth = 1, i = innerStart
      let html: string | null = null
      while (depth > 0 && i < raw.length) {
        openRe.lastIndex = i; closeRe.lastIndex = i
        const nextOpen = openRe.exec(raw)
        const nextClose = closeRe.exec(raw)
        if (!nextClose) break
        if (nextOpen && nextOpen.index < nextClose.index) { depth++; i = nextOpen.index + 1 }
        else { depth--; i = nextClose.index + 1; if (depth === 0) { html = raw.slice(innerStart, nextClose.index); break } }
      }
      const titleMatch = raw.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i)
      const title = titleMatch ? titleMatch[1].replace(/<[^>]+>/g, '').trim() : null
      return { title, html }
    }
  } catch {}

  return { title: null, html: null }
}

const [ayaks, granel, lidov, ereg] = await Promise.all([
  fetchArticleHtml('case-ayaks-dvizh'),
  fetchArticleHtml('granel-rost-procenta-odobreniya'),
  fetchArticleHtml('kak-poluchat-bolshe-kachestvennyh-lidov-po-menshey-stoimosti'),
  fetchArticleHtml('alfavit-polzy-zastroyshchika-elektronnaya-registraciya'),
])

const blogResult = await getBlogPosts({ limit: 3 })
const recentPosts = (blogResult?.docs ?? []).map((post: any) => ({
  image: normalizeMediaUrl(post.cover?.url) ?? '/og-default.jpg',
  imageAlt: post.cover?.alt ?? post.title,
  date: post.publishedAt ?? '',
  category: post.category?.title ?? '',
  categoryHref: post.category?.slug ? `/category/${post.category.slug}` : undefined,
  title: post.title ?? '',
  description: post.excerpt ?? '',
  href: `/blog/${post.slug}`,
}))

const partnerLogos = [
  '/partners/a101.svg',
  '/partners/ava.svg',
  '/partners/ganel.svg',
  '/partners/glorax.svg',
  '/partners/lsr.svg',
  '/partners/strana.svg',
  '/logo-dvizh-white.svg',
]
---

<SiteLayout
  title="Цифровые продукты для рынка недвижимости"
  description="Единая платформа для увеличения продаж. Закрываем весь цикл сделки: от подбора квартиры до одобрения ипотеки и регистрации в Росреестре"
  transparentHeader
>

  {/* ── 1. Hero Section ── */}
  <HeroSection
    title={"ДВИЖ выжимает максимум на рынке, где мало заявок"}
    description={"Единая платформа для увеличения продаж. Закрываем весь цикл сделки: от подбора квартиры до одобрения ипотеки и регистрации в Росреестре"}
    formPreset="lead"
    formSubmitLabel="Получить демо"
    wideTitle
    withGradient
    gradientColors={['#ff4d00', '#ff6b2c', '#ffb347', '#ffd866']}
  >
    <div slot="right" class="w-full h-[700px] hidden xl:block">
      <LogoDrum logos={partnerLogos} duration={55} />
    </div>
    <div slot="logos" class="w-full overflow-x-hidden xl:hidden">
      <LogoGrid
        logos={partnerLogos.map(src => ({ src, alt: '' }))}
        noFade
        white
        noPadding
      />
    </div>
  </HeroSection>

  {/* Sentinel для Island (появляется после скролла мимо Hero) */}
  <div id="hero-sentinel"></div>

  {/* Island — фиксированный CTA внизу экрана */}
  <div
    x-data="{ visible: false }"
    x-init="
      const sentinel = document.getElementById('hero-sentinel');
      if (sentinel) {
        const obs = new IntersectionObserver(([e]) => { visible = !e.isIntersecting }, { threshold: 0 });
        obs.observe(sentinel);
      }
    "
    x-show="visible"
    x-transition:enter="transition duration-300 ease-out"
    x-transition:enter-start="opacity-0 translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition duration-200 ease-in"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-4"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40"
    x-cloak
  >
    <Island
      label="Пора делать ДВИЖ"
      buttonText="Оставить заявку"
      drawerPreset="lead"
    />
  </div>

  {/* ── 2. Девелоперы с ДВИЖ — 4 AdvantageCard ── */}
  {/* gap-24 (96px) base/sm/md / lg:gap-40 (160px) */}
  <div class="flex flex-col gap-24 lg:gap-40 pt-24 lg:pt-40">

  <section>
    <div class="page-container">
      <h2 class="text-h2">Девелоперы с ДВИЖом</h2>
      <div
        x-data="{ active: 0 }"
        @mouseleave="active = 0"
        class="mt-6 md:mt-8 lg:mt-16 grid grid-cols-1 md:grid-cols-2 gap-6"
      >
        <AdvantageCard
          index={0}
          title="Закрывают до 26% больше сделок на том же трафике"
          stat="+26%"
          label="Сделок на том же трафике"
          expandHref="/blog/case-ayaks-dvizh"
        >
          {ayaks.html && (
            <div slot="modal-body" class="p-10">
              {ayaks.title && <h1 class="font-heading text-3xl font-bold mb-8">{ayaks.title}</h1>}
              <div class="prose prose-lg max-w-none" set:html={ayaks.html} />
            </div>
          )}
        </AdvantageCard>
        <AdvantageCard
          index={1}
          title="Снизили количество отказов по ипотеке"
          stat="90%"
          label="Одобрений при объеме выше рынка"
          expandHref="/blog/granel-rost-procenta-odobreniya"
        >
          {granel.html && (
            <div slot="modal-body" class="p-10">
              {granel.title && <h1 class="font-heading text-3xl font-bold mb-8">{granel.title}</h1>}
              <div class="prose prose-lg max-w-none" set:html={granel.html} />
            </div>
          )}
        </AdvantageCard>
        <AdvantageCard
          index={2}
          title="Получают больше выручки на одного менеджера"
          stat="+281%"
          label="Заявок на одного менеджера"
          expandHref="/blog/kak-poluchat-bolshe-kachestvennyh-lidov-po-menshey-stoimosti"
        >
          {lidov.html && (
            <div slot="modal-body" class="p-10">
              {lidov.title && <h1 class="font-heading text-3xl font-bold mb-8">{lidov.title}</h1>}
              <div class="prose prose-lg max-w-none" set:html={lidov.html} />
            </div>
          )}
        </AdvantageCard>
        <AdvantageCard
          index={3}
          title="Сократили расходы на электронную регистрацию"
          stat="-30%"
          label="Затрат на регистрацию"
          expandHref="/blog/alfavit-polzy-zastroyshchika-elektronnaya-registraciya"
        >
          {ereg.html && (
            <div slot="modal-body" class="p-10">
              {ereg.title && <h1 class="font-heading text-3xl font-bold mb-8">{ereg.title}</h1>}
              <div class="prose prose-lg max-w-none" set:html={ereg.html} />
            </div>
          )}
        </AdvantageCard>
      </div>
    </div>
  </section>

  {/* ── 3. Кейсы — SuccessStoryBlock ── */}
  <SuccessStoryBlock
    heading="70+ историй успеха на рынке застройщиков"
    buttonLabel="Получить демо"
    buttonPreset="demo"
    class="!py-0"
    stories={[
      {
        logo: '/api/media/file/lsr_color.svg',
        logoAlt: 'Группа ЛСР',
        logoHover: '/api/media/file/lsr_white-1.svg',
        hoverBackground: '/api/media/file/lsr_bg.png',
        hoverGlass: true,
        titleHtml: 'Помогли начать обрабатывать <span class="text-brand">на 281% заявок больше,</span> чем в среднем на рынке',
        personName: 'Группа ЛСР',
        personJobTitle: 'Один из ведущих строительных холдингов',
      },
      {
        logo: '/api/media/file/tochno_color.svg',
        logoAlt: 'ГК Точно',
        logoHover: '/api/media/file/tochno_white.svg',
        hoverBackground: '/api/media/file/tochno_bg.png',
        titleHtml: 'Увеличили объем закрытых сделок <span class="text-brand">с 1165 до 3500 за год</span>',
        personName: 'ГК «Точно»',
        personJobTitle: 'Крупнейший девелопер Краснодарского края',
      },
      {
        logo: '/api/media/file/samolet_color.svg',
        logoAlt: 'ГК Самолет',
        logoHover: '/api/media/file/samolet_white.svg',
        hoverBackground: '/api/media/file/samolet_bg.png',
        titleHtml: 'Дополнительно продали <span class="text-brand">96 квартир</span>',
        personName: 'ГК «Самолет»',
        personJobTitle: 'Крупнейший федеральный девелопер России',
      },
    ]}
  />


  {/* ── 4. Продукты — ProductBentoBlock ── */}
  <ProductBentoBlock
    eyebrow="наши продукты"
    headingDark="Гибкие решения"
    headingBrand="под любую модель работы"
    subtitle="<strong>Растите вместе с продуктом</strong> — включайте модули по одному, который закрывает вашу самую больную метрику. Дальше расширяйтесь — модули работают по отдельности или в связке"
    cards={[
      {
        variant: "dark",
        title: "Цифровая ипотека",
        description: "40+ банков в одном окне. Анкета «0 полей» через Госуслуги. Параллельная отправка. Авторазбор отказов. Скоринг до отправки в банк.",
        stats: [
          { value: "до 95%", label: "% одобрения", highlight: true },
          { value: "40+", label: "банков-партнеров" },
          { value: "3 дня", label: "срок сделки" },
        ],
      },
      {
        title: "Электронная регистрация ДДУ",
        description: "Подача в Росреестр прямо из ДВИЖ. Автопроверка. Сделка регистрируется за 24 часа",
        statsLayout: "inline",
        stats: [
          { value: "-30%", label: "затраты на регистрацию", highlight: true },
        ],
      },
      {
        title: "Калькулятор ипотеки",
        description: "Актуальные ставки от 40+ банков обновляются автоматически. Клиент сам рассчитывает платеж",
        stats: [
          { value: "+20% конверсия", label: "когда клиент знает свой бюджет ипотеки", highlight: true },
          { value: "80%", label: "вне рабочего времени" },
        ],
      },
      {
        title: "Финансовый скоринг",
        description: "Банковский уровень проверки: кредитная история, долговая нагрузка. 15+ источников, менеджер видит финансовый рейтинг клиента",
        textPosition: "top",
      },
      {
        variant: "brand",
        title: "Нейросети на службе отдела продаж",
        description: "AI-инструменты для скоринга, прогноза и приоритизации заявок. Менеджер видит, кому звонить первым.",
        statsLayout: "inline",
        stats: [
          { value: "+816 млн ₽", label: "доп. выручка (ГК «Самолет»)", highlight: true },
        ],
      },
    ]}
  />

  {/* ── 5. Поддержка — SupportSection ── */}
  <SupportSection
    tabs={[
      {
        title: '15 консультантов поддержки',
        bullets: [
          'Решат технический вопрос прямо в чате',
          'Доступны 24/7 — не дадим сорваться важным сделкам даже в выходные',
          'Знают продукт изнутри и дают конкретные ответы',
        ],
        personName: 'Третьякова Юлия',
        personTitle: 'Руководитель отдела ипотеки и финансовых инструментов',
        photo: '/api/media/file/sup1.webp',
        avatars: ['/api/media/file/sup-small2.jpg', '/api/media/file/sup-small1.jpg'],
        extraCount: 12,
      },
      {
        title: '7 менеджеров успеха',
        bullets: [
          'Настроят платформу под ваши процессы',
          'Проведут обучение для команды',
          'Вовремя подскажут, как решить ваши задачи',
        ],
        personName: 'Иванов Сергей',
        personTitle: 'Руководитель направления Customer Success',
        photo: '/api/media/file/sup2.webp',
        avatars: ['/api/media/file/sup-small3.jpg', '/api/media/file/sup-small2.jpg'],
        extraCount: 4,
      },
      {
        title: '8 аналитиков',
        bullets: [
          'Покажут, какие этапы воронки усилить, чтобы закрыть больше сделок',
          'Соберут и проанализируют портрет целевого клиента',
          'Дадут рекомендации: не выводы, а конкретные шаги',
        ],
        personName: 'Козлова Анна',
        personTitle: 'Руководитель аналитического отдела',
        photo: '/api/media/file/sup3.webp',
        avatars: ['/api/media/file/sup-small1.jpg', '/api/media/file/sup-small3.jpg'],
        extraCount: 5,
      },
    ]}
