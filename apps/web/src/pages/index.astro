          {ayaks.html && (
            <div slot="modal-body" class="p-10">
              {ayaks.title && <h1 class="font-heading text-3xl font-bold mb-8">{ayaks.title}</h1>}
              <div class="prose prose-lg max-w-none" set:html={ayaks.html} />
