      <h2 class="text-[32px] md:text-[48px] lg:text-[64px] font-medium leading-none tracking-[-2px]">Девелоперы с ДВИЖ</h2>
      <div class="mt-16 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <AdvantageCard
          title="Закрывают до\u00A026% больше сделок на\u00A0том же трафике"
          stat="+26%"
          label="Сделок на\u00A0том же трафике"
          expandHref="https://www.dvizh.io/blog/case-ayaks-dvizh"
        >
          {(ayaks.post || ayaks.html) && (
            <article slot="modal-body" class="max-w-3xl mx-auto px-8 py-12">
              {ayaks.title && <h1 class="text-4xl font-bold mb-4">{ayaks.title}</h1>}
              {ayaks.post?.content?.length > 0
                ? <BlockRenderer blocks={ayaks.post.content} />
                : ayaks.html && <div class="prose prose-lg max-w-none mt-8" set:html={ayaks.html} />
              }
            </article>
          )}
        </AdvantageCard>
        <AdvantageCard
          title="Снизили количество отказов по\u00A0ипотеке"
          stat="90%"
          label="Одобрений при\u00A0объёме выше рынка"
          expandHref="https://www.dvizh.io/blog/granel-rost-procenta-odobreniya"
        >
          {(granel.post || granel.html) && (
            <article slot="modal-body" class="max-w-3xl mx-auto px-8 py-12">
              {granel.title && <h1 class="text-4xl font-bold mb-4">{granel.title}</h1>}
              {granel.post?.content?.length > 0
                ? <BlockRenderer blocks={granel.post.content} />
                : granel.html && <div class="prose prose-lg max-w-none mt-8" set:html={granel.html} />
              }
            </article>
          )}
        </AdvantageCard>
        <AdvantageCard
