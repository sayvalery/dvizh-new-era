---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSection from '../components/ui/HeroSection.astro'
import LogoDrum from '../components/ui/LogoDrum.astro'
import BentoGrid from '../components/ui/BentoGrid.astro'
import AdvantageCard from '../components/ui/AdvantageCard.astro'
import FeaturesGrid from '../components/ui/FeaturesGrid.astro'
import SectionBlock from '../components/ui/SectionBlock.astro'
import GradientCTA from '../components/ui/GradientCTA.astro'
import BlogCards from '../components/ui/BlogCards.astro'
import SuccessStoriesCarousel from '../components/ui/SuccessStoriesCarousel.astro'
import ProductSection from '../components/ui/ProductSection.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import CTA from '../components/ui/CTA.astro'
import Island from '../components/ui/Island.astro'
import BlockRenderer from '../components/blocks/BlockRenderer.astro'
import { getBlogPost, normalizeBodyHtml, sanitizeBodyHtml } from '../lib/payload'

// Фетч статьи: CMS → fallback dvizh.io
async function fetchArticle(slug: string): Promise<{ post: any | null, html: string | null, title: string | null }> {
  // 1. Пробуем CMS
  try {
    const post = await getBlogPost(slug)
    if (post) {
      const html = post.bodyHtml
        ? sanitizeBodyHtml(normalizeBodyHtml(
            post.bodyHtml
              .replaceAll('href="https://dvizh.webflow.io/', 'href="/')
              .replaceAll('href="https://www.dvizh.io/', 'href="/')
          ))
        : null
      return { post, html, title: post.title ?? null }
    }
  } catch {}

  // 2. Fallback: парсим dvizh.io
  try {
    const res = await fetch(`https://www.dvizh.io/blog/${slug}`)
    const raw = await res.text()
    const bodyStart = raw.indexOf('class="blog-article-body"')
    if (bodyStart !== -1) {
      const tagStart = raw.lastIndexOf('<', bodyStart)
      const innerStart = raw.indexOf('>', tagStart) + 1
      const tagName = raw.slice(tagStart + 1).match(/^[a-zA-Z]+/)?.[0] ?? 'section'
      const openRe = new RegExp(`<${tagName}[\\s>]`, 'gi')
      const closeRe = new RegExp(`</${tagName}>`, 'gi')
      let depth = 1, i = innerStart, html: string | null = null
      while (depth > 0 && i < raw.length) {
        openRe.lastIndex = i; closeRe.lastIndex = i
        const nextOpen = openRe.exec(raw)
        const nextClose = closeRe.exec(raw)
        if (!nextClose) break
        if (nextOpen && nextOpen.index < nextClose.index) { depth++; i = nextOpen.index + 1 }
        else { depth--; i = nextClose.index + 1; if (depth === 0) { html = raw.slice(innerStart, nextClose.index); break } }
      }
      const titleMatch = raw.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i)
      const title = titleMatch ? titleMatch[1].replace(/<[^>]+>/g, '').trim() : null
      return { post: null, html, title }
    }
  } catch {}

  return { post: null, html: null, title: null }
}

const [ayaks, granel, lidov, ereg] = await Promise.all([
  fetchArticle('case-ayaks-dvizh'),
  fetchArticle('granel-rost-procenta-odobreniya'),
  fetchArticle('kak-poluchat-bolshe-kachestvennyh-lidov-po-menshey-stoimosti'),
  fetchArticle('alfavit-polzy-zastroyshchika-elektronnaya-registraciya'),
])

const partnerLogos = [
  '/partners/a101.svg',
  '/partners/ava.svg',
  '/partners/ganel.svg',
  '/partners/glorax.svg',
  '/partners/lsr.svg',
  '/partners/strana.svg',
  '/logo-dvizh-white.svg',
]
---

<SiteLayout
