  {/* ── 6. KeyFacts ── */}
  <KeyFacts
    class="!py-0"
    items={[
      { value: 'Uptime 99,9%', description: 'Uptime платформы 99,9%' },
      { value: 'Безопасность', description: 'Подтверждена отделами ИБ крупнейших застройщиков и банков страны' },
      { value: '152 ФЗ', description: 'Соответствие стандартам 152 ФЗ' },
    ]}
    variant="large"
  />

  {/* ── 7. Блог — из CMS ── */}
  {recentPosts.length > 0 && (
    <BlogCards
      title="ДВИЖ журнал"
      description="Экспертные материалы о цифровизации продаж в девелопменте"
      articles={recentPosts}
      class="!py-0"
    />
  )}

  {/* ── 8. FormClosing ── */}
  <FormClosing
    preset="lead"
    title="Не оставим вас одних"
    description="За каждым клиентом закреплен менеджер, который обучит вашу команду, подключит все виджеты и ответит на ваши вопросы в течение 57 секунд"
    submitLabel="Оставить заявку"
    class="!py-0"
  />

  </div>

</SiteLayout>
