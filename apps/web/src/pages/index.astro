          expandHref="https://www.dvizh.io/blog/alfavit-polzy-zastroyshchika-elektronnaya-registraciya"
        >
          {(ereg.post || ereg.html) && (
            <article slot="modal-body" class="max-w-3xl mx-auto px-8 py-12">
              {ereg.title && <h1 class="text-4xl font-bold mb-4">{ereg.title}</h1>}
              {ereg.post?.content?.length > 0
                ? <BlockRenderer blocks={ereg.post.content} />
                : ereg.html && <div class="prose prose-lg max-w-none mt-8" set:html={ereg.html} />
              }
