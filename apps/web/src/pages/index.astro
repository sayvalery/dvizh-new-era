---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSection from '../components/ui/HeroSection.astro'
import LogoDrum from '../components/ui/LogoDrum.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import Island from '../components/ui/Island.astro'
import AdvantageCard from '../components/ui/AdvantageCard.astro'
import SuccessStoryBlock from '../components/ui/SuccessStoryBlock.astro'
import ProductSection from '../components/ui/ProductSection.astro'
import SupportSection from '../components/ui/SupportSection.astro'
import KeyFacts from '../components/ui/KeyFacts.astro'
import BlogCards from '../components/ui/BlogCards.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import { getBlogPost, getBlogPosts, normalizeBodyHtml, normalizeMediaUrl, sanitizeBodyHtml } from '../lib/payload'

// Фетч статьи для модалки AdvantageCard: CMS → fallback dvizh.io
async function fetchArticleHtml(slug: string): Promise<{ title: string | null, html: string | null }> {
  // 1. Пробуем CMS
  try {
    const post = await getBlogPost(slug)
    if (post?.bodyHtml) {
      const html = sanitizeBodyHtml(normalizeBodyHtml(
        post.bodyHtml
          .replaceAll('href="https://dvizh.webflow.io/', 'href="/')
          .replaceAll('href="https://www.dvizh.io/', 'href="/')
      ))
      return { title: post.title ?? null, html }
    }
  } catch {}

  // 2. Fallback: парсим dvizh.io
  try {
    const res = await fetch(`https://www.dvizh.io/blog/${slug}`)
    const raw = await res.text()
    const bodyStart = raw.indexOf('class="blog-article-body"')
    if (bodyStart !== -1) {
      const tagStart = raw.lastIndexOf('<', bodyStart)
      const innerStart = raw.indexOf('>', tagStart) + 1
      const tagName = raw.slice(tagStart + 1).match(/^[a-zA-Z]+/)?.[0] ?? 'section'
      const openRe = new RegExp(`<${tagName}[\\s>]`, 'gi')
      const closeRe = new RegExp(`</${tagName}>`, 'gi')
      let depth = 1, i = innerStart
      let html: string | null = null
      while (depth > 0 && i < raw.length) {
        openRe.lastIndex = i; closeRe.lastIndex = i
        const nextOpen = openRe.exec(raw)
        const nextClose = closeRe.exec(raw)
        if (!nextClose) break
        if (nextOpen && nextOpen.index < nextClose.index) { depth++; i = nextOpen.index + 1 }
        else { depth--; i = nextClose.index + 1; if (depth === 0) { html = raw.slice(innerStart, nextClose.index); break } }
      }
      const titleMatch = raw.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i)
      const title = titleMatch ? titleMatch[1].replace(/<[^>]+>/g, '').trim() : null
      return { title, html }
    }
  } catch {}

  return { title: null, html: null }
}

const [ayaks, granel, lidov, ereg] = await Promise.all([
  fetchArticleHtml('case-ayaks-dvizh'),
  fetchArticleHtml('granel-rost-procenta-odobreniya'),
  fetchArticleHtml('kak-poluchat-bolshe-kachestvennyh-lidov-po-menshey-stoimosti'),
  fetchArticleHtml('alfavit-polzy-zastroyshchika-elektronnaya-registraciya'),
])

const blogResult = await getBlogPosts({ limit: 3 })
const recentPosts = (blogResult?.docs ?? []).map((post: any) => ({
  image: normalizeMediaUrl(post.cover?.url) ?? '/og-default.jpg',
  imageAlt: post.cover?.alt ?? post.title,
  date: post.publishedAt ?? '',
  category: post.category?.title ?? '',
  categoryHref: post.category?.slug ? `/category/${post.category.slug}` : undefined,
  title: post.title ?? '',
  description: post.excerpt ?? '',
  href: `/blog/${post.slug}`,
}))

const partnerLogos = [
  '/partners/a101.svg',
  '/partners/ava.svg',
  '/partners/ganel.svg',
  '/partners/glorax.svg',
  '/partners/lsr.svg',
  '/partners/strana.svg',
  '/logo-dvizh-white.svg',
]
