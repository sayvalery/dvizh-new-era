---
/**
 * Редирект-страница /category/[category] → /blog/category/[category]
 *
 * Старый маршрут категории сохранен только для совместимости со ссылками,
 * которые еще ведут на /category/<slug> (напр. с главной index.astro).
 * Сама страница категории живет под /blog/category/[cat].
 *
 * Слаги генерируются по категориям, встречающимся у постов — те же, что у
 * /blog/category, чтобы цель редиректа существовала.
 */
import { getBlogPosts } from '../../lib/payload'

export async function getStaticPaths() {
  const { docs } = await getBlogPosts({ limit: 200, depth: 2 })
  const slugs = [...new Set(docs.map((p: any) => p.category?.slug).filter(Boolean))]
  return slugs.map((slug) => ({ params: { category: slug } }))
}

const { category } = Astro.params
const target = `/blog/category/${category}`
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Перенаправление…</title>
    <script is:inline set:html={`location.replace(${JSON.stringify(target)})`}></script>
  </head>
  <body>
    <p>Страница переехала: <a href={target}>{target}</a></p>
  </body>
</html>
