---
/**
 * Для девелоперов — ДВИЖ
 */
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import PixelArrowPattern from '../components/ui/PixelArrowPattern.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import SuccessStoryBlock from '../components/ui/SuccessStoryBlock.astro'
import FeatureBlock from '../components/ui/FeatureBlock.astro'
import FunnelSection from '../components/ui/FunnelSection.astro'
import ComparisonSection from '../components/ui/ComparisonSection.astro'

const cms = import.meta.env.PUBLIC_CMS_URL
---

<SiteLayout
  title="Для девелоперов"
  description="ДВИЖ — платформа полного цикла для роста продаж у девелоперов: контроль каждого этапа воронки, эффективное одобрение ипотеки и до 26% больше закрытых сделок без роста затрат на маркетинг."
  htmlClass="fluid-scale"
>
  <!-- Hero full layout: контент внизу + слот для анимации -->
  <HeroSectionFull
    title="ДВИЖ – платформа полного цикла для роста продаж у девелоперов"
    description="Позволяет контролировать каждый этап воронки продаж, эффективнее одобрять ипотеку и закрывать до 26% больше сделок без увеличения затрат на маркетинг"
    demoLabel="Записаться на демо"
    kpLabel="Попробовать бесплатно"
    demoPreset="demo"
    kpPreset="lead"
    mobileBg="https://admin.dvizh.cc/api/media/file/developers-hero-mobile.webp"
  >
    <PixelArrowPattern slot="background" />
    <img
      id="hero-img"
      slot="right"
      src="https://admin.dvizh.cc/api/media/file/developers-hero.webp"
      alt=""
      class="h-[106dvh] w-auto object-contain"
      style="max-width: none; opacity: 0; transform: translateY(20px)"
      loading="eager"
      fetchpriority="high"
    />
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/a101.svg', alt: 'А101' },
        { src: '/partners/dark/ava.svg', alt: 'AVA' },
        { src: '/partners/dark/glorax.svg', alt: 'Глоракс' },
        { src: '/partners/dark/ganel.svg', alt: 'Гранель' },
        { src: '/partners/dark/strana.svg', alt: 'Страна' },
        { src: '/partners/dark/lsr.svg', alt: 'ЛСР' },
      ]}
    />
  </HeroSectionFull>

  {/* Reveal-анимация hero-картинки: невидима → плавно выплывает снизу → передает управление float */}
  <script>
    const img = document.getElementById('hero-img') as HTMLImageElement | null
    if (img) {
      const reveal = () => {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          img.style.transition = 'opacity 0.7s ease-out, transform 0.7s ease-out'
          img.style.opacity    = '1'
          img.style.transform  = 'translateY(0)'
        }))
        setTimeout(() => {
          img.style.transition = ''
          img.style.opacity    = ''
          img.style.transform  = ''
          img.classList.add('animate-hero-float')
        }, 750)
      }
      if (img.complete && img.naturalWidth > 0) reveal()
      else img.addEventListener('load', reveal, { once: true })
    }
  </script>

  <!-- gap-24/40 между блоками + mt-24 lg:mt-32 — воздух на стыке hero↔первый блок (флюид) -->
  <div class="flex flex-col gap-24 lg:gap-40 mt-24 lg:mt-32">

  <!-- DeveloperBlock -->
  <FeatureBlock
    class="!py-0"
    heading="Повышаем конверсию в&nbsp;2&nbsp;раза"
    features={[
      {
        title: '40+ банков-партнеров',
        subtitle: '15 «быстрых» банков по API',
        image: `${cms}/api/media/file/developers_difficult-clients_banks-grid.webp`,
      },
      {
        title: '«Умный» скоринг покупателя',
        subtitle: 'До отправки в банк',
        image: `${cms}/api/media/file/developers_difficult-clients_score-256.webp`,
      },
      {
        title: 'Встроенный ипотечный калькулятор',
        subtitle: 'На сайте застройщика',
        image: `${cms}/api/media/file/developers_lead-quality_mortgage-calculator.webp`,
      },
      {
        title: 'Анкета «0 полей»',
        subtitle: 'Через Госуслуги',
        image: `${cms}/api/media/file/developers_faster-competitors_unified-form.webp`,
      },
      {
        title: 'Прямая связь с куратором',
        subtitle: 'На стороне банка',
        image: `${cms}/api/media/file/developers_speed-up_stuck-tickets.webp`,
      },
      {
        title: 'Контроль «зависших» обращений 24/7',
        image: `${cms}/api/media/file/developers_to-the-end_text-to-tags.webp`,
      },
    ]}
  />



  <!-- SuccessStoryBlock -->
  <SuccessStoryBlock
    heading="70+ историй успеха на рынке застройщиков"
    buttonLabel="Получить демо"
    buttonPreset="demo"
    class="!py-0"
    stories={[
      {
        logo: '/api/media/file/lsr_color.svg',
        logoAlt: 'Группа ЛСР',
        logoHover: '/api/media/file/lsr_white-1.svg',
        hoverBackground: '/api/media/file/lsr_bg.png',
        hoverGlass: true,
        href: '/blog/keys-lsr-dvizh',
        titleHtml: 'Помогли начать обрабатывать <span class="text-brand">на 281% заявок больше,</span> чем в среднем на рынке',
        personName: 'Группа ЛСР',
        personJobTitle: 'Один из ведущих строительных холдингов',
      },
      {
        logo: '/api/media/file/tochno_color.svg',
        logoAlt: 'ГК Точно',
        logoHover: '/api/media/file/tochno_white.svg',
        hoverBackground: '/api/media/file/tochno_bg.png',
        href: '/blog/keys-gk-tochno-i-dvizha',
        titleHtml: 'Увеличили объем закрытых сделок <span class="text-brand">с 1165 до 3500 за год</span>',
        personName: 'ГК «Точно»',
        personJobTitle: 'Крупнейший девелопер Краснодарского края',
      },
      {
        logo: '/api/media/file/samolet_color.svg',
        logoAlt: 'ГК Самолет',
        logoHover: '/api/media/file/samolet_white.svg',
        hoverBackground: '/api/media/file/samolet_bg.png',
        href: '/blog/samolet-ai-u-developera',
        titleHtml: 'Дополнительно продали <span class="text-brand">96 квартир</span>',
        personName: 'ГК «Самолет»',
        personJobTitle: 'Крупнейший федеральный девелопер России',
      },
    ]}
  />

  <!-- FunnelSection — воронка по этапам сделки -->
  <FunnelSection
      heading="Добиваемся высоких конверсий на каждом этапе сделки"
      groups={[
        {
          label: 'Лидогенерация',
          cards: [
            { title: 'Калькулятор ипотеки и рассрочки', description: 'Собирайте заявки в нерабочее время', icon: `${cms}/api/media/file/calc_mini-1.png` },
            { title: 'Витрина', description: 'Клиент сам выбирает и бронирует квартиру', icon: `${cms}/api/media/file/vitrina_mini-1.png` },
            { title: 'Личный кабинет клиента', description: 'Объедините офлайн и онлайн продажи', icon: `${cms}/api/media/file/lk_mini.png` },
          ],
        },
        {
          label: 'Управление заявками',
          cards: [
            { title: 'Цифровая ипотека', description: 'Одобряйте до 95% заявок', icon: `${cms}/api/media/file/mortgage_mini.png` },
            { title: 'Финансовый скоринг', description: 'Доведем больше клиентов до одобрения', icon: `${cms}/api/media/file/fin_mini.png` },
          ],
        },
        {
          label: 'Регистрация собственности',
          cards: [
            { title: 'Электронная регистрация', description: 'Регистрируйте сделки любого типа и сложности', icon: `${cms}/api/media/file/rega_mini.png` },
          ],
        },
      ]}
  />

  <!-- ComparisonSection -->
  <ComparisonSection
    title="Одно решение для всей сделки"
    leftTitle="Без ДВИЖа"
    leftItems={[
      'Данные клиента теряются, сделка застревает между отделами',
      'Менеджер тратит время на нецелевых клиентов и не выполняет KPI',
      'Нет потенциала для апсейла клиентов',
      'Менеджер узнает о финансовых проблемах клиента после отказа в банке',
      'Море цифр и ни одного ответа на вопрос: почему сделка так и не закрылась за полгода',
    ]}
    rightItems={[
      'Вся сделка в одном окне: от заявки до регистрации в Росреестре — без ошибок и потерянных часов',
      'Менеджер успевает в 2 раза больше, выполняет KPI и не забывает про кофе-брейки',
      'Средний чек и допродажи постоянно растут',
      'Менеджер знает о платежеспособности клиентов больше, чем они сами',
      'Вклад каждого сотрудника виден как под микроскопом',
    ]}
    rightLogoSrc={`${cms}/api/media/file/dvizh_comp.svg`}
    rightLogoAlt="ДВИЖ"
    primaryButtonText="Записаться на демо"
    primaryDrawerPreset="demo"
    secondaryButtonText="Попробовать бесплатно"
  />

  <!-- Form Closing -->
  <FormClosing
    mode="buttons"
    title="Аудит вашего отдела продаж от аналитиков ДВИЖа"
    items={[
      'Выявим системные ошибки в процессах',
      'Покажем быстрые точки роста',
      'Предложим решения, которые подойдут именно вам',
    ]}
    primaryButton={{ label: 'Получить аудит', drawerPreset: 'demo' }}
    secondaryButton={{ label: 'Скачать пример', drawerPreset: 'lead' }}
  />

  </div>{/* /gap-контейнер */}

</SiteLayout>
