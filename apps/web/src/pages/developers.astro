---
/**
 * Для девелоперов — ДВИЖ
 */
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSection from '../components/ui/HeroSection.astro'
import LogoMarquee from '../components/lab-new/LogoMarquee.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import SuccessStoryBlock from '../components/ui/SuccessStoryBlock.astro'
import DeveloperBlock from '../components/ui/DeveloperBlock.astro'
import ModalSection from '../components/ui/ModalSection.astro'
import ComparisonSection from '../components/ui/ComparisonSection.astro'
---

<SiteLayout title="Для девелоперов" bodyClass="bg-background-primary">
  <!-- Hero full layout: контент внизу + слот для анимации -->
  <HeroSection
    layout="full"
    title="ДВИЖ – платформа полного цикла для роста продаж у девелоперов"
    description="Позволяет контролировать каждый этап воронки продаж, эффективнее одобрять ипотеку и закрывать до 26% больше сделок без увеличения затрат на маркетинг"
    demoLabel="Записаться на демо"
    kpLabel="Пробовать бесплатно"
    demoPreset="demo"
    kpPreset="lead"
  />
  <!-- DeveloperBlock -->
  <DeveloperBlock
    heading="Повышаем конверсию в&nbsp;2&nbsp;раза"
    features={[
      {
        title: '40+ банков-партнёров',
        subtitle: '15 «быстрых» банков по API',
      },
      { title: '«Умный» скоринг покупателя', subtitle: 'До отправки в банк' },
      { title: 'Встроенный ипотечный калькулятор', subtitle: 'На сайте застройщика' },
      { title: 'Анкета «0 полей»', subtitle: 'Через Госуслуги' },
      { title: 'Прямая связь с куратором', subtitle: 'На стороне банка' },
      { title: 'Контроль «зависших» обращений 24/7' },
    ]}
  />

  <!-- Бегущая строка с логотипами -->
  <LogoMarquee
    logos={[
      { name: 'ЛСР', src: '/partners/lsr.svg' },
      { name: 'А101', src: '/partners/a101.svg' },
      { name: 'AVA', src: '/partners/ava.svg' },
      { name: 'Глоракс', src: '/partners/glorax.svg' },
      { name: 'Гранель', src: '/partners/ganel.svg' },
      { name: 'Страна', src: '/partners/strana.svg' },
    ]}
  />

  <!-- SuccessStoryBlock -->
  <SuccessStoryBlock
    heading="70+ историй успеха на рынке застройщиков"
    buttonLabel="Получить демо"
    buttonPreset="demo"
    stories={[
      {
        logo: '/api/media/file/lsr_color.svg',
        logoAlt: 'Группа ЛСР',
        titleHtml: 'Помогли начать обрабатывать <span class="text-brand">на 281% заявок больше,</span> чем в среднем на рынке',
        personName: 'Группа ЛСР',
        personJobTitle: 'Один из ведущих строительных холдингов',
      },
      {
        logo: '/api/media/file/tochno_color.svg',
        logoAlt: 'ГК Точно',
        titleHtml: 'Увеличили объём закрытых сделок <span class="text-brand">с 1165 до 3500 за год</span>',
        personName: 'ГК «Точно»',
        personJobTitle: 'Крупнейший девелопер Краснодарского края',
      },
      {
        logo: '/api/media/file/samolet_color.svg',
        logoAlt: 'ГК Самолет',
        titleHtml: 'Дополнительно продали <span class="text-brand">96 квартир</span>',
        personName: 'ГК «Самолет»',
        personJobTitle: 'Крупнейший федеральный девелопер России',
      },
    ]}
  />

  <!-- ModalSection — продукты по этапам сделки -->
  <section class="py-16 lg:py-20">
    <div class="page-container">
      <ModalSection
        heading="Добиваемся высоких конверсий на каждом этапе сделки"
        groups={[
          {
            label: 'Лидогенерация',
            cards: [
              { title: 'Ипотечный калькулятор', description: 'Собирайте заявки в нерабочее время', href: '/ipotechnyy-kalkulyator' },
              { title: 'Личный кабинет клиента', description: 'Объедините офлайн и онлайн продажи', href: '/lichnyy-kabinet' },
              { title: 'Витрина', description: 'Клиент сам выбирает и бронирует квартиру', href: '/vitrina' },
            ],
          },
          {
            label: 'Управление заявками',
            cards: [
              { title: 'Цифровая ипотека', description: 'Одобряйте до 95% заявок', href: '/ipoteka' },
              { title: 'Финансовый скоринг', description: 'Сократите число отказов в банках', href: '/scoring' },
            ],
          },
          {
            label: 'Регистрация собственности',
            cards: [
              { title: 'Электронная регистрация', description: 'Регистрируйте сделки любого типа и сложности', href: '/elektronnaya-registraciya' },
            ],
          },
        ]}
      />
    </div>
  </section>

  <!-- ComparisonSection -->
  <ComparisonSection
    title="Одно решение для всей сделки"
    leftTitle="Без ДВИЖа"
    leftItems={[
      'Среднее одобрение меньше 60%',
      'Много продуктов, ошибки при переносе данных',
      'Менеджер теряет заявки и выполняет KPI по продажам',
    ]}
    rightItems={[
      'Процент одобрения до 95%',
      'Весь процесс в одном окне: от заявки до регистрации в Росреестре. Без ошибок и переплат',
      'Менеджер успевает в 2 раза больше, выполняет KPI и не забывает про кофе-брейк с коллегами',
    ]}
    primaryButtonText="Записаться на демо"
    primaryDrawerPreset="demo"
    secondaryButtonText="Пробовать бесплатно"
  />

  <!-- Form Closing -->
  <section class="py-20">
    <div class="max-w-[1440px] mx-auto px-4">
      <FormClosing
        title="Не оставим вас одних"
        description="За каждым клиентом закреплён менеджер, который обучит вашу команду, подключит все виджеты и ответит на ваши вопросы в течение 57 секунд"
        preset="lead"
        submitLabel="Отправить заявку"
        bgColor="bg-gray-100"
        bgImage="https://admin.dvizh.cc/api/media/file/form-image.jpg"
        showGradient={false}
        privacyText="Нажимая кнопку «Отправить заявку», вы даёте согласие на обработку ваших персональных данных"
      />
    </div>
  </section>
</SiteLayout>
