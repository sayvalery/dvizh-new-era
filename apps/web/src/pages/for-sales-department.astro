---
/**
 * Для департамента продаж — ДВИЖ
 */
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import KeyFacts from '../components/ui/KeyFacts.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import AdvantageCard from '../components/ui/AdvantageCard.astro'
import FeatureBlock from '../components/ui/FeatureBlock.astro'
import ReviewFull from '../components/ui/ReviewFull.astro'
import SuccessStoryBlock from '../components/ui/SuccessStoryBlock.astro'
import ComparisonSection from '../components/ui/ComparisonSection.astro'

const cms = import.meta.env.PUBLIC_CMS_URL
---

<SiteLayout title="Для департамента продаж" description="Единая платформа для повышения продаж. Помогаем отделам продаж выполнять KPI." bodyClass="bg-background-primary">
  <HeroSectionFull
    title="Ускоряем цикл сделки и&#160;забираем на&#160;себя всю&#160;рутину"
    description="Единая платформа для повышения продаж. Помогаем отделам продаж выполнять KPI"
    demoLabel="Получить демо"
    kpLabel="Получить КП"
    demoPreset="demo"
    kpPreset="lead"
  >
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/fsk.svg', alt: 'ФСК' },
        { src: '/partners/dark/mrgroup.svg', alt: 'MR Group' },
        { src: '/partners/dark/donstroy.svg', alt: 'Донстрой' },
        { src: '/partners/dark/a101.svg', alt: 'А101' },
        { src: '/partners/dark/setl.svg', alt: 'Setl Group' },
        { src: '/partners/dark/etalon.svg', alt: 'Эталон' },
        { src: '/partners/dark/strana.svg', alt: 'Страна' },
        { src: '/partners/dark/dogma.svg', alt: 'Догма' },
        { src: '/partners/dark/glorax.svg', alt: 'Глоракс' },
        { src: '/partners/dark/ava.svg', alt: 'AVA' },
        { src: '/partners/dark/samolet.svg', alt: 'Самолёт' },
      ]}
    />
  </HeroSectionFull>

  <div class="flex flex-col gap-24 lg:gap-40">
    <KeyFacts
      class="!pb-0"
      variant="large"
      items={[
        { value: 'На 26%', description: 'больше сделок закрываем на том же трафике' },
        { value: '1 500 000+', description: 'сделок на рынке прошло через Движ' },
        { value: '79', description: 'застройщиков партнеров из ТОП-100 ЕРЗ' },
        { value: '40+', description: 'банков партнеров' },
      ]}
    />

    <!-- FormClosing -->
    <FormClosing
      mode="buttons"
      title="Каждая третья ипотека"
      description="на первичном рынке России выдается с&#160;помощью ДВИЖа"
      primaryButton={{ label: 'Больше о нас', href: '/about' }}
    />

    <!-- Мы помогаем -->
    <div class="page-container">
      <h2 class="text-h2">Мы помогаем</h2>
      <div
        x-data="{ active: 0 }"
        @mouseleave="active = 0"
        class="mt-6 md:mt-8 lg:mt-16 grid grid-cols-1 md:grid-cols-2 gap-6"
      >
        <AdvantageCard
          index={0}
          title="Наполнить воронку качественными лидами"
          stat="+281%"
          label="Заявок на&#160;одного менеджера"
        />
        <AdvantageCard
          index={1}
          title="Закрыть клиентов быстрее, чем конкуренты"
          stat="×16"
          label="Одна заявка вместо шестнадцати писем"
        />
        <AdvantageCard
          index={2}
          title="Увеличить средний чек и&#160;допродажи"
          stat="×3"
          label="Сделок без&#160;увеличения штата"
        />
        <AdvantageCard
          index={3}
          title="Увидеть результат работы каждого сотрудника"
          stat="90%"
          label="Одобрений при&#160;объеме выше рынка"
        />
      </div>
    </div>

    <!-- Повышаем качество лидов -->
    <FeatureBlock
      class="!py-0"
      heading="Повышаем качество лидов"
      description="Какой-то небольшой подзаголовок + ссылка на&#160;блог на&#160;какую-то определенную подборку статей / кейсов?"
      button={{ label: 'Узнать больше', href: '/blog' }}
      features={[
        {
          title: 'Форма на сайт для проверки кредитного рейтинга',
          subtitle: 'Приведем надежных клиентов',
          image: '/api/media/file/sales_lead-quality_credit-form-embed.webp',
        },
        {
          title: 'Скоринг по банковским стандартам',
          image: '/api/media/file/sales_lead-quality_score.webp',
        },
        {
          title: 'Ипотечный калькулятор для сайта',
          image: '/api/media/file/sales_lead-quality_mortgage-calculator.webp',
        },
      ]}
    />

    <!-- Помогаем закрывать даже сложных клиентов -->
    <FeatureBlock
      class="!py-0"
      heading="Помогаем закрывать даже сложных клиентов…"
      description="Какой-то небольшой подзаголовок + ссылка на&#160;блог на&#160;какую-то определенную подборку статей / кейсов?"
      imageSide="left"
      button={{ label: 'Узнать больше', href: '/blog' }}
      features={[
        {
          title: 'Финансовый скоринг',
          subtitle: 'Покажет, как улучшить портрет клиента до отправки заявки в банк',
          image: '/api/media/file/sales_difficult-clients_score.webp',
        },
        {
          title: '40+ банков-партнеров',
          image: '/api/media/file/sales_difficult-clients_banks-grid.webp',
        },
        {
          title: 'ДВИЖ AI',
          image: '/api/media/file/sales_difficult-clients_ai-prognosis.webp',
        },
      ]}
    />

    <!-- … и делать это быстрее конкурентов + отзыв -->
    <div class="flex flex-col gap-16">
    <FeatureBlock
      class="!py-0"
      heading="… и делать это быстрее конкурентов"
      description="Какой-то небольшой подзаголовок + ссылка на&#160;блог на&#160;какую-то определенную подборку статей / кейсов?"
      imageSide="left"
      button={{ label: 'Узнать больше', href: '/blog' }}
      features={[
        {
          title: 'Актуальные статусы по сделке в CRM',
          subtitle: 'Контроль каждого этапа в карточке клиента',
          image: '/api/media/file/sales_faster-competitors_crm-dashboard.webp',
        },
        {
          title: 'Одна анкета для всех этапов',
          image: '/api/media/file/sales_faster-competitors_unified-form.webp',
        },
        {
          title: 'Все в одном месте',
          image: '/api/media/file/sales_faster-competitors_seamless-timeline.webp',
        },
        {
          title: 'Пакетное распознавание документов',
          image: '/api/media/file/sales_faster-competitors_doc-recognition.webp',
        },
        {
          title: 'Заполнение анкеты через Госуслуги за 30 секунд',
          image: '/api/media/file/sales_faster-competitors_gosuslugi-form.webp',
        },
      ]}
    />
      <div class="page-container">
        <ReviewFull
          photo={{ src: "https://admin.dvizh.cc/api/media/file/ch.png", alt: "Екатерина Чурюкина" }}
          quote="С появлением ДВИЖа мы ускорили подачу заявок с&#160;часа до&#160;5&#160;минут и&#160;минимизировали ошибки в&#160;заполнении анкет"
          author="Екатерина Чурюкина"
          role="Руководитель управления прямых продаж"
          company={{ logo: '/api/media/file/fsk_color.svg', alt: 'ФСК' }}
          caseLink={{ label: 'Читать кейс', href: '/cases/fsk' }}
        />
      </div>
    </div>

    <!-- Раскрываем финансовый потенциал клиентов -->
    <FeatureBlock
      class="!py-0"
      heading="Раскрываем финансовый потенциал клиентов"
      description="Какой-то небольшой подзаголовок + ссылка на&#160;блог на&#160;какую-то определенную подборку статей / кейсов?"
      button={{ label: 'Узнать больше', href: '/blog' }}
      features={[
        {
          title: 'Финансовый скоринг',
          subtitle: 'Покажет, как улучшить портрет клиента до отправки заявки в банк',
          image: '/api/media/file/sales_financial-potential_score-recommendations.webp',
        },
        {
          title: 'Расчет ПДН',
          image: '/api/media/file/sales_financial-potential_pdn-calculation.webp',
        },
      ]}
    />

    <!-- Делаем работу менеджеров управляемой + отзыв -->
    <div class="flex flex-col gap-16">
    <FeatureBlock
      class="!py-0"
      heading="Делаем работу менеджеров управляемой"
      description="Какой-то небольшой подзаголовок + ссылка на&#160;блог на&#160;какую-то определенную подборку статей / кейсов?"
      imageSide="left"
      button={{ label: 'Узнать больше', href: '/blog' }}
      features={[
        {
          title: 'Контроль всех этапов через CRM',
          subtitle: 'Покажем, как быстро менеджер взял сделку в работу',
          image: '/api/media/file/sales_manager-control_seamless-timeline.webp',
        },
        {
          title: 'Отображаем статусы сделки в CRM',
          image: '/api/media/file/sales_manager-control_crm-dashboard.webp',
        },
        {
          title: 'Актуальная статистика',
          image: '/api/media/file/sales_manager-control_weekly-stats.webp',
        },
      ]}
    />
      <div class="page-container">
        <ReviewFull
          photo={{ src: "https://admin.dvizh.cc/api/media/file/sh.png", alt: "Лилия Шаповалова" }}
          quote="Я вижу результаты работы каждого сотрудника как под микроскопом, какой вклад каждый из них вносит в общий результат. И если у кого-то показатели ухудшаются, я смогу быстро это заметить и вовремя проработать вопрос"
          author="Лилия Шаповалова"
          role="Руководитель ипотечного отдела"
          company={{ logo: '/api/media/file/donstroy.svg', alt: 'Донстрой' }}
        />
      </div>
    </div>

    <!-- SuccessStoryBlock -->
    <SuccessStoryBlock
      heading="70+ историй успеха на&#160;рынке застройщиков"
      buttonLabel="Получить демо"
      buttonPreset="demo"
      stories={[
        {
          logo: '/api/media/file/lsr_color.svg',
          logoAlt: 'Группа ЛСР',
          titleHtml: 'Помогли начать обрабатывать <span class="text-brand">на&#160;281% заявок больше,</span> чем&#160;в среднем на&#160;рынке',
          personName: 'Группа ЛСР',
          personJobTitle: 'Один из ведущих строительных холдингов',
        },
        {
          logo: '/api/media/file/tochno_color.svg',
          logoAlt: 'ГК Точно',
          titleHtml: 'Увеличили объем закрытых сделок <span class="text-brand">с&#160;1165 до&#160;3500 за&#160;год</span>',
          personName: 'ГК «Точно»',
          personJobTitle: 'Крупнейший девелопер Краснодарского края',
        },
        {
          logo: '/api/media/file/samolet_color.svg',
          logoAlt: 'ГК Самолет',
          titleHtml: 'Дополнительно продали <span class="text-brand">96 квартир</span>',
          personName: 'ГК «Самолет»',
          personJobTitle: 'Крупнейший федеральный девелопер России',
        },
      ]}
    />

    <!-- ComparisonSection -->
    <ComparisonSection
      title="Одно решение для&#160;всей сделки"
      leftTitle="Без ДВИЖа"
      leftItems={[
        'Данные клиента теряются, сделка застревает между отделами',
        'Менеджер тратит время на нецелевых клиентов и не выполняет KPI',
        'Нет потенциала для апсейла клиентов',
        'Менеджер узнает о финансовых проблемах клиента после отказа в банке',
        'Море цифр и ни одного ответа на вопрос: почему сделка так и не закрылась за полгода',
      ]}
      rightItems={[
        'Вся сделка в одном окне: без ошибок и потерянных часов',
        'Менеджер успевает в 2 раза больше, выполняет KPI и не забывает про кофе-брейки',
        'Средний чек и допродажи постоянно растут',
        'Менеджер знает о платежеспособности клиентов больше, чем они сами',
        'Вклад каждого сотрудника виден как под микроскопом',
      ]}
      rightLogoSrc={`${cms}/api/media/file/dvizh_comp.svg`}
      rightLogoAlt="ДВИЖ"
      primaryButtonText="Получить демо"
      primaryDrawerPreset="demo"
      secondaryButtonText=""
    />

    <!-- FormClosing -->
    <FormClosing
      preset="lead"
      title="Попробуйте ДВИЖ в&#160;деле"
      items={[
        'Менеджер ответит на любые вопросы',
        'Среднее время ответа техподдержки — 57 сек',
        'Помогаем увеличивать продажи',
      ]}
      submitLabel="Получить демо"
      privacyText="Нажимая кнопку «Получить демо», вы даете согласие на&#160;обработку ваших персональных данных и&#160;подтверждаете, что ознакомлены с&#160;Политикой обработки персональных данных"
    />

  </div>
</SiteLayout>
