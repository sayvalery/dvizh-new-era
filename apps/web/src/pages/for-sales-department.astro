---
/**
 * Для департамента продаж — ДВИЖ
 */
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSection from '../components/ui/HeroSection.astro'
---

<SiteLayout title="Для департамента продаж — ДВИЖ" description="ДВИЖ помогает департаменту продаж закрывать больше сделок, автоматизировать рутину и повышать конверсию на каждом этапе воронки." bodyClass="bg-background-primary">
  <HeroSection
    layout="full"
    title="Больше сделок — меньше рутины"
    description="ДВИЖ автоматизирует ипотечный процесс, чтобы менеджеры успевали в 2 раза больше и закрывали до 26% больше сделок"
    demoLabel="Записаться на демо"
    kpLabel="Пробовать бесплатно"
    demoPreset="demo"
    kpPreset="lead"
    class="pb-4 xs:pb-5 md:pb-16 lg:pb-32"
  />
</SiteLayout>
