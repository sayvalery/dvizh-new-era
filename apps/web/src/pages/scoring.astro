---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import PixelArrowPattern from '../components/ui/PixelArrowPattern.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import KeyFacts from '../components/ui/KeyFacts.astro'
import FeatureBlock from '../components/ui/FeatureBlock.astro'
import BentoGrid from '../components/ui/BentoGrid.astro'
import FormClosing from '../components/ui/FormClosing.astro'
---

<SiteLayout
  title="Финансовый скоринг"
  bodyClass="fluid-page"
  description="Проверяйте платежеспособность покупателей на банковском уровне до подписания договора"
  jsonLd={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'ДВИЖ Скоринг', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' }, provider: { '@type': 'Organization', name: 'ДВИЖ', url: 'https://dvizh.io' } }}
>

  {/* ── 1. Hero ── */}
  <HeroSectionFull
    title="Проверьте ипотечного заемщика до обращения в банки"
    description="Сократите риск отказа до минимума благодаря предварительной оценке клиента по данным из 15 источников"
    demoLabel="Записаться на демо"
    kpLabel="Попробовать бесплатно"
    mobileBg="https://admin.dvizh.cc/api/media/file/skoring-hero-mobile.webp"
  >
    <PixelArrowPattern slot="background" />
    <img
      id="hero-img"
      slot="right"
      src="https://admin.dvizh.cc/api/media/file/skoring-hero.webp"
      alt=""
      class="h-[106dvh] w-auto object-contain"
      style="max-width: none; opacity: 0; transform: translateY(20px)"
      loading="eager"
      fetchpriority="high"
    />
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/fsk.svg', alt: 'ФСК' },
        { src: '/partners/dark/mrgroup.svg', alt: 'MR Group' },
        { src: '/partners/dark/donstroy.svg', alt: 'Донстрой' },
        { src: '/partners/dark/a101.svg', alt: 'А101' },
        { src: '/partners/dark/setl.svg', alt: 'Setl Group' },
        { src: '/partners/dark/etalon.svg', alt: 'Эталон' },
        { src: '/partners/dark/strana.svg', alt: 'Страна' },
        { src: '/partners/dark/dogma.svg', alt: 'Догма' },
        { src: '/partners/dark/glorax.svg', alt: 'Глоракс' },
        { src: '/partners/dark/ava.svg', alt: 'AVA' },
        { src: '/partners/dark/samolet.svg', alt: 'Самолёт' },
      ]}
    />
  </HeroSectionFull>

  {/* Reveal-анимация hero-картинки: невидима → плавно выплывает снизу → передаёт управление float */}
  <script>
    const img = document.getElementById('hero-img') as HTMLImageElement | null
    if (img) {
      const reveal = () => {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          img.style.transition = 'opacity 0.7s ease-out, transform 0.7s ease-out'
          img.style.opacity    = '1'
          img.style.transform  = 'translateY(0)'
        }))
        setTimeout(() => {
          img.style.transition = ''
          img.style.opacity    = ''
          img.style.transform  = ''
          img.classList.add('animate-hero-float')
        }, 750)
      }
      if (img.complete && img.naturalWidth > 0) reveal()
      else img.addEventListener('load', reveal, { once: true })
    }
  </script>

  {/* gap-24/40 между блоками + mt-24 lg:mt-32 — воздух на стыке hero↔первый блок (флюид) */}
  <div class="flex flex-col gap-24 lg:gap-40 mt-24 lg:mt-32">


  {/* ── 3. KeyFacts — 3 пункта ── */}
  <KeyFacts
    class="!py-0"
    title="Зачем вам финансовый скоринг"
    variant="large"
    items={[
      {
        value: 'до 35% заявок',
        description: 'уходят в автоматический отказ на стороне банков из-за плохого кредитного рейтинга',
      },
      {
        value: '80% клиентов',
        description: 'не отправляют запросы в БКИ и не знают, могут ли получить одобрение ипотеки',
      },
      {
        value: 'на 20% выше',
        description: 'вероятность одобрения после предварительной проверки и правок в ипотечной анкете',
      },
    ]}
  />

  {/* ── 4. FeatureBlock ── */}
  <FeatureBlock
    class="!py-0"
    heading="Покажем красные флаги клиента"
    description="Скоринг охватывает полный финансовый профиль заемщика — от долговой нагрузки до банкротных дел"
    imageSide="left"
    button={{ label: 'Узнать больше', drawerPreset: 'demo' }}
    features={[
      {
        title: 'Долговую нагрузку клиента',
        subtitle: 'Соотношение активных кредитов и доходов',
        image: '/api/media/file/scoring-red-flags-debt-load.webp',
        imageAlt: 'Долговая нагрузка клиента',
      },
      {
        title: 'Долги по налогам и сборам',
        subtitle: 'Задолженности перед ФНС и другими государственными органами',
        image: '/api/media/file/scoring-red-flags-tax-debts.webp',
        imageAlt: 'Долги по налогам и сборам',
      },
      {
        title: 'Долги по кредитам и кредитным картам',
        subtitle: 'Данные из бюро кредитных историй',
        image: '/api/media/file/scoring_red-flags_credit-history.webp',
        imageAlt: 'Долги по кредитам и кредитным картам',
      },
      {
        title: 'Информацию о банкротстве и приостановлении счетов',
        subtitle: 'Открытые дела о банкротстве и блокировки счетов',
        image: '/api/media/file/scoring_red-flags_bankruptcy.webp',
        imageAlt: 'Информация о банкротстве и приостановлении счетов',
      },
    ]}
  />

  {/* ── 5. BentoGrid variant="four" ── */}
  <section class="!py-0">
    <div class="page-container">
      <BentoGrid
        variant="four"
        heading="Как это работает"
        items={[
          {
            title: 'Распознавание',
            description: 'Определяем тип документа и вытаскиваем нужные поля автоматически',
            backgroundImage: '/api/media/file/scoring_hero_cards-3d.webp',
          },
          {
            title: 'Дополняем профиль клиента',
            description: 'Подтягиваем данные из сторонних источников — ФНС, ГИБДД, БКИ',
            backgroundImage: '/api/media/file/scoring_bento_data-sources.webp',
            backgroundImageMobile: '/api/media/file/scoring_bento_data-sources-mobile.webp',
            backgroundImageTablet: '/api/media/file/scoring_bento_data-sources-laptop.webp',
            imagePositionSm: 'top',
          },
          {
            title: 'Антифрод',
            description: 'Ищем признаки мошенничества и сверяем данные с внешними базами',
            backgroundImage: '/api/media/file/scoring_bento_fraud-check.webp',
            backgroundImageMobile: '/api/media/file/scoring_bento_fraud-check-mobile.webp',
            imagePositionSm: 'top',
          },
          {
            title: 'Верификация',
            description: 'Проверяем документ на подлинность еще до ручной обработки',
            backgroundImage: '/api/media/file/scoring_bento_shield-3d.webp',
          },
        ]}
      />
    </div>
  </section>

  {/* ── 7. FormClosing ── */}
  <FormClosing
    mode="buttons"
    primaryButton={{ label: 'Оставить заявку', drawerPreset: 'lead' }}
    title="Бесплатно проверим 5 ваших клиентов, которые уже получили отказ"
    items={[
      '<span class="font-semibold">Вы присылаете 5 отказников:</span> любые заявки, которые банк не одобрил за последний месяц',
      '<span class="font-semibold">Мы проводим скоринг:</span> проверяем клиента по кредитным бюро и базам, подбираем банк, который бы одобрил заявку',
      '<span class="font-semibold">Вы получаете отчет в течение дня:</span> по каждой заявке — причина отказа, рекомендации, которые спасли бы сделку, и сумма возможного одобрения',
    ]}
    class="!py-0"
  />

  </div>{/* /gap-контейнер */}

</SiteLayout>
