---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import PixelArrowPattern from '../components/ui/PixelArrowPattern.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import KeyFacts from '../components/ui/KeyFacts.astro'
import BentoGrid from '../components/ui/BentoGrid.astro'
import FeatureBlock from '../components/ui/FeatureBlock.astro'
import ReviewFull from '../components/ui/ReviewFull.astro'
import ComparisonSection from '../components/ui/ComparisonSection.astro'
import FormClosing from '../components/ui/FormClosing.astro'
---

<SiteLayout
  title="Финансовый скоринг"
  htmlClass="fluid-scale"
  description="Проверяйте платежеспособность покупателей по банковским стандартам до подписания договора рассрочки"
  jsonLd={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'ДВИЖ Скоринг', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' }, provider: { '@type': 'Organization', name: 'ДВИЖ', url: 'https://dvizh.io' } }}
>

  {/* ── 1. Hero ── */}
  <HeroSectionFull
    title="Сократите риски по рассрочке в 2 раза за счет скоринга клиентов"
    description="Проверяйте клиентов по банковским стандартам и выявляйте все красные флаги до сделки. Оценивайте реальный бюджет и ипотечный потенциал клиентов за секунды — и повышайте средний чек"
    demoLabel="Записаться на демо"
    kpLabel="Попробовать бесплатно"
    demoPreset="demo"
    kpPreset="lead"
    mobileBg="https://admin.dvizh.cc/api/media/file/skoring-hero-mobile.webp"
    class="hero-h1-sm"
  >
    <PixelArrowPattern slot="background" />
    <img
      id="hero-img"
      slot="right"
      src="https://admin.dvizh.cc/api/media/file/skoring-hero.webp"
      alt=""
      class="h-[106dvh] w-auto object-contain"
      style="max-width: none; opacity: 0; transform: translateY(20px)"
      loading="eager"
      fetchpriority="high"
    />
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/fsk.svg', alt: 'ФСК' },
        { src: '/partners/dark/mrgroup.svg', alt: 'MR Group' },
        { src: '/partners/dark/donstroy.svg', alt: 'Донстрой' },
        { src: '/partners/dark/a101.svg', alt: 'А101' },
        { src: '/partners/dark/setl.svg', alt: 'Setl Group' },
        { src: '/partners/dark/etalon.svg', alt: 'Эталон' },
        { src: '/partners/dark/strana.svg', alt: 'Страна' },
        { src: '/partners/dark/dogma.svg', alt: 'Догма' },
        { src: '/partners/dark/glorax.svg', alt: 'Глоракс' },
        { src: '/partners/dark/ava.svg', alt: 'AVA' },
        { src: '/partners/dark/samolet.svg', alt: 'Самолет' },
      ]}
    />
  </HeroSectionFull>

  {/* Reveal-анимация hero-картинки */}
  <script>
    const img = document.getElementById('hero-img') as HTMLImageElement | null
    if (img) {
      const reveal = () => {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          img.style.transition = 'opacity 0.7s ease-out, transform 0.7s ease-out'
          img.style.opacity    = '1'
          img.style.transform  = 'translateY(0)'
        }))
        setTimeout(() => {
          img.style.transition = ''
          img.style.opacity    = ''
          img.style.transform  = ''
          img.classList.add('animate-hero-float')
        }, 750)
      }
      if (img.complete && img.naturalWidth > 0) reveal()
      else img.addEventListener('load', reveal, { once: true })
    }
  </script>

  {/* gap-24/40 между блоками + mt-24 lg:mt-32 — воздух на стыке hero↔первый блок */}
  <div class="flex flex-col gap-24 lg:gap-40 mt-24 lg:mt-32">

  {/* ── 2. KeyFacts — риски рассрочки ── */}
  <KeyFacts
    variant="large"
    titleHtml="Рассрочка без скоринга клиента —<br>прямой риск для застройщика"
    subtitleMaxW="4xl"
    subtitle="Когда клиент берет рассрочку у застройщика, банк в сделке не участвует. Он не проверяет финансовые возможности клиента — и риск остается на застройщике"
    items={[
      {
        value: '80% клиентов',
        description: 'не отправляют запросы в БКИ и не знают, смогут ли получить одобрение ипотеки в будущем',
      },
      {
        value: '22,8% заемщиков',
        description: 'имеют низкий кредитный рейтинг, по данным ОКБ',
      },
      {
        value: '5% договоров',
        description: 'на рассрочку расторгаются, по данным РБК. Это миллионные потери',
      },
    ]}
  />

  {/* ── 3. BentoGrid ── */}
  <section class="!py-0">
    <div class="page-container">
      <BentoGrid
        variant="three"
        headingHtml='Скоринг ДВИЖа — это проверка клиента <span class="text-brand">по банковским стандартам</span>, до сделки и за секунды'
        items={[
          {
            title: 'Расчет ПДН и детализация всех кредитных продуктов',
            description: 'Данные из ОКБ, НБКИ, Скоринг Бюро, КредитИнфо. Учитываем всю долговую нагрузку — вплоть до покупок в сплит',
            theme: 'dark',
            backgroundImage: 'https://admin.dvizh.cc/api/media/file/scoring_01_credit-load-new.webp',
          },
          {
            title: 'Готовое заключение — в карточке клиента в CRM',
            titleHtml: 'Готовое заключение —<br>в карточке клиента в CRM',
            description: 'Менеджер видит риски и принимает взвешенное решение по клиенту',
            backgroundImage: 'https://admin.dvizh.cc/api/media/file/scoring_02_risk-levels-new.webp',
          },
          {
            title: 'Оценка риск-флагов',
            titleHtml: 'Оценка риск-флагов',
            description: 'Просрочки, банкротства, самозапрет, долги ФССП, аресты по налогам, состояние ИП или компании заемщика',
            theme: 'dark',
            backgroundImage: 'https://admin.dvizh.cc/api/media/file/scoring_03_risk-flags.webp',
          },
        ]}
      />
    </div>
  </section>

  {/* ── 4. FeatureBlock 1 — Снижаем риски просрочек и расторжения ── */}
  <FeatureBlock
    interactive={false}
    class="!py-0"
    eyebrow="Для оформления рассрочки и проверок в течение контракта"
    image="https://admin.dvizh.cc/api/media/file/scoring_06_risk-levels.webp"
    imageAlt="Снижаем риски просрочек и расторжения"
    heading="Снижаем риски просрочек и расторжения"
    features={[
      { title: 'Анализируем платежеспособность клиента' },
      { title: 'Предупреждаем о риск-флагах в портрете клиента' },
      { title: 'Менеджер может защитить сделку или отказать клиенту' },
    ]}
  />

  {/* ── 5. FeatureBlock 2 — Выявляем кредитный потенциал клиента ── */}
  <FeatureBlock
    interactive={false}
    class="!py-0"
    eyebrow="Для перехода с рассрочки на ипотеку"
    imageSide="left"
    image="https://admin.dvizh.cc/api/media/file/scoring_07_client-form-new.webp"
    imageAlt="Выявляем кредитный потенциал клиента"
    heading="Выявляем кредитный потенциал клиента"
    features={[
      { title: 'Рассчитываем доступную сумму и платеж по будущей ипотеке' },
      { title: 'Подсвечиваем стоп-факторы для одобрения в банке' },
      { title: 'Менеджер и клиент могут подготовиться к переходу на ипотеку' },
    ]}
  />

  {/* ── 6. Цитата ЭНКО (ReviewFull) ── */}
  <div class="page-container">
    <ReviewFull
      photo={{ src: 'https://admin.dvizh.cc/api/media/file/enco-case.webp', alt: 'Юлия Романовская' }}
      quote="Скоринг ДВИЖа помогает проверять финансовые возможности клиентов и перспективы перехода на ипотеку. С помощью отдельного инструмента менеджеры ЭНКО проверяют покупателя перед подписанием договора по рассрочке, чтобы снизить риски до минимума"
      author="Юлия Романовская"
      role="Руководитель службы сопровождения клиентов"
      company={{ logo: '/api/media/file/enco-logo.svg', alt: 'ЭНКО' }}
      caseLink={{ label: 'Читать кейс', href: '/blog/keys-enko-dvizh' }}
    />
  </div>

  {/* ── 7. FeatureBlock 3 — Повышаем средний чек и находим потенциал для допродаж ── */}
  <FeatureBlock
    interactive={false}
    class="!py-0"
    eyebrow="Для роста продаж"
    image="https://admin.dvizh.cc/api/media/file/scoring_08_budget-headroom.webp"
    imageAlt="Повышаем средний чек и находим потенциал для допродаж"
    heading="Повышаем средний чек и находим потенциал для допродаж"
    features={[
      { title: 'Показываем реальный бюджет клиента, максимальную сумму одобрения и платежа' },
      { title: 'Менеджер может предложить квартиру под доступный бюджет, допродать машиноместо или кладовку' },
    ]}
  />

  {/* ── 7. ComparisonSection — Без скоринга vs Со скорингом ДВИЖа ── */}
  <ComparisonSection
    title=""
    leftTitle="Без скоринга"
    leftItems={[
      'Несистемная проверка клиентов',
      'Клиент сам приносит справки, процесс растягивается на дни и недели',
      'Риски просрочек и расторжения договоров',
      'Миллионы уходят на досудебное урегулирование и суды',
      'Нет потенциала для апсейла',
    ]}
    rightItems={[
      'Проверка 100% клиентов',
      'Клиент проверяется по ОКБ и 15+ источникам за секунды',
      'Снижение доли проблемных сделок в рассрочке в 2 раза',
      'Время менеджеров и юристов на работу<br>с проблемными сделками сведено к минимуму',
      'Средний чек и допродажи растут',
    ]}
    rightLogoSrc={`${import.meta.env.PUBLIC_CMS_URL}/api/media/file/dvizh_comp.svg`}
    rightLogoAlt="ДВИЖ"
    primaryButtonText="Записаться на демо"
    primaryDrawerPreset="demo"
    secondaryButtonText="Попробовать бесплатно"
    secondaryDrawerPreset="lead"
  />

  {/* ── 8. FormClosing ── */}
  <FormClosing
    preset="lead"
    title="Получите 5 бесплатных проверок"
    description="Оставьте заявку, и мы покажем все риски по вашим клиентам"
    submitLabel="Попробовать бесплатно"
    class="!py-0"
  />

  </div>{/* /gap-контейнер */}

</SiteLayout>
