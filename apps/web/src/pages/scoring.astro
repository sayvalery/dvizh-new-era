---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSection from '../components/ui/HeroSection.astro'
import StatsSection from '../components/ui/StatsSection.astro'
import FeaturesGrid from '../components/ui/FeaturesGrid.astro'
import CTA from '../components/ui/CTA.astro'
---

<SiteLayout title="Финансовый скоринг — ДВИЖ" description="Проверяйте платёжеспособность покупателей на банковском уровне до подписания договора" jsonLd={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'ДВИЖ Скоринг', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' }, provider: { '@type': 'Organization', name: 'ДВИЖ', url: 'https://dvizh.io' } }}>
  <HeroSection
    badge="Финансовый скоринг"
    title="Проверьте ипотечного заёмщика до обращения в банки"
    description="Сократите риск отказа до минимума благодаря предварительной оценке клиента по данным из 15 источников"
    formPreset="demo"
    withForm={true}
  />

  <StatsSection
    title="Зачем вам финансовый скоринг"
    cols={3}
    items={[
      { value: 'до 35% заявок', label: 'уходят в автоматический отказ на стороне банков из-за плохого кредитного рейтинга' },
      { value: '80% клиентов', label: 'не отправляют запросы в БКИ и не знают, могут ли получить одобрение ипотеки' },
      { value: 'на 20% выше', label: 'вероятность одобрения после предварительной проверки и правок в ипотечной анкете' },
    ]}
  />

  <!-- Что проверяем -->
  <FeaturesGrid
    badge="Что проверяем"
    title="15 источников данных для каждого клиента"
    description="Скоринг охватывает полный финансовый профиль заёмщика — от долговой нагрузки до банкротных дел."
    features={[
      { icon: 'lock', title: 'Долговую нагрузку клиента', description: ' — соотношение активных кредитов и доходов' },
      { icon: 'document', title: 'Долги по налогам и сборам', description: ' — задолженности перед ФНС и другими госорганами' },
      { icon: 'database', title: 'Долги по кредитам и кредитным картам', description: ' — данные из бюро кредитных историй' },
      { icon: 'check', title: 'Информацию о банкротстве и приостановлении счетов', description: ' — открытые дела о банкротстве и блокировки счетов' },
    ]}
    variant="light"
  />

  <!-- Реализация по API -->
  <FeaturesGrid
    badge="Интеграция"
    title="Реализация по API — для тех, кто хочет ещё больше"
    description="Встройте скоринг в собственную экосистему и управляйте оценкой клиентов на уровне бизнес-процессов."
    features={[
      { icon: 'check', title: 'Адаптируйте ипотечный калькулятор под ваш фирменный стиль', description: ' — брендированный интерфейс без разработчиков на вашей стороне' },
      { icon: 'globe', title: 'Встройте расчёты прямо в карточку лота на сайте', description: ' — покупатель видит ипотечный расчёт рядом с объектом без перехода на другую страницу' },
      { icon: 'document', title: 'Избавьтесь от рисков и юридических ошибок', description: ' — следим за соответствием ФЗ, актуальность законодательства на нашей стороне' },
    ]}
    variant="dark"
  />

  <!-- CTA -->
  <div class="max-w-[1440px] mx-auto px-4 py-12">
    <CTA
      title="Заберите готовое решение и одобряйте больше клиентов"
      description="Наш скоринг заменяет самописные модели — и поднимает одобрение без роста риска."
      buttonText="Забрать решение"
      buttonHref="#"
    />
  </div>
</SiteLayout>
