---
/**
 * Страница компании /companies/[slug]
 *
 * Шаблон по образцу страницы категории (lab/category-page):
 *   BlogLayout insightsHeader → page-container, дизайн-токены, заголовок text-h2.
 *
 * Шапка: логотип компании (вписан в скруглённый квадрат по высоте заголовка)
 * слева от названия; под названием — описание (company.description) и ссылка
 * на сайт. Ниже — раздел «Люди» (персоны компании) и «Материалы» (её статьи).
 */
import BlogLayout from '../../layouts/BlogLayout.astro'
import PersonCard from '../../components/ui/PersonCard.astro'
import BlogCardNew from '../../components/ui/BlogCardNew.astro'
import { getCompanies, getCompany, getPersonsByCompany, getPostsByCompany, normalizeMediaUrl } from '../../lib/payload'

export async function getStaticPaths() {
  const allCompanies: any[] = []
  let page = 1
  while (true) {
    const result = await getCompanies({ limit: 100, page })
    allCompanies.push(...result.docs)
    if (!result.hasNextPage) break
    page++
  }
  return allCompanies.map((c: any) => ({ params: { slug: c.slug } }))
}

const { slug } = Astro.params
const company = await getCompany(slug!)
if (!company) return Astro.redirect('/404')

const [{ docs: persons }, { docs: posts }] = await Promise.all([
  getPersonsByCompany(slug!),
  getPostsByCompany(slug!),
])

const logoUrl = normalizeMediaUrl(company.logo?.url)

/** URL → отображаемый адрес без протокола/www/хвостового слэша: «https://dvizh.io/» → «dvizh.io» */
const linkLabel = company.link
  ? company.link.replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/$/, '')
  : ''

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  ...(company.description ? { description: company.description } : {}),
  ...(logoUrl ? { logo: logoUrl } : {}),
  ...(company.link ? { url: company.link } : {}),
}

// ─── Хелперы карточек «Материалы» (как на шаблоне категории) ─────────────────
const MONTHS = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря']

/** ISO-дата → «27 февраля» */
function ruDate(iso?: string): string | undefined {
  if (!iso) return undefined
  const d = new Date(iso)
  if (isNaN(d.getTime())) return undefined
  return `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`
}

/** Рекурсивно собирает текст из Lexical-узла */
function lexicalText(node: any): string {
  if (!node) return ''
  if (typeof node.text === 'string') return node.text
  const kids = node.children ?? node.root?.children
  return Array.isArray(kids) ? kids.map(lexicalText).join(' ') : ''
}

/** Время чтения (≈200 слов/мин) → «9 мин» */
function readTime(post: any): string {
  let text = ''
  if (post.bodyHtml) text = String(post.bodyHtml).replace(/<[^>]+>/g, ' ')
  else if (Array.isArray(post.content)) text = post.content.map((b: any) => lexicalText(b.richText)).join(' ')
  text = text.replace(/\s+/g, ' ').trim()
  const words = text ? text.split(' ').length : 0
  return `${Math.max(1, Math.round(words / 200))} мин`
}

/** Пост CMS → пропсы BlogCardNew */
function card(post: any) {
  return {
    title: post.title,
    slug: post.slug,
    cover: post.cover,
    excerpt: post.excerpt,
    date: ruDate(post.publishedAt),
    readTime: readTime(post),
  }
}
---

<BlogLayout
  title={`${company.name} — ДВИЖ`}
  description={company.description}
  jsonLd={jsonLd}
  insightsHeader
>
  <div class="py-10 md:py-16">
    <div class="page-container flex flex-col gap-10 lg:gap-16">

      {/* ── Шапка: логотип + название/описание/ссылка ──
           Логотип-квадрат по той же логике, что аватар на странице персоны:
           размер (ширина = высоте) из реальной высоты блока «название + описание»
           через Alpine + ResizeObserver. Минимум — высота этого блока (~60/78px),
           задан через min-w/min-h (и тот же размер — no-JS фолбэк); если описание
           переносится, квадрат растёт выше минимума. */}
      <div
        x-data="{ s: 0, sync() { this.s = this.$refs.txt.offsetHeight } }"
        x-init="$nextTick(() => sync()); new ResizeObserver(() => sync()).observe($refs.txt)"
        class="flex items-start gap-4 sm:gap-5"
      >
        <div
          class="shrink-0 h-[60px] w-[60px] min-h-[60px] min-w-[60px] lg:h-[78px] lg:w-[78px] lg:min-h-[78px] lg:min-w-[78px] rounded-lg lg:rounded-xl border border-gray-200 bg-white flex items-center justify-center overflow-hidden"
          :style="s ? `width:${s}px;height:${s}px` : null"
        >
          {logoUrl ? (
            <img src={logoUrl} alt={company.name} class="max-h-full max-w-full object-contain" />
          ) : (
            <span class="text-h6 text-gray-500">{company.name[0]}</span>
          )}
        </div>

        <div class="flex flex-col gap-2">
          {/* Заголовок (название компании) + описание */}
          <div x-ref="txt" class="flex flex-col gap-2">
            <h1 class="text-h2 text-gray-900">{company.name}</h1>
            {company.description && (
              <p class="text-body-lg text-gray-500">{company.description}</p>
            )}
          </div>
          {company.link && (
            <a
              href={company.link}
              target="_blank"
              rel="noopener noreferrer"
              class="text-subhead text-brand hover:opacity-70 transition-opacity w-fit"
            >
              {linkLabel} ↗
            </a>
          )}
        </div>
      </div>

      {/* ── Люди ── */}
      {persons.length > 0 && (
        <section class="flex flex-col gap-6 lg:gap-10">
          <h2 class="text-h3 text-gray-900">Люди</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-8 items-start">
            {persons.map((person: any) => (
              <PersonCard person={person} variant="full" />
            ))}
          </div>
        </section>
      )}

      {/* ── Материалы ── */}
      {posts.length > 0 && (
        <section class="flex flex-col gap-6 lg:gap-10">
          <h2 class="text-h3 text-gray-900">Материалы</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
            {posts.map((post: any) => (
              <BlogCardNew size="md" {...card(post)} />
            ))}
          </div>
        </section>
      )}

    </div>
  </div>
</BlogLayout>
