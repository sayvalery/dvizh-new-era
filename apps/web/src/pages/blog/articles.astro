---
/**
 * Страница «Статьи блога» /blog/articles
 *
 * Заголовок + счётчик + сетка карточек всех статей. Между заголовком и
 * карточками — теги-фильтр: первый тег «Все статьи» (предвыбран), далее
 * категории по алфавиту. Клик переключает карточки на месте (Alpine).
 * Перенесено из эксперимента /lab/articles.
 */
import BlogLayout from '../../layouts/BlogLayout.astro'
import BlogCardNew from '../../components/ui/BlogCardNew.astro'
import Tab from '../../components/ui/Tab.astro'
import { getBlogPosts } from '../../lib/payload'

const TITLE = 'Статьи блога'

// Все опубликованные посты. Пересортировка: посты без publishedAt — в конец.
const { docs: rawPosts } = await getBlogPosts({ limit: 200, depth: 2 })
const allPosts = [...rawPosts].sort((a: any, b: any) => {
  const ta = a.publishedAt ? Date.parse(a.publishedAt) : -Infinity
  const tb = b.publishedAt ? Date.parse(b.publishedAt) : -Infinity
  return tb - ta
})

const MONTHS = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря']

/** ISO-дата → «27 февраля» (день + месяц) */
function ruDate(iso?: string): string | undefined {
  if (!iso) return undefined
  const d = new Date(iso)
  if (isNaN(d.getTime())) return undefined
  return `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`
}

/** Рекурсивно собирает текст из Lexical-узла (root/children/text) */
function lexicalText(node: any): string {
  if (!node) return ''
  if (typeof node.text === 'string') return node.text
  const kids = node.children ?? node.root?.children
  return Array.isArray(kids) ? kids.map(lexicalText).join(' ') : ''
}

/** Время чтения из объёма текста (≈200 слов/мин) → «9 мин» */
function readTime(post: any): string {
  let text = ''
  if (post.bodyHtml) {
    text = String(post.bodyHtml).replace(/<[^>]+>/g, ' ')
  } else if (Array.isArray(post.content)) {
    text = post.content.map((b: any) => lexicalText(b.richText)).join(' ')
  }
  text = text.replace(/\s+/g, ' ').trim()
  const words = text ? text.split(' ').length : 0
  const min = Math.max(1, Math.round(words / 200))
  return `${min} мин`
}

/** Пост CMS → пропсы BlogCardNew */
function card(post: any) {
  return {
    title: post.title,
    slug: post.slug,
    cover: post.cover,
    excerpt: post.excerpt,
    date: ruDate(post.publishedAt),
    readTime: readTime(post),
  }
}

// Теги-фильтр: категории, реально присутствующие в постах, по алфавиту.
const catMap = new Map<string, { slug: string; title: string }>()
for (const p of allPosts as any[]) {
  const c = p.category
  if (!c?.slug || catMap.has(c.slug)) continue
  catMap.set(c.slug, { slug: c.slug, title: String(c.title ?? c.slug).trim() })
}
const tagCats = [...catMap.values()].sort((a, b) => a.title.localeCompare(b.title, 'ru'))
---

<BlogLayout title={`${TITLE} — ДВИЖ`} description="Все статьи блога" insightsHeader bodyClass="fluid-page">
  <div class="py-10 md:py-16">

    <div class="page-container flex flex-col gap-10 lg:gap-16" x-data="{ cat: new URLSearchParams(window.location.search).get('cat') || 'all' }">

      {/* Верхний заголовок + счётчик статей */}
      <h2 class="text-h2 text-gray-900">{TITLE}<span class="text-h4 text-gray-900 opacity-30 align-top leading-none ml-2">{allPosts.length}</span></h2>

      {/* Теги-фильтр: «Все статьи» + категории по алфавиту */}
      <div class="flex flex-wrap gap-2">
        <Tab
          label="Все статьи"
          x-on:click="cat = 'all'"
          x-bind:class={`cat === 'all' ? '!border-brand-200 !text-brand' : ''`}
        />
        {tagCats.map((c) => (
          <Tab
            label={c.title}
            x-on:click={`cat = '${c.slug}'`}
            x-bind:class={`cat === '${c.slug}' ? '!border-brand-200 !text-brand' : ''`}
          />
        ))}
      </div>

      {/* Шахматка карточек: одна сетка, карточка видна при «Все статьи» или
          совпадении категории (Alpine x-show). 1 → 2 → 3 колонки. */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
        {allPosts.map((post: any) => (
          <div x-show={`cat === 'all' || cat === '${post.category?.slug ?? ''}'`} x-cloak>
            <BlogCardNew size="md" {...card(post)} />
          </div>
        ))}
      </div>

    </div>

  </div>
</BlogLayout>
