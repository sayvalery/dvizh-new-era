          </div>
          <div class="shrink-0">
            <Button variant="primary" size="sm" href="/research">Смотреть все</Button>
          </div>
        </div>

        {/* Карточки: <xl — под заголовком, xl+ — справа 2/3.
            На lg специально 3 md в ряд (без 4-й), на остальных — 4 s стак. */}
        <div class="xl:basis-2/3 xl:shrink xl:min-w-0">
          {/* s-стак: только xl+ */}
          <div class="hidden xl:flex flex-col gap-6">
            {analitika.map((post: any) => (
              <BlogCardNew size="s" {...card(post)} />
            ))}
          </div>
          {/* md-ряд: <xl, 3 md-карточки (4-я только sm/md) */}
          <div class="grid xl:hidden grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
            {analitika.map((post: any, i: number) => (
              <BlogCardNew size="md" {...card(post)} class={i === 3 ? 'hidden sm:block lg:hidden' : ''} />
            ))}
          </div>
        </div>

    </div>

    {/* ── Блок 5: Теги-фильтры + md-карточки — клик по тегу переключает карточки справа (Alpine).
            При md и ниже стак на полную ширину, при lg+ 2 колонки. */}
    <div class="page-container" x-data={`{ cat: '${defaultCat}' }`}>
