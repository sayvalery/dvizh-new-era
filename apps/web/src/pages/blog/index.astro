      heading="Кейсы"
      counter={20}
      headingHref="/blog/category/cases"
      subtitle="Истории успеха на&#160;рынке застройщиков"
      buttonLabel="Смотреть все"
      buttonHref="/blog/category/cases"
      buttonVariant="primary"
      class="!py-0"
      stories={[
        {
          logo: '/api/media/file/lsr_color.svg',
          logoAlt: 'Группа ЛСР',
          logoHover: '/api/media/file/lsr_white-1.svg',
          hoverBackground: '/api/media/file/lsr_bg.png',
          hoverGlass: true,
          href: '/blog/keys-lsr-dvizh',
          titleHtml: 'Помогли начать обрабатывать <span class="text-brand">на&#160;281% заявок больше,</span> чем в&#160;среднем на&#160;рынке',
          personName: 'Группа ЛСР',
          personJobTitle: 'Один из ведущих строительных холдингов',
        },
        {
          logo: '/api/media/file/tochno_color.svg',
          logoAlt: 'ГК Точно',
          logoHover: '/api/media/file/tochno_white.svg',
          hoverBackground: '/api/media/file/tochno_bg.png',
          href: '/blog/keys-gk-tochno-i-dvizha',
          titleHtml: 'Увеличили объем закрытых сделок <span class="text-brand">с&#160;1165 до&#160;3500 за&#160;год</span>',
          personName: 'ГК «Точно»',
          personJobTitle: 'Крупнейший девелопер Краснодарского края',
        },
        {
          logo: '/api/media/file/samolet_color.svg',
          logoAlt: 'ГК Самолет',
          logoHover: '/api/media/file/samolet_white.svg',
          hoverBackground: '/api/media/file/samolet_bg.png',
          href: '/blog/samolet-ai-u-developera',
          titleHtml: 'Дополнительно продали <span class="text-brand">96&#160;квартир</span>',
          personName: 'ГК «Самолет»',
          personJobTitle: 'Крупнейший федеральный девелопер России',
        },
      ]}
    />

    {/* ── Блок 4: «Аналитика рынка» — header-row при <xl, 2 колонки 1/3+2/3 при xl+ ── */}
    <div class="page-container flex flex-col gap-10 xl:flex-row xl:gap-6 xl:items-start">

        {/* Заголовочная область: <xl — heading+button в одну строку (sm+), xl+ — колонка 1/3 */}
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between xl:flex-col xl:gap-6 xl:basis-1/3 xl:shrink xl:min-w-0">
          <div class="flex flex-col gap-1">
            <a href="/blog/category/statistika" class="group w-fit">
              <h2 class="text-h2 text-gray-900 transition-colors group-hover:text-brand">Аналитика рынка<span class="text-h4 text-gray-900 opacity-30 align-top leading-none ml-2 transition-colors group-hover:text-brand">{count('statistika')}</span></h2>
