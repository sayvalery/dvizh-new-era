---
/**
 * Главная блога /blog
 *
 * Лендинг блога: геро-карточка + тематические блоки (Правила девелопера,
 * Кейсы, Аналитика рынка, теги-фильтр, Подкасты, Статьи блога).
 * Перенесено из эксперимента /lab/blog-main.
 */
import BlogLayout from '../../layouts/BlogLayout.astro'
import BlogCardNew from '../../components/ui/BlogCardNew.astro'
import SuccessStoryBlock from '../../components/ui/SuccessStoryBlock.astro'
import Button from '../../components/ui/Button.astro'
import Tab from '../../components/ui/Tab.astro'
import Banner from '../../components/ui/Banner.astro'
import { getBlogPosts } from '../../lib/payload'

// Все опубликованные посты. Пересортировка: посты без publishedAt — в конец,
// иначе CMS (-publishedAt) ставит запись с пустой датой первой и она «угоняет» геро-слот.
const { docs: rawPosts } = await getBlogPosts({ limit: 200, depth: 2 })
const allPosts = [...rawPosts].sort((a: any, b: any) => {
  const ta = a.publishedAt ? Date.parse(a.publishedAt) : -Infinity
  const tb = b.publishedAt ? Date.parse(b.publishedAt) : -Infinity
  return tb - ta
})

const MONTHS = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря']

/** ISO-дата → «27 февраля» (день + месяц) */
function ruDate(iso?: string): string | undefined {
  if (!iso) return undefined
  const d = new Date(iso)
  if (isNaN(d.getTime())) return undefined
  return `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`
}

/** Рекурсивно собирает текст из Lexical-узла (root/children/text) */
function lexicalText(node: any): string {
  if (!node) return ''
  if (typeof node.text === 'string') return node.text
  const kids = node.children ?? node.root?.children
  return Array.isArray(kids) ? kids.map(lexicalText).join(' ') : ''
}

/**
 * Время чтения из объёма текста (≈200 слов/мин) → «9 мин».
 * Webflow-посты — в bodyHtml; CMS-нативные — в content (Lexical).
 */
function readTime(post: any): string {
  let text = ''
  if (post.bodyHtml) {
    text = String(post.bodyHtml).replace(/<[^>]+>/g, ' ')
  } else if (Array.isArray(post.content)) {
    text = post.content.map((b: any) => lexicalText(b.richText)).join(' ')
  }
  text = text.replace(/\s+/g, ' ').trim()
  const words = text ? text.split(' ').length : 0
  const min = Math.max(1, Math.round(words / 200))
  return `${min} мин`
}

/** Пост CMS → пропсы BlogCardNew */
function card(post: any) {
  return {
    title: post.title,
    slug: post.slug,
    cover: post.cover,
    excerpt: post.excerpt,
    date: ruDate(post.publishedAt),
    readTime: readTime(post),
  }
}

const byCat = (slug: string) => allPosts.filter((p: any) => p.category?.slug === slug)
const count = (slug: string) => byCat(slug).length

// Подборки по блокам
const featured = allPosts[0]                              // Блок 1: главная карточка
const recent = allPosts.slice(1, 4)                       // Блок 1: 3 xs-карточки
const pravila = byCat('pravila-developera').slice(0, 4)   // Блок 2
const analitika = byCat('statistika').slice(0, 4)         // Блок 4 (Аналитика рынка)
const podkasty = byCat('podcasts').slice(0, 4)            // Блок 7 (Подкасты)
const statyi = allPosts.slice(0, 10)                      // Блок 8: последние 9 (+1 добивочная для sm)

// Блок 5: теги-фильтры. Категории, реально присутствующие в постах, по алфавиту.
// Клик по тегу не ведёт на страницу категории, а переключает карточки справа (Alpine).
const catMap = new Map<string, { slug: string; title: string; posts: any[] }>()
for (const p of allPosts as any[]) {
  const c = p.category
  if (!c?.slug) continue
  if (!catMap.has(c.slug)) catMap.set(c.slug, { slug: c.slug, title: String(c.title ?? c.slug).trim(), posts: [] })
  catMap.get(c.slug)!.posts.push(p)
}
const tagCats = [...catMap.values()].sort((a, b) => a.title.localeCompare(b.title, 'ru'))
// По умолчанию предвыбраны «Новости» (pro-dvizh); если их нет — первая категория.
const defaultCat = tagCats.some((c) => c.slug === 'pro-dvizh') ? 'pro-dvizh' : (tagCats[0]?.slug ?? '')
---

<BlogLayout title="Блог — ДВИЖ" description="Журнал для современных девелоперов" insightsHeader>
  <div class="py-10 md:py-16 flex flex-col gap-24 lg:gap-40">

    {/* ── Блок 1: заголовок + lg-карточка + ряд xs (lg+: помещается в viewport) ── */}
    <div class="page-container flex flex-col gap-8 md:gap-10">
      <h2 class="text-h2 text-gray-900">Журнал для&#160;современных девелоперов</h2>

      {featured && <BlogCardNew size="lg" layout="stacked" {...card(featured)} imgClass="lg:max-h-[calc(100svh_-_360px)] xl:max-h-[calc(100svh_-_250px)]" />}

      <div class="hidden md:grid gap-6 sm:grid-cols-2 xl:grid-cols-3 sm:-mt-2">
        {recent.map((post: any, i: number) => (
          <BlogCardNew size="xs" {...card(post)} class={i === 2 ? 'hidden xl:block' : ''} />
        ))}
      </div>
    </div>

    {/* ── Блок 2: «Правила девелопера» ── */}
    <div class="page-container flex flex-col gap-10 lg:gap-16">

      {/* Заголовок + подзаголовок + счётчик + кнопка */}
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex flex-col gap-1 max-w-[800px] w-full">
          <a href="/blog/category/pravila-developera" class="group w-fit">
            <h2 class="text-h2 text-gray-900 transition-colors group-hover:text-brand">Правила девелопера<span class="text-h4 text-gray-900 opacity-30 align-top leading-none ml-2 transition-colors group-hover:text-brand">{count('pravila-developera')}</span></h2>
          </a>
          <p class="text-body-lg text-gray-500">Реальные истории топов, их&#160;взгляды на&#160;рынок и&#160;профессию</p>
        </div>
        <div class="shrink-0">
          <Button variant="primary" size="sm" href="/blog/category/pravila-developera">Смотреть все</Button>
        </div>
      </div>

      {/* 3 md-карточки (4-я только sm/md) */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
        {pravila.map((post: any, i: number) => (
          <BlogCardNew size="md" {...card(post)} class={i === 3 ? 'hidden sm:block lg:hidden' : ''} />
        ))}
      </div>

    </div>

    {/* ── Блок 3: SuccessStoryBlock «Кейсы» ── */}
