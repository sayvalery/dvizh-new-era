        {/* Левая колонка (lg+): теги (фильтр) + кнопка. Залипает при скролле. */}
        <div class="flex flex-col gap-6 lg:basis-1/3 lg:shrink lg:min-w-0 lg:sticky lg:top-24 lg:self-start">
          <div class="flex flex-wrap gap-2">
            {tagCats.map((c) => (
              <Tab
                label={c.title}
                x-on:click={`cat = '${c.slug}'`}
                x-bind:class={`cat === '${c.slug}' ? '!border-[#fecda9] !text-brand' : ''`}
              />
            ))}
          </div>
          <div>
            <Button variant="primary" size="sm" href="/blog/articles" x-bind:href={`'/blog/articles?cat=' + cat`}>Смотреть все статьи</Button>
          </div>
        </div>

        {/* Правая колонка: карточки выбранной категории (до 4, 4-я только sm+) */}
        <div class="lg:basis-2/3 lg:shrink lg:min-w-0">
          {tagCats.map((c) => (
            <div
              x-show={`cat === '${c.slug}'`}
              x-cloak
              class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-10"
            >
              {c.posts.slice(0, 4).map((post: any, i: number) => (
                <BlogCardNew size="md" {...card(post)} class={i === 3 ? 'hidden sm:block' : ''} />
              ))}
            </div>
          ))}
        </div>

      </div>
    </div>

    {/* ── Блок 6: Banner — подписка на каналы ── */}
    <Banner
      bg="bg-background-secondary"
      title="Оставайтесь на&#160;связи"
      subtitle="Подпишитесь на&#160;наш канал в&#160;Telegram, чтобы не&#160;упустить свежие новости и&#160;статьи"
      buttons={[
        { label: 'Telegram', href: 'https://t.me/dvizh4realty', icon: '/api/media/file/telegram.svg' },
      ]}
    />

    {/* ── Блок 7: «Конференции, подкасты и вебинары» — header-row при <xl, 2 колонки 1/3+2/3 при xl+ ── */}
    <div class="page-container flex flex-col gap-10 xl:flex-row xl:gap-6 xl:items-start">

        <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between xl:flex-col xl:gap-6 xl:basis-1/3 xl:shrink xl:min-w-0">
          <a href="/blog/category/podcasts" class="group w-fit">
            <h2 class="text-h2 text-gray-900 transition-colors group-hover:text-brand">Конференции, подкасты и&#160;вебинары<span class="text-h4 text-gray-900 opacity-30 align-top leading-none ml-2 transition-colors group-hover:text-brand">{count('podcasts')}</span></h2>
          </a>
          <div class="shrink-0">
            <Button variant="primary" size="sm" href="/events">Смотреть все</Button>
          </div>
        </div>

        <div class="xl:basis-2/3 xl:shrink xl:min-w-0">
          {/* s-стак: только xl+ */}
          <div class="hidden xl:flex flex-col gap-6">
            {podkasty.map((post: any) => (
              <BlogCardNew size="s" {...card(post)} />
            ))}
          </div>
          {/* md-ряд: <xl, 3 md-карточки (4-я только sm/md) */}
          <div class="grid xl:hidden grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
            {podkasty.map((post: any, i: number) => (
              <BlogCardNew size="md" {...card(post)} class={i === 3 ? 'hidden sm:block lg:hidden' : ''} />
            ))}
          </div>
        </div>

    </div>

    {/* ── Блок 8: «Статьи блога» — 9 md-карточек 3×3 ── */}
    <div class="page-container flex flex-col gap-10 lg:gap-16">

      {/* Заголовок + счётчик + кнопка */}
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <a href="/blog/articles" class="group w-fit max-w-[800px]">
          <h2 class="text-h2 text-gray-900 transition-colors group-hover:text-brand">Статьи блога<span class="text-h4 text-gray-900 opacity-30 align-top leading-none ml-2 transition-colors group-hover:text-brand">{allPosts.length}</span></h2>
        </a>
        <div class="shrink-0">
          <Button variant="primary" size="sm" href="/blog/articles">Смотреть все</Button>
        </div>
      </div>

      {/* Сетка 3×3 — 9 md-карточек (10-я только sm/md, чтобы добить ряд) */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
        {statyi.map((post: any, i: number) => (
          <BlogCardNew size="md" {...card(post)} class={i === 9 ? 'hidden sm:block lg:hidden' : ''} />
        ))}
      </div>

    </div>

  </div>
</BlogLayout>
