---
import BlogLayout from '../../layouts/BlogLayout.astro'
import BlogCard from '../../components/ui/BlogCard.astro'
import { getTags, getPostsByTag } from '../../lib/payload'

export async function getStaticPaths() {
  const { docs: tags } = await getTags()
  return tags
    .filter((tag: any) => tag.slug)
    .map((tag: any) => ({
      params: { slug: tag.slug },
      props: { tag },
    }))
}

const { tag } = Astro.props

const { docs: posts } = await getPostsByTag(tag.id)

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Блог', item: `${Astro.site}blog` },
    { '@type': 'ListItem', position: 2, name: tag.name },
  ],
}
---

<BlogLayout
  title={`${tag.name} — Блог ДВИЖ`}
  description={tag.description ?? `Статьи с тегом «${tag.name}» в блоге ДВИЖ`}
  jsonLd={breadcrumbLd}
>
  <div class="max-w-[1440px] mx-auto px-4 py-16">
    <nav class="text-sm text-gray-500 mb-4">
      <a href="/blog" class="hover:underline">Блог</a>
      <span class="mx-2">›</span>
      <span>{tag.name}</span>
    </nav>

    <h1 class="text-4xl font-bold mb-2">#{tag.name}</h1>

    {tag.description && (
      <p class="text-gray-600 mb-2 max-w-2xl">{tag.description}</p>
    )}

    <p class="text-gray-400 text-sm mb-10">{posts.length} статей</p>

    {posts.length === 0 ? (
      <p class="text-gray-500">Пока нет статей с этим тегом.</p>
    ) : (
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        {posts.map((post: any) => (
          <BlogCard
            title={post.title}
            slug={post.slug}
            cover={post.cover}
            category={post.category?.title}
            excerpt={post.excerpt}
            tags={post.tags}
          />
        ))}
      </div>
    )}
  </div>
</BlogLayout>
