---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import PixelArrowPattern from '../components/ui/PixelArrowPattern.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import FeatureBlock from '../components/ui/FeatureBlock.astro'
import BentoGrid from '../components/ui/BentoGrid.astro'
import SuccessStoryBlock from '../components/ui/SuccessStoryBlock.astro'
import FormClosing from '../components/ui/FormClosing.astro'
---

<SiteLayout
  title="Цифровая ипотека"
  description="Ипотечная платформа для современных девелоперов. Повышаем конверсии на каждом этапе работы с заявками: от консультации до одобрения в банке"
  htmlClass="fluid-scale"
>

  {/* ── 1. Hero Section + Logos в одном экране ── */}
  <HeroSectionFull
    title="Закрывайте до 26% больше ипотечных сделок на том же трафике"
    description="Ипотечная платформа, которая повышает конверсии на каждом этапе работы с заявками: от консультации до одобрения в банке"
    demoLabel="Посмотреть демо"
    kpLabel="Получить КП"
    mobileBg="https://admin.dvizh.cc/api/media/file/ipoteka1-hero-mobile.webp"
  >
    <PixelArrowPattern slot="background" />
    <img
      id="hero-img"
      slot="right"
      src="https://admin.dvizh.cc/api/media/file/ipoteka1-hero.webp"
      alt=""
      class="h-[106dvh] w-auto object-contain"
      style="max-width: none; opacity: 0; transform: translateY(20px)"
      loading="eager"
      fetchpriority="high"
    />
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/a101.svg', alt: 'А101' },
        { src: '/partners/dark/ava.svg', alt: 'AVA' },
        { src: '/partners/dark/glorax.svg', alt: 'Глоракс' },
        { src: '/partners/dark/ganel.svg', alt: 'Гранель' },
        { src: '/partners/dark/strana.svg', alt: 'Страна' },
        { src: '/partners/dark/lsr.svg', alt: 'ЛСР' },
      ]}
    />
  </HeroSectionFull>

  {/* Reveal-анимация hero-картинки: невидима → плавно выплывает снизу → передает управление float */}
  <script>
    const img = document.getElementById('hero-img') as HTMLImageElement | null
    if (img) {
      const reveal = () => {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          img.style.transition = 'opacity 0.7s ease-out, transform 0.7s ease-out'
          img.style.opacity    = '1'
          img.style.transform  = 'translateY(0)'
        }))
        setTimeout(() => {
          img.style.transition = ''
          img.style.opacity    = ''
          img.style.transform  = ''
          img.classList.add('animate-hero-float')
        }, 750)
      }
      if (img.complete && img.naturalWidth > 0) reveal()
      else img.addEventListener('load', reveal, { once: true })
    }
  </script>

  {/* gap-24/40 между блоками + mt-24 lg:mt-32 — воздух на стыке hero↔первый блок (флюид) */}
  <div class="flex flex-col gap-24 lg:gap-40 mt-24 lg:mt-32">

  {/* ── 4. FeatureBlock — Повышаем конверсию ── */}
  <FeatureBlock
    interactive={false}
    class="!py-0"
    image="https://admin.dvizh.cc/api/media/file/mortgage_01_program-match.webp"
    imageAlt="Ипотечный калькулятор"
    heading="Повышаем конверсию из первичной консультации в ипотечную заявку в 2 раза"
    button={{ label: 'Узнать больше', drawerPreset: 'demo' }}
    features={[
      { title: 'Автоматический подбор программ под портрет клиента из 10 000 вариантов' },
      { title: '100% охват банков с максимальным одобрением' },
      { title: 'Расчет досрочных погашений и рефинансирования' },
    ]}
    review={{
      quote: 'Без единой анкеты ДВИЖа консультирование усложнилось, так как приходилось заходить на сайты, личные кабинеты каждого банка и смотреть ставки, размеры ежемесячных платежей',
      author: 'Елена Самсонова',
      role: 'Ипотечный брокер АН «АТОМ»',
      company: { logo: '/api/media/file/atom-logo.svg', alt: 'АН «АТОМ»' },
    }}
  />

  {/* ── 5. FeatureBlock — Сокращаем время ── */}
  <FeatureBlock
    interactive={false}
    class="!py-0"
    imageSide="left"
    image="https://admin.dvizh.cc/api/media/file/mortgage_02_unified-form.webp"
    imageAlt="Анкета клиента"
    heading="Убираем ошибки в анкетах — до 25% меньше заявок на доработке"
    button={{ label: 'Узнать больше', drawerPreset: 'demo' }}
    features={[
      { title: 'Распознавание документов от паспорта до 2-НДФЛ' },
      { title: 'Единая анкета в банки-лидеры по одобрению' },
    ]}
    review={{
      quote: 'С появлением ДВИЖа мы ускорили подачу заявок с часа до 5 минут и минимизировали ошибки в заполнении анкет',
      author: 'Екатерина Чурюкина',
      role: 'Руководитель управления прямых продаж',
      company: { logo: '/api/media/file/fsk_color.svg', alt: 'ФСК' },
    }}
  />

  {/* ── 6. FeatureBlock — Проверяем клиентов ── */}
  <FeatureBlock
    interactive={false}
    class="!py-0"
    image="https://admin.dvizh.cc/api/media/file/mortgage_03_client-check.webp"
    imageAlt="Ипотечный калькулятор"
    heading="Повышаем одобрение на 14% с помощью прескоринга"
    button={{ label: 'Узнать больше', drawerPreset: 'demo' }}
    features={[
      { title: 'Проверка долговой нагрузки и «красных флагов» банков' },
      { title: 'Прогноз скорости и вероятности одобрения в разных банках' },
      { title: 'Рекомендации по улучшению рейтинга и кредитного потенциала клиентов' },
    ]}
    review={{
      quote: 'Иногда клиент не знает о наличии какой-либо задолженности. Мы исключаем негативные факторы еще до подачи заявки в банк и увеличиваем шансы клиента получить одобрение по ипотеке',
      author: 'Екатерина Чурюкина',
      role: 'Руководитель управления прямых продаж',
      company: { logo: '/api/media/file/fsk_color.svg', alt: 'ФСК' },
    }}
  />

  {/* ── 7. FeatureBlock — Синхронизируем работу внутри отдела ── */}
  <FeatureBlock
    interactive={false}
    class="!py-0"
    imageSide="left"
    image="https://admin.dvizh.cc/api/media/file/mortgage_04_crm-sync.webp"
    imageAlt="Интеграции с CRM"
    heading="Синхронизируем работу внутри отдела"
    button={{ label: 'Узнать больше', drawerPreset: 'demo' }}
    features={[
      { title: 'Готовые интеграции с популярными CRM' },
      { title: 'Актуальные статусы без смены рабочего окна' },
      { title: 'Контроль сделок на всех этапах' },
    ]}
  />

  {/* ── 8. BentoGrid — Управляйте процессом на основе данных ── */}
  <section>
    <div class="page-container">
      <BentoGrid
        variant="four"
        heading="Управляйте процессом на основе данных"
        description="Насыщаем вашу CRM данными из ипотечных заявок и собираем ключевые показатели в персональные дашборды"
        items={[
          { titleHtml: 'Растите конверсии<br>маркетинговых кампаний', title: 'Растите конверсии маркетинговых кампаний', description: 'Формируем подробный портрет клиента: от возраста и дохода до ПДН и ПВ', backgroundImage: 'https://admin.dvizh.cc/api/media/file/mortgage_05_audience-profile.webp' },
          { titleHtml: 'Стройте новые<br>каналы продаж', title: 'Стройте новые каналы продаж', description: 'Покажем, в какой отрасли и компании работают покупатели, — для корпоративных продаж', backgroundImage: 'https://admin.dvizh.cc/api/media/file/mortgage_06_corporate-sales.webp' },
          { title: 'Анализируйте воронку продаж за 1 минуту', description: 'Рассчитаем конверсии по каждому этапу ипотеки, дадим статистику по сотрудникам и заявкам', backgroundImage: 'https://admin.dvizh.cc/api/media/file/mortgage_07_sales-funnel.webp' },
          { titleHtml: 'Разрабатывайте<br>субсидированные программы', title: 'Разрабатывайте субсидированные программы', description: 'Подготовим статистику по банкам и сегментам вашей ЦА', backgroundImage: 'https://admin.dvizh.cc/api/media/file/mortgage_08_subsidy-programs.webp', theme: 'dark' },
        ]}
      />
    </div>
  </section>

  {/* ── 9. SuccessStoryBlock ── */}
  <SuccessStoryBlock
    heading="70+ историй успеха на рынке девелопмента"
    buttonLabel="Получить демо"
    buttonPreset="demo"
    stories={[
      {
        logo: '/api/media/file/lsr_color.svg',
        logoAlt: 'ЛСР',
        logoHover: '/api/media/file/lsr_white-1.svg',
        hoverBackground: '/api/media/file/lsr_bg.png',
        hoverGlass: true,
        href: '/blog/keys-lsr-dvizh',
        titleHtml: 'Помогли начать обрабатывать на <span class="text-brand">281% заявок больше</span>, чем в среднем на рынке',
        personName: 'Группа ЛСР',
        personJobTitle: 'Один из ведущих строительных холдингов',
      },
      {
        logo: '/api/media/file/tochno_color.svg',
        logoAlt: 'ГК Точно',
        logoHover: '/api/media/file/tochno_white.svg',
        hoverBackground: '/api/media/file/tochno_bg.png',
        href: '/blog/keys-gk-tochno-i-dvizha',
        titleHtml: 'Увеличили объем закрытых сделок <span class="text-brand">с 1165 до 3500 за год</span>',
        personName: 'ГК «Точно»',
        personJobTitle: 'Крупнейший девелопер Краснодарского края',
      },
      {
        logo: '/api/media/file/enko.svg',
        logoAlt: 'ЭНКО',
        logoHover: '/api/media/file/enco-logo-white.svg',
        hoverBackground: '/api/media/file/enco-case.webp',
        href: '/blog/keys-enko-dvizh',
        titleHtml: 'Увеличили <span class="text-brand">объем заявок в 3 раза</span> при доле ипотеки 80%',
        personName: 'ЭНКО',
        personJobTitle: 'Один из крупнейших застройщиков Тюмени',
      },
    ]}
  />

  {/* ── 10. FormClosing ── */}
  <FormClosing
    preset="lead"
    title="Подберем решение<br>под ваши задачи"
    items={[
      'Найдем потерянные заявки и проанализируем путь клиента',
      'Проверим, не отстаете ли вы от рынка, и сравним ваши показатели с бенчмарками',
      'Составим рекомендации на основе опыта работы с застройщиками из топ-50',
    ]}
    submitLabel="Оставить заявку"
  />

  </div>{/* /gap-контейнер */}

</SiteLayout>
