---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSection from '../components/ui/HeroSection.astro'
import CTA from '../components/ui/CTA.astro'
---

<SiteLayout title="Витрина от ДВИЖ — демонстрация недвижимости" description="В 2 раза выше конверсия сайта. Встраиваемый модуль с ипотечным калькулятором, фильтрами и бронированием." jsonLd={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'ДВИЖ Витрина', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', provider: { '@type': 'Organization', name: 'ДВИЖ', url: 'https://dvizh.io' } }}>
  <HeroSection
    badge="Витрина от ДВИЖ"
    title="Удобный инструмент для демонстрации недвижимости"
    description="В 2 раза выше конверсия сайта. Встраиваемый модуль для сайта застройщика с ипотечным калькулятором, фильтрами, бронированием и интеграцией с CRM"
    formPreset="demo"
  />

  <!-- CTA -->
  <div class="max-w-[1440px] mx-auto px-4 py-12">
    <CTA
      title="Запросить демо"
      description="Посмотрите, как витрина ДВИЖ работает на реальном сайте застройщика"
      buttonText="Запросить демо"
      buttonHref="#"
    />
  </div>
</SiteLayout>
