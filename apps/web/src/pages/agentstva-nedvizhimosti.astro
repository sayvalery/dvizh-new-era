---
/**
 * Для агентств недвижимости — ДВИЖ
 */
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import PixelArrowPattern from '../components/ui/PixelArrowPattern.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import KeyFacts from '../components/ui/KeyFacts.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import FeatureBlock from '../components/ui/FeatureBlock.astro'
import SuccessStoryBlock from '../components/ui/SuccessStoryBlock.astro'
import ComparisonSection from '../components/ui/ComparisonSection.astro'

const cms = import.meta.env.PUBLIC_CMS_URL
---

<SiteLayout title="Для агентств недвижимости — ДВИЖ" description="Ипотечная платформа для агентств недвижимости. Подбор программ, подача заявок в банки и электронная регистрация в одном окне." htmlClass="fluid-scale">
  <HeroSectionFull
    title="Закрывайте сложные сделки и зарабатывайте на ипотеке"
    description="ДВИЖ — платформа для увеличения продаж у агентств недвижимости. Закрываем весь цикл сделки: от одобрения ипотеки до регистрации в Росреестре"
    demoLabel="Получить демо"
    kpLabel="Получить КП"
    demoPreset="demo"
    kpPreset="lead"
    mobileBg="https://admin.dvizh.cc/api/media/file/agents-hero-mobile.webp"
  >
    <PixelArrowPattern slot="background" />
    <img
      id="hero-img"
      slot="right"
      src="https://admin.dvizh.cc/api/media/file/agents-hero.webp"
      alt=""
      class="h-[106dvh] w-auto object-contain"
      style="max-width: none; opacity: 0; transform: translateY(20px)"
      loading="eager"
      fetchpriority="high"
    />
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/samolet-plus.svg', alt: 'Самолет Плюс' },
        { src: '/partners/dark/ayaks.svg', alt: 'Аякс', scale: 0.8 },
        { src: '/partners/dark/estatet.svg', alt: 'Est-a-Tet' },
        { src: '/partners/dark/ndv.svg', alt: 'НДВ' },
        { src: '/partners/dark/pn.svg', alt: 'Петербургская Недвижимость' },
      ]}
    />
  </HeroSectionFull>

  {/* Reveal-анимация hero-картинки: невидима → плавно выплывает снизу → передает управление float */}
  <script>
    const img = document.getElementById('hero-img') as HTMLImageElement | null
    if (img) {
      const reveal = () => {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          img.style.transition = 'opacity 0.7s ease-out, transform 0.7s ease-out'
          img.style.opacity    = '1'
          img.style.transform  = 'translateY(0)'
        }))
        setTimeout(() => {
          img.style.transition = ''
          img.style.opacity    = ''
          img.style.transform  = ''
          img.classList.add('animate-hero-float')
        }, 750)
      }
      if (img.complete && img.naturalWidth > 0) reveal()
      else img.addEventListener('load', reveal, { once: true })
    }
  </script>

  {/* mt-24 lg:mt-32 — воздух на стыке hero↔первый блок (флюид) */}
  <div class="flex flex-col gap-24 lg:gap-40 mt-24 lg:mt-32">
    <KeyFacts
      class="!pb-0"
      variant="large"
      items={[
        { value: 'На 26%', description: 'больше сделок закрываем на том же трафике' },
        { value: '79+', description: 'топовых девелоперов и агентств недвижимости' },
        { value: '40+', description: 'банков партнеров' },
      ]}
    />

    <!-- Ускоряем выход на сделку -->
    <FeatureBlock
      class="!py-0"
      heading="Ускоряем выход на сделку"
      features={[
        {
          title: 'Единая анкета',
          subtitle: 'Заполняйте одну анкету сразу во все банки за 5 минут',
          image: '/api/media/file/agencies_faster-competitors_unified-form.webp',
        },
        {
          title: '40+ банков партнеров',
          subtitle: 'Подбирайте ипотечную программу под любого клиента',
          image: '/api/media/file/agencies_difficult-clients_banks-grid.webp',
        },
        {
          title: 'Скоринг «ДВИЖ.Спектр»',
          subtitle: 'Проверяйте покупателей по крупнейшим кредитным бюро до отправки заявки в банк',
          image: '/api/media/file/agencies_difficult-clients_score-256.webp',
        },
        {
          title: 'Контроль сделок',
          subtitle: 'Отслеживайте все ключевые показатели ипотечного отдела в готовом дашборде',
          image: '/api/media/file/agencies_manager-control_weekly-stats.webp',
        },
        {
          title: 'ДВИЖ AI',
          subtitle: 'Выбирайте банки, в которых клиента точно одобрят',
          image: '/api/media/file/agencies_speed-up_text-to-tags.webp',
        },
        {
          title: 'ДВИЖ.Брокер',
          subtitle: 'Получайте до 1,2% КВ за сделки',
          image: '/api/media/file/agencies_speed-up_agency-dashboard.webp',
        },
      ]}
    />

    <!-- … и помогаем довести ее до конца -->
    <FeatureBlock
      class="!py-0"
      heading="… и помогаем довести ее до конца"
      description="Регистрируйте сделки любой сложности"
      imageSide="left"
      features={[
        {
          title: 'Быстрое заполнение данных',
          image: '/api/media/file/agencies_to-the-end_text-to-tags.webp',
        },
        {
          title: 'Пакетные регистрации',
          image: '/api/media/file/agencies_to-the-end_batch-registrations.webp',
        },
        {
          title: 'Актуальные статусы',
          image: '/api/media/file/agencies_to-the-end_e-reg-stages.webp',
        },
        {
          title: 'Выпуск ЭЦП',
          image: '/api/media/file/agencies_to-the-end_e-signature.webp',
        },
        {
          title: 'Бесшовный процесс',
          image: '/api/media/file/agencies_to-the-end_seamless-timeline.webp',
        },
      ]}
    />

    <!-- SuccessStoryBlock -->
    <SuccessStoryBlock
      heading="70+ историй успеха на рынке застройщиков"
      buttonLabel="Получить демо"
      buttonPreset="demo"
      class="!py-0"
      stories={[
        {
          logo: '/api/media/file/ayaks_color.svg',
          logoAlt: '«Аякс»',
          logoHover: '/api/media/file/ayaks_white.svg',
          hoverBackground: '/api/media/file/ayaks_bg.png',
          hoverGlass: true,
          href: '/blog/case-ayaks-dvizh',
          titleHtml: 'Сократили время одобрения в 4 раза <span class="text-brand">и повысили конверсию на 3-5%</span>',
          personName: '«Аякс»',
          personJobTitle: 'Агентство недвижимости',
        },
        {
          logo: '/api/media/file/tochno_color.svg',
          logoAlt: 'ГК Точно',
          logoHover: '/api/media/file/tochno_white.svg',
          hoverBackground: '/api/media/file/tochno_bg.png',
          href: '/blog/keys-gk-tochno-i-dvizha',
          titleHtml: 'Увеличили объем закрытых сделок <span class="text-brand">с 1165 до 3500 за год</span>',
          personName: 'ГК «Точно»',
          personJobTitle: 'Крупнейший девелопер Краснодарского края',
        },
        {
          logo: '/api/media/file/samolet_color.svg',
          logoAlt: 'ГК Самолет',
          logoHover: '/api/media/file/samolet_white.svg',
          hoverBackground: '/api/media/file/samolet_bg.png',
          href: '/blog/samolet-ai-u-developera',
          titleHtml: 'Дополнительно продали <span class="text-brand">96 квартир</span>',
          personName: 'ГК «Самолет»',
          personJobTitle: 'Крупнейший федеральный девелопер России',
        },
      ]}
    />

    <!-- ComparisonSection -->
    <ComparisonSection
      title="Одно решение для всей сделки"
      leftTitle="Без ДВИЖа"
      leftItems={[
        'Данные клиента теряются, сделка застревает между отделами',
        'Менеджер тратит время на нецелевых клиентов и не выполняет KPI',
        'Нет потенциала для апсейла клиентов',
        'Менеджер узнает о финансовых проблемах клиента после отказа в банке',
        'Море цифр и ни одного ответа на вопрос: почему сделка так и не закрылась за полгода',
      ]}
      rightItems={[
        'Вся сделка в одном окне: без ошибок и потерянных часов',
        'Менеджер успевает в 2 раза больше, выполняет KPI и не забывает про кофе-брейки',
        'Средний чек и допродажи постоянно растут',
        'Менеджер знает о платежеспособности клиентов больше, чем они сами',
        'Вклад каждого сотрудника виден как под микроскопом',
      ]}
      rightLogoSrc={`${cms}/api/media/file/dvizh_comp.svg`}
      rightLogoAlt="ДВИЖ"
      primaryButtonText="Получить демо"
      primaryDrawerPreset="demo"
      secondaryButtonText=""
    />

    <!-- FormClosing -->
    <FormClosing
      preset="lead"
      title="Попробуйте ДВИЖ в деле"
      items={[
        'Менеджер ответит на любые вопросы',
        'Среднее время ответа техподдержки — 57 сек',
        'Помогаем увеличивать продажи',
      ]}
      submitLabel="Получить демо"
      privacyText="Нажимая кнопку «Получить демо», вы даете согласие на обработку ваших персональных данных и подтверждаете, что ознакомлены с Политикой обработки персональных данных"
    />

  </div>
</SiteLayout>
