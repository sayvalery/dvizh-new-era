---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSection from '../components/ui/HeroSection.astro'
import CTA from '../components/ui/CTA.astro'
---

<SiteLayout title="Для агентств недвижимости — ДВИЖ" description="Ипотечная платформа для агентств недвижимости. Подбор программ, подача заявок в банки и электронная регистрация в одном окне.">
  <HeroSection
    badge="Решение для агентств"
    title="Улучшайте конверсии на всех этапах воронки"
    description="AI-платформа для автоматизации продаж и маркетинга. Цифровая ипотека, страхование, регистрация сделок и AI-инструменты — всё на одной платформе."
    formPreset="demo"
  />

  <!-- CTA -->
  <div class="max-w-[1440px] mx-auto px-4 py-12">
    <CTA
      title="Записаться на демо"
      description="Покажем, как ДВИЖ поможет вашему агентству зарабатывать больше на каждой сделке"
      buttonText="Записаться на демо"
      buttonHref="#"
    />
  </div>
</SiteLayout>
