---
/**
 * Для агентств недвижимости — ДВИЖ
 */
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import KeyFacts from '../components/ui/KeyFacts.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import FeatureBlock from '../components/ui/FeatureBlock.astro'
import SuccessStoryBlock from '../components/ui/SuccessStoryBlock.astro'
import ComparisonSection from '../components/ui/ComparisonSection.astro'

const cms = import.meta.env.PUBLIC_CMS_URL
---

<SiteLayout title="Для агентств недвижимости — ДВИЖ" description="Ипотечная платформа для агентств недвижимости. Подбор программ, подача заявок в банки и электронная регистрация в одном окне." bodyClass="bg-background-primary">
  <HeroSectionFull
    title="Закрывайте сложные сделки и зарабатывайте на ипотеке"
    description="ДВИЖ — платформа для увеличения продаж у агентств недвижимости. Закрываем весь цикл сделки: от одобрения ипотеки до регистрации в Росреестре"
    demoLabel="Получить демо"
    kpLabel="Получить КП"
    demoPreset="demo"
    kpPreset="lead"
  >
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/a101.svg', alt: 'А101' },
        { src: '/partners/dark/ava.svg', alt: 'AVA' },
        { src: '/partners/dark/glorax.svg', alt: 'Глоракс' },
        { src: '/partners/dark/ganel.svg', alt: 'Гранель' },
        { src: '/partners/dark/strana.svg', alt: 'Страна' },
        { src: '/partners/dark/lsr.svg', alt: 'ЛСР' },
      ]}
    />
  </HeroSectionFull>

  <div class="flex flex-col gap-24 lg:gap-40">
    <KeyFacts
      class="!pb-0"
      variant="large"
      items={[
        { value: 'На 26%', description: 'больше сделок закрываем на том же трафике' },
        { value: '79+', description: 'топовых девелоперов и агентств недвижимости' },
        { value: '40+', description: 'банков партнеров' },
      ]}
    />

    <!-- Ускоряем выход на сделку -->
    <FeatureBlock
      class="!py-0"
      heading="Ускоряем выход на сделку"
      image="https://admin.dvizh.cc/api/media/file/calc_widget_vert.png"
      imageMobile="https://admin.dvizh.cc/api/media/file/calc_widget_horiz.png"
      imageAlt="Калькулятор виджет"
      features={[
        { title: 'Единая анкета', subtitle: 'Заполняйте одну анкету сразу во все банки за 5 минут' },
        { title: '40+ банков партнеров', subtitle: 'Подбирайте ипотечную программу под любого клиента' },
        { title: 'Скоринг «ДВИЖ.Спектр»', subtitle: 'Проверяйте покупателей по крупнейшим кредитным бюро до отправки заявки в банк' },
        { title: 'Контроль сделок', subtitle: 'Отслеживайте все ключевые показатели ипотечного отдела в готовом дашборде' },
        { title: 'ДВИЖ AI', subtitle: 'Выбирайте банки, в которых клиента точно одобрят' },
      ]}
    />

    <!-- … и помогаем довести ее до конца -->
    <FeatureBlock
      class="!py-0"
      heading="… и помогаем довести ее до конца"
      description="Регистрируйте сделки любой сложности"
      imageSide="left"
      image="https://admin.dvizh.cc/api/media/file/anketa_vert.png"
      imageMobile="https://admin.dvizh.cc/api/media/file/anketa_horiz.png"
      imageAlt="Анкета"
      features={[
        { title: 'Быстрое заполнение данных' },
        { title: 'Пакетные регистрации' },
        { title: 'Актуальные статусы' },
        { title: 'Выпуск ЭЦП' },
        { title: 'Бесшовный процесс' },
      ]}
    />

    <!-- SuccessStoryBlock -->
    <SuccessStoryBlock
      heading="70+ историй успеха на рынке застройщиков"
      buttonLabel="Получить демо"
      buttonPreset="demo"
      class="!py-0"
      stories={[
        {
          logo: '/api/media/file/ayaks_color.svg',
          logoAlt: '«Аякс»',
          logoHover: '/api/media/file/ayaks_white.svg',
          hoverBackground: '/api/media/file/ayaks_bg.png',
          hoverGlass: true,
          titleHtml: 'Сократили время одобрения в 4 раза <span class="text-brand">и повысили конверсию на 3-5%</span>',
          personName: '«Аякс»',
          personJobTitle: 'Агентство недвижимости',
        },
        {
          logo: '/api/media/file/tochno_color.svg',
          logoAlt: 'ГК Точно',
          logoHover: '/api/media/file/tochno_white.svg',
          hoverBackground: '/api/media/file/tochno_bg.png',
          titleHtml: 'Увеличили объем закрытых сделок <span class="text-brand">с 1165 до 3500 за год</span>',
          personName: 'ГК «Точно»',
          personJobTitle: 'Крупнейший девелопер Краснодарского края',
        },
        {
          logo: '/api/media/file/samolet_color.svg',
          logoAlt: 'ГК Самолет',
          logoHover: '/api/media/file/samolet_white.svg',
          hoverBackground: '/api/media/file/samolet_bg.png',
          titleHtml: 'Дополнительно продали <span class="text-brand">96 квартир</span>',
          personName: 'ГК «Самолет»',
          personJobTitle: 'Крупнейший федеральный девелопер России',
        },
      ]}
    />

    <!-- ComparisonSection -->
    <ComparisonSection
      title="Одно решение для всей сделки"
      leftTitle="Без ДВИЖа"
      leftItems={[
        'Данные клиента теряются, сделка застревает между отделами',
        'Менеджер тратит время на нецелевых клиентов и не выполняет KPI',
        'Нет потенциала для апсейла клиентов',
        'Менеджер узнает о финансовых проблемах клиента после отказа в банке',
        'Море цифр и ни одного ответа на вопрос: почему сделка так и не закрылась за полгода',
      ]}
      rightItems={[
        'Вся сделка в одном окне: без ошибок и потерянных часов',
        'Менеджер успевает в 2 раза больше, выполняет KPI и не забывает про кофе-брейки',
        'Средний чек и допродажи постоянно растут',
        'Менеджер знает о платежеспособности клиентов больше, чем они сами',
        'Вклад каждого сотрудника виден как под микроскопом',
      ]}
      rightLogoSrc={`${cms}/api/media/file/dvizh_comp.svg`}
      rightLogoAlt="ДВИЖ"
      primaryButtonText="Получить демо"
      primaryDrawerPreset="demo"
      secondaryButtonText=""
    />

    <!-- FormClosing -->
    <FormClosing
      preset="lead"
      title="Попробуйте ДВИЖ в деле"
      items={[
        'Менеджер ответит на любые вопросы',
        'Среднее время ответа техподдержки — 57 сек',
        'Помогаем увеличивать продажи',
      ]}
      submitLabel="Получить демо"
      privacyText="Нажимая кнопку «Получить демо», вы даете согласие на обработку ваших персональных данных и подтверждаете, что ознакомлены с Политикой обработки персональных данных"
    />

  </div>
</SiteLayout>
