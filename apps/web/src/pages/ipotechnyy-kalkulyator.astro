---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import KeyFacts from '../components/ui/KeyFacts.astro'
import ComparisonSection from '../components/ui/ComparisonSection.astro'
import ReviewFull from '../components/ui/ReviewFull.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import CalculatorEmbed from '../components/ui/CalculatorEmbed.astro'
---

<SiteLayout title="Ипотечный калькулятор" description="Встраиваемый ипотечный калькулятор для сайта застройщика. Актуальные ставки 40+ банков." bodyClass="fluid-page" jsonLd={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'ДВИЖ Ипотечный калькулятор', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', provider: { '@type': 'Organization', name: 'ДВИЖ', url: 'https://dvizh.io' } }}>
  <HeroSectionFull
    title="Получайте до 20% больше заявок с помощью готового калькулятора"
    description="ДВИЖ Калькулятор — готовый виджет для вашего сайта, который показывает актуальные программы 40+ банков и помогает подобрать лучшие условия клиенту"
    demoLabel="Записаться на демо"
    kpLabel="Попробовать бесплатно"
    demoPreset="demo"
    kpPreset="lead"
  >
    <img
      slot="right"
      src="https://admin.dvizh.cc/api/media/file/calc-hero.webp"
      alt=""
      class="h-[106dvh] w-auto object-contain animate-hero-float"
      style="max-width: none"
      loading="eager"
    />
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/a101.svg', alt: 'А101' },
        { src: '/partners/dark/ava.svg', alt: 'AVA' },
        { src: '/partners/dark/glorax.svg', alt: 'Глоракс' },
        { src: '/partners/dark/ganel.svg', alt: 'Гранель' },
        { src: '/partners/dark/strana.svg', alt: 'Страна' },
        { src: '/partners/dark/lsr.svg', alt: 'ЛСР' },
      ]}
    />
  </HeroSectionFull>

  <!-- gap-24/40 между блоками + mt-24 lg:mt-32 — воздух на стыке hero↔первый блок (флюид) -->
  <div class="flex flex-col gap-24 lg:gap-40 mt-24 lg:mt-32">

  <!-- KeyFacts -->
  <KeyFacts
    class="!pb-0"
    variant="large"
    title="Больше лидов на том же трафике"
    items={[
      { value: '80% заявок', description: 'приходит в нерабочее время, не теряйте их' },
      { value: '50% клиентов', description: 'заранее хотят рассчитать ежемесячный платеж' },
      { value: 'на 20% выше', description: 'конверсия в сделку, когда клиент знает доступный бюджет ипотеки' },
    ]}
  />

  <!-- Виджет калькулятора — живое демо -->
  <!-- w-full на page-container: внутри flex-col его margin:auto отключает stretch,
       и контейнер сжимается по интринсик-ширине iframe (300px) — w-full это ломает -->
  <div class="page-container w-full">
    <CalculatorEmbed />
  </div>

  <!-- ComparisonSection -->
  <ComparisonSection
    title="Выбор лучших девелоперов"
    leftTitle="Самописные и рыночные решения"
    leftItems={[
      'Необходимо вручную поддерживать актуальность ставок',
      'Нельзя рассчитать комбо- и ипотеку с удорожанием стоимости',
      'Нет возможности выделить наиболее выгодное предложение',
      'Нет потенциала для апсейла клиентов',
    ]}
    rightItems={[
      'Ипотечные ставки обновляются автоматически',
      'Считает все виды ипотек: траншевую, комбо, с удорожанием, субсидированную, рассрочку',
      'Меняет порядок ипотечных программ и показывает выгодные предложения',
      'Увеличивает средний чек за счет персональных предложений',
    ]}
    rightLogoSrc={`${import.meta.env.PUBLIC_CMS_URL}/api/media/file/dvizh_comp.svg`}
    rightLogoAlt="ДВИЖ"
    primaryButtonText="Записаться на демо"
    primaryDrawerPreset="demo"
    secondaryButtonText="Пробовать бесплатно"
    secondaryDrawerPreset="lead"
  />

  <!-- ReviewFull -->
  <div class="page-container">
    <ReviewFull
      photo={{ src: `${import.meta.env.PUBLIC_CMS_URL}/api/media/file/calc_person_transp.png`, alt: 'Бурганов Рунар' }}
      quote="Разработка отдельного инструмента под каждый проект — это большие трудозатраты и финансовые расходы. За счет использования стороннего решения, уже готового и гибко настраиваемого, мы оптимизируем наши процессы и, самое главное, сокращаем в сроке реализации."
      author="Бурганов Рунар"
      role="Руководитель отдела ипотеки и финансовых инструментов"
      company={{ logo: `${import.meta.env.PUBLIC_CMS_URL}/api/media/file/kortross.svg`, alt: 'Кортрос' }}
      caseLink={{ label: 'Читать кейс', href: '/cases/kortros' }}
    />
  </div>

  <!-- FormClosing -->
  <FormClosing
    mode="form"
    preset="lead"
    title="Реализация по API — для тех, кто хочет еще больше"
    items={[
      'Адаптируйте ипотечный калькулятор под ваш фирменный стиль',
      'Встройте расчеты прямо в карточку лота на сайте',
      'Избавьтесь от рисков и юридических ошибок: следим за соответствием ФЗ',
    ]}
    submitLabel="Попробовать бесплатно"
  />

  </div>{/* /gap-контейнер */}
</SiteLayout>
