---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import PixelArrowPattern from '../components/ui/PixelArrowPattern.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import KeyFacts from '../components/ui/KeyFacts.astro'
import ComparisonSection from '../components/ui/ComparisonSection.astro'
import ReviewFull from '../components/ui/ReviewFull.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import CalculatorEmbed from '../components/ui/CalculatorEmbed.astro'
import FeatureBlock from '../components/ui/FeatureBlock.astro'
---

<SiteLayout title="Ипотечный калькулятор" description="Встраиваемый ипотечный калькулятор для сайта застройщика. Актуальные ставки 40+ банков." bodyClass="fluid-page" jsonLd={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'ДВИЖ Ипотечный калькулятор', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', provider: { '@type': 'Organization', name: 'ДВИЖ', url: 'https://dvizh.io' } }}>
  <HeroSectionFull
    title="Получайте до 20% больше заявок с помощью готового калькулятора"
    description="ДВИЖ Калькулятор — готовое решение, которое показывает клиентам реальные условия ипотеки, подбирает лучшие предложения банков и принимает онлайн-заявки 24/7"
    demoLabel="Записаться на демо"
    kpLabel="Попробовать бесплатно"
    demoPreset="demo"
    kpPreset="lead"
    mobileBg="https://admin.dvizh.cc/api/media/file/calc-hero-mobile.webp"
  >
    <PixelArrowPattern slot="background" />
    <img
      id="hero-img"
      slot="right"
      src="https://admin.dvizh.cc/api/media/file/calc-hero.webp"
      alt=""
      class="h-[106dvh] w-auto object-contain"
      style="max-width: none; opacity: 0; transform: translateY(20px)"
      loading="eager"
      fetchpriority="high"
    />
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/a101.svg', alt: 'А101' },
        { src: '/partners/dark/ava.svg', alt: 'AVA' },
        { src: '/partners/dark/glorax.svg', alt: 'Глоракс' },
        { src: '/partners/dark/ganel.svg', alt: 'Гранель' },
        { src: '/partners/dark/strana.svg', alt: 'Страна' },
        { src: '/partners/dark/lsr.svg', alt: 'ЛСР' },
      ]}
    />
  </HeroSectionFull>

  {/* Reveal-анимация hero-картинки: невидима → плавно выплывает снизу → передаёт управление float */}
  <script>
    const img = document.getElementById('hero-img') as HTMLImageElement | null
    if (img) {
      const reveal = () => {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          img.style.transition = 'opacity 0.7s ease-out, transform 0.7s ease-out'
          img.style.opacity    = '1'
          img.style.transform  = 'translateY(0)'
        }))
        setTimeout(() => {
          img.style.transition = ''
          img.style.opacity    = ''
          img.style.transform  = ''
          img.classList.add('animate-hero-float')
        }, 750)
      }
      if (img.complete && img.naturalWidth > 0) reveal()
      else img.addEventListener('load', reveal, { once: true })
    }
  </script>

  <!-- gap-24/40 между блоками + mt-24 lg:mt-32 — воздух на стыке hero↔первый блок (флюид) -->
  <div class="flex flex-col gap-24 lg:gap-40 mt-24 lg:mt-32">

  <!-- KeyFacts -->
  <KeyFacts
    class="!pb-0"
    variant="large"
    title="Больше лидов на том же трафике"
    subtitle="Ипотечный калькулятор круглосуточно конвертирует интерес в заявки, независимо от графика колл-центра и отдела продаж"
    items={[
      { value: '80% заявок', description: 'приходит в нерабочее время, не теряйте их' },
      { value: '50% клиентов', description: 'заранее хотят рассчитать ежемесячный платеж' },
      { value: 'на 20% выше', description: 'конверсия в сделку, когда клиент знает доступный бюджет ипотеки' },
    ]}
  />

  <!-- FeatureBlock 1 — Точные расчёты (картинка справа) + отзыв ЭНКО -->
  <FeatureBlock
    interactive={false}
    class="!py-0"
    image="/api/media/file/mortgage_bento_ai-prognosis.webp"
    imageAlt="Точные расчёты и подбор условий"
    heading="Точные расчёты и подбор лучших условий"
    features={[
      { title: 'Рассчитывает параметры по всем актуальным предложениям банков под каждый лот' },
      { title: 'Работает с комбо-, субсидированной и траншевой ипотеками и ипотекой с удорожанием стоимости' },
      { title: 'Подбирает условия под клиента и сортирует программы от более выгодных к менее' },
    ]}
    review={{
      quote: 'В калькуляторе ДВИЖа очень удобно, что можно настраивать индивидуальные программы и субсидирование. Клиент всегда видит самые выгодные предложения и оставляет заявку на более подробную консультацию у нашего брокера.',
      author: 'Юлия Романовская',
      role: 'Руководитель службы сопровождения клиентов',
      company: { logo: '/api/media/file/enko.svg', alt: 'ЭНКО' },
      caseLink: { label: 'Читать кейс', href: '/blog/keys-enko-dvizh' },
    }}
  />

  <!-- FeatureBlock 2 — Рост конверсии из агентских сделок (картинка слева, шахматный порядок) -->
  <FeatureBlock
    interactive={false}
    class="!py-0"
    imageSide="left"
    image="/api/media/file/mortgage_bento_unified-form.webp"
    imageAlt="Рост конверсии из агентских сделок"
    heading="Рост конверсии из агентских сделок"
    features={[
      { title: 'Исключает расхождения в расчётах агентов и отдела продаж' },
      { title: 'Приводит клиентов с готовым расчётом и сформированными ожиданиями по платежу' },
      { title: 'Отправляет уже заполненную заявку в работу ипотечному брокеру' },
    ]}
  />

  <!-- FeatureBlock 3 — Встраивается в вашу экосистему (картинка справа) -->
  <FeatureBlock
    interactive={false}
    class="!py-0"
    image="/api/media/file/mortgage_bento_score.webp"
    imageAlt="Встраивается в вашу экосистему"
    heading="Встраивается в вашу экосистему"
    features={[
      { title: 'Готовый виджет в ваших цветах или API-интеграция' },
      { title: 'На сайте или в карточке квартиры' },
      { title: 'Передаёт данные в CRM и ипотечный модуль' },
    ]}
  />

  <!-- Виджет калькулятора — живое демо -->
  <!-- w-full на page-container: внутри flex-col его margin:auto отключает stretch,
       и контейнер сжимается по интринсик-ширине iframe (300px) — w-full это ломает -->
  <div class="page-container w-full">
    <CalculatorEmbed />
  </div>

  <!-- ComparisonSection -->
  <ComparisonSection
    title="Окупает себя на этапе внедрения"
    leftTitle="Самописные и рыночные решения"
    leftItems={[
      'Требует ресурсов на разработку',
      'Нужно вручную поддерживать актуальность программ и ставок',
      'Нужно дорабатывать под каждую новую комбо-ипотеку или ипотеку с удорожанием стоимости',
      'Нет возможности выделить наиболее выгодное предложение',
    ]}
    rightItems={[
      'Быстрый старт без привлечения внутренних или внешних IT-ресурсов',
      'Программы и ставки обновляются автоматически — без ошибок и юридических рисков',
      'Считает все виды ипотек: траншевую, комбо, с удорожанием, субсидированную, рассрочку',
      'Меняет порядок программ и подсвечивает самые выгодные предложения',
      'Избавьтесь от рисков и юридических ошибок: следим за соответствием ФЗ',
    ]}
    rightLogoSrc={`${import.meta.env.PUBLIC_CMS_URL}/api/media/file/dvizh_comp.svg`}
    rightLogoAlt="ДВИЖ"
    primaryButtonText="Записаться на демо"
    primaryDrawerPreset="demo"
    secondaryButtonText="Попробовать бесплатно"
    secondaryDrawerPreset="lead"
  />

  <!-- ReviewFull -->
  <div class="page-container">
    <ReviewFull
      photo={{ src: `${import.meta.env.PUBLIC_CMS_URL}/api/media/file/calc_person_transp.png`, alt: 'Рунар Бурганов' }}
      quote="Разработка отдельного инструмента под каждый проект — это большие трудозатраты и финансовые расходы. За счет использования стороннего решения, уже готового и гибко настраиваемого, мы оптимизируем наши процессы и, самое главное, сокращаем в сроке реализации."
      author="Рунар Бурганов"
      role="Руководитель отдела ипотеки и финансовых инструментов"
      company={{ logo: `${import.meta.env.PUBLIC_CMS_URL}/api/media/file/kortross.svg`, alt: 'Кортрос' }}
      caseLink={{ label: 'Читать кейс', href: '/cases/kortros' }}
    />
  </div>

  <!-- FormClosing -->
  <FormClosing
    mode="form"
    preset="lead"
    title="Получайте больше качественных лидов с сайта и от агентов"
    description="Оставьте заявку, и мы покажем, как ДВИЖ Калькулятор будет работать на вашем сайте и в агентском кабинете"
    submitLabel="Попробовать бесплатно"
  />

  </div>{/* /gap-контейнер */}
</SiteLayout>
