---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import ComparisonSection from '../components/ui/ComparisonSection.astro'
import CTABanner from '../components/ui/CTABanner.astro'
import ReviewFull from '../components/ui/ReviewFull.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import ProductBentoBlock from '../components/ui/ProductBentoBlock.astro'
---

<SiteLayout
  title="Электронная регистрация сделок"
  description="Сократите затраты на регистрацию на 30%. Электронная регистрация сделок с недвижимостью."
  jsonLd={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'ДВИЖ Электронная регистрация', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', provider: { '@type': 'Organization', name: 'ДВИЖ', url: 'https://dvizh.io' } }}
>

  {/* ── 1. Hero Section + Logos в одном экране ── */}
  <HeroSectionFull
    title="Регистрируйте все виды сделок с выгодой до 30%"
    description="Заводите сделки на регистрацию за 5 минут — все данные по подписантам подтянутся из CRM или ипотечного модуля"
    demoLabel="Записаться на демо"
    kpLabel="Попробовать бесплатно"
  >
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/fsk.svg', alt: 'ФСК' },
        { src: '/partners/dark/mrgroup.svg', alt: 'MR Group' },
        { src: '/partners/dark/donstroy.svg', alt: 'Донстрой' },
        { src: '/partners/dark/a101.svg', alt: 'А101' },
        { src: '/partners/dark/setl.svg', alt: 'Setl Group' },
        { src: '/partners/dark/etalon.svg', alt: 'Эталон' },
        { src: '/partners/dark/strana.svg', alt: 'Страна' },
        { src: '/partners/dark/dogma.svg', alt: 'Догма' },
        { src: '/partners/dark/glorax.svg', alt: 'Глоракс' },
        { src: '/partners/dark/ava.svg', alt: 'AVA' },
        { src: '/partners/dark/samolet.svg', alt: 'Самолёт' },
      ]}
    />
  </HeroSectionFull>

  {/* gap-24 (96px) base/sm/md / lg:gap-40 (160px) */}
  <div class="flex flex-col gap-24 lg:gap-40">

  {/* ── 2. ProductBentoBlock — 5 карточек ── */}
  <ProductBentoBlock
    class="!py-0"
    showEyebrow={false}
    headingDark="Лучшие девелоперы регистрируют"
    headingBrand="сделки через ДВИЖ"
    cards={[
      {
        title: 'Сложные сделки',
        description: 'Регистрация более 10 видов сделок, включая ДДУ, ДКП, ДС, сделок с детьми и иностранцами',
      },
      {
        title: 'Пакетные регистрации',
        description: 'Чтобы регистрировать квартиру за 15 минут вместо недели',
        variant: 'dark',
      },
      {
        title: 'Ускоренная подача',
        description: 'Подключим оплату госпошлины с авансового счета внутри ДВИЖа',
      },
      {
        title: 'Выпуск ЭЦП за 5 минут',
        description: 'Поддерживаем все технологии: токен, Sign.Me, Госключ',
        variant: 'brand',
      },
      {
        title: 'Всегда рядом с вами',
        description: 'Поможем зарегистрировать сложные сделки: с иностранными гражданами или военной ипотекой',
      },
    ]}
  />

  {/* ── 3. ComparisonSection variant='prices' + CTABanner внутри ── */}
  <ComparisonSection
    class="!py-0"
    variant="prices"
    label="Стоимость"
    title="Быстрее и выгоднее на каждом этапе"
    leftTitle="Без ДВИЖа"
    rightLogoSrc={`${import.meta.env.PUBLIC_CMS_URL}/api/media/file/dvizh_comp.svg`}
    priceRows={[
      { label: 'Регистрация', leftValue: 'от 1 700 ₽', rightValue: '1 000 ₽' },
      { label: 'Госпошлина', leftValue: '7%', rightValue: '200 ₽' },
    ]}
  >
    <CTABanner
      slot="cta"
      title="Узнайте, сколько вы можете сэкономить"
      buttonText="Получить расчет"
      drawerPreset="lead"
    />
  </ComparisonSection>

  {/* ── 5. ReviewFull ── */}
  <section class="!py-0">
    <div class="page-container">
      <ReviewFull
        photo={{ src: '/api/media/file/shved-review.webp', alt: 'Анастасия Швед' }}
        quote="Раньше мы могли провозиться с регистрацией дома неделю, потому что каждое заявление создавалось вручную. Теперь любое количество объектов мы можем отправить на регистрацию за считанные минуты. К тому же, за счет комплексного предложения (ипотека+регистрация) ДВИЖ выходит на 30% дешевле других рыночных платформ."
        author="Анастасия Швед"
        company={{ logo: '/api/media/file/talan_color.svg', alt: 'Талан' }}
        role="Директор по продажам"
        caseLink={{ label: 'Читать кейс', href: '/cases' }}
      />
    </div>
  </section>

  {/* ── 6. FormClosing ── */}
  <FormClosing
    preset="lead"
    title="Попробуйте ДВИЖ в деле"
    items={[
      'Менеджер ответит на любые вопросы',
      'Среднее время ответа техподдержки — 57 сек',
      'Помогаем увеличивать продажи',
    ]}
    submitLabel="Получить демо"
    class="!py-0"
  />

  </div>{/* /gap-контейнер */}

</SiteLayout>
