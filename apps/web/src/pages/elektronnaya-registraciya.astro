---
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroSectionFull from '../components/lab-new/HeroSectionFull.astro'
import PixelArrowPattern from '../components/ui/PixelArrowPattern.astro'
import LogoGrid from '../components/ui/LogoGrid.astro'
import FormClosing from '../components/ui/FormClosing.astro'
import BentoGrid from '../components/ui/BentoGrid.astro'
import FeatureBlock from '../components/ui/FeatureBlock.astro'
---

<SiteLayout
  title="Электронная регистрация сделок"
  bodyClass="fluid-page"
  description="Сократите затраты на регистрацию на 30%. Электронная регистрация сделок с недвижимостью."
  jsonLd={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'ДВИЖ Электронная регистрация', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', provider: { '@type': 'Organization', name: 'ДВИЖ', url: 'https://dvizh.io' } }}
>

  {/* ── 1. Hero Section + Logos ── */}
  <HeroSectionFull
    title="Регистрируйте сделки быстрее: без ручного ввода данных и приостановок"
    description="Заводите сделки на регистрацию за 5 минут — все данные по подписантам подтянутся из CRM или ипотечного модуля. А эксперты поддержки помогут довести до финала сделки любой сложности и без выходных"
    demoLabel="Записаться на демо"
    kpLabel="Попробовать бесплатно"
    mobileBg="https://admin.dvizh.cc/api/media/file/rega1-hero-mobile.webp"
  >
    <PixelArrowPattern slot="background" />
    <img
      id="hero-img"
      slot="right"
      src="https://admin.dvizh.cc/api/media/file/rega-hero.webp"
      alt=""
      class="h-[106dvh] w-auto object-contain"
      style="max-width: none; opacity: 0; transform: translateY(20px)"
      loading="eager"
      fetchpriority="high"
    />
    <LogoGrid
      slot="logos"
      noPadding
      logos={[
        { src: '/partners/dark/glorax.svg', alt: 'Глоракс' },
        { src: '/partners/dark/strana.svg', alt: 'Страна' },
        { src: '/partners/dark/sminex.svg', alt: 'Sminex' },
        { src: '/partners/dark/a101.svg', alt: 'А101' },
        { src: '/partners/dark/one-moscow.svg', alt: 'One Moscow' },
        { src: '/partners/dark/kortros.svg', alt: 'Кортрос' },
      ]}
    />
  </HeroSectionFull>

  {/* Reveal-анимация hero-картинки */}
  <script>
    const img = document.getElementById('hero-img') as HTMLImageElement | null
    if (img) {
      const reveal = () => {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          img.style.transition = 'opacity 0.7s ease-out, transform 0.7s ease-out'
          img.style.opacity    = '1'
          img.style.transform  = 'translateY(0)'
        }))
        setTimeout(() => {
          img.style.transition = ''
          img.style.opacity    = ''
          img.style.transform  = ''
          img.classList.add('animate-hero-float')
        }, 750)
      }
      if (img.complete && img.naturalWidth > 0) reveal()
      else img.addEventListener('load', reveal, { once: true })
    }
  </script>

  {/* gap-24/40 между блоками + mt-24 lg:mt-32 — воздух на стыке hero↔первый блок */}
  <div class="flex flex-col gap-24 lg:gap-40 mt-24 lg:mt-32">

  {/* ── 2. FeatureBlock 1 — Легкий старт (картинка справа) + отзыв GloraX ── */}
  {/* TODO вернуть картинку: image="/api/media/file/e-reg_bento_batch-registrations.webp" */}
  <FeatureBlock
    interactive={false}
    class="!py-0"
    imageAlt="Легкий старт и масштабирование"
    heading="Легкий старт и масштабирование"
    features={[
      { title: 'Заведение сделки в систему — до 5 минут' },
      { title: 'Подключение новых объектов и регионов — до 15 минут' },
    ]}
    review={{
      quote: 'Раньше мы могли провозиться с регистрацией дома неделю, потому что каждое заявление создавалось вручную. Теперь любое количество объектов мы можем отправить на регистрацию за считанные минуты.',
      author: 'Марина Белоусова',
      role: 'Руководитель отдела регистрации GloraX',
      company: { logo: '/api/media/file/glorax_color.svg', alt: 'GloraX' },
      caseLink: { label: 'Читать кейс', href: '/cases/glorax' },
    }}
  >
    <div slot="image" class="h-full w-full bg-gray-200"></div>
  </FeatureBlock>

  {/* ── 3. FeatureBlock 2 — Бесшовный цикл (картинка слева, шахматный порядок) ── */}
  {/* TODO вернуть картинку: image="/api/media/file/e-reg_bento_prepaid-account.webp" */}
  <FeatureBlock
    interactive={false}
    class="!py-0"
    imageSide="left"
    imageAlt="Бесшовный цикл сделки от ипотеки до регистрации"
    heading="Бесшовный цикл сделки от ипотеки до регистрации"
    features={[
      { title: 'Данные из ипотечного профиля или CRM автоматически подставляются в анкету' },
      { title: 'Меньше рутины для менеджеров' },
      { title: 'Меньше ошибок из-за ручного ввода данных' },
    ]}
  >
    <div slot="image" class="h-full w-full bg-gray-200"></div>
  </FeatureBlock>

  {/* ── 3. BentoGrid — 2 карточки: обмен с CRM + экспертная поддержка ── */}
  <section class="!py-0">
    <div class="page-container">
      <BentoGrid
        variant="two"
        headingHtml='Каждый этап регистрации <span class="text-brand">под контролем</span>'
        items={[
          {
            title: 'Обмен данными с CRM',
            description: 'Статус в карточке сделки автоматически обновляется на каждом этапе регистрации',
            // TODO вернуть картинку: backgroundImage: '/api/media/file/e-reg_bento_expert-profile.webp',
          },
          {
            title: 'Экспертная поддержка без выходных',
            description: 'Служба поддержки — бывшие регистраторы застройщиков. Помогают правильно оформить сделки любой сложности. Если возникла приостановка — выясняют причину в Росреестре и решают вопрос максимально быстро',
            // TODO вернуть картинку: backgroundImage: '/api/media/file/e-reg_bento_deal-types.webp',
          },
        ]}
      />
    </div>
  </section>

  {/* ── 4. FeatureBlock 3 — Гибкие опции оплаты (картинка справа) + отзыв GloraX ── */}
  {/* TODO вернуть картинку: image="/api/media/file/e-reg_bento_e-signature.webp" */}
  <FeatureBlock
    interactive={false}
    class="!py-0"
    imageAlt="Гибкие опции оплаты"
    heading="Гибкие опции оплаты и минимум на 30% дешевле других платформ"
    features={[
      { title: 'Стоимость ниже за счет комплексного предложения' },
      { title: 'Отложенный платеж: если на авансовом счете закончились деньги, регистрация не останавливается' },
      { title: 'Настройка оплаты госпошлины под каждую сделку — платит или застройщик, или клиент' },
    ]}
    review={{
      quote: 'За счет комплексного предложения (ипотека + регистрация) ДВИЖ выходит на 30% дешевле других рыночных платформ',
      author: 'Марина Белоусова',
      role: 'Руководитель отдела регистрации GloraX',
      company: { logo: '/api/media/file/glorax_color.svg', alt: 'GloraX' },
      caseLink: { label: 'Читать кейс', href: '/cases/glorax' },
    }}
  >
    <div slot="image" class="h-full w-full bg-gray-200"></div>
  </FeatureBlock>

  {/* ── 6. FormClosing ── */}
  <FormClosing
    preset="lead"
    title="Защитите сделки от ошибок и форс-мажоров"
    description="Оставьте заявку, чтобы заводить сделки на регистрацию за 5 минут — без ошибок и приостановок"
    submitLabel="Попробовать бесплатно"
    class="!py-0"
  />

  </div>{/* /gap-контейнер */}

</SiteLayout>
