---
/**
 * Страница термина словаря /slovar-developera/[slug]
 *
 * Лейаут по шаблону страницы статьи блога (/blog/[slug]):
 *   - две колонки (мета/оглавление 340px + тело)
 *   - sticky-оглавление (SideMenu variant=panel) из заголовков bodyHtml
 *   - кнопка «Поделиться»
 *
 * У глоссария нет автора/даты/категории/тегов/обложки/связанных — эти блоки опущены.
 * Тело — bodyHtml (импорт из Webflow).
 */
import BlogLayout from '../../layouts/BlogLayout.astro'
import SideMenu from '../../components/ui/SideMenu.astro'
import Button from '../../components/ui/Button.astro'
import { getGlossaries, getGlossaryItem, normalizeBodyHtml, sanitizeBodyHtml } from '../../lib/payload'
import { buildTocFromHtml } from '../../lib/lexical'

export async function getStaticPaths() {
  const allDocs: any[] = []
  let page = 1
  while (true) {
    const result = await getGlossaries({ limit: 100, page })
    allDocs.push(...result.docs)
    if (!result.hasNextPage) break
    page++
  }
  return allDocs.map((item: any) => ({
    params: { slug: item.slug },
  }))
}

const { slug } = Astro.params
const item = await getGlossaryItem(slug!)

if (!item) return Astro.redirect('/slovar-developera')

// bodyHtml (Webflow): ссылки → относительные + нормализация медиа + санитизация
const rawBodyHtml = sanitizeBodyHtml(normalizeBodyHtml(
  item.bodyHtml
    ?.replaceAll('href="https://dvizh.webflow.io/', 'href="/')
    .replaceAll('href="https://www.dvizh.io/', 'href="/')
)) ?? ''

// Оглавление из заголовков bodyHtml (тем же хелпером, что и статья)
let bodyHtml = ''
let tocFlat: Array<{ id: string; text: string; level: 2 | 3 }> = []
if (rawBodyHtml) {
  const { html, toc } = buildTocFromHtml(rawBodyHtml)
  bodyHtml = html
  tocFlat = toc
}
const tocIds = tocFlat.map((i) => i.id)

const sentenceCase = (s: string) => {
  const t = s.trim()
  return t ? t.charAt(0).toUpperCase() + t.slice(1) : t
}
const tocItems = tocFlat.map((i) => ({
  title: i.level === 3 ? sentenceCase(i.text) : i.text,
  level: i.level,
}))
---

<BlogLayout
  title={item.meta?.title ?? item.name}
  description={item.meta?.description ?? item.description}
  insightsHeader
>
  <article class="page-container pt-10 md:pt-16 pb-10 md:pb-16">

    {/* ── Контейнер 1: мета + заголовок ── */}
    <div class="grid grid-cols-1 gap-y-8 xl:grid-cols-[340px_1fr] xl:gap-x-10 xl:gap-y-0">
      <aside class="text-subhead text-gray-500">
        <nav class="text-subhead">
          <a href="/slovar-developera" class="hover:text-gray-900">Словарь девелопера</a>
        </nav>
      </aside>

      <div class="flex flex-col gap-4">
        <h1 class="text-h2 text-gray-900">{item.name}</h1>
        {item.description && (
          <p class="text-body-lg text-gray-500">{item.description}</p>
        )}
      </div>
    </div>

    {/* ── Контейнер 2: TOC + тело ── */}
    <div class="grid grid-cols-1 gap-y-8 mt-16 xl:grid-cols-[340px_1fr] xl:gap-x-10 xl:gap-y-0">
      <aside
        class="self-start xl:sticky xl:top-24"
        x-data={`glossaryToc(${JSON.stringify(tocIds)})`}
        @side-menu-change="onClick($event.detail.index)"
      >
        {tocFlat.length > 0 && (
          <SideMenu navId="glossary-toc" variant="panel" items={tocItems} />
        )}
      </aside>
      <div>
        {bodyHtml && <div class="prose prose-lg max-w-none" set:html={bodyHtml} />}
      </div>
    </div>

    {/* ── Низ: «Поделиться» (выровнен под колонкой тела) ── */}
    <div class="grid grid-cols-1 mt-12 xl:grid-cols-[340px_1fr] xl:gap-x-10">
      <div class="xl:col-start-2">
        <hr class="border-gray-200" />
        <div class="flex justify-end mt-10">
          <div x-data="{ copied: false, timer: null }" class="shrink-0">
            <Button
              variant="primary"
              size="md"
              type="button"
              @click="navigator.clipboard.writeText(window.location.href); copied = true; clearTimeout(timer); timer = setTimeout(() => copied = false, 2000)"
            >
              <span x-show="!copied">Поделиться</span>
              <span x-show="copied" x-cloak>Скопировано</span>
            </Button>
          </div>
        </div>
      </div>
    </div>

  </article>
</BlogLayout>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    window.Alpine.data('glossaryToc', (ids) => ({
      ids: ids || [],
      navId: 'glossary-toc',

      setActive(index) {
        window.dispatchEvent(new CustomEvent('side-menu-set-active', {
          detail: { navId: this.navId, index }
        }))
      },

      onClick(index) {
        const id = this.ids[index]
        if (!id) return
        const el = document.getElementById(id)
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' })
      },

      init() {
        if (this.ids.length === 0) return

        const headings = this.ids
          .map((id) => document.getElementById(id))
          .filter(Boolean)
        if (headings.length === 0) return

        const indexById = new Map(this.ids.map((id, i) => [id, i]))

        this.setActive(0)

        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
            if (visible.length > 0) {
              const idx = indexById.get(visible[0].target.id)
              if (idx !== undefined) this.setActive(idx)
            }
          },
          {
            rootMargin: '-15% 0px -70% 0px',
            threshold: 0,
          }
        )

        headings.forEach((h) => observer.observe(h))
      },
    }))
  })
</script>

<style is:global>
  html { scroll-behavior: smooth; }
  /* Отступ при скролле к якорю, чтобы заголовок не прятался под шапкой */
  article h2[id], article h3[id] { scroll-margin-top: 96px; }
</style>
