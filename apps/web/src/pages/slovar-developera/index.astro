---
import BlogLayout from '../../layouts/BlogLayout.astro'
import Tab from '../../components/ui/Tab.astro'
import { getGlossaries } from '../../lib/payload'

const allDocs: any[] = []
let page = 1
while (true) {
  const result = await getGlossaries({ limit: 100, page })
  allDocs.push(...result.docs)
  if (!result.hasNextPage) break
  page++
}

// Group by first letter
const grouped: Record<string, any[]> = {}
for (const item of allDocs) {
  const letter = (item.name || '?')[0].toUpperCase()
  ;(grouped[letter] ??= []).push(item)
}
// Сортировка: сначала кириллица (А, Б, В...), потом латиница (A, B, C...).
// Object.keys().sort() по умолчанию сортирует по Unicode codepoint, из-за чего
// латинские и кириллические буквы перемешиваются. Используем localeCompare('ru')
// внутри каждой группы.
const isCyrillic = (s: string) => /[а-яе]/i.test(s)
const letters = Object.keys(grouped).sort((a, b) => {
  const aCyr = isCyrillic(a)
  const bCyr = isCyrillic(b)
  if (aCyr && !bCyr) return -1
  if (!aCyr && bCyr) return 1
  return a.localeCompare(b, 'ru')
})
---

<BlogLayout title="Словарь девелопера — ДВИЖ" description="Термины и понятия рынка недвижимости и ипотеки" insightsHeader bodyClass="fluid-page">
  <div class="page-container py-10 md:py-16">
    <h1 class="text-4xl font-bold mb-2">Словарь девелопера</h1>
    <p class="text-xl text-gray-600 mb-10">Термины и понятия рынка недвижимости и ипотеки.</p>

    <!-- Алфавитный указатель -->
    <div class="flex flex-wrap gap-2 mb-10">
      {letters.map(letter => (
        <Tab label={letter} href={`#letter-${letter}`} class="hover:!text-brand hover:!border-brand-200" />
      ))}
    </div>

    <!-- Список по буквам -->
    {letters.map(letter => (
      <section id={`letter-${letter}`} class="mb-10">
        <h2 class="text-2xl font-bold mb-4 border-b pb-2">{letter}</h2>
        <ul class="space-y-2">
          {grouped[letter].map((item: any) => (
            <li>
              <a href={`/slovar-developera/${item.slug}`} class="text-brand hover:text-brand-700 transition-colors font-medium">
                {item.name}
              </a>
              {item.description && (
                <span class="text-gray-600 text-sm ml-2">— {item.description}</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BlogLayout>
