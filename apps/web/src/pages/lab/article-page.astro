---
/**
 * Lab: Article Page — эксперимент с новым layout страницы статьи
 *
 * Источник контента: пост `case-ayaks-dvizh` из CMS, тело — из блоков `content`
 * (как на реальной странице /blog/[slug]). Доступна только в dev-режиме.
 *
 * Цель макета: довести дизайн здесь, затем перенести на /blog/[slug].astro.
 */
import BlogLayout from '../../layouts/BlogLayout.astro'
import PersonCard from '../../components/ui/PersonCard.astro'
import SideMenu from '../../components/ui/SideMenu.astro'
import BlockRenderer from '../../components/blocks/BlockRenderer.astro'
import Button from '../../components/ui/Button.astro'
import BlogCardNew from '../../components/ui/BlogCardNew.astro'
import { getBlogPost, getBlogPosts, normalizeMediaUrl } from '../../lib/payload'
import { serializeLexical, createIdGenerator, buildTocFromContent, lexicalNodeText } from '../../lib/lexical'

const post = await getBlogPost('case-ayaks-dvizh')
if (!post) return Astro.redirect('/404')

const coverUrl = normalizeMediaUrl(post.cover?.url)
const primaryAuthor = post.primaryAuthor ?? null

// Низ статьи: хештеги (tags) + участники (primaryAuthor + coAuthors)
const tags = Array.isArray(post.tags) ? post.tags : []
const coAuthors = Array.isArray(post.coAuthors) ? post.coAuthors : []
const contributors = [primaryAuthor, ...coAuthors].filter(Boolean)

// «Читайте еще» — статьи от новых к старым, кроме текущей (структура как «Правила девелопера»)
const MONTHS = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря']
function ruDate(iso?: string): string | undefined {
  if (!iso) return undefined
  const d = new Date(iso)
  if (isNaN(d.getTime())) return undefined
  return `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`
}
function lexicalText(node: any): string {
  if (!node) return ''
  if (typeof node.text === 'string') return node.text
  const kids = node.children ?? node.root?.children
  return Array.isArray(kids) ? kids.map(lexicalText).join(' ') : ''
}
function readTimeOf(p: any): string {
  let text = ''
  if (p.bodyHtml) text = String(p.bodyHtml).replace(/<[^>]+>/g, ' ')
  else if (Array.isArray(p.content)) text = p.content.map((b: any) => lexicalText(b.richText)).join(' ')
  text = text.replace(/\s+/g, ' ').trim()
  const words = text ? text.split(' ').length : 0
  return `${Math.max(1, Math.round(words / 200))} мин`
}
function card(p: any) {
  return { title: p.title, slug: p.slug, cover: p.cover, excerpt: p.excerpt, date: ruDate(p.publishedAt), readTime: readTimeOf(p) }
}

const { docs: rawRelated } = await getBlogPosts({ limit: 50, depth: 2 })
const relatedPosts = [...rawRelated]
  .sort((a: any, b: any) => (b.publishedAt ? Date.parse(b.publishedAt) : -Infinity) - (a.publishedAt ? Date.parse(a.publishedAt) : -Infinity))
  .filter((p: any) => p.slug !== post.slug)
  .slice(0, 4)

// Тело статьи — из CMS-блоков content (как на реальной странице /blog/[slug])
const content: any[] = post.content ?? []

// Время чтения — из текста richText-блоков
const textContent = content
  .filter((b) => b.blockType === 'richText')
  .map((b) => lexicalNodeText(b.content?.root))
  .join(' ')
const wordCount = textContent.split(/\s+/).filter(Boolean).length
const readingTime = Math.max(1, Math.ceil(wordCount / 200))

// Оглавление (h2/h3) из заголовков content
const tocFlat = buildTocFromContent(content)
const tocIds = tocFlat.map((i) => i.id)

// Пре-рендер блоков: richText → HTML с id на заголовках (тот же порядок генератора,
// что в buildTocFromContent → якоря TOC совпадают); прочие блоки → через BlockRenderer.
const renderGen = createIdGenerator()
const renderedBlocks = content.map((block: any) =>
  block.blockType === 'richText'
    ? { kind: 'html' as const, html: serializeLexical(block.content, { makeHeadingId: renderGen }) }
    : { kind: 'block' as const, block }
)
---

<BlogLayout
  title={`${post.title} · Lab`}
  description={post.excerpt ?? ''}
  insightsHeader
>
  <article class="page-container pt-10 md:pt-16">

    {/* ── Контейнер 1: мета + заголовок ── */}
    <div class="grid grid-cols-1 gap-y-8 xl:grid-cols-[340px_1fr] xl:gap-x-10 xl:gap-y-0">
      {/* Левая колонка — мета (на xl+; на lg и меньше — стек: крошки → автор/дата) */}
      <aside class="flex flex-col gap-8 xl:gap-0 xl:h-full xl:justify-between text-subhead text-gray-500">
        <nav class="text-subhead">
          <a href="/blog" class="hover:text-gray-900">Блог</a>
          {post.category?.title && (
            <>
              <span class="mx-1">›</span>
              <a href={`/category/${post.category.slug}`} class="hover:text-gray-900">{post.category.title}</a>
            </>
          )}
        </nav>

        <div class="flex flex-col gap-3 xs:flex-row xs:items-center xs:justify-between xl:flex-col xl:items-start">
          {primaryAuthor && <PersonCard person={primaryAuthor} variant="inline" />}

          {(() => {
            const date = ruDate(post.publishedAt)
            const readTime = `${readingTime} мин`
            const hasDateMeta = date || readTime
            return hasDateMeta && (
              <div class="flex items-end gap-1 text-subhead text-gray-500">
                {date && <span>{date}</span>}
                {date && readTime && <span>·</span>}
                {readTime && <span>{readTime}</span>}
              </div>
            )
          })()}
        </div>
      </aside>

      {/* Правая колонка — заголовок */}
      <div class="flex flex-col gap-4">
        <h2 class="text-h2 text-gray-900">{post.title}</h2>
        {post.excerpt && (
          <p class="text-body-lg text-gray-500">{post.excerpt}</p>
        )}
      </div>
    </div>

    {/* ── Контейнер 2: TOC + обложка/тело ── */}
    <div class="grid grid-cols-1 gap-y-8 mt-16 xl:grid-cols-[340px_1fr] xl:gap-x-10 xl:gap-y-0">
      <aside
        class="self-start xl:sticky xl:top-24"
        x-data={`articleToc(${JSON.stringify(tocIds)})`}
        @side-menu-change="onClick($event.detail.index)"
      >
        {tocFlat.length > 0 && (
          <SideMenu navId="article-toc" variant="panel" items={tocFlat.map((i) => ({ title: i.text, level: i.level }))} />
        )}
      </aside>
      <div>
        {coverUrl && (
          <img
            src={coverUrl}
            alt={post.cover?.alt ?? post.title}
            class="w-full rounded-xl aspect-video object-cover mb-10"
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
          />
        )}
        {renderedBlocks.map((b) => (
          b.kind === 'html'
            ? <div class="prose prose-lg max-w-none" set:html={b.html} />
            : <BlockRenderer blocks={[b.block]} />
        ))}
      </div>
    </div>

    {/* ── Низ статьи: вне колонки тела (выровнен через col-start-2),
         чтобы sticky-оглавление отлипало в конце тела статьи ── */}
    <div class="grid grid-cols-1 mt-12 xl:grid-cols-[340px_1fr] xl:gap-x-10">
      <div class="xl:col-start-2">
        <hr class="border-gray-200" />

        {/* Категория | хештеги ........ Поделиться */}
        <div class="flex flex-wrap items-center justify-between gap-4 mt-10">
          <div class="flex items-center text-subhead text-gray-500">
            {post.category?.title && (
              <a href={`/category/${post.category.slug}`} class="hover:text-gray-900 transition-colors">{post.category.title}</a>
            )}
            {post.category?.title && tags.length > 0 && (
              <span class="mx-3 h-4 w-0.5 bg-gray-300" aria-hidden="true"></span>
            )}
            {tags.length > 0 && (
              <div class="flex flex-wrap gap-3">
                {tags.map((t: any) => (
                  <a href={t.slug ? `/tag/${t.slug}` : '#'} class="text-brand hover:text-brand-600 transition-colors">#{t.title ?? t.name ?? t.slug}</a>
                ))}
              </div>
            )}
          </div>

          <div x-data="{ copied: false, timer: null }" class="shrink-0">
            <Button
              variant="primary"
              size="md"
              type="button"
              @click="navigator.clipboard.writeText(window.location.href); copied = true; clearTimeout(timer); timer = setTimeout(() => copied = false, 2000)"
            >
              <span x-show="!copied">Поделиться</span>
              <span x-show="copied" x-cloak>Скопировано</span>
            </Button>
          </div>
        </div>

        {/* Над статьей работали */}
        {contributors.length > 0 && (
          <>
            <h5 class="text-h5 text-gray-900 mt-10">Над статьей работали:</h5>
            <div class="flex flex-wrap justify-between gap-6 mt-4">
              {contributors.map((p: any) => <PersonCard person={p} variant="full" />)}
            </div>
          </>
        )}
      </div>
    </div>

  </article>

  {/* ── Читайте еще — блок-сетка (структура как «Правила девелопера») ── */}
  {relatedPosts.length > 0 && (
    <section class="page-container mt-[120px] pb-10 md:pb-16">
      <div class="flex flex-col gap-10 lg:gap-16">
        <h2 class="text-h2 text-gray-900">Читайте еще</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
          {relatedPosts.map((p: any, i: number) => (
            <BlogCardNew size="md" {...card(p)} class={i === 3 ? 'hidden sm:block lg:hidden' : ''} />
          ))}
        </div>
      </div>
    </section>
  )}
</BlogLayout>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    window.Alpine.data('articleToc', (ids) => ({
      ids: ids || [],
      navId: 'article-toc',

      setActive(index) {
        window.dispatchEvent(new CustomEvent('side-menu-set-active', {
          detail: { navId: this.navId, index }
        }))
      },

      onClick(index) {
        const id = this.ids[index]
        if (!id) return
        const el = document.getElementById(id)
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' })
      },

      init() {
        if (this.ids.length === 0) return

        const headings = this.ids
          .map((id) => document.getElementById(id))
          .filter(Boolean)
        if (headings.length === 0) return

        const indexById = new Map(this.ids.map((id, i) => [id, i]))

        // По умолчанию подсветить первый
        this.setActive(0)

        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
            if (visible.length > 0) {
              const idx = indexById.get(visible[0].target.id)
              if (idx !== undefined) this.setActive(idx)
            }
          },
          {
            rootMargin: '-15% 0px -70% 0px',
            threshold: 0,
          }
        )

        headings.forEach((h) => observer.observe(h))
      },
    }))
  })
</script>

<style is:global>
  /* Локально для lab-страницы, чтобы не трогать глобальный CSS */
  html { scroll-behavior: smooth; }
  /* Отступ при скролле к якорю, чтобы заголовок не прятался под шапкой */
  article h2[id], article h3[id] { scroll-margin-top: 96px; }
</style>
