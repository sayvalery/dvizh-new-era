---
/**
 * Lab: Article Page — эксперимент с новым layout страницы статьи
 *
 * Источник контента: пост `case-ayaks-dvizh` из CMS.
 * Доступна только в dev-режиме: preview.dvizh.cc/lab/article-page
 *
 * Текущая итерация: только viewport ≥ 1280px (xl, 2xl).
 * Адаптация sm/md/lg — отдельной итерацией.
 */
import SiteLayout from '../../layouts/SiteLayout.astro'
import PersonCard from '../../components/ui/PersonCard.astro'
import SideMenu from '../../components/ui/SideMenu.astro'
import Review from '../../components/ui/Review.astro'
import { getBlogPost, normalizeMediaUrl, normalizeBodyHtml, sanitizeBodyHtml } from '../../lib/payload'

const post = await getBlogPost('case-ayaks-dvizh')
if (!post) return Astro.redirect('/404')

const coverUrl = normalizeMediaUrl(post.cover?.url)
const primaryAuthor = post.primaryAuthor ?? null

// Время чтения
const textContent = (post.bodyHtml as string | null | undefined)?.replace(/<[^>]+>/g, '') ?? ''
const wordCount = textContent.split(/\s+/).filter(Boolean).length
const readingTime = Math.max(1, Math.ceil(wordCount / 200))

// ─── Slugify ──────────────────────────────────────────────────────
// Транслитерация кириллицы + lowercase + замена не-alnum на дефис.
const translitMap: Record<string, string> = {
  а:'a',б:'b',в:'v',г:'g',д:'d',е:'e',ё:'e',ж:'zh',з:'z',и:'i',й:'y',
  к:'k',л:'l',м:'m',н:'n',о:'o',п:'p',р:'r',с:'s',т:'t',у:'u',ф:'f',
  х:'h',ц:'c',ч:'ch',ш:'sh',щ:'sch',ъ:'',ы:'y',ь:'',э:'e',ю:'yu',я:'ya',
}
function slugify(text: string): string {
  return text
    .toLowerCase()
    .split('')
    .map((c) => translitMap[c] ?? c)
    .join('')
    .replace(/<[^>]+>/g, '')
    .replace(/&[a-z]+;/gi, '')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    || 'section'
}

// ─── Извлечение TOC из bodyHtml ───────────────────────────────────
type TocChild = { id: string; text: string }
type TocItem = { id: string; text: string; children: TocChild[] }

function extractToc(html: string | null | undefined): { toc: TocItem[]; htmlWithIds: string } {
  if (!html) return { toc: [], htmlWithIds: '' }

  type Raw = { level: 2 | 3; text: string; id: string; match: string }
  const raw: Raw[] = []
  const usedIds = new Set<string>()
  const ensureUnique = (base: string) => {
    let id = base
    let n = 2
    while (usedIds.has(id)) id = `${base}-${n++}`
    usedIds.add(id)
    return id
  }

  const re = /<(h2|h3)\b([^>]*)>([\s\S]*?)<\/\1>/gi
  let m: RegExpExecArray | null
  while ((m = re.exec(html)) !== null) {
    const level = m[1].toLowerCase() === 'h2' ? 2 : 3
    const text = m[3].replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim()
    if (!text) continue
    const id = ensureUnique(slugify(text))
    raw.push({ level, text, id, match: m[0] })
  }

  const toc: TocItem[] = []
  for (const r of raw) {
    if (r.level === 2) {
      toc.push({ id: r.id, text: r.text, children: [] })
    } else if (toc.length > 0) {
      toc[toc.length - 1].children.push({ id: r.id, text: r.text })
    }
  }

  let htmlWithIds = html
  for (const r of raw) {
    const tag = r.level === 2 ? 'h2' : 'h3'
    const inner = r.match.replace(/^<h[23]\b[^>]*>/i, '').replace(/<\/h[23]>$/i, '')
    const replacement = `<${tag} id="${r.id}">${inner}</${tag}>`
    htmlWithIds = htmlWithIds.replace(r.match, replacement)
  }

  return { toc, htmlWithIds }
}

// Сырой bodyHtml после нормализации ссылок и media-URL
const rawBody = normalizeBodyHtml(
  (post.bodyHtml as string | null | undefined)
    ?.replaceAll('href="https://dvizh.webflow.io/', 'href="/')
    .replaceAll('href="https://www.dvizh.io/', 'href="/')
)

const { toc, htmlWithIds } = extractToc(rawBody)
const bodyHtml = sanitizeBodyHtml(htmlWithIds)

// Плоский список пунктов для SideMenu (H2 и H3 в одну колонку)
const tocFlat: Array<{ id: string; text: string }> = []
for (const item of toc) {
  tocFlat.push({ id: item.id, text: item.text })
  for (const child of item.children) {
    tocFlat.push({ id: child.id, text: child.text })
  }
}
const tocIds = tocFlat.map((i) => i.id)

// ─── Разбиение тела статьи на сегменты (текст + цитаты) ───────────
type BodySegment = { type: 'html'; content: string } | { type: 'quote'; quote: string }

function splitByBlockquote(html: string | null): BodySegment[] {
  if (!html) return []
  const segments: BodySegment[] = []
  const re = /<blockquote[^>]*>([\s\S]*?)<\/blockquote>/gi
  let lastIndex = 0
  let m: RegExpExecArray | null
  while ((m = re.exec(html)) !== null) {
    if (m.index > lastIndex) {
      segments.push({ type: 'html', content: html.slice(lastIndex, m.index) })
    }
    const plain = m[1]
      .replace(/<br\s*\/?>/gi, ' ')
      .replace(/<[^>]+>/g, '')
      .replace(/&nbsp;/g, ' ')
      .replace(/&amp;/g, '&')
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&quot;/g, '"')
      .replace(/&#39;/g, "'")
      .replace(/\s+/g, ' ')
      .trim()
    segments.push({ type: 'quote', quote: plain })
    lastIndex = m.index + m[0].length
  }
  if (lastIndex < html.length) {
    segments.push({ type: 'html', content: html.slice(lastIndex) })
  }
  return segments
}

const bodySegments = splitByBlockquote(bodyHtml)
---

<SiteLayout
  title={`${post.title} · Lab`}
  description={post.excerpt ?? ''}
>
  <article class="page-container pt-12 sm:pt-16 lg:pt-24">

    {/* ── Контейнер 1: мета + заголовок ── */}
    <div class="grid" style="grid-template-columns: 340px 1fr; column-gap: 40px;">
      {/* Левая колонка — мета */}
      <aside class="flex flex-col justify-between h-full text-subhead text-gray-500">
        <nav class="text-subhead">
          <a href="/blog" class="hover:text-gray-900">Блог</a>
          {post.category?.title && (
            <>
              <span class="mx-1">›</span>
              <a href={`/category/${post.category.slug}`} class="hover:text-gray-900">{post.category.title}</a>
            </>
          )}
        </nav>

        <div class="flex flex-col gap-3">
          {primaryAuthor && <PersonCard person={primaryAuthor} variant="inline" />}

          {(() => {
            const date = post.publishedAt
              ? new Date(post.publishedAt).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' })
              : null
            const readTime = `${readingTime} мин`
            const hasDateMeta = date || readTime
            return hasDateMeta && (
              <div class="flex items-end gap-1 text-subhead text-gray-500">
                {date && <span>{date}</span>}
                {date && readTime && <span>·</span>}
                {readTime && <span>{readTime}</span>}
              </div>
            )
          })()}
        </div>
      </aside>

      {/* Правая колонка — заголовок */}
      <div class="flex flex-col gap-4">
        <h2 class="text-h2 text-gray-900">{post.title}</h2>
        {post.excerpt && (
          <p class="text-body-lg text-gray-500">{post.excerpt}</p>
        )}
      </div>
    </div>

    {/* ── Контейнер 2: TOC + обложка/тело ── */}
    <div class="grid mt-16" style="grid-template-columns: 340px 1fr; column-gap: 40px;">
      <aside
        class="sticky top-24 self-start"
        x-data={`articleToc(${JSON.stringify(tocIds)})`}
        @side-menu-change="onClick($event.detail.index)"
      >
        {tocFlat.length > 0 && (
          <SideMenu navId="article-toc" items={tocFlat.map((i) => ({ title: i.text }))} />
        )}
      </aside>
      <div>
        {coverUrl && (
          <img
            src={coverUrl}
            alt={post.cover?.alt ?? post.title}
            class="w-full rounded-xl aspect-video object-cover mb-10"
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
          />
        )}
        {bodySegments.length > 0 ? (
          <div class="flex flex-col gap-8">
            {bodySegments.map((seg) => (
              seg.type === 'quote'
                ? <Review quote={seg.quote} class="bg-gray-200 rounded-3xl p-8 lg:p-10" />
                : <div class="prose prose-lg max-w-none" set:html={seg.content} />
            ))}
          </div>
        ) : (
          bodyHtml && <div class="prose prose-lg max-w-none" set:html={bodyHtml} />
        )}
      </div>
    </div>

  </article>
</SiteLayout>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    window.Alpine.data('articleToc', (ids) => ({
      ids: ids || [],
      navId: 'article-toc',

      setActive(index) {
        window.dispatchEvent(new CustomEvent('side-menu-set-active', {
          detail: { navId: this.navId, index }
        }))
      },

      onClick(index) {
        const id = this.ids[index]
        if (!id) return
        const el = document.getElementById(id)
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' })
      },

      init() {
        if (this.ids.length === 0) return

        const headings = this.ids
          .map((id) => document.getElementById(id))
          .filter(Boolean)
        if (headings.length === 0) return

        const indexById = new Map(this.ids.map((id, i) => [id, i]))

        // По умолчанию подсветить первый
        this.setActive(0)

        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
            if (visible.length > 0) {
              const idx = indexById.get(visible[0].target.id)
              if (idx !== undefined) this.setActive(idx)
            }
          },
          {
            rootMargin: '-15% 0px -70% 0px',
            threshold: 0,
          }
        )

        headings.forEach((h) => observer.observe(h))
      },
    }))
  })
</script>

<style is:global>
  /* Локально для lab-страницы, чтобы не трогать глобальный CSS */
  html { scroll-behavior: smooth; }
  /* Отступ при скролле к якорю, чтобы заголовок не прятался под шапкой */
  article h2[id], article h3[id] { scroll-margin-top: 96px; }
</style>
