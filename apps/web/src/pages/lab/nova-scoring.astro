---
/**
 * Лабораторная страница: Новый Скоринг
 *
 * Сборка блоков для новой версии страницы финансового скоринга.
 * Контент — заглушки, финальный текст будет добавлен отдельно.
 *
 * Маршрут: /lab/nova-scoring (только в dev)
 */

import SiteLayout from '../../layouts/SiteLayout.astro'
import HeroSectionFull from '../../components/lab-new/HeroSectionFull.astro'
import LogoGrid from '../../components/ui/LogoGrid.astro'
import KeyFacts from '../../components/ui/KeyFacts.astro'
import FeatureBlock from '../../components/ui/FeatureBlock.astro'
import BentoGrid from '../../components/ui/BentoGrid.astro'
import TextImageBlock from '../../components/ui/TextImageBlock.astro'
import FormClosing from '../../components/ui/FormClosing.astro'
---

<SiteLayout
  title="Финансовый скоринг — ДВИЖ (лаборатория)"
  description="Финансовый скоринг ДВИЖ — в разработке"
>

  {/* ── 1. Hero ── */}
  <HeroSectionFull
    title="Проверьте ипотечного заёмщика до обращения в банки"
    description="Сократите риск отказа до минимума благодаря предварительной оценке клиента по данным из 15 источников"
    demoLabel="Записаться на демо"
    kpLabel="Попробовать бесплатно"
  />

  {/* ── 2. LogoGrid ── */}
  <LogoGrid
    logos={[
      { src: '/partners/dark/lsr.svg', alt: 'ЛСР' },
      { src: '/partners/dark/a101.svg', alt: 'A101' },
      { src: '/partners/dark/strana.svg', alt: 'Страна Девелопмент' },
      { src: '/partners/dark/glorax.svg', alt: 'Glorax' },
      { src: '/partners/dark/ganel.svg', alt: 'Ganel' },
      { src: '/partners/dark/ava.svg', alt: 'AVA' },
    ]}
  />

  {/* ── 3. KeyFacts — 3 пункта ── */}
  <KeyFacts
    title="Зачем вам финансовый скоринг"
    variant="large"
    items={[
      {
        value: 'до 35% заявок',
        description: 'уходят в автоматический отказ на стороне банков из-за плохого кредитного рейтинга',
      },
      {
        value: '80% клиентов',
        description: 'не отправляют запросы в БКИ и не знают, могут ли получить одобрение ипотеки',
      },
      {
        value: 'на 20% выше',
        description: 'вероятность одобрения после предварительной проверки и правок в ипотечной анкете',
      },
    ]}
  />

  {/* ── 4. FeatureBlock — картинка слева, 4 пункта справа ── */}
  <FeatureBlock
    heading="Что проверяем"
    description="Скоринг охватывает полный финансовый профиль заёмщика — от долговой нагрузки до банкротных дел"
    imageSide="left"
    button={{ label: 'Узнать больше', drawerPreset: 'demo' }}
    features={[
      {
        title: 'Долговую нагрузку клиента',
        subtitle: 'Соотношение активных кредитов и доходов',
      },
      {
        title: 'Долги по налогам и сборам',
        subtitle: 'Задолженности перед ФНС и другими государственными органами',
      },
      {
        title: 'Долги по кредитам и кредитным картам',
        subtitle: 'Данные из бюро кредитных историй',
      },
      {
        title: 'Информацию о банкротстве и приостановлении счетов',
        subtitle: 'Открытые дела о банкротстве и блокировки счетов',
      },
    ]}
  />

  {/* ── 5. BentoGrid variant="four" ── */}
  <section class="py-24 lg:py-[120px]">
    <div class="page-container">
      <BentoGrid
        variant="four"
        heading="Как это работает"
        items={[
          {
            title: 'Распознавание',
            description: 'Определяем тип документа и вытаскиваем нужные поля автоматически',
          },
          {
            title: 'Дополняем профиль клиента',
            description: 'Подтягиваем данные из сторонних источников — ФНС, ГИБДД, БКИ',
          },
          {
            title: 'Антифрод',
            description: 'Ищем признаки мошенничества и сверяем данные с внешними базами',
          },
          {
            title: 'Верификация',
            description: 'Проверяем документ на подлинность ещё до ручной обработки',
          },
        ]}
      />
    </div>
  </section>

  {/* ── 6. TextImageBlock ── */}
  <TextImageBlock
    heading="Заберите готовое решение и одобряйте больше клиентов"
    subheading="Наш скоринг заменяет самописные модели — и поднимает одобрение без роста риска."
    buttonText="Забрать решение"
    drawerPreset="demo"
  />

  {/* ── 7. FormClosing ── */}
  <FormClosing
    preset="lead"
    title="Реализация по API — для тех, кто хочет ещё больше"
    description="Адаптируйте калькулятор под фирменный стиль, встройте расчёты в карточку лота и избавьтесь от юридических рисков"
    submitLabel="Попробовать бесплатно"
    class="py-12"
  />

  {/* ── 8. Footer — автоматически через SiteLayout ── */}

</SiteLayout>
