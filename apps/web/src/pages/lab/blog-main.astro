      bg="bg-background-secondary"
      title="Оставайтесь на&#160;связи"
      subtitle="Подпишитесь на&#160;наши каналы в&#160;Telegram и&#160;Max, чтобы не&#160;упустить свежие новости и&#160;статьи"
      buttons={[
        { label: 'Telegram', href: 'https://t.me/dvizh4realty' },
        { label: 'MAX', href: '#' },
      ]}
    />

    {/* ── Блок 7: «Конференции, подкасты и вебинары» — header-row при <xl, 2 колонки 1/3+2/3 при xl+ ── */}
    <div class="page-container flex flex-col gap-10 xl:flex-row xl:gap-6 xl:items-start">

        <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between xl:flex-col xl:gap-6 xl:basis-1/3 xl:shrink-0">
          <h2 class="text-h2 text-gray-900">Конференции, подкасты и&#160;вебинары<span class="text-h4 text-gray-900 opacity-30 align-top leading-none ml-2">12</span></h2>
          <div class="shrink-0">
            <Button variant="primary" size="sm" href="/events">Смотреть все</Button>
          </div>
        </div>

        <div class="xl:flex-1 xl:min-w-0">
          {/* s-стак: только xl+ */}
          <div class="hidden xl:flex flex-col gap-6">
            <BlogCardNew
              size="s"
              title="Вадим Герасимов о&#160;ситуации с&#160;продажами, идеальном процессе сделки и&#160;подходе Унистроя"
              slug="gerasimov-situaciya-prodazhi-unistroy"
              date="24&#160;марта"
              readTime="13&#160;мин"
            />
            <BlogCardNew
              size="s"
              title="Вадим Герасимов об&#160;идеальном продавце и&#160;системе обучения в&#160;Унистрое"
              slug="gerasimov-idealnyy-prodavec-unistroy"
              date="23&#160;марта"
              readTime="10&#160;мин"
            />
            <BlogCardNew
              size="s"
              title="Вадим Герасимов о&#160;своем пути к&#160;должности директора по&#160;продажам"
