---
/**
 * Lab: Blog Main — экспериментальная страница для нового layout блога
 *
 * Доступна только в dev-режиме: preview.dvizh.cc/lab/blog-main
 */
import SiteLayout from '../../layouts/SiteLayout.astro'
import BlogCardNew from '../../components/ui/BlogCardNew.astro'
import SuccessStoryBlock from '../../components/ui/SuccessStoryBlock.astro'
import Button from '../../components/ui/Button.astro'
import Tab from '../../components/ui/Tab.astro'
---

<SiteLayout title="Blog Main · Lab" description="Эксперимент с новым layout блога">
  <div class="py-24 lg:py-40 flex flex-col gap-24 lg:gap-40">

    {/* ── Блок 1: заголовок + lg-карточка + ряд xs ── */}
    <div class="page-container flex flex-col gap-16">
      <h2 class="text-h2 text-gray-900">Журнал для&#160;современных девелоперов</h2>

      <BlogCardNew
        size="lg"
        title="Как в&#160;2&#160;раза увеличить поток аудитории к&#160;концу 2026&#160;года"
        slug="kak-uvelichit-potok-auditorii"
        date="27&#160;февраля"
        readTime="9&#160;минут"
        excerpt="Сценарии развития событий от&#160;Романа Гурова"
      />

      <div class="grid grid-cols-3 gap-6">
        <BlogCardNew
          size="xs"
          title="«Клиент&#160;— самый важный человек в&#160;компании»: ценности Анжелики Альшаевой"
          slug="cennosti-anzheliki-alshaevoy"
          date="13&#160;мая"
          readTime="15&#160;минут"
        />
        <BlogCardNew
          size="xs"
          title="ДВИЖ и&#160;Банк «РОССИЯ» запустили ускоренный обмен данными по&#160;API"
          slug="dvizh-rossiya-api"
          date="21&#160;апреля"
          readTime="2&#160;минуты"
        />
        <BlogCardNew
          size="xs"
          title="Итоги апреля"
          slug="itogi-aprelya"
          date="12&#160;мая"
          readTime="2&#160;минуты"
        />
      </div>
    </div>

    {/* ── Блок 2: «Правила девелопера» ── */}
    <div class="page-container flex flex-col gap-16">

      {/* Заголовок + подзаголовок + счётчик + кнопка */}
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex flex-col gap-1 max-w-[800px] w-full">
          <h2 class="text-h2 text-gray-900">Правила девелопера<span class="text-h4 text-gray-900 opacity-30 align-top leading-none ml-2">12</span></h2>
          <p class="text-body-lg text-gray-500">Реальные истории топов, их&#160;взгляды на&#160;рынок и&#160;профессию</p>
        </div>
        <div class="shrink-0">
          <Button variant="dark" size="sm" href="/blog">Смотреть все</Button>
        </div>
      </div>

      {/* Ряд из трёх md-карточек */}
      <div class="grid grid-cols-3 gap-6">
        <BlogCardNew
          size="md"
          title="«Клиент&#160;— самый важный человек в&#160;компании»: ценности Анжелики Альшаевой"
          slug="cennosti-anzheliki-alshaevoy"
          date="13&#160;мая"
          readTime="15&#160;мин"
        />
        <BlogCardNew
          size="md"
          title="«Главное изменение на&#160;рынке&#160;— скорость этих изменений»: видение Юлии Файзулиной"
          slug="videnie-yulii-fayzulinoy"
          date="14&#160;апреля"
          readTime="13&#160;мин"
        />
        <BlogCardNew
          size="md"
          title="«Победа требует заботы»: ценности Александра Курникова"
          slug="cennosti-aleksandra-kurnikova"
          date="19&#160;марта"
          readTime="16&#160;мин"
        />
      </div>

    </div>

    {/* ── Блок 3: SuccessStoryBlock «Кейсы» ── */}
    <SuccessStoryBlock
      heading="Кейсы"
      counter={20}
      subtitle="Истории успеха на&#160;рынке застройщиков"
      buttonLabel="Смотреть все"
      buttonHref="/cases"
      class="!py-0"
      stories={[
        {
          logo: '/api/media/file/lsr_color.svg',
          logoAlt: 'Группа ЛСР',
          logoHover: '/api/media/file/lsr_white-1.svg',
          hoverBackground: '/api/media/file/lsr_bg.png',
          hoverGlass: true,
          titleHtml: 'Помогли начать обрабатывать <span class="text-brand">на&#160;281% заявок больше,</span> чем в&#160;среднем на&#160;рынке',
          personName: 'Группа ЛСР',
          personJobTitle: 'Один из&#160;ведущих строительных холдингов',
        },
        {
          logo: '/api/media/file/tochno_color.svg',
          logoAlt: 'ГК Точно',
          logoHover: '/api/media/file/tochno_white.svg',
          hoverBackground: '/api/media/file/tochno_bg.png',
          titleHtml: 'Увеличили объем закрытых сделок <span class="text-brand">с&#160;1165 до&#160;3500 за&#160;год</span>',
          personName: 'ГК «Точно»',
          personJobTitle: 'Крупнейший девелопер Краснодарского края',
        },
        {
          logo: '/api/media/file/samolet_color.svg',
          logoAlt: 'ГК Самолет',
          logoHover: '/api/media/file/samolet_white.svg',
          hoverBackground: '/api/media/file/samolet_bg.png',
          titleHtml: 'Дополнительно продали <span class="text-brand">96&#160;квартир</span>',
          personName: 'ГК «Самолет»',
          personJobTitle: 'Крупнейший федеральный девелопер России',
        },
      ]}
    />

    {/* ── Блок 4: «Аналитика рынка» — 2 колонки (1 кейс-карточка + остаток) ── */}
    <div class="page-container">
      <div class="flex flex-col gap-10 md:flex-row md:gap-6 md:items-start">

        {/* Левая колонка: ширина = 1 кейс-карточка из блока «Кейсы» выше.
            При md (Кейсы 2 col) basis = (100% - gap) / 2.
            При xl (Кейсы 3 col) basis = (100% - 2*gap) / 3. */}
        <div class="flex flex-col gap-6 md:basis-[calc((100%-1.5rem)/2)] xl:basis-[calc((100%-3rem)/3)] md:shrink-0">
          <div class="flex flex-col gap-1">
            <h2 class="text-h2 text-gray-900">Аналитика рынка<span class="text-h4 text-gray-900 opacity-30 align-top leading-none ml-2">30</span></h2>
            <p class="text-body-lg text-gray-500">Проводим исследования и&#160;делимся инсайдами</p>
          </div>
          <div>
            <Button variant="dark" size="sm" href="/research">Смотреть все</Button>
          </div>
        </div>

        {/* Правая колонка: всё оставшееся пространство */}
        <div class="flex flex-col gap-6 md:flex-1 md:min-w-0">
          <BlogCardNew
            size="s"
            title="Итоги апреля"
            slug="itogi-aprelya"
            date="12&#160;мая"
            readTime="2&#160;мин"
          />
          <BlogCardNew
            size="s"
            title="Итоги марта"
            slug="itogi-marta"
            date="10&#160;апреля"
            readTime="3&#160;мин"
          />
          <BlogCardNew
            size="s"
            title="Итоги февраля"
            slug="itogi-fevralya"
            date="13&#160;марта"
            readTime="3&#160;мин"
          />
          <BlogCardNew
            size="s"
            title="Спасибо, что выжили, или&#160;как прошёл 2025&#160;год для&#160;девелоперов"
            slug="spasibo-chto-vyzhili-2025"
            date="29&#160;декабря"
            readTime="9&#160;мин"
          />
        </div>

      </div>
    </div>

    {/* ── Блок 5: Теги + md-карточки — 2 колонки (1 кейс-карточка + остаток) ── */}
    <div class="page-container">
      <div class="flex flex-col gap-10 md:flex-row md:gap-6 md:items-start">

        {/* Левая колонка: теги + кнопка */}
        <div class="flex flex-col gap-6 md:basis-[calc((100%-1.5rem)/2)] xl:basis-[calc((100%-3rem)/3)] md:shrink-0">
          <div class="flex flex-wrap gap-2">
            <Tab label="Правила девелопера" href="/blog/category/pravila" />
            <Tab label="Подкасты" href="/blog/category/podkasty" />
            <Tab label="Новости" href="/blog/category/novosti" selected />
            <Tab label="Аналитика рынка" href="/blog/category/analitika" />
            <Tab label="Кейсы" href="/cases" />
            <Tab label="Маркетинг и продажи" href="/blog/category/marketing" />
            <Tab label="Инсайты" href="/blog/category/insayty" />
          </div>
          <div>
            <Button variant="primary" size="sm" href="/blog">Смотреть все статьи</Button>
          </div>
        </div>

        {/* Правая колонка: 4 md-карточки в сетке 1 → 2 col */}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:flex-1 md:min-w-0">
          <BlogCardNew
            size="md"
            title="ДВИЖ и&#160;Банк «РОССИЯ» запустили ускоренный обмен данными по&#160;API"
            slug="dvizh-rossiya-api"
            date="21&#160;апреля"
            readTime="2&#160;мин"
          />
          <BlogCardNew
            size="md"
            title="Уралсиб и&#160;ДВИЖ перешли на&#160;работу по&#160;протоколу API"
            slug="uralsib-dvizh-api"
            date="14&#160;апреля"
            readTime="2&#160;мин"
          />
          <BlogCardNew
            size="md"
            title="Абсолют Банк провел API-интеграцию с&#160;платформой ДВИЖ"
            slug="absolyut-bank-api-integraciya"
            date="6&#160;апреля"
            readTime="3&#160;мин"
          />
          <BlogCardNew
            size="md"
            title="Взгляд изнутри: как обновился ДВИЖ в&#160;2025"
            slug="kak-obnovilsya-dvizh-2025"
            date="14&#160;января"
            readTime="10&#160;мин"
          />
        </div>

      </div>
    </div>

  </div>
</SiteLayout>
