          {/* md-ряд: <xl, 3 md-карточки */}
          <div class="grid xl:hidden grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <BlogCardNew
              size="md"
              title="Вадим Герасимов о&#160;ситуации с&#160;продажами, идеальном процессе сделки и&#160;подходе Унистроя"
              slug="gerasimov-situaciya-prodazhi-unistroy"
              date="24&#160;марта"
              readTime="13&#160;мин"
            />
            <BlogCardNew
              size="md"
              title="Вадим Герасимов об&#160;идеальном продавце и&#160;системе обучения в&#160;Унистрое"
              slug="gerasimov-idealnyy-prodavec-unistroy"
              date="23&#160;марта"
              readTime="10&#160;мин"
            />
            <BlogCardNew
              size="md"
              title="Вадим Герасимов о&#160;своем пути к&#160;должности директора по&#160;продажам"
              slug="gerasimov-put-k-direktoru-po-prodazham"
              date="22&#160;марта"
              readTime="11&#160;мин"
            />
          </div>
        </div>

    </div>

    {/* ── Блок 8: «Статьи блога» — 9 md-карточек 3×3 ── */}
    <div class="page-container flex flex-col gap-16">

      {/* Заголовок + счётчик + кнопка */}
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <h2 class="text-h2 text-gray-900 max-w-[800px] w-full">Статьи блога<span class="text-h4 text-gray-900 opacity-30 align-top leading-none ml-2">86</span></h2>
        <div class="shrink-0">
          <Button variant="primary" size="sm" href="/blog">Смотреть все</Button>
