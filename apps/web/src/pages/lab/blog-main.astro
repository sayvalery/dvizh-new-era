---

<SiteLayout title="Блог — Журнал для современных девелоперов">

  {/* ── HERO: оранжевый блок с заголовком и featured-постом ── */}
  <section class="bg-brand relative overflow-hidden">
    {/* Фоновая анимация — заглушка */}
    <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0" style="background: linear-gradient(135deg, #ff6b2c 0%, #ff4d00 50%, #c73d00 100%)"></div>
    </div>

    <div class="relative z-10 page-container pt-16 pb-16 lg:pb-24">
      <h1 class="text-h1 text-white mb-10 lg:mb-16 max-w-[700px]">
        Журнал для современных девелоперов
      </h1>

      {/* Desktop: featured слева ~60% + 2 small справа. Mobile: стек */}
      <div class="grid grid-cols-1 xl:grid-cols-[3fr_2fr] gap-6 lg:gap-8">

        {/* Featured (lg) */}
        <BlogCard
          size="lg"
          title={featured.title}
          slug={featured.slug}
          category={featured.category}
          date={featured.date}
          readTime={featured.readTime}
          excerpt={featured.excerpt}
        />

        {/* 2 вторичных (s) */}
        <div class="flex flex-col gap-4 lg:gap-6">
          {heroSecondary.map(post => (
            <BlogCard
              size="s"
              title={post.title}
              slug={post.slug}
              category={post.category}
              date={post.date}
              readTime={post.readTime}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ── ПРАВИЛА ДЕВЕЛОПЕРА ── */}
  <section class="page-container py-16 lg:py-20">
    <div class="flex items-center justify-between mb-8 lg:mb-10">
      <h2 class="text-h2 text-gray-900">Правила девелопера</h2>
      <Button variant="ghost" size="sm" href="/blog/category/pravila">Все правила</Button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">
      {rules.map(post => (
        <BlogCard
          size="xs"
          title={post.title}
          slug={post.slug}
          date={post.date}
          readTime={post.readTime}
        />
      ))}
    </div>
  </section>

  {/* ── КЕЙСЫ ── */}
  <section class="page-container py-16 lg:py-20 border-t border-gray-100">
    <div class="flex items-center justify-between mb-8 lg:mb-10">
      <h2 class="text-h2 text-gray-900">Кейсы</h2>
      <Button variant="ghost" size="sm" href="/cases">Все кейсы</Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {cases.map(post => (
        <BlogCard
          size="md"
          title={post.title}
          slug={post.slug}
          category={post.category}
          date={post.date}
          readTime={post.readTime}
        />
      ))}
    </div>
  </section>

  {/* ── АНАЛИТИКА ── */}
  <section class="page-container py-16 lg:py-20 border-t border-gray-100">
    <div class="flex items-center justify-between mb-8 lg:mb-10">
      <h2 class="text-h2 text-gray-900">Аналитика</h2>
      <Button variant="ghost" size="sm" href="/blog/category/analitika">Все статьи</Button>
    </div>

    {/* Desktop: featured слева + список справа. Mobile: стек */}
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 lg:gap-10">

      {/* Featured */}
      <BlogCard
        size="md"
        title={analyticsMain.title}
        slug={analyticsMain.slug}
        category={analyticsMain.category}
        date={analyticsMain.date}
        readTime={analyticsMain.readTime}
        excerpt={analyticsMain.excerpt}
      />

      {/* Список xs */}
      <div class="flex flex-col divide-y divide-gray-100">
        {analyticsList.map(post => (
          <div class="py-1">
            <BlogCard
              size="xs"
              title={post.title}
              slug={post.slug}
              date={post.date}
              readTime={post.readTime}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── CTA — ОСТАВАЙТЕСЬ НА СВЯЗИ ── */}
  <section class="bg-brand relative overflow-hidden">
    <div class="page-container py-16 lg:py-20 relative z-10">
      <div class="max-w-[600px]">
        <h2 class="text-h2 text-white mb-4">Оставайтесь на связи</h2>
        <p class="text-body-lg text-white/70 mb-8">
          Подпишитесь на еженедельный дайджест — только важное о рынке недвижимости и цифровых продажах.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="email"
            placeholder="Ваш email"
            class="flex-1 px-5 py-3 rounded-xl bg-white/15 border border-white/30 text-white placeholder:text-white/50 text-subhead focus:outline-none focus:border-white/60"
          />
          <Button variant="secondary" size="md">Подписаться</Button>
        </div>
      </div>
    </div>
  </section>

  {/* ── КОНФЕРЕНЦИИ, ПОДКАСТЫ И ВЕБИНАРЫ ── */}
  <section class="page-container py-16 lg:py-20 border-t border-gray-100">
    <div class="flex items-center justify-between mb-8 lg:mb-10">
      <h2 class="text-h2 text-gray-900">Конференции,<br class="hidden md:block" /> подкасты и вебинары</h2>
      <Button variant="ghost" size="sm" href="/blog/category/events">Все события</Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {events.map(post => (
        <BlogCard
          size="s"
          title={post.title}
          slug={post.slug}
          category={post.category}
          date={post.date}
          readTime={post.readTime}
        />
      ))}
    </div>
  </section>

  {/* ── СТАТЬИ БЛОГА ── */}
  <section class="page-container py-16 lg:py-20 border-t border-gray-100">
    <div class="flex items-center justify-between mb-8 lg:mb-10">
      <h2 class="text-h2 text-gray-900">Статьи блога</h2>
      <Button variant="ghost" size="sm" href="/blog">Все статьи</Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {articles.map(post => (
        <BlogCard
          size="md"
          title={post.title}
          slug={post.slug}
          category={post.category}
          date={post.date}
          readTime={post.readTime}
        />
      ))}
    </div>

    <div class="mt-10 text-center">
      <Button variant="ghost" size="md">Показать ещё</Button>
    </div>
  </section>

</SiteLayout>
