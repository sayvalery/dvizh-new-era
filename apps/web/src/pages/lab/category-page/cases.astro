---
/**
 * Lab: Category Page «Кейсы» — статический маршрут /lab/category-page/cases
 *
 * Кейсы — отдельная коллекция (не категория блога), поэтому это отдельный
 * статический маршрут (Astro отдаёт его раньше динамического [cat].astro).
 * Структура — как у шаблона категории: заголовок + счётчик + шахматка карточек.
 * Карточки — StoryCard (как в блоке «Кейсы» на lab-главной).
 *
 * Доступна только в dev-режиме: preview.dvizh.cc/lab/category-page/cases
 */
import BlogLayout from '../../../layouts/BlogLayout.astro'
import StoryCard from '../../../components/ui/StoryCard.astro'
import { getCases } from '../../../lib/payload'

const TITLE = 'Кейсы'
const { docs: cases } = await getCases({ limit: 200 })
---

<BlogLayout title={`${TITLE} · Lab`} description={`Кейсы — истории успеха`} insightsHeader>
  <div class="py-10 md:py-16">

    <div class="page-container flex flex-col gap-10 lg:gap-16">

      {/* Верхний заголовок + счётчик кейсов */}
      <h2 class="text-h2 text-gray-900">{TITLE}<span class="text-h4 text-gray-900 opacity-30 align-top leading-none ml-2">{cases.length}</span></h2>

      {cases.length === 0 ? (
        <p class="text-body-lg text-gray-500">Кейсы скоро появятся.</p>
      ) : (
        /* Шахматка карточек: 1 → 2 → 3 колонки (как блок «Кейсы») */
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {cases.map((c: any) => (
            <StoryCard
              variant="default"
              title={c.title}
              person={{ name: c.client || c.title, jobTitle: c.client ? c.description : undefined }}
              class="min-h-[350px] md:min-h-0 h-full"
            />
          ))}
        </div>
      )}

    </div>

  </div>
</BlogLayout>
