---
/**
 * /lab/contacts — эксперимент редизайна страницы «Контакты».
 *
 * Полноширинный оранжевый (brand-500) контейнер на высоту вьюпорта,
 * скругления 24/16 (rounded-2xl sm:rounded-3xl), контент по центру.
 * Отступы: 64px между h1 / контактами / кнопкой; 32px между колонками
 * и между строкой контактов и адресом.
 */
import SiteLayout from '../../layouts/SiteLayout.astro'
import Button from '../../components/ui/Button.astro'

const contacts = [
  { label: 'Телефон', value: '+7 495 032 10 47', href: 'tel:+74950321047' },
  { label: 'Email', value: 'make@dvizh.io', href: 'mailto:make@dvizh.io' },
  { label: 'Telegram', value: '@dvizh4reality', href: 'https://t.me/dvizh4reality' },
]
---

<SiteLayout
  title="Контакты — ДВИЖ"
  description="Наши контакты: телефон, email, Telegram, адрес"
  transparentHeader
  headerInvertClear
  headerClearAt={90}
>
  <section class="px-2 sm:px-4 pb-2 sm:pb-4 pt-[120px] sm:pt-[140px]">
    <div class="bg-brand rounded-2xl sm:rounded-3xl min-h-[calc(100svh-128px)] sm:min-h-[calc(100svh-156px)] flex items-center justify-center px-6 py-16 text-center">

      <div class="flex flex-col items-center gap-16">

        <h1 class="text-h1 font-medium text-white">Наши контакты</h1>

        {/* Контакты: строка из 3 колонок + строка адреса */}
        <div class="flex flex-col gap-8">
          <div class="flex flex-col gap-8 sm:flex-row">
            {contacts.map((c) => (
              <div class="flex flex-col gap-1">
                <span class="text-h4 text-white/50">{c.label}</span>
                {c.href ? (
                  <a href={c.href} class="text-h4 text-white transition-opacity hover:opacity-80">{c.value}</a>
                ) : (
                  <span class="text-h4 text-white">{c.value}</span>
                )}
              </div>
            ))}
          </div>

          <div class="flex flex-col gap-1">
            <span class="text-h4 text-white/50">Адрес</span>
            <span class="text-h4 text-white">Москва, Новодмитровская 2к2</span>
          </div>
        </div>

        <Button variant="dark" size="lg" drawerPreset="lead">Оставить заявку</Button>

      </div>

    </div>
  </section>
</SiteLayout>
