import FeaturesGrid from '../../components/ui/FeaturesGrid.astro'
import SectionBlock from '../../components/ui/SectionBlock.astro'
import GradientCTA from '../../components/ui/GradientCTA.astro'
import BlogCards from '../../components/ui/BlogCards.astro'
import ProductSection from '../../components/ui/ProductSection.astro'
import BentoThreeNew from '../../components/ui/BentoThreeNew.astro'
import FormClosing from '../../components/ui/FormClosing.astro'
import Card from '../../components/lab-new/Card.astro'
import CTA from '../../components/ui/CTA.astro'
import StoryCard from '../../components/ui/StoryCard.astro'

const partnerLogos = [
  '/partners/a101.svg',
  '/partners/ava.svg',
  '/partners/ganel.svg',
  '/partners/glorax.svg',
  '/partners/lsr.svg',
  '/partners/strana.svg',
  '/logo-dvizh-white.svg',
]

const blogArticles = [
  {
    image: "https://admin.dvizh.cc/api/media/file/1.jpg",
    imageAlt: "Статья 1",
    date: "15 января 2025",
    category: "Продажи",
    title: "Как увеличить конверсию заявок в ипотеке",
    description: "Практические советы по работе с заявками",
    href: "#",
    author: { name: "Иван Иванов", role: "Эксперт" }
  },
  {
    image: "https://admin.dvizh.cc/api/media/file/2.jpg",
    imageAlt: "Статья 2",
    date: "10 января 2025",
    category: "Маркетинг",
    title: "Эффективные стратегии для девелоперов",
    description: "Как привлечь больше клиентов",
    href: "#",
    author: { name: "Мария Петрова", role: "Маркетолог" }
  },
  {
    image: "https://admin.dvizh.cc/api/media/file/3.jpg",
    imageAlt: "Статья 3",
    date: "5 января 2025",
    category: "Автоматизация",
    title: "Внедрение CRM для отдела продаж",
    description: "Пошаговое руководство",
    href: "#",
    author: { name: "Алексей Сидоров", role: "Технолог" }
  }
]
---

<SiteLayout
  title="Lab: Homepage — ДВИЖ"
  description="Лаборатория дизайна: главная страница сайта ДВИЖ"
  transparentHeader
>
  <!-- Hero -->
  <HeroSection
    title={"Лучшие отделы продаж застройщиков используют ДВИЖ"}
    description="Единая платформа для увеличения продаж. Закрываем весь цикл сделки: от подбора квартиры до одобрения ипотеки и регистрации в Росреестре"
    formPreset="lead"
    formSubmitLabel="Получить демо"
    withGradient
    gradientColors={['#ff4d00', '#ff6b2c', '#ffb347', '#ffd866']}
  >
    <div slot="right" class="w-full h-[700px]">
      <LogoDrum logos={partnerLogos} duration={55} />
    </div>
  </HeroSection>

  <!-- Card -->
  <section class="pt-32 pb-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <Card
          title="Закрывают до 26% больше сделок на том же трафике"
          description="какие-то цифры или показатели"
          image="https://admin.dvizh.cc/api/media/file/1.jpg"
        />
        <Card
          title="Снизили количество отказов по ипотеке"
          description="какие-то цифры или показатели"
          image="https://admin.dvizh.cc/api/media/file/3.jpg"
        />
        <Card
          title="Получают больше выручки на одного менеджера"
          description="какие-то цифры или показатели"
          image="https://admin.dvizh.cc/api/media/file/2.jpg"
        />
        <Card
          title="Сократили расходы на электронную регистрацию"
          description="какие-то цифры или показатели"
          image="https://admin.dvizh.cc/api/media/file/4.jpg"
        />
      </div>
    </div>
  </section>

  <!-- ProductSection Demo -->
  <div class="max-w-[1440px] mx-auto px-4 mt-[50px]">
    <ProductSection
      sections={[
        {
          number: "01",
          title: "Цифровая ипотека",
          cardTitle: "Поможем перевыполнить план продаж на том же трафике",
          items: ["До 96% одобрения", "Единая анкета в 40+ банков", "Моментальное заполнение через Госуслуги", "Готовые интеграции с CRM"],
          button: { label: "Подробнее", href: "#" },
          image: { src: "https://admin.dvizh.cc/api/media/file/product-section-1.jpg", alt: "Цифровая ипотека" }
        },
        {
          number: "02",
          title: "Ипотечный калькулятор",
          cardTitle: "Приведем больше лидов с сайта",
          items: ["Расчет рассрочки и досрочного погашения", "Автоматическое обновление ставок"],
          button: { label: "Подробнее", href: "#" },
          image: { src: "https://admin.dvizh.cc/api/media/file/product-section-2v2.jpg", alt: "Ипотечный калькулятор" }
        },
        {
          number: "03",
          title: "Финансовый скоринг",
          cardTitle: "Сократим процент отказов по проблемным заемщикам",
          items: ["Проверка заемщика по 15 источникам", "Ежемесячный скоринг по ДДУ c рассрочкой"],
          button: { label: "Подробнее", href: "#" },
          image: { src: "https://admin.dvizh.cc/api/media/file/product-section-3.jpg", alt: "Финансовый скоринг" }
        },
        {
          number: "04",
          title: "Электронная регистрация",
          cardTitle: "Сократим стоимость регистрации в Росреестре",
          items: ["Сквозное оформление сделки от ипотеки до регистрации", "До 30% дешевле цены конкурентов"],
          button: { label: "Подробнее", href: "#" },
          image: { src: "https://admin.dvizh.cc/api/media/file/product-section-4.jpg", alt: "Электронная регистрация" }
        },
        {
          number: "05",
          title: "Движ AI",
          cardTitle: "Нейросети на службе вашего бизнеса",
          items: ["Расчет вероятности одобрения по банкам", "Меньше отказов, больше сделок"],
          button: { label: "Подробнее", href: "#" },
          image: { src: "https://admin.dvizh.cc/api/media/file/product-section-5.jpg", alt: "Движ AI" }
        }
      ]}
    />
  </div>

  <!-- BentoThreeNew Demo (hidden) -->
