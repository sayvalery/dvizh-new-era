    { params: { slug: 'navigation' }, props: { section: 'navigation' } },
    { params: { slug: 'persons' }, props: { section: 'persons' } },
    { params: { slug: 'product-card' }, props: { section: 'product-card' } },
    { params: { slug: 'product-card-review' }, props: { section: 'product-card-review' } },
    { params: { slug: 'product-section' }, props: { section: 'product-section' } },
    { params: { slug: 'side-menu' }, props: { section: 'side-menu' } },
