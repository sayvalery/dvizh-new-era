                <span class="text-xs text-gray-400 block mb-2">.text-h1 — Styrene Bold 64, lh 100%, ls -1px</span>
                <p class="text-h1">H1 Bold 64</p>
              </div>
              <div>
                <span class="text-xs text-gray-400 block mb-2">.text-h1-italic — Styrene Bold Italic 64, lh 100%, ls -1px</span>
                <p class="text-h1-italic">H1 Bold Italic 64</p>
              </div>
              <div>
                <span class="text-xs text-gray-400 block mb-2">.text-h2 — Styrene Medium 48, lh 100%, ls -2px</span>
