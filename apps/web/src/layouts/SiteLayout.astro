---
import BaseLayout from './BaseLayout.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import Drawer from '../components/ui/Drawer.astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  jsonLd?: object | object[]
  /** Запретить индексацию (meta robots noindex) */
  noindex?: boolean
  /** Прозрачный хедер поверх контента */
  transparentHeader?: boolean
  /** Инвертировать триггер белой версии хедера (тёмный вверху, белый после скролла над цветным блоком) */
  headerInvertClear?: boolean
  /** Кастомный порог переключения белой версии хедера (px) */
  headerClearAt?: number
  /** CSS-класс для <body> — применяется ко всей странице включая футер */
  bodyClass?: string
  /** CSS-класс для <main> (например bg-background-primary) */
  mainClass?: string
}

const { transparentHeader = false, headerInvertClear = false, headerClearAt, mainClass = '', ...baseProps } = Astro.props
---

<BaseLayout {...baseProps}>
  <Header transparent={transparentHeader} invertClear={headerInvertClear} clearAt={headerClearAt} />
  <main class:list={['flex-1', mainClass]}>
    <slot />
  </main>
  <Footer />
  <Drawer />
</BaseLayout>
