---
import BaseLayout from './BaseLayout.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import Drawer from '../components/ui/Drawer.astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  jsonLd?: object | object[]
  /** Прозрачный хедер поверх контента */
  transparentHeader?: boolean
  /** CSS-класс для <body> — применяется ко всей странице включая футер */
  bodyClass?: string
  /** CSS-класс для <main> (например bg-background-primary) */
  mainClass?: string
}

const { transparentHeader = false, mainClass = '', ...baseProps } = Astro.props
---

<BaseLayout {...baseProps}>
  <Header transparent={transparentHeader} />
  <main class:list={['flex-1', mainClass]}>
    <slot />
  </main>
  <Footer />
  <Drawer />
</BaseLayout>
