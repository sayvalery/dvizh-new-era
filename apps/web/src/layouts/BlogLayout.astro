---
/**
 * BlogLayout — лейаут для страниц блога/инсайтов
 *
 * Оранжевый фон (bg-brand + FlutedGlassBg fixed) на весь экран.
 * Header variant="blog", контент в белой карточке rounded-t-3xl,
 * слот cta между контентом и футером, футер в белой карточке.
 */

import BaseLayout from './BaseLayout.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import Drawer from '../components/ui/Drawer.astro'
import FlutedGlassBg from '../components/ui/FlutedGlassBg.astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  jsonLd?: object | object[]
  /** Хедер «ДВИЖ Инсайты»: transparent-режим (бел. вверху → фрост на скролле) + insight-логотип */
  insightsHeader?: boolean
}

const { insightsHeader = false, ...baseProps } = Astro.props
---

<BaseLayout {...baseProps}>

  <!-- Фиксированный анимированный фон на весь viewport -->
  <div class="fixed inset-0" style="z-index:0; background:#ff4d00">
    <FlutedGlassBg grain={0.05} />
  </div>

  <!-- Хедер блога (sticky, поверх фона). insightsHeader → transparent + insight-брендинг. -->
  <div class="sticky top-0" style="z-index:50">
    {insightsHeader ? <Header variant="blog" transparent insights /> : <Header variant="blog" />}
  </div>

  <!-- Белая карточка контента. insights — отступ под плавающим хедером (симметрия с pt-3 = 12px);
       обычный blog — наезд -mt-6 (карточка под хедер). -->
  <main class:list={['relative bg-background-primary flex-1', insightsHeader ? 'rounded-3xl mt-1' : 'rounded-t-3xl -mt-6']} style="z-index:10">
    <slot />
  </main>

  <!-- CTA-слот на оранжевом фоне -->
  {Astro.slots.has('cta') && (
    <div class="relative px-4 py-8" style="z-index:10">
      <slot name="cta" />
    </div>
  )}

  <!-- Футер в белой карточке. Гасим SiteLayout-овый mt-24/40 и border-t: -->
  <!-- внутри карточки они дают пустую полосу и лишнюю линию. Отступ задаёт сам Footer (py-12). -->
  <div class="relative px-4 pb-6" style="z-index:10">
    <div class="bg-background-primary rounded-3xl overflow-hidden [&>footer]:!mt-0 [&>footer]:!border-t-0">
      <Footer />
    </div>
  </div>

  <Drawer />

</BaseLayout>
