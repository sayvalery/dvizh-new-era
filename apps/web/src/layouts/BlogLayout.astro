---
/**
 * BlogLayout — лейаут для страниц блога/инсайтов
 *
 * Оранжевый фон (bg-brand + FlutedGlassBg fixed) на весь экран.
 * Header variant="blog", контент в белой карточке rounded-t-3xl,
 * слот cta между контентом и футером, футер в белой карточке.
 */

import BaseLayout from './BaseLayout.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import Drawer from '../components/ui/Drawer.astro'
import FlutedGlassBg from '../components/ui/FlutedGlassBg.astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  jsonLd?: object | object[]
}

const { ...baseProps } = Astro.props
---

<BaseLayout {...baseProps}>

  <!-- Фиксированный анимированный фон на весь viewport -->
  <div class="fixed inset-0" style="z-index:0; background:#ff4d00">
    <FlutedGlassBg grain={0.05} />
  </div>

  <!-- Хедер блога (sticky, поверх фона) -->
  <div class="sticky top-0" style="z-index:50">
    <Header variant="blog" />
  </div>

  <!-- Белая карточка контента: перекрывает низ хедера -->
  <main class="relative bg-background-primary rounded-t-3xl -mt-6 flex-1" style="z-index:10">
    <slot />
  </main>

  <!-- CTA-слот на оранжевом фоне -->
  {Astro.slots.has('cta') && (
    <div class="relative px-4 py-8" style="z-index:10">
      <slot name="cta" />
    </div>
  )}

  <!-- Футер в белой карточке -->
  <div class="relative px-4 pb-6" style="z-index:10">
    <div class="bg-background-primary rounded-3xl overflow-hidden">
      <Footer />
    </div>
  </div>

  <Drawer />

</BaseLayout>
