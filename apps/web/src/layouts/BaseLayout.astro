---
import '../styles/global.css'
import { getPageScripts, filterPageScriptsByGroup } from '../lib/payload'
import { getPageGroup, type PageGroup } from '../lib/pageGroup'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  ogType?: string
  jsonLd?: object | object[]
  /** Запретить индексацию (meta robots noindex) */
  noindex?: boolean
  /** CSS-класс для <body> (например bg-background-primary) */
  bodyClass?: string
  /** CSS-класс для <html>. Нужен для правил, зависящих от корневого font-size
   *  (пропорциональный скейл .fluid-scale — rem считается от <html>). */
  htmlClass?: string
  /** Явная группа страницы для скриптов (Тип B). По умолчанию — по pathname. */
  pageGroup?: PageGroup
}

const { title, description, ogImage, ogType = 'website', jsonLd, noindex = false, bodyClass = '', htmlClass = '', pageGroup } = Astro.props
const siteTitle = title
  ? (title.endsWith('— ДВИЖ') ? title : `${title} — ДВИЖ`)
  : 'ДВИЖ'
const canonicalUrl = Astro.url.href
const defaultOgImage = `${Astro.site}og-default.jpg`
const resolvedOgImage = ogImage || defaultOgImage

// ── Скрипты страниц (Тип B интеграций) ──
// Группа страницы: явный проп либо авто-детект по маршруту.
const resolvedGroup: PageGroup = pageGroup ?? getPageGroup(Astro.url.pathname)
const allPageScripts = await getPageScripts()
const groupScripts = filterPageScriptsByGroup(allPageScripts, resolvedGroup)
const headScripts = groupScripts.filter((s) => s.placement === 'head')
const bodyEndScripts = groupScripts.filter((s) => s.placement === 'body-end')
---

<!doctype html>
<html lang="ru" class:list={[htmlClass]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{siteTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="ДВИЖ — Блог" href="/rss.xml" />

    <!-- Preload critical font (body text only — heading fonts load via @font-face) -->
    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:site_name" content="ДВИЖ" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={siteTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Figma capture script (dev only) -->
    {import.meta.env.DEV && <script src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- JSON-LD -->
    {jsonLd && Array.isArray(jsonLd)
      ? jsonLd.map((ld: object) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)
      : jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    }

    <script>
      import Alpine from 'alpinejs'
      window.Alpine = Alpine
      Alpine.start()
    </script>

    {/* Скрипты страниц (Тип B) — placement: head. Сырой код, вставляется как есть. */}
    {headScripts.map((s) => <Fragment set:html={s.code} />)}
  </head>
  <body class:list={['min-h-screen flex flex-col bg-background-primary', bodyClass]}>
    <slot />

    {/* Скрипты страниц (Тип B) — placement: body-end. Сырой код, вставляется как есть. */}
    {bodyEndScripts.map((s) => <Fragment set:html={s.code} />)}
  </body>
</html>
