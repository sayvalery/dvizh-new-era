<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dvizh.monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>node</string>
        <string>/Users/server/dev/dvizh-new-era/scripts/monitor.mjs</string>
    </array>
    <!-- Запуск раз в ~30 минут -->
    <key>StartInterval</key>
    <integer>1800</integer>
    <!-- И один прогон сразу при загрузке агента -->
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Users/server/dev/dvizh-new-era</string>
    <key>StandardOutPath</key>
    <string>/Users/server/dev/dvizh-new-era/logs/monitor-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/server/dev/dvizh-new-era/logs/monitor-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Секреты/конфиг подхватываются из .env.bot скриптом (loadEnvFile).
             Чувствительные значения (TELEGRAM_BOT_TOKEN, CMS_API_KEY) НЕ хранить в plist. -->
    </dict>
</dict>
</plist>
