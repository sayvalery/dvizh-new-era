<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dvizh.bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>node</string>
        <string>/Users/server/dev/dvizh-new-era/scripts/bot.mjs</string>
    </array>
    <!-- Долгоживущий long-poll процесс: держим живым и перезапускаем при крахе -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>WorkingDirectory</key>
    <string>/Users/server/dev/dvizh-new-era</string>
    <key>StandardOutPath</key>
    <string>/Users/server/dev/dvizh-new-era/logs/bot-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/server/dev/dvizh-new-era/logs/bot-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- TELEGRAM_BOT_TOKEN / CMS_API_KEY подхватываются из .env.bot (loadEnvFile). -->
    </dict>
</dict>
</plist>
